package org.ironwood.orderbook;

// Emit deterministic reports for comparison with the Java reporter. Warmup,
// tied durations, partial buckets, unit boundaries, empty and singleton reports
// must match byte for byte. All sample and histogram storage is reclaimed.
public final class LatencyReportChecks {

    private static void report(long[] samples, int warmup) {

        ironwood.bench.Bench bench = new ironwood.bench.Bench(warmup);
        defer free bench;
        for (int index = 0; index < samples.length; index++) bench.measure(samples[index]);
        bench.printResults();
    }

    public static int main(String[] args) {

        report(new long[] {999, 10, 11}, 1);
        report(new long[] {999, 20, 10, 10, 10, 10, 10, 0, 0}, 1);
        long[] units = {Long.MAX_VALUE, Long.MAX_VALUE,
                0, 999, 1000, 1000, 1999, 2000, 1000000, 1000000000};
        report(units, 2);
        free units;
        report(new long[] {100, 42}, 1);
        report(new long[] {99, 88}, 2);
        return 0;
    }
}
