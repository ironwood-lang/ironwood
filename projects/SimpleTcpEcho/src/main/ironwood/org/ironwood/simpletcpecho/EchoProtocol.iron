package org.ironwood.simpletcpecho;

import ironwood.io.ByteArrayOutputStream;
import ironwood.io.IOException;
import ironwood.io.InputStream;

// TCP can split a message across reads. Read chunks until the sender signals EOF.
// The caller owns the returned bytes; this helper only borrows the input stream.
final class EchoProtocol {

    static byte[] readMessage(InputStream input) throws IOException {

        ByteArrayOutputStream message = new ByteArrayOutputStream();
        try {
            byte[] buffer = new byte[1024];
            try {
                int count = input.read(buffer);
                while (count >= 0) {
                    message.write(buffer, 0, count);
                    count = input.read(buffer);
                }
                return message.toByteArray();
            } finally {
                free buffer;
            }
        } finally {
            free message;
        }
    }
}
