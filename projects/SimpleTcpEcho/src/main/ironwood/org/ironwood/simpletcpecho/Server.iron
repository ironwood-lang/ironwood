package org.ironwood.simpletcpecho;

import ironwood.io.IOException;
import ironwood.io.InputStream;
import ironwood.io.OutputStream;
import ironwood.net.ServerSocket;
import ironwood.net.Socket;

// Listens on port 55556 by default and serves clients one at a time until Ctrl+C.
// Replies with "=[" + message + "]=", printing GOT and REPLIED lines to stdout.
// Status and connection errors go to stderr. Exit: 64 bad arguments, 74 listener failure.
public final class Server {

    static void reply(InputStream input, OutputStream output, byte[] buffer) throws IOException {

        // Borrow the same storage for every client, reserving room for both delimiters.
        int length = 0; // the length of the received message
        int capacity = buffer.length - 4; // we need space for the "=[" and "]=" (4 characters)
        while (length < capacity) {
            int count = input.read(buffer, length + 2, capacity - length);
            if (count < 0) break; // keep reading as much as possible until EOF (-1)
            length += count;
        }

        // A full buffer is valid only if the next read is EOF
        // Otherwise we did not read the full message
        if (length == capacity && input.read() != -1) {
            throw new IOException("Message is too big!");
        }
        
        // Print what was received
        System.out.print("GOT: ");
        System.out.write(buffer, 2, length);
        System.out.println();

        // Add delimeters on both ends
        buffer[0] = (byte) '=';
        buffer[1] = (byte) '[';
        buffer[length + 2] = (byte) ']';
        buffer[length + 3] = (byte) '=';

        // Send out the response
        output.write(buffer, 0, length + 4);

        // Print the response
        System.out.print("REPLIED: ");
        System.out.write(buffer, 0, length + 4);
        System.out.println();
    }

    private static void serve(int port) throws IOException {

        ServerSocket server = new ServerSocket(port);
        try {
            byte[] buffer = new byte[1024 + 4]; // 1KB + 4 bytes for the delimeters
            try {
                System.out.print("Listening on port ");
                System.out.println(server.getLocalPort());
                while (true) {
                    Socket client = server.accept();
                    try {
                        try {
                            InputStream input = client.getInputStream();
                            OutputStream output = client.getOutputStream();
                            reply(input, output, buffer);
                        } finally {
                            try { client.close(); } finally { free client; }
                        }
                    } catch (IOException e) {
                        e.printStackTrace();
                    }
                }
            } finally {
                free buffer;
            }
        } finally {
            try { server.close(); } finally { free server; }
        }
    }

    public static int main(String[] args) {

        if (args.length > 1) {
            System.out.println("usage: run-server.sh [PORT] (default: 55556)");
            return 64;
        }
        try {
            int port = args.length == 0 ? 55556 : Integer.parseInt(args[0]);
            // Zero lets the OS choose a free port, useful for the local test.
            if (port < 0 || port > 65535) {
                System.err.println("usage: run-server.sh [PORT] (default: 55556; range: 0-65535)");
                return 64;
            }
            serve(port);
            return 0;
        } catch (IOException e) {
            e.printStackTrace();
            return 74;
        }
    }
}
