package org.ironwood.simpletcpecho;

import ironwood.io.IOException;
import ironwood.io.InputStream;
import ironwood.io.OutputStream;
import ironwood.net.Socket;

// Connects to localhost:55555 by default, sends "HiThere!", and prints "Got: HiThere!".
// Exit: 0 success, 64 bad arguments, 74 connection/I/O failure. Only the reply uses stdout.
public final class Client {

    private static void exchange(Socket socket, String messageText) throws IOException {

        socket.setSoTimeout(5000);
        // The socket owns these stream views; they are not freed separately.
        InputStream input = socket.getInputStream();
        OutputStream output = socket.getOutputStream();
        byte[] message = messageText.getBytes();
        try {
            output.write(message);
            // Signal the end of this request while keeping input open for the reply.
            socket.shutdownOutput();
        } finally {
            free message;
        }
        byte[] response = EchoProtocol.readMessage(input);
        try {
            String text = new String(response);
            try {
                System.out.println(text);
                if (System.out.checkError()) throw new IOException("Cannot write the response to stdout");
            } finally {
                free text;
            }
        } finally {
            free response;
        }
    }

    public static int main(String[] args) {

        if (args.length > 3) {
            System.err.println("usage: run-client.sh [HOST [PORT [MESSAGE]]] (defaults: localhost 55555 HiThere!)");
            return 64;
        }
        try {
            String host = args.length == 0 ? "localhost" : args[0];
            int port = args.length < 2 ? 55555 : Integer.parseInt(args[1]);
            String message = args.length < 3 ? "HiThere!" : args[2];
            if (host.length() == 0 || port < 1 || port > 65535) throw new IllegalArgumentException("Invalid host or port");
            Socket socket = new Socket(host, port);
            try {
                exchange(socket, message);
            } finally {
                try { socket.close(); } finally { free socket; }
            }
            return 0;
        } catch (IllegalArgumentException failure) {
            System.err.println("usage: run-client.sh [HOST [PORT [MESSAGE]]] (port range: 1-65535)");
            return 64;
        } catch (IOException failure) {
            System.err.print("Client failed: ");
            System.err.println(failure.getMessage());
            return 74;
        }
    }
}
