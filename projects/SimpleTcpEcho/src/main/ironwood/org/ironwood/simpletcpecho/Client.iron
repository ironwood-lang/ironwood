package org.ironwood.simpletcpecho;

import ironwood.io.IOException;
import ironwood.io.InputStream;
import ironwood.io.OutputStream;
import ironwood.net.Socket;

// Connects to localhost:55556 by default and sends "HiThere!".
// Prints "SENT: HiThere!" and "GOT: =[HiThere!]=", then disconnects.
// Exit: 0 success, 64 bad arguments, 74 connection/I/O failure.
public final class Client {

    private static void exchange(Socket socket, String messageText) throws IOException {

        InputStream input = socket.getInputStream();
        OutputStream output = socket.getOutputStream();

        byte[] message = messageText.getBytes();
        defer free message;
        output.write(message);
        // Signal the end of this request while keeping input open for the reply.
        socket.shutdownOutput(); // sends EOF causing read() to return -1

        System.out.print("SENT: ");
        System.out.println(messageText);

        byte[] buffer = new byte[64];
        defer free buffer;
        System.out.print("GOT: ");
        // TCP can split the reply across reads. Reuse the buffer until EOF.
        int count = input.read(buffer);
        while (count != -1) {
            System.out.write(buffer, 0, count);
            count = input.read(buffer);
        }
        System.out.println();
    }

    public static int main(String[] args) {

        if (args.length > 3) {
            System.out.println("usage: run-client.sh [HOST [PORT [MESSAGE]]] (defaults: localhost 55556 HiThere!)");
            return 64;
        }

        try {
            String host = args.length == 0 ? "localhost" : args[0];
            int port = args.length < 2 ? 55556 : Integer.parseInt(args[1]);
            String message = args.length < 3 ? "HiThere!" : args[2];
            if (host.length() == 0 || port < 1 || port > 65535) {
                System.out.println("usage: run-client.sh [HOST [PORT [MESSAGE]]] (port range: 1-65535)");
                return 64;
            }

            Socket socket = new Socket(host, port);
            defer free socket;
            defer socket.close();
            exchange(socket, message);

            return 0;

        } catch (IOException e) {
            e.printStackTrace();
            return 74;
        }
    }
}
