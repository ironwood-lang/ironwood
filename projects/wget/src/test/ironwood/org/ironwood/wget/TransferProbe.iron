package org.ironwood.wget;

// Measure the real reader and concrete TCP/TLS stream after headers have warmed
// native record buffers. Output uses a file, so stdout carries test markers only.
public final class TransferProbe {

    public static int main(String[] args) throws Exception {

        Config config = new Config(args);
        {
            defer free config;
            Transport transport = new Transport(config.initial().secure(), config.proxy(), config.caBundle(), config.socks4());
            defer free transport;
            defer transport.closeAfterFailure();
            transport.connect(config.initial(), config.connectTimeout());
            transport.request(config.initial(), config.headTimeout());
            Response response = new Response(transport.input(), transport);
            {
                defer free response;
                if (response.head(config.headTimeout()) != 200) return 1;
                Sink sink = new Sink("/dev/null");
                defer free sink;
                System.out.println("@tls:steady");
                long before = System.allocationCount();
                long start = System.nanoTime();
                long bytes = response.body(sink, config.readTimeout());
                long elapsed = System.nanoTime() - start;
                System.out.println("@tls:close");
                if (System.allocationCount() != before) return 2;
                sink.close();
                System.out.print("BODY ");
                System.out.println(bytes);
                System.out.print("NANOS ");
                System.out.println(elapsed);
            }
            transport.close();
        }
        System.out.println("@tls:end");
        return 0;
    }
}
