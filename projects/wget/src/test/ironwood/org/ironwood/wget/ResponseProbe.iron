package org.ironwood.wget;

import ironwood.io.FileInputStream;

// Decode a prebuilt wire fixture to /dev/null without payload-sized storage.
// The measured head/body paths must allocate no managed objects. Repeated
// complete reader cycles must return to their warmed live-allocation baseline.
public final class ResponseProbe {

    public static int main(String[] args) throws Exception {

        for (int round = 0; round < 4; round++) {
            long live = System.liveAllocationCount();
            System.out.println("@tls:setup");
            FileInputStream input = new FileInputStream(args[0]);
            long elapsed = 0L;
            long count = 0L;
            {
                defer free input;
                Response response = new Response(input, null);
                {
                    defer free response;
                    Sink sink = new Sink("/dev/null");
                    defer free sink;
                    long allocations = System.allocationCount();
                    System.out.println("@tls:steady");
                    long start = System.nanoTime();
                    if (response.head(0) != 200) return 1;
                    count = response.body(sink, 0);
                    elapsed = System.nanoTime() - start;
                    System.out.println("@tls:close");
                    if (System.allocationCount() != allocations) return 2;
                    sink.close();
                }
                input.close();
            }
            System.out.println("@tls:end");
            if (round > 0 && System.liveAllocationCount() != live) return 3;
            System.out.print("BODY ");
            System.out.println(count);
            System.out.print("NANOS ");
            System.out.println(elapsed);
        }
        return 0;
    }
}
