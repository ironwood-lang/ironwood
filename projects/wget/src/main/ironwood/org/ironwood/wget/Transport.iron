package org.ironwood.wget;

import ironwood.io.IOException;
import ironwood.io.InputStream;
import ironwood.io.OutputStream;
import ironwood.net.InetSocketAddress;
import ironwood.net.Proxy;
import ironwood.net.Socket;
import ironwood.net.tls.TlsClient;

// Owns one connection; views remain borrowed from the concrete socket/client.
// Construction does no network I/O, so failed construction rolls back safely.
final class Transport {

    private final Socket socket;
    private final TlsClient tls;
    private final boolean resolve;

    Transport(boolean secure, Proxy proxy, String caBundle, boolean socks4) {

        this.resolve = proxy == Proxy.NO_PROXY || socks4;
        if (secure) {
            this.tls = new TlsClient(proxy, caBundle);
            this.socket = null;
        } else {
            this.socket = new Socket(proxy);
            this.tls = null;
        }
    }

    void connect(Url url, int timeout) throws IOException {

        long deadline = Deadline.start(timeout);
        InetSocketAddress endpoint = url.endpoint(this.resolve);
        defer free endpoint;
        if (this.tls == null) {
            this.socket.connect(endpoint, Deadline.remaining(timeout, deadline));
        } else {
            String identity = url.identity();
            defer free identity;
            this.tls.connect(endpoint, identity, Deadline.remaining(timeout, deadline));
        }
        Deadline.remaining(timeout, deadline);
    }

    InputStream input() throws IOException {

        if (this.tls != null) return this.tls.getInputStream();
        return this.socket.getInputStream();
    }

    OutputStream output() throws IOException {

        if (this.tls != null) return this.tls.getOutputStream();
        return this.socket.getOutputStream();
    }

    void readTimeout(int timeout) throws IOException {

        if (this.tls == null) {
            this.socket.setSoTimeout(timeout);
        } else {
            this.tls.setReadTimeout(timeout);
        }
    }

    void request(Url url, int timeout) throws IOException {

        if (this.tls != null) this.tls.setWriteTimeout(timeout);
        String target = url.target();
        {
            defer free target;
            StringBuilder request = new StringBuilder();
            defer free request;
            request.append("GET ").append(target).append(" HTTP/1.1\r\nHost: ");
            request.append(url.authority());
            request.append("\r\nConnection: close\r\nAccept-Encoding: identity\r\nUser-Agent: Ironwood-wget/1\r\n\r\n");
            String text = request.toString();
            defer free text;
            byte[] bytes = text.getBytes();
            defer free bytes;
            this.output().write(bytes);
            this.output().flush();
        }
        // Materialize the input view before the reader's measured transfer loop.
        this.input();
    }

    void close() throws IOException {

        if (this.tls == null) {
            this.socket.close();
        } else {
            this.tls.close();
        }
    }

    void closeAfterFailure() {

        try { this.close(); } catch (IOException secondary) {
            // Preserve the active primary failure. Both transports invalidate
            // their handle before a close error, so a retry cannot double-close.
        }
    }

    destructor {

        free this.tls;
        free this.socket;
    }
}
