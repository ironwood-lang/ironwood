package ironwood.compiler.lexer;

import ironwood.compiler.source.SourceSpan;

/**
 * Source trivia retained only when a documentation consumer requests it.
 * Ports the Java record {@code DocumentationComment}.
 */
public final class DocumentationComment {

    private final String text;
    private final SourceSpan span;

    /**
     * Creates a retained comment.
     *
     * @param text the comment text including its delimiters
     * @param span the source span
     */
    public DocumentationComment(String text, SourceSpan span) {

        this.text = text;
        this.span = span;
    }

    /** @return the comment text including its delimiters */
    public String text() {

        return this.text;
    }

    /** @return the source span */
    public SourceSpan span() {

        return this.span;
    }
}
