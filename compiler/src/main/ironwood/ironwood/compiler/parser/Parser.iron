package ironwood.compiler.parser;

import ironwood.compiler.ast.*;
import ironwood.compiler.diagnostic.Diagnostic;
import ironwood.compiler.lexer.Token;
import ironwood.compiler.lexer.TokenKind;
import ironwood.compiler.port.SnapshotInts;
import ironwood.compiler.port.SnapshotList;
import ironwood.compiler.source.SourceFile;
import ironwood.compiler.source.SourcePosition;
import ironwood.compiler.source.SourceSpan;
import ironwood.ds.ArrayList;
import ironwood.ds.IntArrayList;
import ironwood.util.NoSuchElementException;

/**
 * Recursive-descent parser from tokens to a compilation unit. Ports the Java
 * {@code Parser} with the D258 conventions: {@code Optional} values are
 * nullable with explicit presence branches, the varargs
 * {@code contiguousKinds} is two fixed-arity overloads, and stream projections
 * are ordered loops. Every list is built in a parser-owned builder that is
 * freed on every exit; nodes receive frozen copies from {@link AstLists}.
 * Parser-private records are freed by the method that consumes them. AST nodes,
 * frozen lists, tokens and spans live for the invocation.
 */
public final class Parser {

    private static final String GENERAL_ANNOTATIONS = "general annotations are not supported; "
            + "only the built-in @Override, @Test, and @SuppressUnfreed directives are recognized";

    private final SourceFile source;
    private final SnapshotList<Token> tokens;
    private final ArrayList<Diagnostic> diagnostics = new ArrayList<Diagnostic>();
    private int current;

    /**
     * Creates a parser.
     *
     * @param source the borrowed source
     * @param tokens the borrowed tokens, ending with an end-of-file token
     */
    public Parser(SourceFile source, SnapshotList<Token> tokens) {

        this.source = source;
        this.tokens = tokens;
    }

    /**
     * Parses the whole token list.
     *
     * @return a caller-owned result whose diagnostic list copies this parser's builder
     */
    public ParseResult parse() {

        CompilationUnit unit = this.parseCompilationUnit();
        return new ParseResult(unit, this.diagnostics);
    }

    private CompilationUnit parseCompilationUnit() {

        ArrayList<TypeDeclaration> declarations = new ArrayList<TypeDeclaration>();
        defer free declarations;
        Token first = this.peek();
        PackageDeclaration packageDeclaration = null;
        if (this.match(TokenKind.PACKAGE)) packageDeclaration = this.parsePackageDeclaration(this.previous());
        ArrayList<ImportDeclaration> imports = new ArrayList<ImportDeclaration>();
        defer free imports;
        while (this.match(TokenKind.IMPORT)) {
            ImportDeclaration declaration = this.parseImportDeclaration(this.previous());
            if (declaration != null) imports.add(declaration);
        }
        while (!this.check(TokenKind.EOF)) {
            int before = this.current;
            TypeDeclaration declaration = this.parseTypeDeclaration();
            if (declaration != null) declarations.add(declaration);
            if (this.current == before) this.advance();
        }
        if (this.source.fileName().equals("package-info.iron")) {
            if (packageDeclaration == null) {
                this.diagnostics.add(this.error(first, "package-info.iron requires a package declaration"));
            } else if (!declarations.isEmpty()) {
                this.diagnostics.add(Diagnostic.error(this.source, declarations.get(0).span(),
                        "package-info.iron must not declare types"));
            }
            if (!this.diagnostics.isEmpty()) return null;
            if (packageDeclaration == null) throw new NoSuchElementException();
            SourceSpan start = packageDeclaration.span();
            SourceSpan end = imports.isEmpty() ? start : imports.get(imports.size() - 1).span();
            return new CompilationUnit(this.source, packageDeclaration, AstLists.importDeclarations(imports),
                    AstLists.typeDeclarations(declarations), new SourceSpan(start.start(), end.end()));
        }
        if (declarations.isEmpty()) {
            if (this.diagnostics.isEmpty()) this.diagnostics.add(this.error(first, "expected a class declaration"));
            return null;
        }
        SourceSpan start = null;
        if (packageDeclaration != null) {
            start = packageDeclaration.span();
        } else {
            start = imports.isEmpty() ? declarations.get(0).span() : imports.get(0).span();
        }
        return new CompilationUnit(this.source, packageDeclaration, AstLists.importDeclarations(imports),
                AstLists.typeDeclarations(declarations),
                new SourceSpan(start.start(), declarations.get(declarations.size() - 1).span().end()));
    }

    private PackageDeclaration parsePackageDeclaration(Token keyword) {

        QualifiedName name = this.parseQualifiedName("expected package name after 'package'", false);
        defer free name;
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after package declaration");
        if (name == null) {
            this.synchronizeTopLevel();
            return null;
        }
        SourceSpan end = semicolon == null ? name.span() : semicolon.span();
        return new PackageDeclaration(name.text(), name.span(), new SourceSpan(keyword.span().start(), end.end()));
    }

    private ImportDeclaration parseImportDeclaration(Token keyword) {

        boolean staticImport = this.match(TokenKind.STATIC);
        QualifiedName name = this.parseQualifiedName(staticImport
                ? "expected type name after 'import static'"
                : "expected type or package name after 'import'", true);
        defer free name;
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after import declaration");
        if (name == null) {
            this.synchronizeTopLevel();
            return null;
        }
        if (staticImport && !name.wildcard() && name.text().indexOf('.') < 0) {
            this.diagnostics.add(Diagnostic.error(this.source, name.span(),
                    "single-static import requires a type name followed by a member name"));
        }
        SourceSpan end = semicolon == null ? name.span() : semicolon.span();
        return new ImportDeclaration(name.text(), name.wildcard(), staticImport, name.span(),
                new SourceSpan(keyword.span().start(), end.end()));
    }

    private TypeDeclaration parseTypeDeclaration() {

        Token start = this.peek();
        Modifiers modifiers = this.parseModifiers();
        defer free modifiers;
        if (modifiers.isStatic()) {
            this.diagnostics.add(this.error(modifiers.staticToken(), "top-level types cannot be static"));
        }
        if (modifiers.isDefault()) {
            this.diagnostics.add(this.error(modifiers.defaultToken(), "top-level types cannot be default"));
        }
        this.rejectOverrideDirective(modifiers);
        if (this.match(TokenKind.CLASS)) return this.parseClass(start, modifiers, true, false);
        if (this.match(TokenKind.ENUM)) return this.parseEnum(start, modifiers, true, false);
        if (this.match(TokenKind.INTERFACE)) {
            if (modifiers.isFinal()) {
                this.diagnostics.add(this.error(modifiers.finalToken(), "interfaces cannot be final"));
            }
            return this.parseInterface(start, modifiers, true, false);
        }
        this.diagnostics.add(this.error(this.peek(),
                "expected 'class', 'enum', or 'interface' at the start of a type declaration"));
        this.synchronizeTopLevel();
        return null;
    }

    private ClassDeclaration parseClass(Token start, Modifiers modifiers, boolean topLevel,
                                        boolean enclosingInterface) {

        Token className = this.expect(TokenKind.IDENTIFIER, "expected class name after 'class'");
        ArrayList<TypeParameter> typeParameters = new ArrayList<TypeParameter>(4);
        defer free typeParameters;
        if (className != null) this.parseTypeParameters(typeParameters);
        TypeReference superclass = null;
        if (this.match(TokenKind.EXTENDS)) {
            superclass = this.parseTypeReference("expected superclass name after 'extends'");
        }
        ArrayList<TypeReference> interfaces = new ArrayList<TypeReference>(4);
        defer free interfaces;
        if (this.match(TokenKind.IMPLEMENTS)) {
            this.parseTypeReferenceList("expected interface name after 'implements'", interfaces);
        }
        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, "expected '{' after class name");
        if (className == null || leftBrace == null) {
            this.synchronizeTopLevel();
            return null;
        }

        MemberBuilders members = new MemberBuilders();
        defer free members;
        while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
            int before = this.current;
            this.parseMember(className.lexeme(), members, false, false);
            if (this.current == before) this.advance();
        }

        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close class body");
        if (rightBrace == null) return null;
        AccessModifier access = enclosingInterface ? AccessModifier.PUBLIC : modifiers.accessModifier();
        DestructorDeclaration destructorDeclaration = members.destructors().isEmpty() ? null
                : members.destructors().get(0);
        return new ClassDeclaration(access, !topLevel && (modifiers.isStatic() || enclosingInterface),
                modifiers.isAbstract(), modifiers.isFinal(), className.lexeme(), className.span(),
                AstLists.typeParameters(typeParameters), superclass, AstLists.typeReferences(interfaces),
                AstLists.fieldDeclarations(members.fields()),
                AstLists.instanceInitializations(members.instanceInitializations()),
                AstLists.staticInitializations(members.staticInitializations()),
                AstLists.constructorDeclarations(members.constructors()), destructorDeclaration,
                AstLists.methodDeclarations(members.methods()), AstLists.typeDeclarations(members.memberTypes()),
                false, AstLists.NO_ENUM_CONSTANTS, new SourceSpan(start.span().start(), rightBrace.span().end()));
    }

    private ClassDeclaration parseEnum(Token start, Modifiers modifiers, boolean topLevel,
                                       boolean enclosingInterface) {

        if (modifiers.isAbstract()) {
            this.diagnostics.add(this.error(modifiers.abstractToken(), "enums cannot be abstract"));
        }
        if (modifiers.isFinal()) {
            this.diagnostics.add(this.error(modifiers.finalToken(),
                    "enums are implicitly final and cannot declare the 'final' modifier"));
        }
        if (modifiers.isDefault()) {
            this.diagnostics.add(this.error(modifiers.defaultToken(), "enums cannot be default"));
        }
        Token enumName = this.expect(TokenKind.IDENTIFIER, "expected enum name after 'enum'");
        ArrayList<TypeParameter> typeParameters = new ArrayList<TypeParameter>(4);
        defer free typeParameters;
        if (enumName != null) this.parseTypeParameters(typeParameters);
        if (!typeParameters.isEmpty()) {
            this.diagnostics.add(Diagnostic.error(this.source, typeParameters.get(0).span(),
                    "enum declarations cannot declare type parameters"));
        }
        if (this.match(TokenKind.EXTENDS)) {
            Token extendsToken = this.previous();
            this.parseTypeReference("expected type name after 'extends'");
            this.diagnostics.add(this.error(extendsToken, "enums cannot declare an explicit superclass"));
        }
        ArrayList<TypeReference> interfaces = new ArrayList<TypeReference>(4);
        defer free interfaces;
        if (this.match(TokenKind.IMPLEMENTS)) {
            this.parseTypeReferenceList("expected interface name after 'implements'", interfaces);
        }
        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, "expected '{' after enum name");
        if (enumName == null || leftBrace == null) {
            this.synchronizeTopLevel();
            return null;
        }

        ArrayList<EnumConstant> constants = new ArrayList<EnumConstant>();
        defer free constants;
        if (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.SEMICOLON)) {
            while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.SEMICOLON)
                    && !this.check(TokenKind.EOF)) {
                Token constantName = this.expect(TokenKind.IDENTIFIER, "expected enum constant name");
                if (constantName == null) {
                    this.synchronizeMember();
                    break;
                }
                SnapshotList<Expression> arguments = AstLists.NO_EXPRESSIONS;
                SourceSpan end = constantName.span();
                if (this.match(TokenKind.LEFT_PAREN)) {
                    arguments = this.parseArguments();
                    Token rightParen = this.expect(TokenKind.RIGHT_PAREN,
                            "expected ')' after enum constant arguments");
                    if (rightParen != null) end = rightParen.span();
                }
                AnonymousClassBody classBody = null;
                if (this.check(TokenKind.LEFT_BRACE)) {
                    classBody = this.parseAnonymousClassBody(true);
                    if (classBody != null) end = classBody.span();
                }
                constants.add(new EnumConstant(constantName.lexeme(), constantName.span(), arguments, classBody,
                        new SourceSpan(constantName.span().start(), end.end())));
                if (!this.match(TokenKind.COMMA)) break;
                if (this.check(TokenKind.RIGHT_BRACE) || this.check(TokenKind.SEMICOLON)) break;
            }
        }

        MemberBuilders members = new MemberBuilders();
        defer free members;
        if (this.match(TokenKind.SEMICOLON)) {
            while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
                int before = this.current;
                this.parseMember(enumName.lexeme(), members, false, true);
                if (this.current == before) this.advance();
            }
        } else if (!this.check(TokenKind.RIGHT_BRACE)) {
            this.diagnostics.add(this.error(this.peek(), "expected ',' or ';' after enum constant list"));
            this.synchronizeMember();
        }

        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close enum body");
        if (rightBrace == null) return null;
        AccessModifier access = enclosingInterface ? AccessModifier.PUBLIC : modifiers.accessModifier();
        return new ClassDeclaration(access, !topLevel, false, true, enumName.lexeme(), enumName.span(),
                AstLists.NO_TYPE_PARAMETERS, null, AstLists.typeReferences(interfaces),
                AstLists.fieldDeclarations(members.fields()),
                AstLists.instanceInitializations(members.instanceInitializations()),
                AstLists.staticInitializations(members.staticInitializations()),
                AstLists.constructorDeclarations(members.constructors()), null,
                AstLists.methodDeclarations(members.methods()), AstLists.typeDeclarations(members.memberTypes()),
                true, AstLists.enumConstants(constants),
                new SourceSpan(start.span().start(), rightBrace.span().end()));
    }

    private InterfaceDeclaration parseInterface(Token start, Modifiers modifiers, boolean topLevel,
                                                boolean enclosingInterface) {

        Token interfaceName = this.expect(TokenKind.IDENTIFIER, "expected interface name after 'interface'");
        ArrayList<TypeParameter> typeParameters = new ArrayList<TypeParameter>(4);
        defer free typeParameters;
        if (interfaceName != null) this.parseTypeParameters(typeParameters);
        ArrayList<TypeReference> extendedInterfaces = new ArrayList<TypeReference>(4);
        defer free extendedInterfaces;
        if (this.match(TokenKind.EXTENDS)) {
            this.parseTypeReferenceList("expected interface name after 'extends'", extendedInterfaces);
        }
        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, "expected '{' after interface name");
        if (interfaceName == null || leftBrace == null) {
            this.synchronizeTopLevel();
            return null;
        }

        ArrayList<FieldDeclaration> fields = new ArrayList<FieldDeclaration>();
        defer free fields;
        ArrayList<InterfaceMethodDeclaration> methods = new ArrayList<InterfaceMethodDeclaration>();
        defer free methods;
        ArrayList<TypeDeclaration> memberTypes = new ArrayList<TypeDeclaration>(4);
        defer free memberTypes;
        while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
            int before = this.current;
            this.parseInterfaceMember(fields, methods, memberTypes);
            if (this.current == before) this.advance();
        }
        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close interface body");
        if (rightBrace == null) return null;
        AccessModifier access = enclosingInterface ? AccessModifier.PUBLIC : modifiers.accessModifier();
        return new InterfaceDeclaration(access, !topLevel, interfaceName.lexeme(), interfaceName.span(),
                AstLists.typeParameters(typeParameters), AstLists.typeReferences(extendedInterfaces),
                AstLists.fieldDeclarations(fields), AstLists.interfaceMethodDeclarations(methods),
                AstLists.typeDeclarations(memberTypes), new SourceSpan(start.span().start(), rightBrace.span().end()));
    }

    // Java returns a fresh list that every caller appends to its own builder;
    // this appends to that builder directly.
    private void parseTypeReferenceList(String message, ArrayList<TypeReference> references) {

        do {
            TypeReference reference = this.parseTypeReference(message);
            if (reference == null) break;
            references.add(reference);
        } while (this.match(TokenKind.COMMA));
    }

    // Java returns List.of() when no list is present; callers pass an empty builder.
    private void parseTypeParameters(ArrayList<TypeParameter> parameters) {

        if (!this.match(TokenKind.LESS)) return;
        if (this.check(TokenKind.GREATER)) {
            this.diagnostics.add(this.error(this.peek(),
                    "generic type declarations require at least one type parameter"));
            this.advance();
            return;
        }
        do {
            Token parameter = this.expect(TokenKind.IDENTIFIER, "expected type parameter name");
            if (parameter == null) break;
            ArrayList<TypeName> upperBounds = new ArrayList<TypeName>(4);
            // Loop-local builder: retires at the end of each iteration.
            defer free upperBounds;
            if (this.match(TokenKind.EXTENDS)) {
                do {
                    TypeName bound = this.parseType(false, "expected type after type-parameter bound");
                    if (bound != null) upperBounds.add(bound);
                } while (this.match(TokenKind.AMPERSAND));
            }
            parameters.add(new TypeParameter(parameter.lexeme(), AstLists.typeNames(upperBounds),
                    parameter.span()));
        } while (this.match(TokenKind.COMMA));
        this.expect(TokenKind.GREATER, "expected '>' after type parameter list");
    }

    private TypeReference parseTypeReference(String message) {

        ParameterizedQualifiedName name = this.parseParameterizedQualifiedName(message);
        if (name == null) return null;
        defer free name;
        return new TypeReference(name.text(), name.typeArguments(), name.typeArgumentSegmentCounts(), name.span());
    }

    private void parseInterfaceMember(ArrayList<FieldDeclaration> fields,
                                      ArrayList<InterfaceMethodDeclaration> methods,
                                      ArrayList<TypeDeclaration> memberTypes) {

        Token start = this.peek();
        Modifiers modifiers = this.parseModifiers();
        defer free modifiers;
        if (this.match(TokenKind.DESTRUCTOR)) {
            this.rejectOverrideDirective(modifiers);
            Block body = this.parseBlock("expected '{' after 'destructor'", "expected '}' to close destructor body");
            this.diagnostics.add(this.error(start, "interfaces cannot declare destructors"));
            if (body == null) this.synchronizeMember();
            return;
        }
        if (this.check(TokenKind.LEFT_BRACE)) {
            this.rejectOverrideDirective(modifiers);
            Block block = this.parseBlock("expected '{' before interface initializer block",
                    "expected '}' to close interface initializer block");
            this.diagnostics.add(this.error(modifiers.staticToken() == null ? start : modifiers.staticToken(),
                    "interfaces cannot declare initializer blocks"));
            if (block == null) this.synchronizeMember();
            return;
        }
        if (this.check(TokenKind.CLASS) || this.check(TokenKind.ENUM) || this.check(TokenKind.INTERFACE)) {
            this.rejectOverrideDirective(modifiers);
            if (modifiers.accessModifier() == AccessModifier.PRIVATE
                    || modifiers.accessModifier() == AccessModifier.PROTECTED) {
                this.diagnostics.add(this.error(modifiers.accessToken(),
                        "types declared in an interface must be public"));
            }
            if (modifiers.isDefault()) {
                this.diagnostics.add(this.error(modifiers.defaultToken(), "nested types cannot be default"));
            }
            if (this.match(TokenKind.CLASS)) {
                TypeDeclaration declaration = this.parseClass(start, modifiers, false, true);
                if (declaration != null) memberTypes.add(declaration);
            } else if (this.match(TokenKind.ENUM)) {
                TypeDeclaration declaration = this.parseEnum(start, modifiers, false, true);
                if (declaration != null) memberTypes.add(declaration);
            } else {
                this.advance();
                if (modifiers.isFinal()) {
                    this.diagnostics.add(this.error(modifiers.finalToken(), "interfaces cannot be final"));
                }
                TypeDeclaration declaration = this.parseInterface(start, modifiers, false, true);
                if (declaration != null) memberTypes.add(declaration);
            }
            return;
        }
        ArrayList<TypeParameter> typeParameters = new ArrayList<TypeParameter>(4);
        defer free typeParameters;
        this.parseTypeParameters(typeParameters);
        TypeName type = this.parseType(true, "expected interface field type or method return type");
        Token name = this.expect(TokenKind.IDENTIFIER, "expected interface member name after type");
        if (type == null || name == null) {
            this.synchronizeMember();
            return;
        }
        if (!this.match(TokenKind.LEFT_PAREN)) {
            this.rejectOverrideDirective(modifiers);
            if (!typeParameters.isEmpty()) {
                this.diagnostics.add(Diagnostic.error(this.source, typeParameters.get(0).span(),
                        "type parameters may only be declared by an interface method"));
            }
            if (type.kind() == TypeName.Kind.VOID) {
                this.diagnostics.add(this.error(name, "interface fields cannot have type void"));
            }
            if (modifiers.accessModifier() == AccessModifier.PRIVATE
                    || modifiers.accessModifier() == AccessModifier.PROTECTED) {
                this.diagnostics.add(this.error(modifiers.accessToken(),
                        "interface fields must be public static final"));
            }
            if (modifiers.isAbstract()) {
                this.diagnostics.add(this.error(modifiers.abstractToken(), "interface fields cannot be abstract"));
            }
            if (modifiers.isDefault()) {
                this.diagnostics.add(this.error(modifiers.defaultToken(), "interface fields cannot be default"));
            }
            Expression initializer = null;
            if (this.match(TokenKind.EQUAL)) {
                initializer = this.parseVariableInitializer();
            } else {
                this.diagnostics.add(this.error(name, "interface field '" + name.lexeme()
                        + "' requires an initializer"));
            }
            Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after interface field declaration");
            SourceSpan end = null;
            if (semicolon != null) {
                end = semicolon.span();
            } else {
                end = initializer == null ? name.span() : initializer.span();
            }
            fields.add(new FieldDeclaration(AccessModifier.PUBLIC, true, true, type, name.lexeme(), name.span(),
                    initializer, new SourceSpan(start.span().start(), end.end())));
            if (semicolon == null) this.synchronizeMember();
            return;
        }

        if (modifiers.isFinal()) {
            this.diagnostics.add(this.error(modifiers.finalToken(), "interface methods cannot be final"));
        }
        if (modifiers.accessModifier() == AccessModifier.PROTECTED) {
            this.diagnostics.add(this.error(modifiers.accessToken(), "interface methods cannot be protected"));
        }
        if (modifiers.isDefault() && modifiers.isStatic()) {
            this.diagnostics.add(this.error(modifiers.defaultToken(), "default interface methods cannot be static"));
        }
        if (modifiers.isDefault() && modifiers.isAbstract()) {
            this.diagnostics.add(this.error(modifiers.defaultToken(), "default interface methods cannot be abstract"));
        }
        if (modifiers.isDefault() && modifiers.accessModifier() == AccessModifier.PRIVATE) {
            this.diagnostics.add(this.error(modifiers.defaultToken(), "default interface methods cannot be private"));
        }
        if (modifiers.isAbstract() && modifiers.isStatic()) {
            this.diagnostics.add(this.error(modifiers.abstractToken(), "abstract interface methods cannot be static"));
        }
        if (modifiers.isAbstract() && modifiers.accessModifier() == AccessModifier.PRIVATE) {
            this.diagnostics.add(this.error(modifiers.abstractToken(), "abstract interface methods cannot be private"));
        }
        SnapshotList<Parameter> parameters = this.parseParameters();
        this.expect(TokenKind.RIGHT_PAREN, "expected ')' after interface method parameter list");
        SnapshotList<TypeName> thrownTypes = this.parseThrowsClause();
        InterfaceMethodKind kind = null;
        if (modifiers.isDefault()) {
            kind = InterfaceMethodKind.DEFAULT;
        } else if (modifiers.accessModifier() == AccessModifier.PRIVATE) {
            kind = modifiers.isStatic() ? InterfaceMethodKind.PRIVATE_STATIC : InterfaceMethodKind.PRIVATE_INSTANCE;
        } else if (modifiers.isStatic()) {
            kind = InterfaceMethodKind.STATIC;
        } else {
            kind = InterfaceMethodKind.ABSTRACT;
        }
        Block body = null;
        SourceSpan end = null;
        if (kind == InterfaceMethodKind.ABSTRACT) {
            if (this.check(TokenKind.LEFT_BRACE)) {
                this.diagnostics.add(this.error(this.peek(),
                        "interface instance method with a body must be declared default"));
                Block parsed = this.parseBlock("expected '{' before interface method body",
                        "expected '}' to close interface method body");
                body = parsed;
                end = parsed == null ? name.span() : parsed.span();
            } else {
                Token semicolon = this.expect(TokenKind.SEMICOLON,
                        "expected ';' after abstract interface method declaration");
                end = semicolon == null ? name.span() : semicolon.span();
                if (semicolon == null) this.synchronizeMember();
            }
        } else {
            Block parsed = this.parseBlock("expected '{' before interface method body",
                    "expected '}' to close interface method body");
            body = parsed;
            end = parsed == null ? name.span() : parsed.span();
            if (parsed == null) this.synchronizeMember();
        }
        AccessModifier access = kind == InterfaceMethodKind.PRIVATE_INSTANCE
                || kind == InterfaceMethodKind.PRIVATE_STATIC ? AccessModifier.PRIVATE : AccessModifier.PUBLIC;
        if (modifiers.hasTestDirective()) {
            this.diagnostics.add(this.error(modifiers.testToken(),
                    "the @Test directive may only be used on class methods"));
        }
        methods.add(new InterfaceMethodDeclaration(access, kind, modifiers.hasOverrideDirective(),
                AstLists.typeParameters(typeParameters), type, name.lexeme(), name.span(), parameters, thrownTypes,
                body, new SourceSpan(start.span().start(), end.end())));
    }

    private void parseMember(String className, MemberBuilders members, boolean anonymousClass,
                             boolean enumConstantBody) {

        Token start = this.peek();
        Modifiers modifiers = this.parseModifiers();
        defer free modifiers;

        if (this.match(TokenKind.DESTRUCTOR)) {
            Token keyword = this.previous();
            if (modifiers.accessToken() != null || modifiers.isStatic() || modifiers.isFinal()
                    || modifiers.isAbstract() || modifiers.isDefault() || modifiers.hasOverrideDirective()) {
                this.diagnostics.add(this.error(start, "destructors cannot have modifiers or @Override"));
            }
            if (modifiers.hasTestDirective()) {
                this.diagnostics.add(this.error(modifiers.testToken(),
                        "the @Test directive may only be used on methods"));
            }
            Block body = this.parseBlock("expected '{' after 'destructor'", "expected '}' to close destructor body");
            if (enumConstantBody) {
                this.diagnostics.add(this.error(keyword, anonymousClass
                        ? "enum constant bodies cannot declare destructors"
                        : "enums cannot declare destructors"));
            } else if (body != null) {
                if (!members.destructors().isEmpty()) {
                    this.diagnostics.add(this.error(keyword, "class may declare at most one destructor"));
                } else {
                    members.destructors().add(new DestructorDeclaration(body, keyword.span(),
                            new SourceSpan(start.span().start(), body.span().end())));
                }
            }
            if (body == null) this.synchronizeMember();
            return;
        }

        if (modifiers.isDefault()) {
            this.diagnostics.add(this.error(modifiers.defaultToken(), "class members cannot be default"));
        }

        if (this.check(TokenKind.LEFT_BRACE)) {
            this.rejectOverrideDirective(modifiers);
            Block initializer = this.parseBlock("expected '{' before initializer block",
                    "expected '}' to close initializer block");
            if (initializer != null) {
                if (modifiers.isStatic()) {
                    if (anonymousClass) {
                        this.diagnostics.add(this.error(modifiers.staticToken(),
                                (enumConstantBody ? "enum constant bodies" : "anonymous classes")
                                        + " cannot declare static initializer blocks"));
                    } else if (modifiers.accessToken() != null || modifiers.isFinal()
                            || modifiers.isAbstract() || modifiers.isDefault()) {
                        this.diagnostics.add(this.error(start,
                                "static initializer blocks cannot have modifiers other than static"));
                    } else {
                        members.staticInitializations().add(initializer);
                    }
                } else if (modifiers.accessToken() != null || modifiers.isFinal() || modifiers.isAbstract()) {
                    this.diagnostics.add(this.error(start, "instance initializer blocks cannot have modifiers"));
                } else {
                    members.instanceInitializations().add(initializer);
                }
            }
            return;
        }

        if (this.match(TokenKind.CLASS)) {
            this.rejectOverrideDirective(modifiers);
            TypeDeclaration declaration = this.parseClass(start, modifiers, false, false);
            if (declaration != null) members.memberTypes().add(declaration);
            return;
        }
        if (this.match(TokenKind.ENUM)) {
            this.rejectOverrideDirective(modifiers);
            TypeDeclaration declaration = this.parseEnum(start, modifiers, false, false);
            if (declaration != null) members.memberTypes().add(declaration);
            return;
        }
        if (this.match(TokenKind.INTERFACE)) {
            this.rejectOverrideDirective(modifiers);
            if (modifiers.isFinal()) {
                this.diagnostics.add(this.error(modifiers.finalToken(), "interfaces cannot be final"));
            }
            TypeDeclaration declaration = this.parseInterface(start, modifiers, false, false);
            if (declaration != null) members.memberTypes().add(declaration);
            return;
        }

        ArrayList<TypeParameter> typeParameters = new ArrayList<TypeParameter>(4);
        defer free typeParameters;
        this.parseTypeParameters(typeParameters);

        if (anonymousClass && this.check(TokenKind.IDENTIFIER) && this.checkNext(TokenKind.LEFT_PAREN)) {
            Token name = this.advance();
            this.rejectOverrideDirective(modifiers);
            this.diagnostics.add(this.error(name, (enumConstantBody ? "enum constant bodies" : "anonymous classes")
                    + " cannot declare constructors"));
            this.advance();
            this.parseParameters();
            this.expect(TokenKind.RIGHT_PAREN, "expected ')' after constructor parameter list");
            Block body = this.parseBlock("expected '{' before constructor body",
                    "expected '}' to close constructor body");
            if (body == null) this.synchronizeMember();
            return;
        }

        if (!anonymousClass && this.check(TokenKind.IDENTIFIER) && this.peek().lexeme().equals(className)
                && this.checkNext(TokenKind.LEFT_PAREN)) {
            Token name = this.advance();
            this.rejectOverrideDirective(modifiers);
            if (modifiers.isStatic()) {
                this.diagnostics.add(this.error(modifiers.staticToken(), "constructors cannot be static"));
            }
            if (modifiers.isFinal()) {
                this.diagnostics.add(this.error(modifiers.finalToken(), "constructors cannot be final"));
            }
            if (modifiers.isAbstract()) {
                this.diagnostics.add(this.error(modifiers.abstractToken(), "constructors cannot be abstract"));
            }
            this.advance();
            SnapshotList<Parameter> parameters = this.parseParameters();
            this.expect(TokenKind.RIGHT_PAREN, "expected ')' after constructor parameter list");
            SnapshotList<TypeName> thrownTypes = this.parseThrowsClause();
            // Java parses a Block and then rebuilds it without a leading
            // explicit invocation; the statements are collected here once.
            ArrayList<Statement> bodyStatements = new ArrayList<Statement>();
            defer free bodyStatements;
            SourceSpan bodySpan = this.parseBlockStatements(bodyStatements, "expected '{' before constructor body",
                    "expected '}' to close constructor body");
            if (bodySpan != null) {
                SuperConstructorInvocation superInvocation = null;
                ThisConstructorInvocation thisInvocation = null;
                if (!bodyStatements.isEmpty()
                        && bodyStatements.get(0) instanceof SuperConstructorInvocation invocation) {
                    superInvocation = invocation;
                    bodyStatements.removeFirst();
                } else if (!bodyStatements.isEmpty()
                        && bodyStatements.get(0) instanceof ThisConstructorInvocation invocation) {
                    thisInvocation = invocation;
                    bodyStatements.removeFirst();
                }
                Block body = new Block(AstLists.statements(bodyStatements), bodySpan);
                members.constructors().add(new ConstructorDeclaration(modifiers.accessModifier(),
                        AstLists.typeParameters(typeParameters), name.lexeme(), name.span(), parameters, thrownTypes,
                        superInvocation, thisInvocation, body, new SourceSpan(start.span().start(),
                                body.span().end())));
            } else {
                this.synchronizeMember();
            }
            return;
        }

        TypeName type = this.parseType(true, "expected field or method type");
        if (type == null) {
            this.synchronizeMember();
            return;
        }
        Token name = this.expect(TokenKind.IDENTIFIER, "expected member name after type");
        if (name == null) {
            this.synchronizeMember();
            return;
        }

        if (this.match(TokenKind.LEFT_PAREN)) {
            SnapshotList<Parameter> parameters = this.parseParameters();
            this.expect(TokenKind.RIGHT_PAREN, "expected ')' after method parameter list");
            SnapshotList<TypeName> thrownTypes = this.parseThrowsClause();
            if (anonymousClass && modifiers.isAbstract()) {
                this.diagnostics.add(this.error(modifiers.abstractToken(),
                        (enumConstantBody ? "enum constant bodies" : "anonymous classes")
                                + " cannot declare abstract methods"));
            }
            if (modifiers.isAbstract()) {
                Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after abstract method declaration");
                SourceSpan end = semicolon == null ? name.span() : semicolon.span();
                members.methods().add(new MethodDeclaration(modifiers.accessModifier(), modifiers.isStatic(), true,
                        modifiers.isFinal(), modifiers.hasOverrideDirective(), modifiers.hasTestDirective(),
                        AstLists.typeParameters(typeParameters), type, name.lexeme(), name.span(), parameters,
                        thrownTypes, null, new SourceSpan(start.span().start(), end.end())));
                if (semicolon == null) this.synchronizeMember();
            } else {
                Block body = this.parseBlock("expected '{' before method body", "expected '}' to close method body");
                if (body != null) {
                    members.methods().add(new MethodDeclaration(modifiers.accessModifier(), modifiers.isStatic(),
                            false, modifiers.isFinal(), modifiers.hasOverrideDirective(),
                            modifiers.hasTestDirective(), AstLists.typeParameters(typeParameters), type,
                            name.lexeme(), name.span(), parameters, thrownTypes, body,
                            new SourceSpan(start.span().start(), body.span().end())));
                } else {
                    this.synchronizeMember();
                }
            }
            return;
        }

        if (!typeParameters.isEmpty()) {
            this.diagnostics.add(Diagnostic.error(this.source, typeParameters.get(0).span(),
                    "type parameters may only be declared by a method or constructor"));
        }
        if (modifiers.isAbstract()) {
            this.diagnostics.add(this.error(modifiers.abstractToken(), "fields cannot be abstract"));
        }
        this.rejectOverrideDirective(modifiers);

        Expression initializer = null;
        if (this.match(TokenKind.EQUAL)) initializer = this.parseVariableInitializer();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after field declaration");
        SourceSpan end = semicolon == null ? name.span() : semicolon.span();
        FieldDeclaration field = new FieldDeclaration(modifiers.accessModifier(), modifiers.isStatic(),
                modifiers.isFinal(), type, name.lexeme(), name.span(), initializer,
                new SourceSpan(start.span().start(), end.end()));
        members.fields().add(field);
        if (!field.isStatic()) {
            members.instanceInitializations().add(field);
        } else {
            members.staticInitializations().add(field);
        }
        if (semicolon == null) this.synchronizeMember();
    }

    private SnapshotList<TypeName> parseThrowsClause() {

        if (!this.match(TokenKind.THROWS)) return AstLists.NO_TYPE_NAMES;
        ArrayList<TypeName> thrownTypes = new ArrayList<TypeName>(4);
        defer free thrownTypes;
        do {
            TypeName type = this.parseType(false, "expected exception type after 'throws'");
            if (type == null) break;
            thrownTypes.add(type);
        } while (this.match(TokenKind.COMMA));
        if (thrownTypes.isEmpty()) {
            this.diagnostics.add(this.error(this.previous(), "throws clause requires at least one exception type"));
        }
        return AstLists.typeNames(thrownTypes);
    }

    private Modifiers parseModifiers() {

        AccessModifier access = AccessModifier.PACKAGE_PRIVATE;
        Token accessToken = null;
        Token staticToken = null;
        Token finalToken = null;
        Token abstractToken = null;
        Token defaultToken = null;
        Token overrideToken = null;
        Token testToken = null;
        boolean progress = false;
        do {
            progress = false;
            if (this.check(TokenKind.PUBLIC) || this.check(TokenKind.PROTECTED) || this.check(TokenKind.PRIVATE)) {
                Token token = this.advance();
                if (accessToken != null) {
                    this.diagnostics.add(this.error(token, "declaration cannot have more than one access modifier"));
                } else {
                    accessToken = token;
                    access = switch (token.kind()) {
                        case PUBLIC -> AccessModifier.PUBLIC;
                        case PROTECTED -> AccessModifier.PROTECTED;
                        case PRIVATE -> AccessModifier.PRIVATE;
                        default -> throw new IllegalStateException("unexpected access modifier");
                    };
                }
                progress = true;
            } else if (this.match(TokenKind.STATIC)) {
                Token token = this.previous();
                if (staticToken != null) {
                    this.diagnostics.add(this.error(token, "duplicate 'static' modifier"));
                } else {
                    staticToken = token;
                }
                progress = true;
            } else if (this.match(TokenKind.FINAL)) {
                Token token = this.previous();
                if (finalToken != null) {
                    this.diagnostics.add(this.error(token, "duplicate 'final' modifier"));
                } else {
                    finalToken = token;
                }
                progress = true;
            } else if (this.match(TokenKind.ABSTRACT)) {
                Token token = this.previous();
                if (abstractToken != null) {
                    this.diagnostics.add(this.error(token, "duplicate 'abstract' modifier"));
                } else {
                    abstractToken = token;
                }
                progress = true;
            } else if (this.match(TokenKind.DEFAULT)) {
                Token token = this.previous();
                if (defaultToken != null) {
                    this.diagnostics.add(this.error(token, "duplicate 'default' modifier"));
                } else {
                    defaultToken = token;
                }
                progress = true;
            } else if (this.match(TokenKind.AT)) {
                Token at = this.previous();
                Token name = this.expect(TokenKind.IDENTIFIER,
                        "expected 'Override', 'Test', or 'SuppressUnfreed' after '@'");
                if (name != null) {
                    if (name.lexeme().equals("Override")) {
                        if (overrideToken != null) {
                            this.diagnostics.add(this.error(at, "duplicate '@Override' directive"));
                        } else {
                            overrideToken = at;
                        }
                    } else if (name.lexeme().equals("Test")) {
                        if (testToken != null) {
                            this.diagnostics.add(this.error(at, "duplicate '@Test' directive"));
                        } else {
                            testToken = at;
                        }
                    } else if (name.lexeme().equals("SuppressUnfreed")) {
                        this.diagnostics.add(this.error(at,
                                "the @SuppressUnfreed directive may only be used on local variable declarations"));
                    } else {
                        this.diagnostics.add(this.error(name, GENERAL_ANNOTATIONS));
                    }
                    if ((name.lexeme().equals("Override") || name.lexeme().equals("Test")
                            || name.lexeme().equals("SuppressUnfreed")) && this.check(TokenKind.LEFT_PAREN)) {
                        this.diagnostics.add(this.error(this.peek(), "the @" + name.lexeme()
                                + " directive does not accept arguments"));
                    }
                }
                progress = true;
            }
        } while (progress);
        return new Modifiers(access, accessToken, staticToken, finalToken, abstractToken, defaultToken,
                overrideToken, testToken);
    }

    private void rejectOverrideDirective(Modifiers modifiers) {

        if (modifiers.hasOverrideDirective()) {
            this.diagnostics.add(this.error(modifiers.overrideToken(),
                    "the @Override directive may only be used on methods"));
        }
        if (modifiers.hasTestDirective()) {
            this.diagnostics.add(this.error(modifiers.testToken(), "the @Test directive may only be used on methods"));
        }
    }

    private SnapshotList<Parameter> parseParameters() {

        ArrayList<Parameter> parameters = new ArrayList<Parameter>(4);
        defer free parameters;
        if (this.check(TokenKind.RIGHT_PAREN)) return AstLists.NO_PARAMETERS;
        do {
            Token start = this.peek();
            boolean isFinal = this.parseVariableModifiers("parameter").isFinal();
            TypeName type = this.parseType(false, "expected parameter type");
            SourceSpan ellipsis = this.matchEllipsis();
            if (ellipsis != null) {
                this.diagnostics.add(Diagnostic.error(this.source, ellipsis,
                        "varargs are not supported; declare an explicit array parameter instead"));
            }
            isFinal = this.parseMisplacedVariableModifiers("parameter", isFinal);
            Token name = this.expect(TokenKind.IDENTIFIER, "expected parameter name after type");
            if (type != null && name != null) {
                parameters.add(new Parameter(type, isFinal, name.lexeme(), name.span(),
                        new SourceSpan(start.span().start(), name.span().end())));
            } else {
                this.synchronizeParameter();
            }
        } while (this.match(TokenKind.COMMA));
        return AstLists.parameters(parameters);
    }

    private VariableModifiers parseVariableModifiers(String role) {

        boolean isFinal = false;
        boolean suppressUnfreed = false;
        while (isVariableModifier(this.peek().kind()) || this.check(TokenKind.AT)) {
            Token modifier = this.advance();
            if (modifier.kind() == TokenKind.AT) {
                Token name = this.expect(TokenKind.IDENTIFIER,
                        "expected 'SuppressUnfreed' after '@' on a local variable");
                if (name == null) continue;
                if (name.lexeme().equals("SuppressUnfreed")) {
                    if (!role.equals("local variable")) {
                        this.diagnostics.add(this.error(modifier,
                                "the @SuppressUnfreed directive may only be used on local variable declarations"));
                    }
                    if (suppressUnfreed) {
                        this.diagnostics.add(this.error(modifier, "duplicate '@SuppressUnfreed' directive"));
                    }
                    suppressUnfreed = true;
                } else if (name.lexeme().equals("Override") || name.lexeme().equals("Test")) {
                    this.diagnostics.add(this.error(modifier,
                            "the @" + name.lexeme() + " directive may only be used on methods"));
                } else {
                    this.diagnostics.add(this.error(name, GENERAL_ANNOTATIONS));
                }
                if (this.check(TokenKind.LEFT_PAREN)) {
                    this.diagnostics.add(this.error(this.peek(), "the @" + name.lexeme()
                            + " directive does not accept arguments"));
                }
            } else if (modifier.kind() == TokenKind.FINAL) {
                if (isFinal) this.diagnostics.add(this.error(modifier, "duplicate 'final' modifier on " + role));
                isFinal = true;
            } else {
                this.diagnostics.add(this.error(modifier, "modifier '" + modifier.lexeme()
                        + "' is not permitted on " + role));
            }
        }
        return new VariableModifiers(isFinal, suppressUnfreed);
    }

    private boolean parseMisplacedVariableModifiers(String role, boolean isFinal) {

        while (isVariableModifier(this.peek().kind())) {
            Token modifier = this.advance();
            if (modifier.kind() == TokenKind.FINAL) {
                this.diagnostics.add(this.error(modifier, "'final' modifier must precede the " + role + " type"));
                isFinal = true;
            } else {
                this.diagnostics.add(this.error(modifier, "modifier '" + modifier.lexeme()
                        + "' is not permitted on " + role));
            }
        }
        return isFinal;
    }

    private static boolean isVariableModifier(TokenKind kind) {

        return kind == TokenKind.PUBLIC || kind == TokenKind.PROTECTED
                || kind == TokenKind.PRIVATE || kind == TokenKind.STATIC
                || kind == TokenKind.FINAL || kind == TokenKind.ABSTRACT
                || kind == TokenKind.DEFAULT;
    }

    private SourceSpan matchEllipsis() {

        if (!this.contiguousKinds(TokenKind.DOT, TokenKind.DOT, TokenKind.DOT)) return null;
        Token first = this.advance();
        this.advance();
        Token last = this.advance();
        return new SourceSpan(first.span().start(), last.span().end());
    }

    private TypeName parseType(boolean allowVoid, String message) {

        TypeName base = null;
        if (isNumericPrimitive(this.peek().kind())) {
            Token primitive = this.advance();
            base = TypeName.primitive(primitiveKind(primitive.kind()), primitive.span());
        } else if (this.match(TokenKind.BOOLEAN)) {
            base = TypeName.primitive(TypeName.Kind.BOOLEAN, this.previous().span());
        } else if (allowVoid && this.match(TokenKind.VOID)) {
            base = TypeName.primitive(TypeName.Kind.VOID, this.previous().span());
        } else if (this.check(TokenKind.IDENTIFIER)) {
            ParameterizedQualifiedName name = this.parseParameterizedQualifiedName(message);
            if (name == null) {
                base = null;
            } else {
                base = TypeName.reference(name.text(), name.typeArguments(), name.typeArgumentSegmentCounts(),
                        name.span());
                free name;
            }
        } else {
            this.diagnostics.add(this.error(this.peek(), message));
            return null;
        }
        while (base != null && this.match(TokenKind.LEFT_BRACKET)) {
            Token right = this.expect(TokenKind.RIGHT_BRACKET, "expected ']' in array type");
            SourceSpan end = right == null ? this.previous().span() : right.span();
            if (base.kind() == TypeName.Kind.VOID) {
                this.diagnostics.add(this.error(this.previous(), "array element type cannot be void"));
                return base;
            }
            base = TypeName.array(base, new SourceSpan(base.span().start(), end.end()));
        }
        return base;
    }

    private SnapshotList<TypeName> parseTypeArguments() {

        ParsedTypeArguments parsed = this.parseTypeArguments(false);
        defer free parsed;
        return AstLists.typeNames(parsed.arguments());
    }

    private ParsedTypeArguments parseTypeArguments(boolean allowDiamond) {

        // Consecutive '>' characters remain separate GREATER tokens so nested
        // arguments close without lexer state.
        if (!this.match(TokenKind.LESS)) return ParsedTypeArguments.absent();
        Token opening = this.previous();
        ArrayList<TypeName> arguments = new ArrayList<TypeName>(4);
        defer free arguments;
        if (this.match(TokenKind.GREATER)) {
            SourcePosition end = this.previous().span().end();
            if (!allowDiamond) {
                this.diagnostics.add(this.error(opening,
                        "empty type arguments are only permitted for diamond class creation"));
            }
            return new ParsedTypeArguments(true, true, arguments, opening.span().start(), end);
        }
        do {
            if (this.match(TokenKind.QUESTION)) {
                Token wildcard = this.previous();
                TypeName.WildcardKind wildcardKind = TypeName.WildcardKind.UNBOUNDED;
                if (this.match(TokenKind.EXTENDS)) {
                    wildcardKind = TypeName.WildcardKind.EXTENDS;
                } else if (this.match(TokenKind.SUPER)) {
                    wildcardKind = TypeName.WildcardKind.SUPER;
                }
                if (wildcardKind == TypeName.WildcardKind.UNBOUNDED) {
                    arguments.add(TypeName.wildcard(wildcard.span()));
                } else {
                    TypeName bound = this.parseType(false, "expected wildcard bound type");
                    if (bound == null) {
                        arguments.add(TypeName.wildcard(wildcard.span()));
                    } else {
                        arguments.add(TypeName.wildcard(wildcardKind, bound,
                                new SourceSpan(wildcard.span().start(), bound.span().end())));
                    }
                }
                continue;
            }
            TypeName argument = this.parseType(false, "expected type argument");
            if (argument != null) arguments.add(argument);
        } while (this.match(TokenKind.COMMA));
        Token closing = this.expect(TokenKind.GREATER, "expected '>' after type argument list");
        SourcePosition end = closing == null ? this.previous().span().end() : closing.span().end();
        return new ParsedTypeArguments(true, false, arguments, opening.span().start(), end);
    }

    private Block parseBlock(String openingMessage, String closingMessage) {

        ArrayList<Statement> statements = new ArrayList<Statement>();
        defer free statements;
        SourceSpan span = this.parseBlockStatements(statements, openingMessage, closingMessage);
        if (span == null) return null;
        return new Block(AstLists.statements(statements), span);
    }

    // Parses a braced statement list into the caller's builder and returns the
    // block span, or null without consuming input when the opening brace is absent.
    private SourceSpan parseBlockStatements(ArrayList<Statement> statements, String openingMessage,
                                            String closingMessage) {

        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, openingMessage);
        if (leftBrace == null) return null;
        while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
            int before = this.current;
            Statement statement = this.match(TokenKind.DEFER)
                    ? this.parseDefer(this.previous()) : this.parseBlockStatement();
            if (statement != null) statements.add(statement);
            if (this.current == before) this.advance();
        }
        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, closingMessage);
        return rightBrace == null
                ? leftBrace.span()
                : new SourceSpan(leftBrace.span().start(), rightBrace.span().end());
    }

    private Statement parseBlockStatement() {

        TokenKind localType = this.localTypeDeclarationKind();
        if (localType == TokenKind.CLASS) return this.parseLocalClassDeclaration();
        if (localType == TokenKind.INTERFACE) {
            Token start = this.peek();
            Modifiers modifiers = this.parseModifiers();
            defer free modifiers;
            this.rejectOverrideDirective(modifiers);
            this.diagnostics.add(this.error(this.peek(), "interfaces cannot be declared in a block"));
            this.advance();
            this.parseInterface(start, modifiers, false, false);
            return null;
        }
        if (localType == TokenKind.ENUM) {
            Token start = this.peek();
            Modifiers modifiers = this.parseModifiers();
            defer free modifiers;
            this.rejectOverrideDirective(modifiers);
            this.diagnostics.add(this.error(this.peek(), "local enum declarations are not supported"));
            this.advance();
            this.parseEnum(start, modifiers, false, false);
            return null;
        }
        return this.parseStatement();
    }

    private LocalClassDeclaration parseLocalClassDeclaration() {

        Token start = this.peek();
        Modifiers modifiers = this.parseModifiers();
        defer free modifiers;
        if (modifiers.accessToken() != null) {
            this.diagnostics.add(this.error(modifiers.accessToken(), "local classes cannot have an access modifier"));
        }
        if (modifiers.isStatic()) {
            this.diagnostics.add(this.error(modifiers.staticToken(), "local classes cannot be static"));
        }
        if (modifiers.isDefault()) {
            this.diagnostics.add(this.error(modifiers.defaultToken(), "local classes cannot be default"));
        }
        this.expect(TokenKind.CLASS, "expected 'class' in local class declaration");
        this.rejectOverrideDirective(modifiers);
        Modifiers localModifiers = new Modifiers(AccessModifier.PACKAGE_PRIVATE, null, null,
                modifiers.finalToken(), modifiers.abstractToken(), null, null, null);
        defer free localModifiers;
        ClassDeclaration declaration = this.parseClass(start, localModifiers, false, false);
        return declaration == null ? null : new LocalClassDeclaration(declaration);
    }

    private Statement parseStatement() {

        if (this.match(TokenKind.DEFER)) {
            Token keyword = this.previous();
            this.diagnostics.add(this.error(keyword,
                    "defer must be a direct statement of an explicit block; add braces"));
            return this.parseDefer(keyword);
        }
        if (this.match(TokenKind.SEMICOLON)) return new EmptyStatement(this.previous().span());
        if (this.check(TokenKind.IDENTIFIER) && this.checkNext(TokenKind.COLON)) return this.parseLabeledStatement();
        if (this.check(TokenKind.LEFT_BRACE)) return this.parseBlock("expected '{'", "expected '}' to close block");
        if (this.match(TokenKind.RETURN)) return this.parseReturn(this.previous());
        if (this.match(TokenKind.YIELD)) return this.parseYield(this.previous());
        if (this.match(TokenKind.FREE)) return this.parseFree(this.previous());
        if (this.match(TokenKind.THROW)) return this.parseThrow(this.previous());
        if (this.match(TokenKind.TRY)) return this.parseTry(this.previous());
        if (this.match(TokenKind.IF)) return this.parseIf(this.previous());
        if (this.match(TokenKind.WHILE)) return this.parseWhile(this.previous());
        if (this.match(TokenKind.DO)) return this.parseDoWhile(this.previous());
        if (this.match(TokenKind.FOR)) return this.parseFor(this.previous());
        if (this.match(TokenKind.SWITCH)) return this.parseSwitch(this.previous());
        if (this.match(TokenKind.BREAK)) return this.parseBreak(this.previous());
        if (this.match(TokenKind.CONTINUE)) return this.parseContinue(this.previous());
        if (this.check(TokenKind.SUPER) && this.checkNext(TokenKind.LEFT_PAREN)) {
            this.advance();
            Token keyword = this.previous();
            return this.parseSuperConstructorInvocation(keyword, keyword, AstLists.NO_TYPE_NAMES);
        }
        if (this.check(TokenKind.THIS) && this.checkNext(TokenKind.LEFT_PAREN)) {
            this.advance();
            Token keyword = this.previous();
            return this.parseThisConstructorInvocation(keyword, keyword, AstLists.NO_TYPE_NAMES);
        }
        if (this.check(TokenKind.LESS)) {
            Token opening = this.peek();
            SnapshotList<TypeName> typeArguments = this.parseTypeArguments();
            if (this.match(TokenKind.SUPER) && this.check(TokenKind.LEFT_PAREN)) {
                return this.parseSuperConstructorInvocation(opening, this.previous(), typeArguments);
            }
            if (this.match(TokenKind.THIS) && this.check(TokenKind.LEFT_PAREN)) {
                return this.parseThisConstructorInvocation(opening, this.previous(), typeArguments);
            }
            this.diagnostics.add(this.error(this.peek(),
                    "explicit constructor type arguments must be followed by 'this' or 'super'"));
            this.synchronizeStatement();
            return null;
        }
        if (this.looksLikeLocalVariableDeclaration()) return this.parseLocalVariable();
        return this.parseAssignmentOrExpressionStatement();
    }

    private SuperConstructorInvocation parseSuperConstructorInvocation(Token start, Token superKeyword,
                                                                       SnapshotList<TypeName> typeArguments) {

        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'super'");
        SnapshotList<Expression> arguments = this.parseArguments();
        Token rightParen = this.expect(TokenKind.RIGHT_PAREN, "expected ')' after superclass constructor arguments");
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after superclass constructor invocation");
        SourceSpan end = semicolon != null ? semicolon.span()
                : rightParen != null ? rightParen.span() : superKeyword.span();
        return new SuperConstructorInvocation(null, typeArguments, arguments,
                new SourceSpan(start.span().start(), end.end()));
    }

    private ThisConstructorInvocation parseThisConstructorInvocation(Token start, Token thisKeyword,
                                                                     SnapshotList<TypeName> typeArguments) {

        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'this'");
        SnapshotList<Expression> arguments = this.parseArguments();
        Token rightParen = this.expect(TokenKind.RIGHT_PAREN, "expected ')' after constructor delegation arguments");
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after constructor delegation");
        SourceSpan end = semicolon != null ? semicolon.span()
                : rightParen != null ? rightParen.span() : thisKeyword.span();
        return new ThisConstructorInvocation(typeArguments, arguments, new SourceSpan(start.span().start(), end.end()));
    }

    private ReturnStatement parseReturn(Token returnKeyword) {

        Expression value = this.check(TokenKind.SEMICOLON) ? null : this.parseExpression();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after return statement");
        SourceSpan span = semicolon == null
                ? returnKeyword.span()
                : new SourceSpan(returnKeyword.span().start(), semicolon.span().end());
        return new ReturnStatement(value, span);
    }

    private Statement parseDefer(Token keyword) {

        if (this.match(TokenKind.FREE)) {
            boolean startsWithName = this.check(TokenKind.IDENTIFIER);
            // Java parses a FreeStatement only to read its value and end; the
            // same expression, diagnostic and end are read here without it.
            Expression value = this.parseExpression();
            Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after free statement");
            if (value == null) return null;
            SourcePosition end = semicolon == null ? value.span().end() : semicolon.span().end();
            if (!startsWithName || !(value instanceof NameExpression target)) {
                this.diagnostics.add(this.error(keyword, "defer free requires a local variable name"));
                return null;
            }
            return new DeferredFreeStatement(target, new SourceSpan(keyword.span().start(), end));
        }
        Expression action = this.parseExpression();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after defer statement");
        if (!(action instanceof CallExpression call)) {
            this.diagnostics.add(this.error(keyword, "defer requires a void method invocation"));
            return null;
        }
        return new DeferStatement(call, new SourceSpan(keyword.span().start(),
                semicolon == null ? call.span().end() : semicolon.span().end()));
    }

    private FreeStatement parseFree(Token freeKeyword) {

        Expression value = this.parseExpression();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after free statement");
        SourceSpan end = null;
        if (semicolon != null) {
            end = semicolon.span();
        } else {
            end = value == null ? freeKeyword.span() : value.span();
        }
        return value == null ? null : new FreeStatement(value, new SourceSpan(freeKeyword.span().start(), end.end()));
    }

    private ThrowStatement parseThrow(Token throwKeyword) {

        Expression value = this.parseExpression();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after throw statement");
        SourceSpan end = null;
        if (semicolon != null) {
            end = semicolon.span();
        } else {
            end = value == null ? throwKeyword.span() : value.span();
        }
        return value == null ? null : new ThrowStatement(value, new SourceSpan(throwKeyword.span().start(), end.end()));
    }

    private TryStatement parseTry(Token tryKeyword) {

        boolean resourceClause = this.check(TokenKind.LEFT_PAREN);
        if (resourceClause) {
            Token opening = this.peek();
            this.parseTryResources();
            this.diagnostics.add(this.error(opening, "try-with-resources is not supported; declare the "
                    + "resource before try and close it in finally or with an explicit defer call"));
        }
        Block body = this.parseBlock("expected '{' after 'try'", "expected '}' to close try block");
        ArrayList<CatchClause> catches = new ArrayList<CatchClause>(4);
        defer free catches;
        while (this.match(TokenKind.CATCH)) {
            Token catchKeyword = this.previous();
            this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'catch'");
            boolean isFinal = this.parseVariableModifiers("catch parameter").isFinal();
            TypeName type = this.parseType(false, "expected catch type");
            ArrayList<TypeName> types = new ArrayList<TypeName>(4);
            // Loop-local builder: retires at the end of each iteration.
            defer free types;
            if (type != null) types.add(type);
            while (this.match(TokenKind.PIPE)) {
                TypeName alternative = this.parseType(false, "expected catch type after '|'");
                if (alternative != null) types.add(alternative);
            }
            isFinal = this.parseMisplacedVariableModifiers("catch parameter", isFinal);
            Token variable = this.expect(TokenKind.IDENTIFIER, "expected catch variable name after catch type");
            this.expect(TokenKind.RIGHT_PAREN, "expected ')' after catch parameter");
            Block catchBody = this.parseBlock("expected '{' before catch body", "expected '}' to close catch body");
            if (!types.isEmpty() && variable != null && catchBody != null) {
                catches.add(new CatchClause(AstLists.typeNames(types), isFinal || types.size() > 1,
                        variable.lexeme(), variable.span(), catchBody,
                        new SourceSpan(catchKeyword.span().start(), catchBody.span().end())));
            }
        }
        Block finallyBlock = null;
        if (this.match(TokenKind.FINALLY)) {
            finallyBlock = this.parseBlock("expected '{' after 'finally'", "expected '}' to close finally block");
        }
        if (!resourceClause && catches.isEmpty() && finallyBlock == null) {
            this.diagnostics.add(this.error(this.peek(), "try statement requires at least one catch or finally block"));
        }
        if (body == null) return null;
        SourceSpan end = null;
        if (finallyBlock != null) {
            end = finallyBlock.span();
        } else {
            end = catches.isEmpty() ? body.span() : catches.get(catches.size() - 1).span();
        }
        return new TryStatement(body, AstLists.catchClauses(catches), finallyBlock,
                new SourceSpan(tryKeyword.span().start(), end.end()));
    }

    // Java returns the parsed resources, which its only caller discards after
    // the unsupported-feature diagnostic; the list is not retained here.
    private void parseTryResources() {

        Token opening = this.expect(TokenKind.LEFT_PAREN, "expected '(' before try resource list");
        boolean empty = true;
        if (this.check(TokenKind.RIGHT_PAREN)) {
            this.diagnostics.add(this.error(this.peek(), "try resource list requires at least one resource"));
        } else {
            while (!this.check(TokenKind.EOF) && !this.check(TokenKind.RIGHT_PAREN)) {
                Expression resource = this.parseExpression();
                if (resource != null) empty = false;
                if (!this.match(TokenKind.SEMICOLON)) break;
            }
        }
        Token closing = this.expect(TokenKind.RIGHT_PAREN, "expected ')' after try resource list");
        if (empty && opening != null && closing == null) this.synchronizeStatement();
    }

    private IfStatement parseIf(Token ifKeyword) {

        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'if'");
        Expression condition = this.parseExpression();
        this.expect(TokenKind.RIGHT_PAREN, "expected ')' after if condition");
        Statement thenBranch = this.parseRequiredStatement("expected statement after if condition");
        Statement elseBranch = null;
        if (this.match(TokenKind.ELSE)) elseBranch = this.parseRequiredStatement("expected statement after 'else'");
        SourceSpan end = null;
        if (elseBranch != null) {
            end = elseBranch.span();
        } else {
            end = thenBranch == null ? ifKeyword.span() : thenBranch.span();
        }
        return new IfStatement(condition, thenBranch, elseBranch, new SourceSpan(ifKeyword.span().start(), end.end()));
    }

    private WhileStatement parseWhile(Token whileKeyword) {

        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'while'");
        Expression condition = this.parseExpression();
        this.expect(TokenKind.RIGHT_PAREN, "expected ')' after while condition");
        Statement body = this.parseRequiredStatement("expected statement after while condition");
        SourceSpan end = body == null ? whileKeyword.span() : body.span();
        return new WhileStatement(condition, body, new SourceSpan(whileKeyword.span().start(), end.end()));
    }

    private DoWhileStatement parseDoWhile(Token doKeyword) {

        Statement body = this.parseRequiredStatement("expected statement after 'do'");
        this.expect(TokenKind.WHILE, "expected 'while' after do statement body");
        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'while' in do statement");
        Expression condition = this.parseExpression();
        Token rightParen = this.expect(TokenKind.RIGHT_PAREN, "expected ')' after do-while condition");
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after do-while statement");
        SourceSpan end = semicolon != null ? semicolon.span()
                : rightParen != null ? rightParen.span()
                : condition != null ? condition.span()
                : body != null ? body.span() : doKeyword.span();
        return body == null || condition == null ? null
                : new DoWhileStatement(body, condition, new SourceSpan(doKeyword.span().start(), end.end()));
    }

    private Statement parseFor(Token forKeyword) {

        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'for'");
        if (this.looksLikeEnhancedForInitializer()) return this.parseEnhancedFor(forKeyword);
        Statement initializer = null;
        if (this.match(TokenKind.SEMICOLON)) {
            // Empty initializer.
        } else if (this.looksLikeLocalVariableDeclaration()) {
            initializer = this.parseLocalVariable();
        } else {
            Expression expression = this.parseExpression();
            Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after for initializer");
            if (expression != null) {
                SourceSpan end = semicolon == null ? expression.span() : semicolon.span();
                initializer = new ExpressionStatement(expression, new SourceSpan(expression.span().start(), end.end()));
            }
        }

        Expression condition = this.check(TokenKind.SEMICOLON) ? null : this.parseExpression();
        this.expect(TokenKind.SEMICOLON, "expected ';' after for condition");

        ArrayList<Expression> updates = new ArrayList<Expression>(4);
        defer free updates;
        if (!this.check(TokenKind.RIGHT_PAREN)) {
            do {
                Expression update = this.parseExpression();
                if (update != null) updates.add(update);
            } while (this.match(TokenKind.COMMA));
        }
        this.expect(TokenKind.RIGHT_PAREN, "expected ')' after for clauses");
        Statement body = this.parseRequiredStatement("expected statement after for clauses");
        SourceSpan end = body == null ? forKeyword.span() : body.span();
        return new ForStatement(initializer, condition, AstLists.expressions(updates), body,
                new SourceSpan(forKeyword.span().start(), end.end()));
    }

    private EnhancedForStatement parseEnhancedFor(Token forKeyword) {

        boolean isFinal = this.parseVariableModifiers("enhanced-for variable").isFinal();
        TypeName type = this.parseType(false, "expected enhanced-for variable type");
        isFinal = this.parseMisplacedVariableModifiers("enhanced-for variable", isFinal);
        Token name = this.expect(TokenKind.IDENTIFIER, "expected enhanced-for variable name after type");
        this.expect(TokenKind.COLON, "expected ':' after enhanced-for variable");
        Expression iterable = this.parseExpression();
        this.expect(TokenKind.RIGHT_PAREN, "expected ')' after enhanced-for expression");
        Statement body = this.parseRequiredStatement("expected statement after enhanced-for expression");
        SourceSpan end = body == null ? forKeyword.span() : body.span();
        if (type == null || name == null || iterable == null || body == null) {
            this.synchronizeStatement();
            return null;
        }
        return new EnhancedForStatement(type, isFinal, name.lexeme(), name.span(), iterable, body,
                new SourceSpan(forKeyword.span().start(), end.end()));
    }

    private Statement parseSwitch(Token switchKeyword) {

        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'switch'");
        Expression selector = this.parseExpression();
        this.expect(TokenKind.RIGHT_PAREN, "expected ')' after switch selector");
        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, "expected '{' before switch body");
        if (leftBrace == null) {
            this.synchronizeStatement();
            return null;
        }
        ParsedSwitchBody body = this.parseSwitchBody(leftBrace);
        defer free body;
        if (selector == null) return null;
        SourceSpan span = new SourceSpan(switchKeyword.span().start(), body.end().end());
        if (body.arrowRules()) return new ModernSwitchStatement(selector, body.rules(), span);
        return new SwitchStatement(selector, body.groups(), span);
    }

    private SwitchExpression parseSwitchExpression(Token switchKeyword) {

        this.expect(TokenKind.LEFT_PAREN, "expected '(' after 'switch'");
        Expression selector = this.parseExpression();
        this.expect(TokenKind.RIGHT_PAREN, "expected ')' after switch selector");
        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, "expected '{' before switch body");
        if (leftBrace == null) return null;
        ParsedSwitchBody body = this.parseSwitchBody(leftBrace);
        defer free body;
        if (selector == null) return null;
        return new SwitchExpression(selector, body.groups(), body.rules(), body.arrowRules(),
                new SourceSpan(switchKeyword.span().start(), body.end().end()));
    }

    private ParsedSwitchBody parseSwitchBody(Token leftBrace) {

        if (this.check(TokenKind.RIGHT_BRACE)) {
            Token rightBrace = this.advance();
            return new ParsedSwitchBody(AstLists.NO_SWITCH_GROUPS, AstLists.NO_SWITCH_RULES, false, rightBrace.span());
        }
        if (!this.check(TokenKind.CASE) && !this.check(TokenKind.DEFAULT)) {
            this.diagnostics.add(this.error(this.peek(), "expected 'case' or 'default' label in switch body"));
        }
        ParsedSwitchLabels first = this.parseSwitchLabels();
        if (first == null) {
            while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) this.advance();
            Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close switch body");
            return new ParsedSwitchBody(AstLists.NO_SWITCH_GROUPS, AstLists.NO_SWITCH_RULES, false,
                    rightBrace == null ? leftBrace.span() : rightBrace.span());
        }
        defer free first;
        return first.arrowRules() ? this.parseSwitchRules(first, leftBrace) : this.parseSwitchGroups(first, leftBrace);
    }

    private ParsedSwitchBody parseSwitchRules(ParsedSwitchLabels first, Token leftBrace) {

        ArrayList<SwitchRule> rules = new ArrayList<SwitchRule>();
        defer free rules;
        // Java carries the next labels into the following iteration; here
        // each iteration parses and owns its labels, and the caller owns the first.
        this.parseSwitchRule(rules, first);
        while (this.check(TokenKind.CASE) || this.check(TokenKind.DEFAULT)) {
            ParsedSwitchLabels labels = this.parseSwitchLabels();
            if (labels == null) break;
            // Loop-local labels: retire at the end of each iteration.
            defer free labels;
            if (!labels.arrowRules()) {
                this.diagnostics.add(Diagnostic.error(this.source, new SourceSpan(labels.start(), labels.end()),
                        "cannot mix ':' labels and '->' rules in one switch body"));
            }
            this.parseSwitchRule(rules, labels);
        }
        while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
            this.diagnostics.add(this.error(this.peek(), "expected 'case' or 'default' rule in switch body"));
            int before = this.current;
            this.parseBlockStatement();
            if (this.current == before) this.advance();
        }
        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close switch body");
        return new ParsedSwitchBody(AstLists.NO_SWITCH_GROUPS, AstLists.switchRules(rules), true,
                rightBrace == null ? leftBrace.span() : rightBrace.span());
    }

    // Parses the body for the borrowed labels and appends the rule.
    private void parseSwitchRule(ArrayList<SwitchRule> rules, ParsedSwitchLabels labels) {

        SwitchRuleBody body = this.parseSwitchRuleBody();
        SourcePosition end = body == null ? labels.end() : body.span().end();
        if (body != null) {
            rules.add(new SwitchRule(AstLists.switchLabels(labels.labels()), body,
                    new SourceSpan(labels.start(), end)));
        }
    }

    private SwitchRuleBody parseSwitchRuleBody() {

        if (this.match(TokenKind.DEFER)) {
            Token keyword = this.previous();
            this.diagnostics.add(this.error(keyword,
                    "defer must be a direct statement of an explicit block; add braces"));
            this.parseDefer(keyword);
            return null;
        }
        if (this.check(TokenKind.LEFT_BRACE)) {
            Block block = this.parseBlock("expected '{' after '->'", "expected '}' to close switch rule block");
            return block == null ? null : new SwitchRuleBlock(block, block.span());
        }
        if (this.match(TokenKind.THROW)) {
            ThrowStatement statement = this.parseThrow(this.previous());
            // As in Java, a missing thrown value fails with NullPointerException.
            return new SwitchRuleThrow(statement, statement.span());
        }
        Expression expression = this.parseExpression();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after switch rule expression");
        if (expression == null) return null;
        SourceSpan span = semicolon == null ? expression.span()
                : new SourceSpan(expression.span().start(), semicolon.span().end());
        return new SwitchRuleExpression(expression, span);
    }

    private ParsedSwitchBody parseSwitchGroups(ParsedSwitchLabels first, Token leftBrace) {

        ArrayList<SwitchGroup> groups = new ArrayList<SwitchGroup>();
        defer free groups;
        // Java carries the pending labels into the following iteration; here
        // each iteration parses and owns its labels, and the caller owns the first.
        this.parseSwitchGroup(groups, first);
        while (this.check(TokenKind.CASE) || this.check(TokenKind.DEFAULT)) {
            ParsedSwitchLabels pending = this.parseSwitchLabels();
            if (pending == null) break;
            // Loop-local labels: retire at the end of each iteration.
            defer free pending;
            if (pending.arrowRules()) {
                this.diagnostics.add(Diagnostic.error(this.source, new SourceSpan(pending.start(), pending.end()),
                        "cannot mix ':' labels and '->' rules in one switch body"));
                this.parseSwitchRuleBody();
                break;
            }
            this.parseSwitchGroup(groups, pending);
        }
        while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
            this.diagnostics.add(this.error(this.peek(), "expected 'case' or 'default' label in switch body"));
            this.advance();
        }
        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close switch body");
        return new ParsedSwitchBody(AstLists.switchGroups(groups), AstLists.NO_SWITCH_RULES, false,
                rightBrace == null ? leftBrace.span() : rightBrace.span());
    }

    // Collects the labels following the borrowed pending set and the group's
    // statements, and appends the group.
    private void parseSwitchGroup(ArrayList<SwitchGroup> groups, ParsedSwitchLabels pending) {

        ArrayList<SwitchLabel> labels = pending.labels().copy();
        defer free labels;
        while (this.check(TokenKind.CASE) || this.check(TokenKind.DEFAULT)) {
            ParsedSwitchLabels next = this.parseSwitchLabels();
            if (next == null) break;
            // Loop-local labels: retire at the end of each iteration.
            defer free next;
            if (next.arrowRules()) {
                this.diagnostics.add(Diagnostic.error(this.source, new SourceSpan(next.start(), next.end()),
                        "cannot mix ':' labels and '->' rules in one switch body"));
                this.parseSwitchRuleBody();
                continue;
            }
            ArrayList<SwitchLabel> added = next.labels();
            for (int index = 0; index < added.size(); index++) labels.add(added.get(index));
        }
        ArrayList<Statement> statements = new ArrayList<Statement>();
        defer free statements;
        while (!this.check(TokenKind.CASE) && !this.check(TokenKind.DEFAULT)
                && !this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
            int before = this.current;
            Statement statement = this.parseBlockStatement();
            if (statement != null) statements.add(statement);
            if (this.current == before) this.advance();
        }
        SourceSpan end = statements.isEmpty()
                ? labels.get(labels.size() - 1).span() : statements.get(statements.size() - 1).span();
        groups.add(new SwitchGroup(AstLists.switchLabels(labels), AstLists.statements(statements),
                new SourceSpan(labels.get(0).span().start(), end.end())));
    }

    private ParsedSwitchLabels parseSwitchLabels() {

        if (!this.check(TokenKind.CASE) && !this.check(TokenKind.DEFAULT)) {
            this.diagnostics.add(this.error(this.peek(), "expected 'case' or 'default' label in switch body"));
            return null;
        }
        Token keyword = this.advance();
        ArrayList<SwitchLabel> labels = new ArrayList<SwitchLabel>(4);
        defer free labels;
        if (keyword.kind() == TokenKind.DEFAULT) {
            labels.add(new SwitchLabel(null, keyword.span()));
        } else {
            while (true) {
                if (this.match(TokenKind.DEFAULT)) {
                    if (labels.size() != 1 || labels.get(0).value() == null
                            || !(this.labelValue(labels.get(0)) instanceof NullLiteralExpression)) {
                        this.diagnostics.add(this.error(this.previous(),
                                "default may be combined only with case null"));
                    }
                    labels.add(new SwitchLabel(null, this.previous().span()));
                } else {
                    if (this.looksLikeSwitchPatternLabel()) {
                        this.diagnostics.add(this.error(this.peek(),
                                "switch pattern labels are not supported; use constant labels only"));
                    }
                    Expression value = this.parseExpression();
                    if (value != null) {
                        if (this.check(TokenKind.IDENTIFIER)) {
                            this.diagnostics.add(this.error(this.peek(),
                                    "switch pattern labels are not supported; use constant labels only"));
                        }
                        labels.add(new SwitchLabel(value, new SourceSpan(keyword.span().start(), value.span().end())));
                    }
                }
                if (!this.match(TokenKind.COMMA)) break;
            }
        }
        Token delimiter = null;
        boolean arrow = false;
        if (this.match(TokenKind.COLON)) {
            delimiter = this.previous();
            arrow = false;
        } else if (this.match(TokenKind.ARROW)) {
            delimiter = this.previous();
            arrow = true;
        } else {
            this.diagnostics.add(this.error(this.peek(), keyword.kind() == TokenKind.DEFAULT
                    ? "expected ':' after 'default' or '->' after switch rule label"
                    : "expected ':' after case label or '->' after switch rule label"));
            delimiter = keyword;
            arrow = false;
        }
        if (labels.isEmpty()) return null;
        return new ParsedSwitchLabels(labels, arrow, keyword.span().start(), delimiter.span().end());
    }

    // Java's orElseThrow on a label value already checked to be present.
    private Expression labelValue(SwitchLabel label) {

        Expression value = label.value();
        if (value == null) throw new NoSuchElementException();
        return value;
    }

    private YieldStatement parseYield(Token keyword) {

        Expression value = this.parseExpression();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after yield value");
        SourceSpan end = null;
        if (semicolon != null) {
            end = semicolon.span();
        } else {
            end = value == null ? keyword.span() : value.span();
        }
        return value == null ? null : new YieldStatement(value, new SourceSpan(keyword.span().start(), end.end()));
    }

    private BreakStatement parseBreak(Token keyword) {

        String label = null;
        SourceSpan labelSpan = null;
        if (this.match(TokenKind.IDENTIFIER)) {
            label = this.previous().lexeme();
            labelSpan = this.previous().span();
        }
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after 'break'");
        SourceSpan end = null;
        if (semicolon != null) {
            end = semicolon.span();
        } else {
            end = labelSpan == null ? keyword.span() : labelSpan;
        }
        return new BreakStatement(label, labelSpan, new SourceSpan(keyword.span().start(), end.end()));
    }

    private ContinueStatement parseContinue(Token keyword) {

        String label = null;
        SourceSpan labelSpan = null;
        if (this.match(TokenKind.IDENTIFIER)) {
            label = this.previous().lexeme();
            labelSpan = this.previous().span();
        }
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after 'continue'");
        SourceSpan end = null;
        if (semicolon != null) {
            end = semicolon.span();
        } else {
            end = labelSpan == null ? keyword.span() : labelSpan;
        }
        return new ContinueStatement(label, labelSpan, new SourceSpan(keyword.span().start(), end.end()));
    }

    private LabeledStatement parseLabeledStatement() {

        Token label = this.advance();
        this.expect(TokenKind.COLON, "expected ':' after statement label");
        if (this.looksLikeLocalVariableDeclaration()) {
            this.diagnostics.add(this.error(this.peek(),
                    "statement labels cannot directly precede a local variable declaration; use a block"));
        }
        Statement body = this.parseRequiredStatement(null, label);
        SourceSpan end = body == null ? label.span() : body.span();
        return body == null ? null : new LabeledStatement(label.lexeme(), label.span(), body,
                new SourceSpan(label.span().start(), end.end()));
    }

    private Statement parseRequiredStatement(String message) {

        return this.parseRequiredStatement(message, null);
    }

    // A labeled statement's message names its label; Java builds it before
    // the call, but it is only needed when reported, so it is built there.
    private Statement parseRequiredStatement(String message, Token label) {

        if (this.check(TokenKind.EOF) || this.check(TokenKind.RIGHT_BRACE) || this.check(TokenKind.ELSE)) {
            String reported = label == null ? message : "expected statement after label '" + label.lexeme() + "'";
            this.diagnostics.add(this.error(this.peek(), reported));
            return null;
        }
        if (this.localTypeDeclarationKind() != null) {
            this.diagnostics.add(this.error(this.peek(),
                    "local type declarations must be directly enclosed by a block"));
            this.parseBlockStatement();
            return null;
        }
        return this.parseStatement();
    }

    private LocalVariableDeclaration parseLocalVariable() {

        Token start = this.peek();
        VariableModifiers modifiers = this.parseVariableModifiers("local variable");
        defer free modifiers;
        boolean isFinal = modifiers.isFinal();
        TypeName type = this.parseType(false, "expected local variable type");
        isFinal = this.parseMisplacedVariableModifiers("local variable", isFinal);
        Token name = this.expect(TokenKind.IDENTIFIER, "expected local variable name after type");
        this.expect(TokenKind.EQUAL, "local variable declarations require an initializer after '='");
        Expression initializer = this.parseVariableInitializer();
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after local variable declaration");
        SourceSpan end = semicolon == null ? start.span() : semicolon.span();
        if (type == null || name == null || initializer == null) {
            this.synchronizeStatement();
            return null;
        }
        return new LocalVariableDeclaration(type, isFinal, modifiers.hasSuppressUnfreedDirective(), name.lexeme(),
                name.span(), initializer, new SourceSpan(start.span().start(), end.end()));
    }

    private Statement parseAssignmentOrExpressionStatement() {

        Expression expression = this.parseExpression();
        if (expression == null) {
            this.synchronizeStatement();
            return null;
        }
        Token semicolon = this.expect(TokenKind.SEMICOLON, "expected ';' after expression statement");
        SourceSpan span = semicolon == null
                ? expression.span()
                : new SourceSpan(expression.span().start(), semicolon.span().end());
        if (expression instanceof QualifiedSuperConstructorExpression invocation) {
            return new SuperConstructorInvocation(invocation.enclosingInstance(), invocation.typeArguments(),
                    invocation.arguments(), span);
        }
        return new ExpressionStatement(expression, span);
    }

    private Expression parseExpression() {

        return this.parseAssignment();
    }

    private Expression parseVariableInitializer() {

        return this.check(TokenKind.LEFT_BRACE) ? this.parseArrayInitializer() : this.parseExpression();
    }

    private ArrayInitializerExpression parseArrayInitializer() {

        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, "expected '{' to begin array initializer");
        if (leftBrace == null) return null;
        ArrayList<Expression> elements = new ArrayList<Expression>();
        defer free elements;
        if (!this.check(TokenKind.RIGHT_BRACE)) {
            while (true) {
                Expression element = this.check(TokenKind.LEFT_BRACE)
                        ? this.parseArrayInitializer() : this.parseExpression();
                if (element != null) elements.add(element);
                if (!this.match(TokenKind.COMMA)) break;
                if (this.check(TokenKind.RIGHT_BRACE)) break;
            }
        }
        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close array initializer");
        SourceSpan end = null;
        if (rightBrace != null) {
            end = rightBrace.span();
        } else {
            end = elements.isEmpty() ? leftBrace.span() : elements.get(elements.size() - 1).span();
        }
        return new ArrayInitializerExpression(AstLists.expressions(elements),
                new SourceSpan(leftBrace.span().start(), end.end()));
    }

    private Expression parseAssignment() {

        Expression target = this.parseConditional();
        ParsedAssignment operator = this.matchAssignmentOperator();
        if (operator == null) return target;
        defer free operator;
        Expression value = this.parseAssignment();
        if (target == null || value == null) return null;
        return new AssignmentExpression(target, operator.operator(), operator.span(), value,
                new SourceSpan(target.span().start(), value.span().end()));
    }

    private Expression parseConditional() {

        Expression condition = this.parseLogicalOr();
        if (!this.match(TokenKind.QUESTION)) return condition;
        Token question = this.previous();
        Expression whenTrue = this.parseExpression();
        this.expect(TokenKind.COLON, "expected ':' in conditional expression");
        Expression whenFalse = this.parseConditional();
        if (condition == null || whenTrue == null || whenFalse == null) return null;
        return new ConditionalExpression(condition, whenTrue, whenFalse, question.span(),
                new SourceSpan(condition.span().start(), whenFalse.span().end()));
    }

    private Expression parseLogicalOr() {

        Expression expression = this.parseLogicalAnd();
        while (this.match(TokenKind.OR_OR)) {
            Token operator = this.previous();
            expression = this.binary(expression, operator, this.parseLogicalAnd(), BinaryOperator.LOGICAL_OR);
        }
        return expression;
    }

    private Expression parseLogicalAnd() {

        Expression expression = this.parseBitwiseOr();
        while (this.match(TokenKind.AND_AND)) {
            Token operator = this.previous();
            expression = this.binary(expression, operator, this.parseBitwiseOr(), BinaryOperator.LOGICAL_AND);
        }
        return expression;
    }

    private Expression parseBitwiseOr() {

        Expression expression = this.parseBitwiseXor();
        while (this.match(TokenKind.PIPE)) {
            Token operator = this.previous();
            expression = this.binary(expression, operator, this.parseBitwiseXor(), BinaryOperator.BITWISE_OR);
        }
        return expression;
    }

    private Expression parseBitwiseXor() {

        Expression expression = this.parseBitwiseAnd();
        while (this.match(TokenKind.CARET)) {
            Token operator = this.previous();
            expression = this.binary(expression, operator, this.parseBitwiseAnd(), BinaryOperator.BITWISE_XOR);
        }
        return expression;
    }

    private Expression parseBitwiseAnd() {

        Expression expression = this.parseEquality();
        while (this.match(TokenKind.AMPERSAND)) {
            Token operator = this.previous();
            expression = this.binary(expression, operator, this.parseEquality(), BinaryOperator.BITWISE_AND);
        }
        return expression;
    }

    private Expression parseEquality() {

        Expression expression = this.parseComparison();
        while (this.match(TokenKind.EQUAL_EQUAL) || this.match(TokenKind.BANG_EQUAL)) {
            Token operator = this.previous();
            Expression right = this.parseComparison();
            expression = this.binary(expression, operator, right,
                    operator.kind() == TokenKind.EQUAL_EQUAL ? BinaryOperator.EQUAL : BinaryOperator.NOT_EQUAL);
        }
        return expression;
    }

    private Expression parseComparison() {

        Expression expression = this.parseShift();
        while (true) {
            if (this.match(TokenKind.INSTANCEOF)) {
                Token operator = this.previous();
                boolean bindingFinal = this.match(TokenKind.FINAL);
                TypeName target = this.parseType(false, "expected type name after 'instanceof'");
                Token bindingName = null;
                if (target != null && this.check(TokenKind.IDENTIFIER)) {
                    bindingName = this.advance();
                } else if (bindingFinal) {
                    this.diagnostics.add(this.error(this.peek(),
                            "expected pattern variable name after instanceof type"));
                }
                if (expression != null && target != null) {
                    TypePatternBinding binding = bindingName == null ? null
                            : new TypePatternBinding(bindingName.lexeme(), bindingName.span(), bindingFinal);
                    SourceSpan end = bindingName == null ? target.span() : bindingName.span();
                    expression = new InstanceOfExpression(expression, target, binding, operator.span(),
                            new SourceSpan(expression.span().start(), end.end()));
                }
                continue;
            }
            if (this.contiguousKinds(TokenKind.LESS, TokenKind.LESS)
                    || this.contiguousKinds(TokenKind.LESS, TokenKind.LESS_EQUAL)
                    || this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER_EQUAL)
                    || this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER, TokenKind.GREATER_EQUAL)) {
                break;
            }
            if (!(this.match(TokenKind.LESS) || this.match(TokenKind.LESS_EQUAL)
                    || this.match(TokenKind.GREATER) || this.match(TokenKind.GREATER_EQUAL))) {
                break;
            }
            Token operator = this.previous();
            Expression right = this.parseShift();
            BinaryOperator kind = switch (operator.kind()) {
                case LESS -> BinaryOperator.LESS;
                case LESS_EQUAL -> BinaryOperator.LESS_EQUAL;
                case GREATER -> BinaryOperator.GREATER;
                case GREATER_EQUAL -> BinaryOperator.GREATER_EQUAL;
                default -> throw new IllegalStateException("unexpected comparison operator");
            };
            expression = this.binary(expression, operator, right, kind);
        }
        return expression;
    }

    private Expression parseShift() {

        Expression expression = this.parseAdditive();
        while (true) {
            ParsedBinary operator = this.matchShiftOperator();
            if (operator == null) break;
            // Each matched operator retires once its fields are copied into the node.
            defer free operator;
            Expression right = this.parseAdditive();
            if (expression == null || right == null) return null;
            expression = new BinaryExpression(expression, operator.operator(), right, operator.span(),
                    new SourceSpan(expression.span().start(), right.span().end()));
        }
        return expression;
    }

    private Expression parseAdditive() {

        Expression expression = this.parseMultiplicative();
        while (this.match(TokenKind.PLUS) || this.match(TokenKind.MINUS)) {
            Token operator = this.previous();
            Expression right = this.parseMultiplicative();
            expression = this.binary(expression, operator, right,
                    operator.kind() == TokenKind.PLUS ? BinaryOperator.ADD : BinaryOperator.SUBTRACT);
        }
        return expression;
    }

    private Expression parseMultiplicative() {

        Expression expression = this.parseUnary();
        while (this.match(TokenKind.STAR) || this.match(TokenKind.SLASH) || this.match(TokenKind.PERCENT)) {
            Token operator = this.previous();
            Expression right = this.parseUnary();
            BinaryOperator kind = switch (operator.kind()) {
                case STAR -> BinaryOperator.MULTIPLY;
                case SLASH -> BinaryOperator.DIVIDE;
                case PERCENT -> BinaryOperator.REMAINDER;
                default -> throw new IllegalStateException("unexpected multiplicative operator");
            };
            expression = this.binary(expression, operator, right, kind);
        }
        return expression;
    }

    private Expression parseUnary() {

        if (this.match(TokenKind.PLUS_PLUS) || this.match(TokenKind.MINUS_MINUS)) {
            Token operator = this.previous();
            Expression operand = this.parseUnary();
            if (operand == null) return null;
            UpdateOperator kind = operator.kind() == TokenKind.PLUS_PLUS
                    ? UpdateOperator.INCREMENT : UpdateOperator.DECREMENT;
            return new UpdateExpression(operand, kind, true, operator.span(),
                    new SourceSpan(operator.span().start(), operand.span().end()));
        }
        if (this.match(TokenKind.PLUS) || this.match(TokenKind.MINUS) || this.match(TokenKind.BANG)
                || this.match(TokenKind.TILDE)) {
            Token operator = this.previous();
            Expression operand = this.parseUnary();
            if (operand == null) return null;
            UnaryOperator kind = switch (operator.kind()) {
                case PLUS -> UnaryOperator.POSITIVE;
                case MINUS -> UnaryOperator.NEGATE;
                case BANG -> UnaryOperator.NOT;
                case TILDE -> UnaryOperator.BITWISE_COMPLEMENT;
                default -> throw new IllegalStateException("unexpected unary operator");
            };
            return new UnaryExpression(kind, operand, operator.span(),
                    new SourceSpan(operator.span().start(), operand.span().end()));
        }
        if (this.check(TokenKind.LEFT_PAREN) && this.looksLikeCast()) {
            Token opening = this.advance();
            TypeName castType = this.parseType(false, "expected cast type");
            this.expect(TokenKind.RIGHT_PAREN, "expected ')' after cast type");
            Expression operand = this.parseUnary();
            if (castType == null || operand == null) return null;
            return new CastExpression(castType, operand, new SourceSpan(opening.span().start(), operand.span().end()));
        }
        return this.parsePostfix();
    }

    private Expression parsePostfix() {

        Expression expression = this.parsePrimary();
        while (expression != null) {
            if (this.match(TokenKind.LEFT_BRACKET)) {
                Expression index = this.parseExpression();
                Token right = this.expect(TokenKind.RIGHT_BRACKET, "expected ']' after array index");
                if (index != null) {
                    SourceSpan end = right == null ? index.span() : right.span();
                    expression = new ArrayAccessExpression(expression, index,
                            new SourceSpan(expression.span().start(), end.end()));
                }
                continue;
            }
            if (this.match(TokenKind.PLUS_PLUS) || this.match(TokenKind.MINUS_MINUS)) {
                Token operator = this.previous();
                UpdateOperator kind = operator.kind() == TokenKind.PLUS_PLUS
                        ? UpdateOperator.INCREMENT : UpdateOperator.DECREMENT;
                expression = new UpdateExpression(expression, kind, false, operator.span(),
                        new SourceSpan(expression.span().start(), operator.span().end()));
                break;
            }
            if (!this.match(TokenKind.DOT)) break;
            SnapshotList<TypeName> typeArguments = this.parseTypeArguments();
            if (this.match(TokenKind.SUPER)) {
                Token superKeyword = this.previous();
                if (this.match(TokenKind.LEFT_PAREN)) {
                    SnapshotList<Expression> arguments = this.parseArguments();
                    Token rightParen = this.expect(TokenKind.RIGHT_PAREN,
                            "expected ')' after superclass constructor arguments");
                    SourceSpan end = rightParen == null ? superKeyword.span() : rightParen.span();
                    expression = new QualifiedSuperConstructorExpression(expression, typeArguments, arguments,
                            new SourceSpan(expression.span().start(), end.end()));
                    continue;
                }
                if (!typeArguments.isEmpty()) {
                    this.diagnostics.add(Diagnostic.error(this.source, typeArguments.get(0).span(),
                            "type arguments before 'super' require a superclass constructor invocation"));
                }
                String interfaceName = sourceQualifiedName(expression);
                if (interfaceName == null) {
                    this.diagnostics.add(this.error(superKeyword, "interface super qualifier must be a type name"));
                    return expression;
                }
                expression = new InterfaceSuperExpression(interfaceName, expression.span(),
                        new SourceSpan(expression.span().start(), superKeyword.span().end()));
                continue;
            }
            if (this.match(TokenKind.THIS)) {
                Token thisKeyword = this.previous();
                if (!typeArguments.isEmpty()) {
                    this.diagnostics.add(Diagnostic.error(this.source, typeArguments.get(0).span(),
                            "qualified 'this' cannot have type arguments"));
                }
                String typeName = sourceQualifiedName(expression);
                if (typeName == null) {
                    this.diagnostics.add(this.error(thisKeyword, "qualified this receiver must be a type name"));
                    return expression;
                }
                expression = new QualifiedThisExpression(typeName, expression.span(),
                        new SourceSpan(expression.span().start(), thisKeyword.span().end()));
                continue;
            }
            if (this.match(TokenKind.NEW)) {
                if (!typeArguments.isEmpty()) {
                    this.diagnostics.add(Diagnostic.error(this.source, typeArguments.get(0).span(),
                            "constructor type arguments must follow 'new'"));
                }
                expression = this.finishQualifiedNew(expression, this.previous());
                continue;
            }
            Token member = this.expect(TokenKind.IDENTIFIER, "expected member name after '.'");
            if (member == null) return expression;
            if (this.match(TokenKind.LEFT_PAREN)) {
                expression = this.finishCall(expression, typeArguments, member);
            } else {
                if (!typeArguments.isEmpty()) {
                    this.diagnostics.add(Diagnostic.error(this.source, typeArguments.get(0).span(),
                            "explicit type arguments require a method invocation"));
                }
                expression = new FieldAccessExpression(expression, member.lexeme(), member.span(),
                        new SourceSpan(expression.span().start(), member.span().end()));
            }
        }
        return expression;
    }

    private Expression parsePrimary() {

        if (this.match(TokenKind.INTEGER)) {
            return new IntegerLiteralExpression(this.previous().lexeme(), this.previous().span());
        }
        if (this.match(TokenKind.FLOATING)) {
            return new FloatingLiteralExpression(this.previous().lexeme(), this.previous().span());
        }
        if (this.match(TokenKind.CHARACTER)) {
            String value = this.previous().lexeme();
            return new CharacterLiteralExpression(value.isEmpty() ? 0 : value.charAt(0), this.previous().span());
        }
        if (this.match(TokenKind.STRING)) {
            return new StringLiteralExpression(this.previous().lexeme(), this.previous().span());
        }
        if (this.match(TokenKind.TRUE)) return new BooleanLiteralExpression(true, this.previous().span());
        if (this.match(TokenKind.FALSE)) return new BooleanLiteralExpression(false, this.previous().span());
        if (this.match(TokenKind.NULL)) return new NullLiteralExpression(this.previous().span());
        if (this.match(TokenKind.THIS)) return new ThisExpression(this.previous().span());
        if (this.match(TokenKind.SUPER)) return new SuperExpression(this.previous().span());
        if (this.match(TokenKind.NEW)) return this.finishNew(this.previous());
        if (this.match(TokenKind.SWITCH)) return this.parseSwitchExpression(this.previous());
        if (this.match(TokenKind.IDENTIFIER)) {
            Token name = this.previous();
            if (this.match(TokenKind.LEFT_PAREN)) return this.finishCall(null, AstLists.NO_TYPE_NAMES, name);
            return new NameExpression(name.lexeme(), name.span());
        }
        if (this.match(TokenKind.LEFT_PAREN)) {
            Expression expression = this.parseExpression();
            this.expect(TokenKind.RIGHT_PAREN, "expected ')' after expression");
            return expression;
        }
        this.diagnostics.add(this.error(this.peek(), "expected expression"));
        return null;
    }

    private boolean looksLikeCast() {

        int lookahead = this.current + 1;
        if (lookahead >= this.tokens.size()) return false;
        boolean primitive = isPrimitive(this.tokens.get(lookahead).kind());
        if (primitive) {
            lookahead++;
        } else {
            lookahead = this.parameterizedTypeEnd(lookahead);
            if (lookahead < 0) return false;
        }
        while (lookahead + 1 < this.tokens.size()
                && this.tokens.get(lookahead).kind() == TokenKind.LEFT_BRACKET
                && this.tokens.get(lookahead + 1).kind() == TokenKind.RIGHT_BRACKET) {
            lookahead += 2;
        }
        if (lookahead >= this.tokens.size() || this.tokens.get(lookahead).kind() != TokenKind.RIGHT_PAREN) {
            return false;
        }
        lookahead++;
        if (lookahead >= this.tokens.size()) return false;
        TokenKind following = this.tokens.get(lookahead).kind();
        if (!primitive && (following == TokenKind.MINUS || following == TokenKind.PLUS)) return false;
        return switch (following) {
            case IDENTIFIER, INTEGER, FLOATING, CHARACTER, STRING, TRUE, FALSE, NULL, THIS, NEW, SWITCH, LEFT_PAREN,
                    SUPER, MINUS, BANG, TILDE, PLUS_PLUS, MINUS_MINUS -> true;
            default -> false;
        };
    }

    private ParsedAssignment matchAssignmentOperator() {

        AssignmentOperator direct = switch (this.peek().kind()) {
            case EQUAL -> AssignmentOperator.ASSIGN;
            case PLUS_EQUAL -> AssignmentOperator.ADD;
            case MINUS_EQUAL -> AssignmentOperator.SUBTRACT;
            case STAR_EQUAL -> AssignmentOperator.MULTIPLY;
            case SLASH_EQUAL -> AssignmentOperator.DIVIDE;
            case PERCENT_EQUAL -> AssignmentOperator.REMAINDER;
            case AMPERSAND_EQUAL -> AssignmentOperator.BITWISE_AND;
            case CARET_EQUAL -> AssignmentOperator.BITWISE_XOR;
            case PIPE_EQUAL -> AssignmentOperator.BITWISE_OR;
            default -> null;
        };
        if (direct != null) return new ParsedAssignment(direct, this.advance().span());
        if (this.contiguousKinds(TokenKind.LESS, TokenKind.LESS_EQUAL)) {
            Token first = this.advance();
            Token last = this.advance();
            return new ParsedAssignment(AssignmentOperator.SHIFT_LEFT,
                    new SourceSpan(first.span().start(), last.span().end()));
        }
        if (this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER, TokenKind.GREATER_EQUAL)) {
            Token first = this.advance();
            this.advance();
            Token last = this.advance();
            return new ParsedAssignment(AssignmentOperator.UNSIGNED_SHIFT_RIGHT,
                    new SourceSpan(first.span().start(), last.span().end()));
        }
        if (this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER_EQUAL)) {
            Token first = this.advance();
            Token last = this.advance();
            return new ParsedAssignment(AssignmentOperator.SHIFT_RIGHT,
                    new SourceSpan(first.span().start(), last.span().end()));
        }
        return null;
    }

    private ParsedBinary matchShiftOperator() {

        if (this.contiguousKinds(TokenKind.LESS, TokenKind.LESS)) {
            Token first = this.advance();
            Token last = this.advance();
            return new ParsedBinary(BinaryOperator.SHIFT_LEFT, new SourceSpan(first.span().start(), last.span().end()));
        }
        // A trailing GREATER_EQUAL belongs to >>= or >>>= and must remain for
        // the assignment grammar. Plain nested generic closes are consumed
        // only by parseTypeArguments, never by this expression-only helper.
        if (this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER, TokenKind.GREATER_EQUAL)
                || this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER_EQUAL)) {
            return null;
        }
        if (this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER, TokenKind.GREATER)) {
            Token first = this.advance();
            this.advance();
            Token last = this.advance();
            return new ParsedBinary(BinaryOperator.UNSIGNED_SHIFT_RIGHT,
                    new SourceSpan(first.span().start(), last.span().end()));
        }
        if (this.contiguousKinds(TokenKind.GREATER, TokenKind.GREATER)) {
            Token first = this.advance();
            Token last = this.advance();
            return new ParsedBinary(BinaryOperator.SHIFT_RIGHT,
                    new SourceSpan(first.span().start(), last.span().end()));
        }
        return null;
    }

    // Java's varargs contiguousKinds is two fixed-arity overloads (D258): the
    // tokens must have the kinds and touch with no gap between them.
    private boolean contiguousKinds(TokenKind first, TokenKind second) {

        if (this.current + 2 > this.tokens.size()) return false;
        return this.tokens.get(this.current).kind() == first && this.contiguousAt(1, second);
    }

    private boolean contiguousKinds(TokenKind first, TokenKind second, TokenKind third) {

        if (this.current + 3 > this.tokens.size()) return false;
        return this.tokens.get(this.current).kind() == first && this.contiguousAt(1, second)
                && this.contiguousAt(2, third);
    }

    private boolean contiguousAt(int index, TokenKind kind) {

        Token token = this.tokens.get(this.current + index);
        return token.kind() == kind
                && this.tokens.get(this.current + index - 1).span().end().offset() == token.span().start().offset();
    }

    private Expression finishNew(Token newKeyword) {

        SnapshotList<TypeName> constructorTypeArguments = this.parseTypeArguments();
        TypeName elementType = null;
        TypeName classType = null;
        boolean diamond = false;
        if (isNumericPrimitive(this.peek().kind())) {
            Token primitive = this.advance();
            elementType = TypeName.primitive(primitiveKind(primitive.kind()), primitive.span());
        } else if (this.match(TokenKind.BOOLEAN)) {
            elementType = TypeName.primitive(TypeName.Kind.BOOLEAN, this.previous().span());
        } else if (this.check(TokenKind.IDENTIFIER)) {
            ParameterizedCreationType creationType =
                    this.parseParameterizedCreationType("expected type name after 'new'");
            if (creationType == null) return null;
            ParameterizedQualifiedName className = creationType.name();
            diamond = creationType.diamond();
            classType = TypeName.reference(className.text(), className.typeArguments(),
                    className.typeArgumentSegmentCounts(), className.span());
            free creationType;
            elementType = classType;
        } else {
            this.diagnostics.add(this.error(this.peek(), "expected type name after 'new'"));
            return null;
        }

        if (this.match(TokenKind.LEFT_BRACKET)) {
            if (!constructorTypeArguments.isEmpty()) {
                this.diagnostics.add(Diagnostic.error(this.source, constructorTypeArguments.get(0).span(),
                        "explicit constructor type arguments cannot be used for array creation"));
            }
            Token opening = this.previous();
            boolean initializerCreation = this.match(TokenKind.RIGHT_BRACKET);
            Expression length = initializerCreation ? null : this.parseExpression();
            Token rightBracket = initializerCreation ? this.previous()
                    : this.expect(TokenKind.RIGHT_BRACKET, "expected ']' after array length");
            SourceSpan end = null;
            if (rightBracket != null) {
                end = rightBracket.span();
            } else {
                end = length == null ? opening.span() : length.span();
            }
            while (this.match(TokenKind.LEFT_BRACKET)) {
                Token dimensionOpening = this.previous();
                boolean emptyDimension = this.match(TokenKind.RIGHT_BRACKET);
                Token dimensionRight = emptyDimension ? this.previous() : null;
                if (!emptyDimension) {
                    this.parseExpression();
                    dimensionRight = this.expect(TokenKind.RIGHT_BRACKET, "expected ']' after array dimension");
                    this.diagnostics.add(this.error(dimensionOpening,
                            "array creation may size only the outer dimension; "
                            + "allocate each child array with a separate new expression"));
                }
                SourceSpan dimensionEnd = dimensionRight == null ? this.previous().span() : dimensionRight.span();
                elementType = TypeName.array(elementType,
                        new SourceSpan(elementType.span().start(), dimensionEnd.end()));
                end = dimensionEnd;
            }
            if (initializerCreation) {
                if (!this.check(TokenKind.LEFT_BRACE)) {
                    this.diagnostics.add(this.error(this.peek(),
                            "array creation with an unsized dimension requires an initializer"));
                    return null;
                }
                ArrayInitializerExpression initializer = this.parseArrayInitializer();
                SourceSpan initializerEnd = initializer == null ? end : initializer.span();
                return initializer == null ? null : new ArrayCreationExpression(elementType, null, initializer,
                        new SourceSpan(newKeyword.span().start(), initializerEnd.end()));
            }
            if (this.check(TokenKind.LEFT_BRACE)) {
                ArrayInitializerExpression initializer = this.parseArrayInitializer();
                this.diagnostics.add(this.error(opening,
                        "array creation cannot combine an explicit length with an initializer"));
                if (initializer != null) end = initializer.span();
            }
            return length == null ? null : new ArrayCreationExpression(elementType, length, null,
                    new SourceSpan(newKeyword.span().start(), end.end()));
        }

        if (classType == null) {
            this.diagnostics.add(this.error(this.peek(), "expected '[' after primitive array element type"));
            return null;
        }
        this.expect(TokenKind.LEFT_PAREN, "expected '(' after class name in object creation");
        SnapshotList<Expression> arguments = this.parseArguments();
        Token rightParen = this.expect(TokenKind.RIGHT_PAREN, "expected ')' after constructor arguments");
        SourceSpan end = rightParen == null ? classType.span() : rightParen.span();
        AnonymousClassBody anonymousClassBody = null;
        if (this.check(TokenKind.LEFT_BRACE)) {
            anonymousClassBody = this.parseAnonymousClassBody(false);
            if (anonymousClassBody != null) end = anonymousClassBody.span();
        }
        return new NewExpression(classType, null, constructorTypeArguments, diamond, arguments, anonymousClassBody,
                new SourceSpan(newKeyword.span().start(), end.end()));
    }

    private Expression finishQualifiedNew(Expression enclosingInstance, Token newKeyword) {

        SnapshotList<TypeName> constructorTypeArguments = this.parseTypeArguments();
        Token className = this.expect(TokenKind.IDENTIFIER, "expected member class name after qualified 'new'");
        if (className == null) return enclosingInstance;
        ParsedTypeArguments parsedTypeArguments = this.parseTypeArguments(true);
        defer free parsedTypeArguments;
        SnapshotList<TypeName> typeArguments = AstLists.typeNames(parsedTypeArguments.arguments());
        SourceSpan typeSpan = parsedTypeArguments.present()
                ? new SourceSpan(className.span().start(), parsedTypeArguments.end())
                : className.span();
        IntArrayList counts = new IntArrayList(1);
        defer free counts;
        counts.add(typeArguments.size());
        TypeName classType = TypeName.reference(className.lexeme(), typeArguments, AstLists.counts(counts), typeSpan);
        this.expect(TokenKind.LEFT_PAREN, "expected '(' after member class name");
        SnapshotList<Expression> arguments = this.parseArguments();
        Token rightParen = this.expect(TokenKind.RIGHT_PAREN, "expected ')' after constructor arguments");
        SourceSpan end = rightParen == null ? classType.span() : rightParen.span();
        AnonymousClassBody anonymousClassBody = null;
        if (this.check(TokenKind.LEFT_BRACE)) {
            anonymousClassBody = this.parseAnonymousClassBody(false);
            if (anonymousClassBody != null) end = anonymousClassBody.span();
        }
        return new NewExpression(classType, enclosingInstance, constructorTypeArguments, parsedTypeArguments.diamond(),
                arguments, anonymousClassBody, new SourceSpan(enclosingInstance.span().start(), end.end()));
    }

    private AnonymousClassBody parseAnonymousClassBody(boolean enumConstantBody) {

        Token leftBrace = this.expect(TokenKind.LEFT_BRACE, "expected '{' before anonymous class body");
        if (leftBrace == null) return null;
        MemberBuilders members = new MemberBuilders();
        defer free members;
        while (!this.check(TokenKind.RIGHT_BRACE) && !this.check(TokenKind.EOF)) {
            int before = this.current;
            this.parseMember(null, members, true, enumConstantBody);
            if (this.current == before) this.advance();
        }
        Token rightBrace = this.expect(TokenKind.RIGHT_BRACE, "expected '}' to close anonymous class body");
        if (rightBrace == null) return null;
        DestructorDeclaration destructorDeclaration = members.destructors().isEmpty() ? null
                : members.destructors().get(0);
        return new AnonymousClassBody(AstLists.fieldDeclarations(members.fields()),
                AstLists.instanceInitializations(members.instanceInitializations()),
                AstLists.staticInitializations(members.staticInitializations()), destructorDeclaration,
                AstLists.methodDeclarations(members.methods()), AstLists.typeDeclarations(members.memberTypes()),
                new SourceSpan(leftBrace.span().start(), rightBrace.span().end()));
    }

    private boolean looksLikeLocalVariableDeclaration() {

        int start = this.current;
        while (start < this.tokens.size() && isVariableModifier(this.tokens.get(start).kind())) start++;
        // Route malformed local directives through modifier diagnostics as well.
        if (start < this.tokens.size() && this.tokens.get(start).kind() == TokenKind.AT) return true;
        if (start >= this.tokens.size()) return false;
        if (isPrimitive(this.tokens.get(start).kind())) return true;
        if (this.tokens.get(start).kind() != TokenKind.IDENTIFIER) return false;
        int lookahead = this.parameterizedTypeEnd(start);
        if (lookahead < 0) return false;
        while (lookahead + 1 < this.tokens.size()
                && this.tokens.get(lookahead).kind() == TokenKind.LEFT_BRACKET
                && this.tokens.get(lookahead + 1).kind() == TokenKind.RIGHT_BRACKET) {
            lookahead += 2;
        }
        return lookahead < this.tokens.size() && this.tokens.get(lookahead).kind() == TokenKind.IDENTIFIER;
    }

    private boolean looksLikeEnhancedForInitializer() {

        int lookahead = this.current;
        while (lookahead < this.tokens.size()) {
            if (isVariableModifier(this.tokens.get(lookahead).kind())) {
                lookahead++;
            } else if (this.tokens.get(lookahead).kind() == TokenKind.AT
                    && lookahead + 1 < this.tokens.size()
                    && this.tokens.get(lookahead + 1).kind() == TokenKind.IDENTIFIER) {
                lookahead += 2;
            } else {
                break;
            }
        }
        if (lookahead >= this.tokens.size()) return false;
        if (isPrimitive(this.tokens.get(lookahead).kind())) {
            lookahead++;
        } else if (this.tokens.get(lookahead).kind() == TokenKind.IDENTIFIER) {
            lookahead = this.parameterizedTypeEnd(lookahead);
            if (lookahead < 0) return false;
        } else {
            return false;
        }
        while (lookahead + 1 < this.tokens.size()
                && this.tokens.get(lookahead).kind() == TokenKind.LEFT_BRACKET
                && this.tokens.get(lookahead + 1).kind() == TokenKind.RIGHT_BRACKET) {
            lookahead += 2;
        }
        return lookahead + 1 < this.tokens.size()
                && this.tokens.get(lookahead).kind() == TokenKind.IDENTIFIER
                && this.tokens.get(lookahead + 1).kind() == TokenKind.COLON;
    }

    private TokenKind localTypeDeclarationKind() {

        int lookahead = this.current;
        while (lookahead < this.tokens.size()) {
            TokenKind kind = this.tokens.get(lookahead).kind();
            if (kind == TokenKind.AT
                    && lookahead + 1 < this.tokens.size()
                    && this.tokens.get(lookahead + 1).kind() == TokenKind.IDENTIFIER) {
                lookahead += 2;
                continue;
            }
            if (kind == TokenKind.PUBLIC || kind == TokenKind.PROTECTED
                    || kind == TokenKind.PRIVATE || kind == TokenKind.STATIC
                    || kind == TokenKind.FINAL || kind == TokenKind.ABSTRACT
                    || kind == TokenKind.DEFAULT) {
                lookahead++;
                continue;
            }
            return kind == TokenKind.CLASS || kind == TokenKind.ENUM || kind == TokenKind.INTERFACE ? kind : null;
        }
        return null;
    }

    private int parameterizedTypeEnd(int start) {

        int lookahead = start;
        if (lookahead >= this.tokens.size() || this.tokens.get(lookahead).kind() != TokenKind.IDENTIFIER) return -1;
        while (true) {
            lookahead++;
            if (lookahead < this.tokens.size() && this.tokens.get(lookahead).kind() == TokenKind.LESS) {
                int depth = 0;
                do {
                    TokenKind kind = this.tokens.get(lookahead).kind();
                    if (kind == TokenKind.LESS) {
                        depth++;
                    } else if (kind == TokenKind.GREATER) {
                        depth--;
                    }
                    lookahead++;
                } while (lookahead < this.tokens.size() && depth > 0);
                if (depth != 0) return -1;
            }
            if (lookahead + 1 >= this.tokens.size()
                    || this.tokens.get(lookahead).kind() != TokenKind.DOT
                    || this.tokens.get(lookahead + 1).kind() != TokenKind.IDENTIFIER) {
                return lookahead;
            }
            lookahead++;
        }
    }

    private static boolean isPrimitive(TokenKind kind) {

        return isNumericPrimitive(kind) || kind == TokenKind.BOOLEAN;
    }

    private static boolean isNumericPrimitive(TokenKind kind) {

        return switch (kind) {
            case BYTE, SHORT, INT, LONG, CHAR, FLOAT, DOUBLE -> true;
            default -> false;
        };
    }

    private static TypeName.Kind primitiveKind(TokenKind kind) {

        return switch (kind) {
            case BYTE -> TypeName.Kind.BYTE;
            case SHORT -> TypeName.Kind.SHORT;
            case INT -> TypeName.Kind.INT;
            case LONG -> TypeName.Kind.LONG;
            case CHAR -> TypeName.Kind.CHAR;
            case FLOAT -> TypeName.Kind.FLOAT;
            case DOUBLE -> TypeName.Kind.DOUBLE;
            default -> throw new IllegalArgumentException("not a numeric primitive token: " + kind.name());
        };
    }

    private QualifiedName parseQualifiedName(String message, boolean allowWildcard) {

        Token first = this.expect(TokenKind.IDENTIFIER, message);
        if (first == null) return null;
        StringBuilder text = new StringBuilder();
        defer free text;
        text.append(first.lexeme());
        SourceSpan end = first.span();
        boolean wildcard = false;
        while (this.match(TokenKind.DOT)) {
            if (allowWildcard && this.match(TokenKind.STAR)) {
                wildcard = true;
                end = this.previous().span();
                break;
            }
            Token part = this.expect(TokenKind.IDENTIFIER, "expected identifier after '.'");
            if (part == null) break;
            text.append('.');
            text.append(part.lexeme());
            end = part.span();
        }
        return new QualifiedName(text.toString(), wildcard, new SourceSpan(first.span().start(), end.end()));
    }

    private ParameterizedQualifiedName parseParameterizedQualifiedName(String message) {

        Token first = this.expect(TokenKind.IDENTIFIER, message);
        if (first == null) return null;
        StringBuilder text = new StringBuilder();
        defer free text;
        text.append(first.lexeme());
        ArrayList<TypeName> arguments = new ArrayList<TypeName>(4);
        defer free arguments;
        IntArrayList segmentCounts = new IntArrayList(4);
        defer free segmentCounts;
        // Java copies each segment's argument list into this builder; the
        // segment's own arguments are appended directly instead.
        int firstCount = this.appendTypeArguments(arguments);
        segmentCounts.add(firstCount);
        SourceSpan end = arguments.isEmpty() ? first.span() : this.previous().span();
        while (this.check(TokenKind.DOT) && this.checkNext(TokenKind.IDENTIFIER)) {
            this.advance();
            Token part = this.expect(TokenKind.IDENTIFIER, "expected identifier after '.'");
            if (part == null) break;
            text.append('.');
            text.append(part.lexeme());
            end = part.span();
            int segmentCount = this.appendTypeArguments(arguments);
            segmentCounts.add(segmentCount);
            if (segmentCount != 0) end = this.previous().span();
        }
        return new ParameterizedQualifiedName(text.toString(), AstLists.typeNames(arguments),
                AstLists.counts(segmentCounts), new SourceSpan(first.span().start(), end.end()));
    }

    // Java's parseTypeArguments() for one name segment, appending the
    // arguments to a builder; returns their count.
    private int appendTypeArguments(ArrayList<TypeName> destination) {

        ParsedTypeArguments segment = this.parseTypeArguments(false);
        defer free segment;
        ArrayList<TypeName> parsed = segment.arguments();
        for (int index = 0; index < parsed.size(); index++) destination.add(parsed.get(index));
        return parsed.size();
    }

    private ParameterizedCreationType parseParameterizedCreationType(String message) {

        Token first = this.expect(TokenKind.IDENTIFIER, message);
        if (first == null) return null;
        StringBuilder text = new StringBuilder();
        defer free text;
        text.append(first.lexeme());
        ArrayList<TypeName> arguments = new ArrayList<TypeName>(4);
        defer free arguments;
        IntArrayList segmentCounts = new IntArrayList(4);
        defer free segmentCounts;
        ParsedTypeArguments segment = this.parseTypeArguments(true);
        this.appendSegment(arguments, segmentCounts, segment);
        boolean diamond = segment.diamond();
        SourcePosition diamondStart = segment.start();
        SourcePosition diamondEnd = segment.end();
        SourcePosition end = segment.present() ? segment.end() : first.span().end();
        free segment;
        while (this.check(TokenKind.DOT) && this.checkNext(TokenKind.IDENTIFIER)) {
            this.advance();
            if (diamond) {
                this.diagnostics.add(Diagnostic.error(this.source, new SourceSpan(diamondStart, diamondEnd),
                        "diamond type arguments are only permitted on the final class name segment"));
            }
            Token part = this.expect(TokenKind.IDENTIFIER, "expected identifier after '.'");
            if (part == null) break;
            text.append('.');
            text.append(part.lexeme());
            ParsedTypeArguments next = this.parseTypeArguments(true);
            // Loop-local segment: retires at the end of each iteration.
            defer free next;
            this.appendSegment(arguments, segmentCounts, next);
            diamond = next.diamond();
            diamondStart = next.start();
            diamondEnd = next.end();
            end = next.present() ? next.end() : part.span().end();
        }
        return new ParameterizedCreationType(text.toString(), AstLists.typeNames(arguments),
                AstLists.counts(segmentCounts), new SourceSpan(first.span().start(), end), diamond);
    }

    private void appendSegment(ArrayList<TypeName> arguments, IntArrayList segmentCounts, ParsedTypeArguments segment) {

        ArrayList<TypeName> parsed = segment.arguments();
        for (int index = 0; index < parsed.size(); index++) arguments.add(parsed.get(index));
        segmentCounts.add(parsed.size());
    }

    private CallExpression finishCall(Expression receiver, SnapshotList<TypeName> typeArguments, Token name) {

        SnapshotList<Expression> arguments = this.parseArguments();
        Token rightParen = this.expect(TokenKind.RIGHT_PAREN, "expected ')' after method arguments");
        SourceSpan span = null;
        if (rightParen == null) {
            span = name.span();
        } else {
            span = new SourceSpan(receiver == null ? name.span().start() : receiver.span().start(),
                    rightParen.span().end());
        }
        return new CallExpression(receiver, typeArguments, name.lexeme(), name.span(), arguments, span);
    }

    private SnapshotList<Expression> parseArguments() {

        ArrayList<Expression> arguments = new ArrayList<Expression>(4);
        defer free arguments;
        if (!this.check(TokenKind.RIGHT_PAREN)) {
            do {
                Expression argument = this.parseExpression();
                if (argument != null) arguments.add(argument);
            } while (this.match(TokenKind.COMMA));
        }
        return AstLists.expressions(arguments);
    }

    private BinaryExpression binary(Expression left, Token token, Expression right, BinaryOperator operator) {

        if (left == null || right == null) return null;
        return new BinaryExpression(left, operator, right, token.span(),
                new SourceSpan(left.span().start(), right.span().end()));
    }

    private void synchronizeParameter() {

        while (!this.check(TokenKind.EOF) && !this.check(TokenKind.RIGHT_PAREN) && !this.check(TokenKind.COMMA)) {
            this.advance();
        }
    }

    private void synchronizeStatement() {

        while (!this.check(TokenKind.EOF) && !this.check(TokenKind.RIGHT_BRACE)) {
            if (this.match(TokenKind.SEMICOLON)) return;
            this.advance();
        }
    }

    private void synchronizeMember() {

        while (!this.check(TokenKind.EOF) && !this.check(TokenKind.RIGHT_BRACE)) {
            if (this.match(TokenKind.SEMICOLON)) return;
            this.advance();
        }
    }

    private void synchronizeTopLevel() {

        while (!this.check(TokenKind.EOF)) {
            if (this.check(TokenKind.CLASS) || this.check(TokenKind.ENUM) || this.check(TokenKind.INTERFACE)
                    || this.check(TokenKind.PUBLIC) || this.check(TokenKind.PROTECTED)
                    || this.check(TokenKind.PRIVATE) || this.check(TokenKind.ABSTRACT)
                    || this.check(TokenKind.DEFAULT) || this.check(TokenKind.FINAL) || this.check(TokenKind.STATIC)) {
                return;
            }
            this.advance();
        }
    }

    private Token expect(TokenKind kind, String message) {

        if (this.check(kind)) return this.advance();
        this.diagnostics.add(this.error(this.peek(), message));
        return null;
    }

    private boolean match(TokenKind kind) {

        if (!this.check(kind)) return false;
        this.advance();
        return true;
    }

    private boolean check(TokenKind kind) {

        return this.peek().kind() == kind;
    }

    private boolean checkNext(TokenKind kind) {

        return this.current + 1 < this.tokens.size() && this.tokens.get(this.current + 1).kind() == kind;
    }

    private boolean looksLikeSwitchPatternLabel() {

        TokenKind first = this.peek().kind();
        if ((isNumericPrimitive(first) || first == TokenKind.BOOLEAN)
                && this.current + 1 < this.tokens.size()
                && this.tokens.get(this.current + 1).kind() == TokenKind.IDENTIFIER) {
            return true;
        }
        if (first != TokenKind.IDENTIFIER || this.current + 1 >= this.tokens.size()) return false;
        TokenKind second = this.tokens.get(this.current + 1).kind();
        if (second == TokenKind.IDENTIFIER) return true;
        if (second != TokenKind.LEFT_PAREN || this.current + 2 >= this.tokens.size()) return false;
        TokenKind nested = this.tokens.get(this.current + 2).kind();
        if (isNumericPrimitive(nested) || nested == TokenKind.BOOLEAN) {
            return this.current + 3 < this.tokens.size()
                    && this.tokens.get(this.current + 3).kind() == TokenKind.IDENTIFIER;
        }
        if (nested != TokenKind.IDENTIFIER) return false;
        String text = this.tokens.get(this.current + 2).lexeme();
        return text.equals("_") || this.current + 3 < this.tokens.size()
                && this.tokens.get(this.current + 3).kind() == TokenKind.IDENTIFIER;
    }

    private Token advance() {

        if (!this.check(TokenKind.EOF)) this.current++;
        return this.previous();
    }

    private Token peek() {

        return this.tokens.get(this.current);
    }

    private Token previous() {

        return this.tokens.get(Math.max(0, this.current - 1));
    }

    private Diagnostic error(Token token, String message) {

        return Diagnostic.error(this.source, token.span(), message);
    }

    private static String sourceQualifiedName(Expression expression) {

        if (expression instanceof NameExpression name) return name.name();
        if (expression instanceof FieldAccessExpression access) {
            String receiver = sourceQualifiedName(access.receiver());
            return receiver == null ? null : receiver + "." + access.fieldName();
        }
        return null;
    }

    destructor {

        free this.diagnostics;
    }

    // The ten parser-private Java records as final classes. Each is freed by
    // the method that consumes it; list components are frozen copies that
    // move into AST nodes, except where a holder owns a builder copy.

    private static final class Modifiers {

        private final AccessModifier accessModifier;
        private final Token accessToken;
        private final Token staticToken;
        private final Token finalToken;
        private final Token abstractToken;
        private final Token defaultToken;
        private final Token overrideToken;
        private final Token testToken;

        Modifiers(AccessModifier accessModifier, Token accessToken, Token staticToken, Token finalToken,
                  Token abstractToken, Token defaultToken, Token overrideToken, Token testToken) {

            this.accessModifier = accessModifier;
            this.accessToken = accessToken;
            this.staticToken = staticToken;
            this.finalToken = finalToken;
            this.abstractToken = abstractToken;
            this.defaultToken = defaultToken;
            this.overrideToken = overrideToken;
            this.testToken = testToken;
        }

        AccessModifier accessModifier() {

            return this.accessModifier;
        }

        Token accessToken() {

            return this.accessToken;
        }

        Token staticToken() {

            return this.staticToken;
        }

        Token finalToken() {

            return this.finalToken;
        }

        Token abstractToken() {

            return this.abstractToken;
        }

        Token defaultToken() {

            return this.defaultToken;
        }

        Token overrideToken() {

            return this.overrideToken;
        }

        Token testToken() {

            return this.testToken;
        }

        boolean isStatic() {

            return this.staticToken != null;
        }

        boolean isFinal() {

            return this.finalToken != null;
        }

        boolean isAbstract() {

            return this.abstractToken != null;
        }

        boolean isDefault() {

            return this.defaultToken != null;
        }

        boolean hasOverrideDirective() {

            return this.overrideToken != null;
        }

        boolean hasTestDirective() {

            return this.testToken != null;
        }
    }

    private static final class VariableModifiers {

        private final boolean isFinal;
        private final boolean hasSuppressUnfreedDirective;

        VariableModifiers(boolean isFinal, boolean hasSuppressUnfreedDirective) {

            this.isFinal = isFinal;
            this.hasSuppressUnfreedDirective = hasSuppressUnfreedDirective;
        }

        boolean isFinal() {

            return this.isFinal;
        }

        boolean hasSuppressUnfreedDirective() {

            return this.hasSuppressUnfreedDirective;
        }
    }

    private static final class QualifiedName {

        private final String text;
        private final boolean wildcard;
        private final SourceSpan span;

        QualifiedName(String text, boolean wildcard, SourceSpan span) {

            this.text = text;
            this.wildcard = wildcard;
            this.span = span;
        }

        String text() {

            return this.text;
        }

        boolean wildcard() {

            return this.wildcard;
        }

        SourceSpan span() {

            return this.span;
        }
    }

    private static final class ParameterizedQualifiedName {

        private final String text;
        private final SnapshotList<TypeName> typeArguments;
        private final SnapshotInts typeArgumentSegmentCounts;
        private final SourceSpan span;

        ParameterizedQualifiedName(String text, SnapshotList<TypeName> typeArguments,
                                   SnapshotInts typeArgumentSegmentCounts, SourceSpan span) {

            this.text = text;
            this.typeArguments = typeArguments;
            this.typeArgumentSegmentCounts = typeArgumentSegmentCounts;
            this.span = span;
        }

        String text() {

            return this.text;
        }

        SnapshotList<TypeName> typeArguments() {

            return this.typeArguments;
        }

        SnapshotInts typeArgumentSegmentCounts() {

            return this.typeArgumentSegmentCounts;
        }

        SourceSpan span() {

            return this.span;
        }
    }

    // Owns a copy of its argument builder, because one name segment's
    // arguments are appended to the whole name's builder rather than kept.
    // Java's span component is kept as its two borrowed positions: no output
    // retains the span itself, and every consumer reads only its positions.
    private static final class ParsedTypeArguments {

        private final boolean present;
        private final boolean diamond;
        private final ArrayList<TypeName> arguments;
        private final SourcePosition start;
        private final SourcePosition end;

        ParsedTypeArguments(boolean present, boolean diamond, ArrayList<TypeName> arguments, SourcePosition start,
                            SourcePosition end) {

            this.present = present;
            this.diamond = diamond;
            this.arguments = arguments.copy();
            this.start = start;
            this.end = end;
        }

        static ParsedTypeArguments absent() {

            ArrayList<TypeName> none = new ArrayList<TypeName>(1);
            defer free none;
            return new ParsedTypeArguments(false, false, none, null, null);
        }

        boolean present() {

            return this.present;
        }

        boolean diamond() {

            return this.diamond;
        }

        ArrayList<TypeName> arguments() {

            return this.arguments;
        }

        SourcePosition start() {

            return this.start;
        }

        SourcePosition end() {

            return this.end;
        }

        destructor {

            free this.arguments;
        }
    }

    // Java wraps an already built name; the name is built here from its
    // components so this holder owns it.
    private static final class ParameterizedCreationType {

        private final ParameterizedQualifiedName name;
        private final boolean diamond;

        ParameterizedCreationType(String text, SnapshotList<TypeName> typeArguments, SnapshotInts segmentCounts,
                                  SourceSpan span, boolean diamond) {

            this.name = new ParameterizedQualifiedName(text, typeArguments, segmentCounts, span);
            this.diamond = diamond;
        }

        ParameterizedQualifiedName name() {

            return this.name;
        }

        boolean diamond() {

            return this.diamond;
        }

        destructor {

            free this.name;
        }
    }

    private static final class ParsedAssignment {

        private final AssignmentOperator operator;
        private final SourceSpan span;

        ParsedAssignment(AssignmentOperator operator, SourceSpan span) {

            this.operator = operator;
            this.span = span;
        }

        AssignmentOperator operator() {

            return this.operator;
        }

        SourceSpan span() {

            return this.span;
        }
    }

    private static final class ParsedBinary {

        private final BinaryOperator operator;
        private final SourceSpan span;

        ParsedBinary(BinaryOperator operator, SourceSpan span) {

            this.operator = operator;
            this.span = span;
        }

        BinaryOperator operator() {

            return this.operator;
        }

        SourceSpan span() {

            return this.span;
        }
    }

    // Owns a copy of its label builder: rule labels are frozen into a rule,
    // while group labels are appended to the group's own builder. Java's span
    // component is kept as its two borrowed positions: no output retains it,
    // and diagnostics that report it build their own span.
    private static final class ParsedSwitchLabels {

        private final ArrayList<SwitchLabel> labels;
        private final boolean arrowRules;
        private final SourcePosition start;
        private final SourcePosition end;

        ParsedSwitchLabels(ArrayList<SwitchLabel> labels, boolean arrowRules, SourcePosition start,
                           SourcePosition end) {

            this.labels = labels.copy();
            this.arrowRules = arrowRules;
            this.start = start;
            this.end = end;
        }

        ArrayList<SwitchLabel> labels() {

            return this.labels;
        }

        boolean arrowRules() {

            return this.arrowRules;
        }

        SourcePosition start() {

            return this.start;
        }

        SourcePosition end() {

            return this.end;
        }

        destructor {

            free this.labels;
        }
    }

    private static final class ParsedSwitchBody {

        private final SnapshotList<SwitchGroup> groups;
        private final SnapshotList<SwitchRule> rules;
        private final boolean arrowRules;
        private final SourceSpan end;

        ParsedSwitchBody(SnapshotList<SwitchGroup> groups, SnapshotList<SwitchRule> rules, boolean arrowRules,
                         SourceSpan end) {

            this.groups = groups;
            this.rules = rules;
            this.arrowRules = arrowRules;
            this.end = end;
        }

        SnapshotList<SwitchGroup> groups() {

            return this.groups;
        }

        SnapshotList<SwitchRule> rules() {

            return this.rules;
        }

        boolean arrowRules() {

            return this.arrowRules;
        }

        SourceSpan end() {

            return this.end;
        }
    }

    // Java passes a class body's seven member lists to parseMember separately;
    // natively they travel together and are freed together.
    private static final class MemberBuilders {

        private final ArrayList<FieldDeclaration> fields = new ArrayList<FieldDeclaration>();
        private final ArrayList<InstanceInitialization> instanceInitializations =
                new ArrayList<InstanceInitialization>();
        private final ArrayList<StaticInitialization> staticInitializations = new ArrayList<StaticInitialization>(4);
        private final ArrayList<ConstructorDeclaration> constructors = new ArrayList<ConstructorDeclaration>(4);
        private final ArrayList<DestructorDeclaration> destructors = new ArrayList<DestructorDeclaration>(1);
        private final ArrayList<MethodDeclaration> methods = new ArrayList<MethodDeclaration>();
        private final ArrayList<TypeDeclaration> memberTypes = new ArrayList<TypeDeclaration>(4);

        MemberBuilders() {

        }

        ArrayList<FieldDeclaration> fields() {

            return this.fields;
        }

        ArrayList<InstanceInitialization> instanceInitializations() {

            return this.instanceInitializations;
        }

        ArrayList<StaticInitialization> staticInitializations() {

            return this.staticInitializations;
        }

        ArrayList<ConstructorDeclaration> constructors() {

            return this.constructors;
        }

        ArrayList<DestructorDeclaration> destructors() {

            return this.destructors;
        }

        ArrayList<MethodDeclaration> methods() {

            return this.methods;
        }

        ArrayList<TypeDeclaration> memberTypes() {

            return this.memberTypes;
        }

        destructor {

            free this.memberTypes;
            free this.methods;
            free this.destructors;
            free this.constructors;
            free this.staticInitializations;
            free this.instanceInitializations;
            free this.fields;
        }
    }
}
