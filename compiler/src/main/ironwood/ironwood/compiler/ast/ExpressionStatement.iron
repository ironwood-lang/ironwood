package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code ExpressionStatement}. Components keep
 * the record's order; {@code Optional} components are nullable, and list components
 * are frozen, independent copies that the node borrows for the invocation.
 */
public final class ExpressionStatement implements Statement {

    private final Expression expression;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public ExpressionStatement(Expression expression, SourceSpan span) {

        this.expression = expression;
        this.span = span;
    }

    /** @return the {@code expression} component */
    public Expression expression() {

        return this.expression;
    }

    /** @return the {@code span} component */
    @Override public SourceSpan span() {

        return this.span;
    }

    @Override public StatementVariant statementVariant() {

        return StatementVariant.EXPRESSION_STATEMENT;
    }
}
