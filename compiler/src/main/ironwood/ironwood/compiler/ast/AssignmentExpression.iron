package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code AssignmentExpression}. Components keep
 * the record's order; {@code Optional} components are nullable, and list components
 * are frozen, independent copies that the node borrows for the invocation.
 */
public final class AssignmentExpression implements Expression {

    private final Expression target;
    private final AssignmentOperator operator;
    private final SourceSpan operatorSpan;
    private final Expression value;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public AssignmentExpression(Expression target, AssignmentOperator operator, SourceSpan operatorSpan,
                                Expression value, SourceSpan span) {

        this.target = target;
        this.operator = operator;
        this.operatorSpan = operatorSpan;
        this.value = value;
        this.span = span;
    }

    /** @return the {@code target} component */
    public Expression target() {

        return this.target;
    }

    /** @return the {@code operator} component */
    public AssignmentOperator operator() {

        return this.operator;
    }

    /** @return the {@code operatorSpan} component */
    public SourceSpan operatorSpan() {

        return this.operatorSpan;
    }

    /** @return the {@code value} component */
    public Expression value() {

        return this.value;
    }

    /** @return the {@code span} component */
    @Override public SourceSpan span() {

        return this.span;
    }

    @Override public ExpressionVariant expressionVariant() {

        return ExpressionVariant.ASSIGNMENT_EXPRESSION;
    }
}
