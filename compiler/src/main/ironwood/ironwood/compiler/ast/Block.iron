package ironwood.compiler.ast;

import ironwood.compiler.port.SnapshotList;
import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code Block}. Components keep the record's
 * order; {@code Optional} components are nullable, and list components are frozen,
 * independent copies that the node borrows for the invocation.
 */
public final class Block implements Statement, InstanceInitialization, StaticInitialization {

    private final SnapshotList<Statement> statements;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public Block(SnapshotList<Statement> statements, SourceSpan span) {

        if (statements == null) throw new NullPointerException();
        this.statements = statements;
        this.span = span;
    }

    /** @return the {@code statements} component */
    public SnapshotList<Statement> statements() {

        return this.statements;
    }

    /** @return the {@code span} component */
    @Override public SourceSpan span() {

        return this.span;
    }

    @Override public StatementVariant statementVariant() {

        return StatementVariant.BLOCK;
    }

    @Override public InitializationVariant initializationVariant() {

        return InitializationVariant.BLOCK;
    }
}
