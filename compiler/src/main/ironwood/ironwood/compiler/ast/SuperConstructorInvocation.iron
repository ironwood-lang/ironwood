package ironwood.compiler.ast;

import ironwood.compiler.port.SnapshotList;
import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code SuperConstructorInvocation}. Components
 * keep the record's order; {@code Optional} components are nullable, and list
 * components are frozen, independent copies that the node borrows for the invocation.
 */
public final class SuperConstructorInvocation implements Statement {

    private final Expression enclosingInstance;
    private final SnapshotList<TypeName> typeArguments;
    private final SnapshotList<Expression> arguments;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public SuperConstructorInvocation(Expression enclosingInstance, SnapshotList<TypeName> typeArguments,
                                      SnapshotList<Expression> arguments, SourceSpan span) {

        if (typeArguments == null) typeArguments = AstLists.NO_TYPE_NAMES;
        if (arguments == null) throw new NullPointerException();
        this.enclosingInstance = enclosingInstance;
        this.typeArguments = typeArguments;
        this.arguments = arguments;
        this.span = span;
    }

    /** @return the {@code enclosingInstance} component */
    public Expression enclosingInstance() {

        return this.enclosingInstance;
    }

    /** @return the {@code typeArguments} component */
    public SnapshotList<TypeName> typeArguments() {

        return this.typeArguments;
    }

    /** @return the {@code arguments} component */
    public SnapshotList<Expression> arguments() {

        return this.arguments;
    }

    /** @return the {@code span} component */
    @Override public SourceSpan span() {

        return this.span;
    }

    @Override public StatementVariant statementVariant() {

        return StatementVariant.SUPER_CONSTRUCTOR_INVOCATION;
    }
}
