package ironwood.compiler.ast;

import ironwood.compiler.port.SnapshotList;
import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code SwitchGroup}. Components keep the
 * record's order; {@code Optional} components are nullable, and list components are
 * frozen, independent copies that the node borrows for the invocation.
 */
public final class SwitchGroup {

    private final SnapshotList<SwitchLabel> labels;
    private final SnapshotList<Statement> statements;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public SwitchGroup(SnapshotList<SwitchLabel> labels, SnapshotList<Statement> statements, SourceSpan span) {

        if (labels == null) throw new NullPointerException();
        if (statements == null) throw new NullPointerException();
        if (labels.isEmpty()) throw new IllegalArgumentException("switch group requires at least one label");
        this.labels = labels;
        this.statements = statements;
        this.span = span;
    }

    /** @return the {@code labels} component */
    public SnapshotList<SwitchLabel> labels() {

        return this.labels;
    }

    /** @return the {@code statements} component */
    public SnapshotList<Statement> statements() {

        return this.statements;
    }

    /** @return the {@code span} component */
    public SourceSpan span() {

        return this.span;
    }
}
