package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code Parameter}. Components keep the record's
 * order; {@code Optional} components are nullable, and list components are frozen,
 * independent copies that the node borrows for the invocation.
 */
public final class Parameter {

    private final TypeName type;
    private final boolean isFinal;
    private final String name;
    private final SourceSpan nameSpan;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public Parameter(TypeName type, boolean isFinal, String name, SourceSpan nameSpan, SourceSpan span) {

        this.type = type;
        this.isFinal = isFinal;
        this.name = name;
        this.nameSpan = nameSpan;
        this.span = span;
    }

    /** @return the {@code type} component */
    public TypeName type() {

        return this.type;
    }

    /** @return the {@code isFinal} component */
    public boolean isFinal() {

        return this.isFinal;
    }

    /** @return the {@code name} component */
    public String name() {

        return this.name;
    }

    /** @return the {@code nameSpan} component */
    public SourceSpan nameSpan() {

        return this.nameSpan;
    }

    /** @return the {@code span} component */
    public SourceSpan span() {

        return this.span;
    }
}
