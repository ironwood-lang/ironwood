package ironwood.compiler.ast;

/**
 * Prefix unary operators other than increment and decrement. Ports the Java enum {@code UnaryOperator} with the same
 * constants in the same order.
 */
public enum UnaryOperator {

    POSITIVE,
    NEGATE,
    NOT,
    BITWISE_COMPLEMENT
}
