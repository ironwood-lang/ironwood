package ironwood.compiler.ast;

/**
 * The declaration form of an interface method. Ports the Java enum {@code InterfaceMethodKind} with the same constants
 * in the same order.
 */
public enum InterfaceMethodKind {

    ABSTRACT,
    DEFAULT,
    STATIC,
    PRIVATE_INSTANCE,
    PRIVATE_STATIC
}
