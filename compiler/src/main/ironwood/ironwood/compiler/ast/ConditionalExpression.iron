package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code ConditionalExpression}. Components keep
 * the record's order; {@code Optional} components are nullable, and list components
 * are frozen, independent copies that the node borrows for the invocation.
 */
public final class ConditionalExpression implements Expression {

    private final Expression condition;
    private final Expression whenTrue;
    private final Expression whenFalse;
    private final SourceSpan questionSpan;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public ConditionalExpression(Expression condition, Expression whenTrue, Expression whenFalse,
                                 SourceSpan questionSpan, SourceSpan span) {

        this.condition = condition;
        this.whenTrue = whenTrue;
        this.whenFalse = whenFalse;
        this.questionSpan = questionSpan;
        this.span = span;
    }

    /** @return the {@code condition} component */
    public Expression condition() {

        return this.condition;
    }

    /** @return the {@code whenTrue} component */
    public Expression whenTrue() {

        return this.whenTrue;
    }

    /** @return the {@code whenFalse} component */
    public Expression whenFalse() {

        return this.whenFalse;
    }

    /** @return the {@code questionSpan} component */
    public SourceSpan questionSpan() {

        return this.questionSpan;
    }

    /** @return the {@code span} component */
    @Override public SourceSpan span() {

        return this.span;
    }

    @Override public ExpressionVariant expressionVariant() {

        return ExpressionVariant.CONDITIONAL_EXPRESSION;
    }
}
