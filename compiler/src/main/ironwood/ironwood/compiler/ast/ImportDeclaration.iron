package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code ImportDeclaration}. Components keep the
 * record's order; {@code Optional} components are nullable, and list components are
 * frozen, independent copies that the node borrows for the invocation.
 */
public final class ImportDeclaration {

    private final String name;
    private final boolean wildcard;
    private final boolean staticImport;
    private final SourceSpan nameSpan;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public ImportDeclaration(String name, boolean wildcard, boolean staticImport, SourceSpan nameSpan,
                             SourceSpan span) {

        this.name = name;
        this.wildcard = wildcard;
        this.staticImport = staticImport;
        this.nameSpan = nameSpan;
        this.span = span;
    }

    /** @return the {@code name} component */
    public String name() {

        return this.name;
    }

    /** @return the {@code wildcard} component */
    public boolean wildcard() {

        return this.wildcard;
    }

    /** @return the {@code staticImport} component */
    public boolean staticImport() {

        return this.staticImport;
    }

    /** @return the {@code nameSpan} component */
    public SourceSpan nameSpan() {

        return this.nameSpan;
    }

    /** @return the {@code span} component */
    public SourceSpan span() {

        return this.span;
    }
}
