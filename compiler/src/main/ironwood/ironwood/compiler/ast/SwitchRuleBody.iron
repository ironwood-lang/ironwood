package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * The body of an arrow switch rule.
 * Ports the Java sealed interface {@code SwitchRuleBody}: implementations report their
 * closed variant so consumers dispatch with an exhaustive {@code switch} (D260).
 */
public interface SwitchRuleBody {

    /** @return the source span */
    SourceSpan span();

    /** @return this node's closed variant */
    SwitchRuleBodyVariant switchRuleBodyVariant();
}
