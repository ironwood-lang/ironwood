package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * A source-ordered instance field initializer or instance initializer block.
 * Ports the Java sealed interface {@code InstanceInitialization}: implementations report their
 * closed variant so consumers dispatch with an exhaustive {@code switch} (D260).
 */
public interface InstanceInitialization {

    /** @return the source span */
    SourceSpan span();

    /** @return this node's closed variant */
    InitializationVariant initializationVariant();
}
