package ironwood.compiler.ast;

import ironwood.compiler.source.SourceSpan;

/**
 * Port of the Java frontend AST record {@code SwitchRuleThrow}. Components keep the
 * record's order; {@code Optional} components are nullable, and list components are
 * frozen, independent copies that the node borrows for the invocation.
 */
public final class SwitchRuleThrow implements SwitchRuleBody {

    private final ThrowStatement statement;
    private final SourceSpan span;

    /** Creates the node from its components in record order. */
    public SwitchRuleThrow(ThrowStatement statement, SourceSpan span) {

        this.statement = statement;
        this.span = span;
    }

    /** @return the {@code statement} component */
    public ThrowStatement statement() {

        return this.statement;
    }

    /** @return the {@code span} component */
    @Override public SourceSpan span() {

        return this.span;
    }

    @Override public SwitchRuleBodyVariant switchRuleBodyVariant() {

        return SwitchRuleBodyVariant.SWITCH_RULE_THROW;
    }
}
