            case IR_STRING_HASH_CODE_INSTRUCTION -> "result:IrValueReference,string:IrOperand,sourceSpan:SourceSpan";
            case IR_STRING_JOIN_INSTRUCTION -> "result:IrValueReference,delimiter:IrOperand,elements:IrOperand,sourceSpan:SourceSpan";
            case IR_STRING_REPEAT_INSTRUCTION -> "result:IrValueReference,source:IrOperand,count:IrOperand,sourceSpan:SourceSpan";
            case IR_STRING_REPLACE_CHAR_INSTRUCTION -> "result:IrValueReference,source:IrOperand,oldChar:IrOperand,newChar:IrOperand,sourceSpan:SourceSpan";
            case IR_STRING_REPLACE_TEXT_INSTRUCTION -> "result:IrValueReference,source:IrOperand,target:IrOperand,replacement:IrOperand,sourceSpan:SourceSpan";
            case IR_SWITCH_CASE -> "value:IrConstant,target:String,sourceSpan:SourceSpan";
            case IR_SWITCH_TERMINATOR -> "selector:IrOperand,cases:List<IrSwitchCase>,defaultTarget:String,sourceSpan:SourceSpan";
            case IR_SYSTEM_ARRAY_COPY_INSTRUCTION -> "source:IrOperand,sourcePosition:IrOperand,destination:IrOperand,destinationPosition:IrOperand,length:IrOperand,sourceSpan:SourceSpan";
            case IR_SYSTEM_CLOCK_INSTRUCTION -> "result:IrValueReference,clock:IrSystemClockInstruction.Clock,sourceSpan:SourceSpan";
            case IR_SYSTEM_EXIT_INSTRUCTION -> "status:IrOperand,sourceSpan:SourceSpan";
            case IR_SYSTEM_GETENV_INSTRUCTION -> "result:IrValueReference,name:IrOperand,sourceSpan:SourceSpan";
            case IR_SYSTEM_PROPERTY_INSTRUCTION -> "result:IrValueReference,name:IrOperand,sourceSpan:SourceSpan";
            case IR_TCP_INSTRUCTION -> "result:IrValueReference,operation:IrTcpInstruction.Operation,arguments:List<IrOperand>,outputFields:List<IrField>,sourceSpan:SourceSpan";
            case IR_THROW_TERMINATOR -> "exception:IrOperand,normalTarget:String,unwindTarget:Optional<String>,sourceSpan:SourceSpan";
            case IR_THROWABLE_DESCRIPTION_INSTRUCTION -> "result:IrValueReference,throwable:IrOperand,message:IrOperand,sourceSpan:SourceSpan";
            case IR_THROWABLE_TRACE_INSTRUCTION -> "result:Optional<IrValueReference>,operation:IrThrowableTraceInstruction.Operation,arguments:List<IrOperand>,sourceSpan:SourceSpan";
            case IR_TLS_INSTRUCTION -> "result:IrValueReference,operation:IrTlsInstruction.Operation,arguments:List<IrOperand>,sourceSpan:SourceSpan";
            case IR_TYPE -> "kind:IrType.Kind,referenceName:String,typeArguments:List<IrType>,elementType:IrType,typeParameterErasure:IrType,wildcardKind:IrType.WildcardKind,wildcardBound:IrType";
            case IR_TYPE_INITIALIZATION -> "typeName:String,prerequisiteTypes:List<String>,initializerLinkageName:Optional<String>,sourceSpan:SourceSpan";
            case IR_TYPE_INITIALIZED_INSTRUCTION -> "result:IrValueReference,typeName:String,sourceSpan:SourceSpan";
            case IR_UNARY_INSTRUCTION -> "result:IrValueReference,operator:IrUnaryOperator,operand:IrOperand,sourceSpan:SourceSpan";
            case IR_UNREACHABLE -> "sourceSpan:SourceSpan";
            case IR_VALUE_REFERENCE -> "id:int,type:IrType,sourceSpan:SourceSpan";
            case IR_VIRTUAL_CALL_INSTRUCTION -> "result:Optional<IrValueReference>,slot:IrDispatchSlot,returnType:IrType,arguments:List<IrOperand>,specializationArguments:Map<String, IrType>,sourceSpan:SourceSpan";
        };
    }

    /**
     * @return the components the reflective IR walkers follow: IR types,
     *     operands, string constants, dispatch slots, enum constants, fields,
     *     static fields and nested IR records, directly or through Optional
     *     and List/Set; never maps, text, primitives, enums or source spans
     */
    public static String walked(Record record) {

        return switch (record) {
            case IR_ADD_SECONDARY_EXCEPTION_INSTRUCTION -> "primary,secondary";
            case IR_ALLOCATE_INSTRUCTION -> "result";
            case IR_ALLOCATION_COUNT_INSTRUCTION -> "result";
            case IR_ARRAY_ALLOCATE_INSTRUCTION -> "result,elementType,length";
            case IR_ARRAY_BOUNDS_CHECK_INSTRUCTION -> "result,array,index";
            case IR_ARRAY_LENGTH_CHECK_INSTRUCTION -> "result,length";
            case IR_ARRAY_LENGTH_INSTRUCTION -> "result,array";
            case IR_ARRAY_LOAD_INSTRUCTION -> "result,array,index";
            case IR_ARRAY_STORE_INSTRUCTION -> "array,index,value";
            case IR_ARRAY_TYPE -> "type,dispatchEntries";
            case IR_ARRAY_TYPE_TEST_INSTRUCTION -> "result,value,targetType";
            case IR_BASIC_BLOCK -> "instructions,terminator";
            case IR_BINARY_INSTRUCTION -> "result,left,right";
            case IR_BRANCH -> "condition";
            case IR_BRIDGE_ARRAY_COPY_INSTRUCTION -> "result,stateAddress";
            case IR_BRIDGE_BATCH_APPEND_INSTRUCTION -> "result,context,index,count,arguments";
            case IR_BRIDGE_FAILURE_SNAPSHOT_INSTRUCTION -> "exception,frameAddress";
            case IR_BRIDGE_RESULT_STORE_INSTRUCTION -> "frameAddress,value";
            case IR_BRIDGE_SLOT_STORE_INSTRUCTION -> "frameAddress,holder,value";
            case IR_BRIDGE_STRING_COPY_INSTRUCTION -> "result,address,length";
            case IR_BYTE_VIEW_INSTRUCTION -> "result,view,arguments";
            case IR_CALL_INSTRUCTION -> "result,returnType,arguments";
            case IR_CHARACTER_INSTRUCTION -> "result,codePoint";
            case IR_CLASS -> "fields,dispatchEntries";
            case IR_CONSTANT -> "type";
            case IR_DESTROY_ARRAY_ELEMENTS_INSTRUCTION -> "array";
            case IR_DISPATCH_ENTRY -> "slot";
            case IR_DISPATCH_SLOT -> "returnType,parameterTypes";
            case IR_ENSURE_TYPE_INITIALIZED_INSTRUCTION -> "";
            case IR_ENUM_CONSTANT -> "type,storageType,nameValue";
            case IR_EXCEPTION_CAUGHT_INSTRUCTION -> "exception";
            case IR_EXCEPTION_LANDING_PAD_INSTRUCTION -> "exceptionHandle,exceptionObject";
            case IR_FIELD -> "type";
            case IR_FIELD_LOAD_INSTRUCTION -> "result,receiver,field";
            case IR_FIELD_STORE_INSTRUCTION -> "receiver,field,value";
            case IR_FILE_INSTRUCTION -> "result,path,value";
            case IR_FLOATING_BITS_INSTRUCTION -> "result,value";
            case IR_FLOATING_PARSE_INSTRUCTION -> "result,text";
            case IR_FOREIGN_CALL_INSTRUCTION -> "result,returnType,arguments,invocationContext";
            case IR_FREE_INSTRUCTION -> "allocation";
            case IR_FUNCTION -> "returnType,parameters,blocks";
            case IR_IDENTITY_HASH_CODE_INSTRUCTION -> "result,object";
            case IR_IMMORTAL_OBJECT -> "type,storageType";
            case IR_INSTANCE_OF_INSTRUCTION -> "result,value,exactTargetType";
            case IR_INTERFACE_CALL_INSTRUCTION -> "result,slot,returnType,arguments";
            case IR_INVOKE_TERMINATOR -> "call";
            case IR_JUMP -> "";
            case IR_LIVE_ALLOCATION_COUNT_INSTRUCTION -> "result";
            case IR_MATH_BINARY_INSTRUCTION -> "result,left,right";
            case IR_MATH_UNARY_INSTRUCTION -> "result,value";
            case IR_NULL -> "type";
            case IR_NULL_CHECK_INSTRUCTION -> "result,receiver";
            case IR_NUMERIC_CONVERSION_INSTRUCTION -> "result,value";
            case IR_OBJECT_HASH_CODE_INSTRUCTION -> "result,object";
            case IR_OBJECT_TO_STRING_INSTRUCTION -> "result,object";
            case IR_PARAMETER -> "value";
            case IR_PHI_INCOMING -> "value";
            case IR_PHI_INSTRUCTION -> "result,incoming";
            case IR_PRINT_STREAM_CHECK_ERROR_INSTRUCTION -> "result,stream";
            case IR_PRINT_STREAM_FLUSH_INSTRUCTION -> "stream";
            case IR_PRINT_STREAM_PRINTLN_INSTRUCTION -> "value";
            case IR_PRINT_STREAM_WRITE_INSTRUCTION -> "stream,value";
            case IR_PROGRAM -> "classes,staticFields,typeInitializations,arrayTypes,stringConstants,dispatchSlots,functions,entryPoint,allocationFailure";
            case IR_RAW_DEALLOCATE_INSTRUCTION -> "allocation";
            case IR_REFERENCE_CONVERSION_INSTRUCTION -> "result,value";
            case IR_RELEASE_OWNED_THROWABLE_MESSAGE_INSTRUCTION -> "throwable,message";
            case IR_RELEASE_OWNED_TO_STRING_RESULT_INSTRUCTION -> "object,result";
            case IR_RETURN_TERMINATOR -> "value";
            case IR_ROLLBACK_INSTRUCTION -> "allocation";
            case IR_SECONDARY_EXCEPTION_AT_INSTRUCTION -> "result,primary,index";
            case IR_SECONDARY_EXCEPTION_COUNT_INSTRUCTION -> "result,primary";
            case IR_STATIC_FIELD -> "type,initialValue";
            case IR_STATIC_FIELD_LOAD_INSTRUCTION -> "result,field";
            case IR_STATIC_FIELD_STORE_INSTRUCTION -> "field,value";
            case IR_STREAM_INSTRUCTION -> "result,arguments";
            case IR_STRING_CASE_INSTRUCTION -> "result,source,upper";
            case IR_STRING_CHAR_AT_INSTRUCTION -> "result,string,index";
            case IR_STRING_CONCAT_INSTRUCTION -> "result,parts";
            case IR_STRING_CONCAT_PART -> "value";
            case IR_STRING_CONSTANT -> "";
            case IR_STRING_COPY_INSTRUCTION -> "result,source";
            case IR_STRING_EQUALS_IGNORE_CASE_INSTRUCTION -> "result,source,other";
            case IR_STRING_EQUALS_INSTRUCTION -> "result,string,other";
            case IR_STRING_FROM_CHAR_RANGE_INSTRUCTION -> "result,characters,offset,length";
            case IR_STRING_FROM_CHARACTER_INSTRUCTION -> "result,value";
            case IR_STRING_FROM_CHARS_INSTRUCTION -> "result,characters,length";
            case IR_STRING_FROM_INTEGER_INSTRUCTION -> "result,value,radix";
            case IR_STRING_FROM_RANGE_INSTRUCTION -> "result,source,beginIndex,length";
            case IR_STRING_FROM_UTF8_INSTRUCTION -> "result,bytes,length";
            case IR_STRING_HASH_CODE_INSTRUCTION -> "result,string";
            case IR_STRING_JOIN_INSTRUCTION -> "result,delimiter,elements";
            case IR_STRING_REPEAT_INSTRUCTION -> "result,source,count";
            case IR_STRING_REPLACE_CHAR_INSTRUCTION -> "result,source,oldChar,newChar";
            case IR_STRING_REPLACE_TEXT_INSTRUCTION -> "result,source,target,replacement";
            case IR_SWITCH_CASE -> "value";
            case IR_SWITCH_TERMINATOR -> "selector,cases";
            case IR_SYSTEM_ARRAY_COPY_INSTRUCTION -> "source,sourcePosition,destination,destinationPosition,length";
            case IR_SYSTEM_CLOCK_INSTRUCTION -> "result";
            case IR_SYSTEM_EXIT_INSTRUCTION -> "status";
            case IR_SYSTEM_GETENV_INSTRUCTION -> "result,name";
            case IR_SYSTEM_PROPERTY_INSTRUCTION -> "result,name";
            case IR_TCP_INSTRUCTION -> "result,arguments,outputFields";
            case IR_THROW_TERMINATOR -> "exception";
            case IR_THROWABLE_DESCRIPTION_INSTRUCTION -> "result,throwable,message";
            case IR_THROWABLE_TRACE_INSTRUCTION -> "result,arguments";
            case IR_TLS_INSTRUCTION -> "result,arguments";
            case IR_TYPE -> "typeArguments,elementType,typeParameterErasure,wildcardBound";
            case IR_TYPE_INITIALIZATION -> "";
            case IR_TYPE_INITIALIZED_INSTRUCTION -> "result";
            case IR_UNARY_INSTRUCTION -> "result,operand";
            case IR_UNREACHABLE -> "";
            case IR_VALUE_REFERENCE -> "type";
            case IR_VIRTUAL_CALL_INSTRUCTION -> "result,slot,returnType,arguments";
        };
    }

    /** @return the enum's constants in declaration order */
    public static String constants(Enumeration enumeration) {

        return switch (enumeration) {
            case IR_BINARY_OPERATOR -> "ADD,SUBTRACT,MULTIPLY,DIVIDE,REMAINDER,SHIFT_LEFT,SHIFT_RIGHT,UNSIGNED_SHIFT_RIGHT,BITWISE_AND,BITWISE_XOR,BITWISE_OR,EQUAL,NOT_EQUAL,SIGNED_LESS,SIGNED_LESS_EQUAL,SIGNED_GREATER,SIGNED_GREATER_EQUAL";
            case IR_BRIDGE_RESULT_STORE_INSTRUCTION__SLOT -> "VALUE,EXCEPTION";
            case IR_BYTE_VIEW_INSTRUCTION__OPERATION -> "LENGTH,READ_ONLY,READ,WRITE";
            case IR_CALL_KIND -> "DIRECT,DEVIRTUALIZED_VIRTUAL,DEVIRTUALIZED_INTERFACE";
            case IR_CALLABLE_KIND -> "METHOD,CONSTRUCTOR,DESTRUCTOR,CLASS_INITIALIZER,CONSTRUCTOR_ROLLBACK";
            case IR_CHARACTER_INSTRUCTION__OPERATION -> "DIGIT,LETTER,UPPER,LOWER,TO_UPPER,TO_LOWER,DIGIT_VALUE,NUMERIC_VALUE";
            case IR_FILE_INSTRUCTION__OPERATION -> "READ_ALL_BYTES,READ_STRING,WRITE_BYTES,WRITE_STRING,WRITE_CHARS,DELETE,CREATE_DIRECTORIES,COPY,MOVE,OPEN_DIRECTORY,DIRECTORY_HAS_NEXT,NEXT_DIRECTORY_ENTRY,CLOSE_DIRECTORY,READ_ATTRIBUTES,FILE_KIND,FILE_KIND_NOFOLLOW,FILE_SIZE,SAME_FILE,LAST_ERROR,CURRENT_DIRECTORY,NORMALIZE_SYNTAX,NORMALIZE_PATH,FILE_NAME,PARENT,RESOLVE,RESOLVE_SIBLING,ABSOLUTE_PATH";
            case IR_FLOATING_BITS_INSTRUCTION__OPERATION -> "FLOAT_TO_RAW_INT,INT_TO_FLOAT,DOUBLE_TO_RAW_LONG,LONG_TO_DOUBLE";
            case IR_MATH_BINARY_INSTRUCTION__OPERATION -> "ATAN2,POW,HYPOT";
            case IR_MATH_UNARY_INSTRUCTION__OPERATION -> "SIN,COS,TAN,EXP,LOG,LOG10,SQRT,CBRT,RINT";
            case IR_STREAM_INSTRUCTION__OPERATION -> "OPEN,READ_BYTE,READ_BYTES,WRITE_BYTE,WRITE_BYTES,AVAILABLE,POSITION,SEEK,LENGTH,SET_LENGTH,CLOSE,PRINT_BYTE,PRINT_BYTES";
            case IR_STRING_CONCAT_PART_KIND -> "STRING,BOOLEAN,CHARACTER,INTEGER,FLOAT,DOUBLE";
            case IR_SYSTEM_CLOCK_INSTRUCTION__CLOCK -> "CURRENT_TIME_MILLIS,NANO_TIME";
            case IR_TCP_INSTRUCTION__OPERATION -> "CREATE,BIND,CONNECT,LISTEN,ACCEPT,COMPLETE_CONNECT,READ_BYTE,TRY_READ_BYTE,READ_BYTES,TRY_READ_BYTES,PEEK_BYTES,WRITE_BYTE,WRITE_BYTES,URGENT,GET_TRAFFIC_CLASS,SET_TRAFFIC_CLASS,REUSE_PORT_SUPPORTED,AVAILABLE,SHUTDOWN,CLOSE,WAIT,BLOCKING,RESTORE_FLAGS,GET_BOOLEAN,SET_BOOLEAN,GET_INTEGER,SET_INTEGER,ENDPOINT,RESOLVE_START,RESOLVE_ADDRESS,RESOLVE_RELEASE,REVERSE_NAME,LOCAL_NAME,SCOPE_ID,PREFERRED_FAMILY,INTERFACES_START,INTERFACE_NEXT,INTERFACE_ADDRESS,INTERFACES_RELEASE,INTERFACE_FLAGS,INTERFACE_MTU,INTERFACE_HARDWARE,REACHABLE,ERROR_KIND";
            case IR_THROWABLE_TRACE_INSTRUCTION__OPERATION -> "CAPTURE,RELEASE,COMMON,PRINT,EMERGENCY,ARRAY";
            case IR_TLS_INSTRUCTION__OPERATION -> "CREATE,CONFIGURE,ATTACH,HANDSHAKE,READ_BYTE,READ_BYTES,WRITE_BYTE,WRITE_BYTES,AVAILABLE,WAIT,CLOSE";
            case IR_TYPE__KIND -> "I1,I8,I16,U16,I32,I64,F32,F64,VOID,NULL,EXCEPTION,REFERENCE,TYPE_PARAMETER,WILDCARD,ARRAY";
            case IR_TYPE__WILDCARD_KIND -> "UNBOUNDED,EXTENDS,SUPER";
            case IR_TYPE_KIND -> "CLASS,INTERFACE";
            case IR_UNARY_OPERATOR -> "NEGATE,NOT,BITWISE_COMPLEMENT";
        };
    }
}
