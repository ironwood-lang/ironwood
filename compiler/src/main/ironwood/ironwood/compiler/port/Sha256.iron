package ironwood.compiler.port;

/**
 * Compiler-private SHA-256 (FIPS 180-4), written independently from the
 * standard's algorithm description; the round constants and initial hash
 * value are the standard's definitions, recomputed from the cube and square
 * roots of the first primes. It replaces {@code MessageDigest} for the
 * compiler's exact digest consumers: ByteView declaration authority, Bridge
 * byte identities and file identities.
 *
 * <p>A digest owns its state, message schedule and one block buffer; updates
 * and {@link #digest(byte[], int)} allocate nothing. Finishing a digest pads
 * and processes the final block, produces the result and resets the state,
 * so one object can hash many inputs in turn. Inputs are borrowed only for
 * the duration of each call.
 */
public final class Sha256 {

    private static final int[] ROUND = {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    };

    private final int[] state;
    private final int[] schedule;
    private final byte[] block;
    private int buffered;
    private long total;

    /** Creates a reset digest: the object, its state, schedule and block buffer. */
    public Sha256() {

        this.state = new int[8];
        this.schedule = new int[64];
        this.block = new byte[64];
        reset();
    }

    /** Discards any partial input and restores the initial hash value. */
    public void reset() {

        this.state[0] = 0x6a09e667;
        this.state[1] = 0xbb67ae85;
        this.state[2] = 0x3c6ef372;
        this.state[3] = 0xa54ff53a;
        this.state[4] = 0x510e527f;
        this.state[5] = 0x9b05688c;
        this.state[6] = 0x1f83d9ab;
        this.state[7] = 0x5be0cd19;
        this.buffered = 0;
        this.total = 0;
    }

    /** Appends one byte, the low eight bits of the argument. */
    public void update(int value) {

        this.block[this.buffered] = (byte) value;
        this.buffered++;
        this.total++;
        if (this.buffered == 64) compress();
    }

    /**
     * Appends {@code count} bytes of {@code data} starting at {@code offset}.
     *
     * @throws NullPointerException if data is null
     * @throws IndexOutOfBoundsException if the range is outside data
     */
    public void update(byte[] data, int offset, int count) {

        if (data == null) throw new NullPointerException();
        if (offset < 0 || count < 0 || count > data.length - offset) throw new IndexOutOfBoundsException();
        for (int index = 0; index < count; index++) update(data[offset + index]);
    }

    /**
     * Appends the UTF-8 encoding of the text, as Java's
     * {@code getBytes(StandardCharsets.UTF_8)} produces it: a surrogate pair
     * becomes four bytes and an unpaired surrogate becomes {@code '?'}.
     *
     * @throws NullPointerException if text is null
     */
    public void updateUtf8(String text) {

        if (text == null) throw new NullPointerException();
        int length = text.length();
        int index = 0;
        while (index < length) {
            char unit = text.charAt(index);
            index++;
            if (unit < 0x80) {
                update(unit);
            } else if (unit < 0x800) {
                update(0xC0 | (unit >> 6));
                update(0x80 | (unit & 0x3F));
            } else if (unit >= 0xD800 && unit <= 0xDBFF && index < length
                    && text.charAt(index) >= 0xDC00 && text.charAt(index) <= 0xDFFF) {
                int point = 0x10000 + ((unit - 0xD800) << 10) + (text.charAt(index) - 0xDC00);
                index++;
                update(0xF0 | (point >> 18));
                update(0x80 | ((point >> 12) & 0x3F));
                update(0x80 | ((point >> 6) & 0x3F));
                update(0x80 | (point & 0x3F));
            } else if (unit >= 0xD800 && unit <= 0xDFFF) {
                update('?');
            } else {
                update(0xE0 | (unit >> 12));
                update(0x80 | ((unit >> 6) & 0x3F));
                update(0x80 | (unit & 0x3F));
            }
        }
    }

    /**
     * Finishes the digest into {@code result[offset..offset + 32)}, big-endian,
     * then resets. Nothing is allocated.
     *
     * @throws NullPointerException if result is null
     * @throws IndexOutOfBoundsException if fewer than 32 bytes remain at offset
     */
    public void digest(byte[] result, int offset) {

        if (result == null) throw new NullPointerException();
        if (offset < 0 || result.length - offset < 32) throw new IndexOutOfBoundsException();
        finish();
        for (int word = 0; word < 8; word++) {
            int value = this.state[word];
            result[offset + word * 4] = (byte) (value >>> 24);
            result[offset + word * 4 + 1] = (byte) (value >>> 16);
            result[offset + word * 4 + 2] = (byte) (value >>> 8);
            result[offset + word * 4 + 3] = (byte) value;
        }
        reset();
    }

    /** @return a fresh 32-byte digest, owned by the caller; the digest resets */
    public byte[] digest() {

        byte[] result = new byte[32];
        digest(result, 0);
        return result;
    }

    /**
     * @return a fresh 64-character lowercase hexadecimal digest, as
     *     {@code HexFormat.of().formatHex(digest())} renders it; the digest resets
     */
    public String hexDigest() {

        finish();
        char[] text = new char[64];
        defer free text;
        for (int word = 0; word < 8; word++) {
            int value = this.state[word];
            for (int nibble = 0; nibble < 8; nibble++) {
                text[word * 8 + nibble] = "0123456789abcdef".charAt((value >>> (28 - nibble * 4)) & 15);
            }
        }
        reset();
        return new String(text);
    }

    // Pads with 0x80, zeros and the 64-bit big-endian bit length.
    private void finish() {

        long bits = this.total * 8;
        update(0x80);
        while (this.buffered != 56) update(0);
        for (int shift = 56; shift >= 0; shift = shift - 8) update((int) (bits >>> shift));
    }

    private void compress() {

        for (int word = 0; word < 16; word++) {
            this.schedule[word] = (this.block[word * 4] & 0xFF) << 24 | (this.block[word * 4 + 1] & 0xFF) << 16
                    | (this.block[word * 4 + 2] & 0xFF) << 8 | this.block[word * 4 + 3] & 0xFF;
        }
        for (int word = 16; word < 64; word++) {
            int early = this.schedule[word - 15];
            int late = this.schedule[word - 2];
            int smallSigma0 = rotate(early, 7) ^ rotate(early, 18) ^ (early >>> 3);
            int smallSigma1 = rotate(late, 17) ^ rotate(late, 19) ^ (late >>> 10);
            this.schedule[word] = smallSigma1 + this.schedule[word - 7] + smallSigma0 + this.schedule[word - 16];
        }
        int a = this.state[0];
        int b = this.state[1];
        int c = this.state[2];
        int d = this.state[3];
        int e = this.state[4];
        int f = this.state[5];
        int g = this.state[6];
        int h = this.state[7];
        for (int round = 0; round < 64; round++) {
            int bigSigma1 = rotate(e, 6) ^ rotate(e, 11) ^ rotate(e, 25);
            int choose = (e & f) ^ (~e & g);
            int first = h + bigSigma1 + choose + ROUND[round] + this.schedule[round];
            int bigSigma0 = rotate(a, 2) ^ rotate(a, 13) ^ rotate(a, 22);
            int majority = (a & b) ^ (a & c) ^ (b & c);
            int second = bigSigma0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + first;
            d = c;
            c = b;
            b = a;
            a = first + second;
        }
        this.state[0] = this.state[0] + a;
        this.state[1] = this.state[1] + b;
        this.state[2] = this.state[2] + c;
        this.state[3] = this.state[3] + d;
        this.state[4] = this.state[4] + e;
        this.state[5] = this.state[5] + f;
        this.state[6] = this.state[6] + g;
        this.state[7] = this.state[7] + h;
        this.buffered = 0;
    }

    private static int rotate(int value, int distance) {

        return (value >>> distance) | (value << (32 - distance));
    }

    destructor {

        free this.block;
        free this.schedule;
        free this.state;
    }
}
