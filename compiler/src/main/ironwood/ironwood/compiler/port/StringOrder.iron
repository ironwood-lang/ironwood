package ironwood.compiler.port;

import ironwood.util.Comparator;

/**
 * Java's natural String order: lexicographic over UTF-16 code units, then
 * length. It replaces natural-order {@code TreeMap}/{@code TreeSet} keys and
 * {@code sorted()} over Strings; comparator-zero equals String equality, so a
 * hash container followed by sorting keeps their duplicate rules. Stateless:
 * one process-lived instance can serve every sort.
 */
public final class StringOrder implements Comparator<String> {

    @Override
    public int compare(String first, String second) {

        return first.compareTo(second);
    }
}
