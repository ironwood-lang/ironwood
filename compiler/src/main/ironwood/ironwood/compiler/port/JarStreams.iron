package ironwood.compiler.port;

import ironwood.io.IOException;

/**
 * {@code JarInputStream.getManifest()} for the Bridge's values companion
 * check (BridgeValuesLibrary.validate, B6, S7): the manifest is the first
 * entry, or the second when the first is a {@code META-INF/} directory,
 * named {@code META-INF/MANIFEST.MF} without regard to case
 * ({@code equalsIgnoreCase}); a manifest anywhere else is not found. The
 * entries are read in file order through {@link ZipStream}, inflating
 * DEFLATED data. Java's stream would also verify a signed jar, which the
 * companion never is. Inputs are borrowed.
 */
public final class JarStreams {

    private JarStreams() {

    }

    /**
     * @param jar the jar bytes; borrowed
     * @param inflate the decoder for DEFLATED data; borrowed
     * @param display the jar's name in container messages; borrowed
     * @return a fresh manifest owned by the caller, or null when there is none
     * @throws IOException for a malformed manifest (Java's message) or entry
     *     (the native container message)
     */
    public static JarManifest manifest(byte[] jar, Inflate inflate, String display) throws IOException {

        ZipStream stream = new ZipStream();
        defer free stream;
        byte[] bytes = manifestEntry(stream, jar, inflate, display);
        if (bytes == null) return null;
        defer free bytes;
        return new JarManifest(bytes, 0, bytes.length);
    }

    // The manifest entry's bytes, or null: the first entry, or the second
    // after a META-INF/ directory entry. An entry's bytes are released before
    // an allocation failure in a name check propagates.
    private static byte[] manifestEntry(ZipStream stream, byte[] jar, Inflate inflate, String display) throws IOException {

        byte[] first = stream.next(jar, inflate, display);
        if (first == null) return null;
        boolean directory = false;
        boolean manifest = false;
        try {
            directory = named(stream, 0, "META-INF/");
            manifest = !directory && named(stream, 0, "META-INF/MANIFEST.MF");
        } catch (OutOfMemoryError failure) {
            free first;
            throw failure;
        }
        if (manifest) return first;
        free first;
        if (!directory) return null;
        byte[] second = stream.next(jar, inflate, display);
        if (second == null) return null;
        boolean found = false;
        try {
            found = named(stream, 1, "META-INF/MANIFEST.MF");
        } catch (OutOfMemoryError failure) {
            free second;
            throw failure;
        }
        if (found) return second;
        free second;
        return null;
    }

    // Whether entry index is named name without regard to case.
    private static boolean named(ZipStream stream, int index, String name) {

        String spelling = stream.name(index);
        defer free spelling;
        return spelling.equalsIgnoreCase(name);
    }
}
