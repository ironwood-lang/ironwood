package ironwood.compiler.port;

import ironwood.ds.LinkedHashMap;

/**
 * Compiler-owned independent read-only keyed membership. Keys and values are
 * borrowed; destruction reclaims private storage and never frees either input.
 * Source mutation does not change this version. Lookup aliases conservatively
 * retain the snapshot until their last use. No iterator or mutable view escapes.
 */
public final class SnapshotLinkedMap<K extends Object, V extends Object> {

    private final LinkedHashMap<K, V> membership;

    /** Copies non-null source membership without touching its source cursor. */
    public SnapshotLinkedMap(LinkedHashMap<K, V> source) {

        if (source == null) throw new NullPointerException();
        this.membership = source.copy();
    }

    /** @return the fixed membership count, without allocation */
    public int size() {

        return this.membership.size();
    }

    /** @return whether this version is empty, without allocation */
    public boolean isEmpty() {

        return this.membership.isEmpty();
    }

    /** Returns the borrowed value or null for an absent non-null key. */
    public V get(K key) {

        return this.membership.get(key);
    }

    /** @return whether the non-null key belongs to this version */
    public boolean containsKey(K key) {

        return this.membership.containsKey(key);
    }

    destructor {

        free this.membership;
    }
}
