package ironwood.compiler.port;

/**
 * Compiler-local replacement for {@code Consumer} (API0610), as in
 * mutable lvalue writers. The action may retain its argument.
 *
 * @param <T> the reference argument type
 */
public interface Action<T extends Object> {

    /** Performs the action; failures propagate to the caller. */
    void accept(T value);
}
