package ironwood.compiler.port;

import ironwood.ds.HashSet;

/**
 * Compiler-owned independent read-only value membership, for Java
 * {@code Set.copyOf} sites that only query membership. Items are borrowed;
 * destruction reclaims private storage and never frees caller items. Source
 * mutation does not change this version. Lookups call the items' ordinary
 * {@code hashCode} and {@code equals}. No iterator or mutable view escapes:
 * Java leaves {@code Set.copyOf} iteration order unspecified, so a consumer
 * that traverses keeps a separate ordered member list (D257).
 */
public final class SnapshotSet<E extends Object> {

    private final HashSet<E> membership;

    /** Copies non-null source membership without touching its source cursor. */
    public SnapshotSet(HashSet<E> source) {

        if (source == null) throw new NullPointerException();
        this.membership = source.copy();
    }

    /** @return the fixed membership count, without allocation */
    public int size() {

        return this.membership.size();
    }

    /** @return whether this version is empty, without allocation */
    public boolean isEmpty() {

        return this.membership.isEmpty();
    }

    /** @return whether an equal non-null item belongs to this immutable version */
    public boolean contains(E item) {

        return this.membership.contains(item);
    }

    destructor {

        free this.membership;
    }
}
