package ironwood.pool;

/**
 * Owns reusable objects and lends them to callers through {@link #get()}.
 *
 * <p>The bundled implementations are single-threaded and intentionally retain
 * builder-created values, including checked-out objects. Checkout references
 * keep their objects alive independently under GC. Returning a value changes
 * its reuse state; it never closes native resources or resets object state.
 *
 * @param <E> the reference type of pooled objects
 */
public interface ObjectPool<E extends Object> {

    /**
     * Borrows an available object or creates a fresh pool-owned object.
     *
     * @return a non-null value checked out from this pool
     * @throws IllegalStateException if the builder returns null during checkout
     */
    E get();

    /**
     * Returns a checked-out object for reuse without changing its state.
     *
     * <p>Return each checkout at most once, only to its originating pool. Stop
     * using it until a later checkout. Duplicate returns are not checked and may
     * corrupt reuse. External objects are outside this contract: they are not
     * valid checkout results.
     *
     * @param instance the non-null checked-out object to make available
     * @throws IllegalArgumentException if the value is null
     */
    void release(E instance);
}
