package ironwood.pool;

/**
 * Reuses objects across linked array segments without copying existing slots.
 *
 * <p>This single-threaded pool retains every non-null builder result, including
 * checked-out objects. Return each checkout at most once and only to its
 * originating pool. Checkout and return do not reset state, close resources or
 * perform identity lookups. External objects are outside the return contract.
 *
 * <p>Growth adds a segment with twice the current length, capped at the maximum
 * array length. The creation array retains builder results and segment holders.
 * Reuse does not touch that array or allocate. Dropped managed graphs become
 * eligible for explicit collection. Builder results must be fresh and unescaped.
 *
 * @param <E> the reference type of pooled objects
 * @see ArrayObjectPool
 */
public final class MultiArrayObjectPool<E extends Object> implements ObjectPool<E> {

    private static final int GROWTH_FACTOR = 2;

    private static class ArrayHolder<E> {

        ArrayHolder<E> previous;
        private final E[] array;
        ArrayHolder<E> next;

        ArrayHolder(int length) {

            this.array = new E[length];
        }


    }

    private ArrayHolder<E> arrayHolder;
    private int pointer;
    private final ObjectBuilder<E> builder;
    // Retain created objects and segment holders independently of checkout state.
    private Object[] createdObjects;
    private int createdCount;

    /**
     * Creates a fully preloaded pool.
     * @param initialCapacity the positive initial segment length
     * @param builder the borrowed factory of fresh objects
     */
    public MultiArrayObjectPool(int initialCapacity, ObjectBuilder<E> builder) {

        this(initialCapacity, initialCapacity, builder);
    }

    /**
     * Creates a pool with the requested preload count.
     *
     * <p>The builder is called exactly {@code preloadCount} times. A null result
     * leaves an empty slot to retry on checkout. Builder exceptions propagate;
     * failed construction leaves a valid managed graph eligible for collection.
     *
     * @param initialCapacity the positive initial segment length
     * @param preloadCount the initial number of builder calls, from zero to capacity
     * @param builder the borrowed factory of fresh objects
     * @throws IllegalArgumentException if capacity or preload count is invalid
     */
    public MultiArrayObjectPool(int initialCapacity, int preloadCount, ObjectBuilder<E> builder) {

        check(initialCapacity, preloadCount);
        this.builder = builder;
        this.createdObjects = new Object[initialCapacity];
        arrayHolder = createArrayHolder(initialCapacity);
        for (int index = 0; index < preloadCount; index++) {
            E value = createObject();
            arrayHolder.array[index] = value;
        }
    }

    private void check(int initialCapacity, int preloadCount) {

        if (initialCapacity < 1) throw new IllegalArgumentException("initialCapacity must be greater than zero");
        if (preloadCount < 0) throw new IllegalArgumentException("preloadCount cannot be negative");
        if (preloadCount > initialCapacity) throw new IllegalArgumentException("preloadCount cannot be bigger than initialCapacity");
    }

    int getArrayLength() {

        return arrayHolder.array.length;
    }

    static int calculateNewArrayLength(int currentArrayLength) {

        if (currentArrayLength >= ArraySizing.MAX_ARRAY_LENGTH) return currentArrayLength;
        return ArraySizing.calculateNewLength(currentArrayLength, GROWTH_FACTOR);
    }

    private void ensureCreationCapacity() {

        if (this.createdCount == this.createdObjects.length) {
            int newLength = ArraySizing.calculateNewLength(this.createdObjects.length, 2.0f);
            Object[] oldArray = this.createdObjects;
            this.createdObjects = new Object[newLength];
            System.arraycopy(oldArray, 0, this.createdObjects, 0, oldArray.length);
        }
    }

    private ArrayHolder<E> createArrayHolder(int length) {

        ensureCreationCapacity();
        ArrayHolder<E> holder = new ArrayHolder<E>(length);
        this.createdObjects[this.createdCount++] = holder;
        return holder;
    }

    private E createObject() {

        // Reserve before calling the builder so allocation failure cannot lose
        // a successfully constructed object. Null preload results stay empty.
        ensureCreationCapacity();
        E object = this.builder.newInstance();
        if (object != null) this.createdObjects[this.createdCount++] = object;
        return object;
    }

    private final ArrayHolder<E> grow(boolean growRight) {

        int newLength = calculateNewArrayLength(arrayHolder.array.length);
        ArrayHolder<E> holder = createArrayHolder(newLength);
        if (growRight) {
            holder.previous = arrayHolder;
            arrayHolder.next = holder;
        } else {
            holder.next = arrayHolder;
            arrayHolder.previous = holder;
        }
        return holder;
    }

    /**
     * Checks out a value, creating one when its slot is empty.
     * @return a non-null checked-out managed value
     * @throws IllegalStateException if the builder returns null
     */
    @Override
    public final E get() {

        if (this.pointer == arrayHolder.array.length) {
            if (arrayHolder.next != null) {
                arrayHolder = arrayHolder.next;
            } else {
                arrayHolder = grow(true);
            }
            this.pointer = 0;
        }
        E value = arrayHolder.array[this.pointer];
        if (value == null) {
            value = buildObject();
        } else {
            arrayHolder.array[this.pointer] = null;
        }
        this.pointer++;
        return value;
    }

    private final E buildObject() {

        E object = createObject();
        if (object == null) throw new IllegalStateException("ObjectBuilder returned null");
        return object;
    }

    /**
     * Returns a checkout for reuse without changing its state.
     *
     * <p>Return each checkout at most once and only to its originating pool.
     * Duplicate returns are not checked. External objects are unsupported and
     * are outside the return contract.
     *
     * @param instance the non-null checked-out object
     * @throws IllegalArgumentException if the argument is null
     */
    @Override
    public final void release(E instance) {

        if (instance == null) throw new IllegalArgumentException("Cannot release null!");
        if (this.pointer == 0) {
            if (arrayHolder.previous != null) {
                arrayHolder = arrayHolder.previous;
            } else {
                arrayHolder = grow(false);
            }
            this.pointer = arrayHolder.array.length;
        }
        arrayHolder.array[--this.pointer] = instance;
    }


}
