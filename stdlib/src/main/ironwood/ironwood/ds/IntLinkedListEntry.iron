package ironwood.ds;

class IntLinkedListEntry {

    int value;
    IntLinkedListEntry next;
    IntLinkedListEntry previous;

    IntLinkedListEntry() {

        this.value = 0;
        this.next = null;
        this.previous = null;
    }
}
