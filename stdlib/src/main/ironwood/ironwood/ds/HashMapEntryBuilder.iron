package ironwood.ds;

import ironwood.pool.ObjectBuilder;

class HashMapEntryBuilder<K extends Object, E extends Object> implements ObjectBuilder<HashMapEntry<K, E>> {

    HashMapEntryBuilder() {

    }

    @Override
    public HashMapEntry<K, E> newInstance() {

        return new HashMapEntry<K, E>();
    }
}
