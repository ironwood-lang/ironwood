package ironwood.ds;

class IdentityHashMapEntry<K extends Object, E extends Object> {

    K key;
    E value;
    IdentityHashMapEntry<K, E> next;

    IdentityHashMapEntry() {

        this.key = null;
        this.value = null;
        this.next = null;
    }
}
