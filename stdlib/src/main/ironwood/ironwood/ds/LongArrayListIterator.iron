package ironwood.ds;

import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;

class LongArrayListIterator implements Iterator<LongHolder> {

    private LongArrayList owner;
    private LongArrayListHolder holder;
    private int currentIndex;
    private boolean canRemove;

    LongArrayListIterator(LongArrayList owner) {

        this.owner = owner;
        this.holder = new LongArrayListHolder();
        reset();
    }

    void reset() {

        this.currentIndex = 0;
        this.canRemove = false;
    }

    @Override
    public boolean hasNext() {

        return this.currentIndex < this.owner.size();
    }

    @Override
    public LongHolder next() {

        if (!hasNext()) throw new NoSuchElementException();
        long value = this.owner.get(this.currentIndex);
        this.currentIndex++;
        this.canRemove = true;
        return this.holder.set(value);
    }

    @Override
    public void remove() {

        if (!this.canRemove) throw new NoSuchElementException();
        this.currentIndex--;
        this.owner.remove(this.currentIndex);
        this.canRemove = false;
    }

    destructor {

        free this.holder;
    }
}
