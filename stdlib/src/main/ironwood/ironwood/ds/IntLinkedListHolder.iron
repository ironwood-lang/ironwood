package ironwood.ds;

class IntLinkedListHolder implements IntHolder {

    private int value;

    IntLinkedListHolder() {

        this.value = 0;
    }

    IntHolder set(int value) {

        this.value = value;
        return this;
    }

    @Override
    public int get() {

        return value;
    }
}
