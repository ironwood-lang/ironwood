package ironwood.ds;

import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;

class LinkedListIterator<E extends Object> implements Iterator<E> {

    private LinkedList<E> owner;
    private LinkedListEntry<E> nextEntry;
    private LinkedListEntry<E> currentEntry;

    LinkedListIterator(LinkedList<E> owner) {

        this.owner = owner;
        reset();
    }

    void reset() {

        this.nextEntry = this.owner.firstEntry();
        this.currentEntry = null;
    }

    @Override
    public boolean hasNext() {

        return this.nextEntry != null;
    }

    @Override
    public E next() {

        if (this.nextEntry == null) throw new NoSuchElementException();
        this.currentEntry = this.nextEntry;
        E result = this.nextEntry.value;
        this.nextEntry = this.nextEntry.next;
        return result;
    }

    @Override
    public void remove() {

        if (this.currentEntry == null) throw new NoSuchElementException();
        this.owner.removeEntry(this.currentEntry);
        this.currentEntry = null;
    }
}
