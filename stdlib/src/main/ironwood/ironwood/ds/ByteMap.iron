package ironwood.ds;

import ironwood.util.Iterator;
/** Maps byte keys to values. */

public class ByteMap<E extends Object> implements Iterable<E> {

    private E[] data;
    private ByteMapIterator<E> reusableIterator;
    private int count;
    private byte currentIteratorKey;
    /** Creates a new ByteMap. */

    public ByteMap() {

        this.data = new E[256];
        this.reusableIterator = new ByteMapIterator<E>(this);
        this.count = 0;
        this.currentIteratorKey = (byte) 0;
    }

    private int convert(byte key) {

        return key & 255;
    }
    /** Returns whether a value is associated with the supplied key. */

    public boolean containsKey(byte key) {

        int index = convert(key);
        return this.data[index] != null;
    }
    /** Returns whether the supplied value is present. */

    public boolean containsValue(E value) {

        if (value == null) return false;
        int index = 0;
        while (index < this.data.length) {
            E current = this.data[index];
            if (current != null && value.equals(current)) return true;
            index++;
        }
        return false;
    }
    /** Associates the supplied key with the supplied value. */

    public E put(byte key, E value) {

        ensureNotNull(value);
        int index = convert(key);
        E old = this.data[index];
        this.data[index] = value;
        if (old == null) this.count++;
        return old;
    }

    private void ensureNotNull(E value) {

        if (value == null) throw new IllegalArgumentException("Method cannot receive null value!");
    }
    /** Returns the requested value. */

    public E get(byte key) {

        int index = convert(key);
        return this.data[index];
    }
    /** Removes the requested value or entry. */

    public E remove(byte key) {

        int index = convert(key);
        E old = this.data[index];
        this.data[index] = null;
        if (old != null) this.count--;
        return old;
    }
    /** Returns the curr iterator key. */

    public byte getCurrIteratorKey() {

        return currentIteratorKey;
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return count == 0;
    }
    /** Removes all stored values. */

    public void clear() {

        int index = 0;
        while (index < this.data.length) {
            this.data[index] = null;
            index++;
        }
        this.count = 0;
    }
    /** Returns the number of stored values. */

    public int size() {

        return count;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof ByteMap<?>)) return false;
        ByteMap<?> other = (ByteMap<?>) otherObject;
        if (this.count != other.count) return false;
        int index = 0;
        while (index < this.data.length) {
            Object value = this.data[index];
            Object otherValue = other.data[index];
            if (value == null ? otherValue != null : !value.equals(otherValue)) return false;
            index++;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 0;
        int index = 0;
        while (index < this.data.length) {
            if (this.data[index] != null) hash += Byte.hashCode((byte) index) ^ this.data[index].hashCode();
            index++;
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        try {
            builder.append('{');
            boolean first = true;
            int index = 0;
            while (index < this.data.length) {
                if (this.data[index] != null) {
                    if (!first) builder.append(", ");
                    first = false;
                    builder.append((byte) index).append('=');
                    if (this.data[index] == this) {
                        builder.append("(this ByteMap)");
                    } else {
                        builder.append(this.data[index]);
                    }
                }
                index++;
            }
            builder.append('}');
            return builder.toString();
        } finally {
            free builder;
        }
    }

    int iteratorSize() {

        return count;
    }

    E iteratorElement(int index) {

        return this.data[index];
    }

    void iteratorVisited(int index) {

        this.currentIteratorKey = (byte) index;
    }

    void iteratorRemove(int index) {

        this.data[index] = null;
        this.count--;
    }

    destructor {

        free this.reusableIterator;
        free this.data;
    }
}
