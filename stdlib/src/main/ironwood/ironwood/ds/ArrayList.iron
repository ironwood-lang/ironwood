 * Modified for Ironwood: neutral package, generic native arrays, reusable
 * helpers, and deterministic reclamation of superseded backing arrays.
 */
package ironwood.ds;

import ironwood.util.Comparator;
import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;
/** Provides a resizable array-backed list. */

public class ArrayList<E extends Object> implements Iterable<E> {
    /** The default initial capacity. */

    public static final int DEFAULT_INITIAL_CAPACITY = 64;
    /** The default growth factor. */
    public static final float DEFAULT_GROWTH_FACTOR = 1.75f;
    // Ranges at most this long are insertion sorted; longer ranges merge.
    private static final int INSERTION_SORT_LIMIT = 16;

    private E[] array;
    private int currentSize;
    private int initialCapacity;
    private float growthFactor;
    private ArrayListIterator<E> reusableIterator;
    /** Creates a new ArrayList. */

    public ArrayList() {

        this(DEFAULT_INITIAL_CAPACITY, DEFAULT_GROWTH_FACTOR);
    }
    /** Creates a new ArrayList. */

    public ArrayList(int initialCapacity) {

        this(initialCapacity, DEFAULT_GROWTH_FACTOR);
    }
    /** Creates a new ArrayList. */

    public ArrayList(float growthFactor) {

        this(DEFAULT_INITIAL_CAPACITY, growthFactor);
    }
    /** Creates a new ArrayList. */

    public ArrayList(int initialCapacity, float growthFactor) {

        if (initialCapacity <= 0) throw new IllegalArgumentException("initialCapacity must be greater than zero");
        if (!Float.isFinite(growthFactor) || growthFactor <= 1.0f) throw new IllegalArgumentException("growthFactor must be finite and greater than one");
        this.array = new E[initialCapacity];
        this.currentSize = 0;
        this.initialCapacity = initialCapacity;
        this.growthFactor = growthFactor;
        this.reusableIterator = new ArrayListIterator<E>(this);
    }
    /** Returns the initial capacity. */

    public int getInitialCapacity() {

        return initialCapacity;
    }
    /** Returns the growth factor. */

    public float getGrowthFactor() {

        return growthFactor;
    }

    private void checkBounds(int index) {

        if (index < 0 || index >= this.currentSize) throw new IndexOutOfBoundsException();
    }

    private void ensureNotNull(E element) {

        if (element == null) throw new IllegalArgumentException("element cannot be null");
    }

    private void grow() {

        int oldCapacity = this.array.length;
        int newCapacity = Math.round(oldCapacity * this.growthFactor);
        if (newCapacity == oldCapacity) newCapacity = newCapacity + 1;

        E[] oldArray = this.array;
        this.array = new E[newCapacity];
        System.arraycopy(oldArray, 0, this.array, 0, this.currentSize);
        free oldArray;
    }

    /*
     * currentSize is the visibility boundary: inactive slots are never read,
     * and add/insert overwrite them before making them observable. Ironwood
     * has no tracing GC. A proven clear releases the compiler's caller-item
     * loans without destroying any items or scrubbing unobservable aliases.
     * Removal likewise leaves inactive slots unchanged.
     */
    /** Removes all stored values. */
    public void clear() {

        this.currentSize = 0;
    }
    /** Adds the supplied value. */

    public void add(E element) {

        ensureNotNull(element);
        if (this.currentSize == this.array.length) grow();
        this.array[this.currentSize] = element;
        this.currentSize = this.currentSize + 1;
    }
    /** Adds the supplied last. */

    public void addLast(E element) {

        add(element);
    }
    /** Adds the supplied first. */

    public void addFirst(E element) {

        insert(0, element);
    }
    /** Performs the remove first operation. */

    public E removeFirst() {

        if (this.currentSize == 0) throw new NoSuchElementException();
        return removeAt(0);
    }
    /** Performs the remove last operation. */

    public E removeLast() {

        if (this.currentSize == 0) throw new NoSuchElementException();
        this.currentSize = this.currentSize - 1;
        E result = this.array[this.currentSize];
        return result;
    }
    /** Inserts the supplied value. */

    public void insert(int index, E element) {

        if (index == this.currentSize) {
            addLast(element);
            return;
        }
        checkBounds(index);
        ensureNotNull(element);
        if (this.currentSize == this.array.length) grow();
        System.arraycopy(this.array, index, this.array, index + 1, this.currentSize - index);
        this.array[index] = element;
        this.currentSize = this.currentSize + 1;
    }
    /** Returns the requested value. */

    public E get(int index) {

        checkBounds(index);
        return this.array[index];
    }
    /** Sets the supplied value. */

    public E set(int index, E element) {

        checkBounds(index);
        ensureNotNull(element);
        E previous = this.array[index];
        this.array[index] = element;
        return previous;
    }
    /** Removes the requested value or entry. */

    public E remove(int index) {

        return removeAt(index);
    }

    E removeAt(int index) {

        checkBounds(index);
        E result = this.array[index];
        int shiftCount = this.currentSize - index - 1;
        if (shiftCount > 0) System.arraycopy(this.array, index + 1, this.array, index, shiftCount);
        this.currentSize = this.currentSize - 1;
        return result;
    }
    /** Returns whether the supplied value is present. */

    public boolean contains(E element) {

        return indexOf(element) >= 0;
    }
    /** Returns the first index of the supplied value. */

    public int indexOf(E element) {

        if (element == null) return -1;
        int index = 0;
        while (index < this.currentSize) {
            if (element.equals(this.array[index])) return index;
            index++;
        }
        return -1;
    }
    /** Returns the last index of the supplied value. */

    public int lastIndexOf(E element) {

        if (element == null) return -1;
        int index = this.currentSize - 1;
        while (index >= 0) {
            if (element.equals(this.array[index])) return index;
            index--;
        }
        return -1;
    }
    /** Removes the requested value or entry. */

    public boolean remove(E element) {

        if (element == null) return false;
        int index = 0;
        while (index < this.currentSize) {
            if (element.equals(this.array[index])) {
                removeAt(index);
                return true;
            }
            index++;
        }
        return false;
    }
    /**
     * Copies ordered membership into independent mutable storage.
     *
     * <p>The result owns its array and reusable iterator, with the default
     * growth factor and initial capacity equal to the larger of one and this
     * list's size. Unused source capacity is not copied.
     * Elements are borrowed, retain their identity and are never destroyed by
     * this operation or either list's destructor. Null elements cannot occur
     * in a valid list. The source iterator's position is unchanged.
     *
     * <p>This operation takes linear time and allocates one list, one iterator,
     * and one backing array for an ordinary list. On failure all result storage is
     * reclaimed and source membership is unchanged. Free the result only after
     * its last consumer; keep its borrowed elements alive until then.
     *
     * @return a fresh mutable list with the same ordered element references
     */
    public ArrayList<E> copy() {

        ArrayList<E> result = new ArrayList<E>(this.copyCapacity());
        try {
            for (int index = 0; index < this.size(); index++) {
                result.add(this.get(index));
            }
            return result;
        } catch (RuntimeException failure) {
            free result;
            throw failure;
        } catch (Error failure) {
            free result;
            throw failure;
        }
    }

    private int copyCapacity() {

        return this.currentSize > 0 ? this.currentSize : 1;
    }

    /**
     * Sorts the live elements stably with an explicit comparator.
     *
     * <p>Only indexes {@code [0, size())} are compared and reordered. Elements
     * the comparator considers equal keep their encounter order. Size,
     * capacity, growth factor and the reusable iterator's position are
     * unchanged, elements keep their identity and none is freed. The
     * comparator is required even for an empty list; unlike Java's
     * {@code List.sort}, there is no natural-order fallback.
     *
     * <p>The sort takes O(n log n) comparisons, or n - 1 for already sorted
     * input. Lists of at most sixteen elements are sorted without workspace;
     * a longer list allocates one private array of {@code size() / 2}
     * references and frees it before returning, also on failure. If the
     * comparator throws, the exception propagates and the list holds the same
     * elements in an unspecified order. A comparator that mutates this list
     * leaves its order unspecified; the comparator must not do so.
     *
     * @param comparator the ordering; it may retain or publish the elements it
     *     compares, so its actual effects govern their lifetime
     * @throws NullPointerException if {@code comparator} is null
     */
    public void sortWithComparator(Comparator<? super E> comparator) {

        if (comparator == null) throw new NullPointerException("comparator");
        int size = this.currentSize;
        if (size <= INSERTION_SORT_LIMIT) {
            insertionSort(0, size, comparator);
            return;
        }
        E[] scratch = new E[size / 2];
        defer free scratch;
        mergeSort(scratch, 0, size, comparator);
    }

    /*
     * The sort helpers re-read this.array on every access. A comparator that
     * grows the list replaces and frees the old array, so no array reference is
     * held across a comparator call. Each helper keeps the live range a
     * permutation of its elements even when the comparator throws.
     */
    private void insertionSort(int from, int to, Comparator<? super E> comparator) {

        for (int index = from + 1; index < to; index++) {
            E value = this.array[index];
            int position = index;
            try {
                while (position > from && comparator.compare(this.array[position - 1], value) > 0) {
                    this.array[position] = this.array[position - 1];
                    position--;
                }
            } finally {
                this.array[position] = value;
            }
        }
    }

    private void mergeSort(E[] scratch, int from, int to, Comparator<? super E> comparator) {

        if (to - from <= INSERTION_SORT_LIMIT) {
            insertionSort(from, to, comparator);
            return;
        }
        int middle = from + (to - from) / 2;
        mergeSort(scratch, from, middle, comparator);
        mergeSort(scratch, middle, to, comparator);
        if (comparator.compare(this.array[middle - 1], this.array[middle]) > 0) {
            merge(scratch, from, middle, to, comparator);
        }
    }

    private void merge(E[] scratch, int from, int middle, int to, Comparator<? super E> comparator) {

        int leftLength = middle - from;
        // An element loop: an arraycopy into a parameter array escapes it.
        for (int index = 0; index < leftLength; index++) scratch[index] = this.array[from + index];
        int left = 0;
        int right = middle;
        int target = from;
        try {
            while (left < leftLength && right < to) {
                if (comparator.compare(this.array[right], scratch[left]) < 0) {
                    this.array[target] = this.array[right];
                    right++;
                } else {
                    this.array[target] = scratch[left];
                    left++;
                }
                target++;
            }
        } finally {
            // The unmerged left elements fill exactly the free slots [target, right).
            System.arraycopy(scratch, left, this.array, target, leftLength - left);
        }
    }

    /** Returns the number of stored values. */

    public int size() {

        return currentSize;
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return currentSize == 0;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof ArrayList<?>)) return false;
        ArrayList<?> other = (ArrayList<?>) otherObject;
        if (this.currentSize != other.size()) return false;
        int index = 0;
        while (index < this.currentSize) {
            if (!this.array[index].equals(other.get(index))) return false;
            index = index + 1;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 1;
        int index = 0;
        while (index < this.currentSize) {
            hash = 31 * hash + this.array[index].hashCode();
            index = index + 1;
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        defer free builder;
        builder.append('[');
        int index = 0;
        while (index < this.currentSize) {
            if (index > 0) builder.append(", ");
            Object element = this.array[index];
            if (element == this) {
                builder.append("(this ArrayList)");
            } else {
                builder.append(element);
            }
            index = index + 1;
        }
        builder.append(']');
        return builder.toString();
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
        free this.array;
    }
}
