package ironwood.ds;

import ironwood.pool.ObjectBuilder;

class LinkedHashMapEntryBuilder<K extends Object, E extends Object> implements ObjectBuilder<LinkedHashMapEntry<K, E>> {

    LinkedHashMapEntryBuilder() {

    }

    @Override
    public LinkedHashMapEntry<K, E> newInstance() {

        return new LinkedHashMapEntry<K, E>();
    }
}
