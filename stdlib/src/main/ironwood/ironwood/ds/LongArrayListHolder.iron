package ironwood.ds;

class LongArrayListHolder implements LongHolder {

    private long value;

    LongArrayListHolder() {

        this.value = 0L;
    }

    LongHolder set(long value) {

        this.value = value;
        return this;
    }

    @Override
    public long get() {

        return value;
    }
}
