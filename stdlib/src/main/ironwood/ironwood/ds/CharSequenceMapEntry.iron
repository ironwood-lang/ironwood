package ironwood.ds;

class CharSequenceMapEntry<E extends Object> {

    private final StringBuilder keyBuilder;
    int hash;
    E value;
    CharSequenceMapEntry<E> next;

    CharSequenceMapEntry(int maxKeyLength) {

        this.keyBuilder = new StringBuilder(maxKeyLength);
        this.hash = 0;
        this.value = null;
        this.next = null;
    }

    final StringBuilder key() {

        // The entry owns this reusable key; callers receive a dependent borrow.
        return keyBuilder;
    }

    destructor {

        free this.keyBuilder;
    }
}
