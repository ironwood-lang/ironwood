package ironwood.ds;

import ironwood.pool.ObjectBuilder;

class LinkedListEntryBuilder<E extends Object> implements ObjectBuilder<LinkedListEntry<E>> {

    LinkedListEntryBuilder() {

    }

    @Override
    public LinkedListEntry<E> newInstance() {

        return new LinkedListEntry<E>();
    }
}
