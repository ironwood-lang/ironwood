package ironwood.ds;

import ironwood.pool.ObjectBuilder;

class ByteBufferMapEntryBuilder<E extends Object> implements ObjectBuilder<ByteBufferMapEntry<E>> {

    private int maxKeyLength;

    ByteBufferMapEntryBuilder(int maxKeyLength) {

        this.maxKeyLength = maxKeyLength;
    }

    @Override
    public ByteBufferMapEntry<E> newInstance() {

        return new ByteBufferMapEntry<E>(this.maxKeyLength);
    }
}
