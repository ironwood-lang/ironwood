 *
 * Modified for Ironwood: neutral package, heap-only copied keys, reusable
 * helpers, explicit builder, and deterministic reclamation of superseded
 * bucket arrays.
 */
package ironwood.ds;

import ironwood.nio.ByteBuffer;
import ironwood.pool.ArrayObjectPool;
import ironwood.pool.ObjectBuilder;
import ironwood.util.Iterator;
/** Maps byte-buffer keys to values. */

public class ByteBufferMap<E extends Object> implements Iterable<E> {
    /** The default initial capacity. */

    public static final int DEFAULT_INITIAL_CAPACITY = 128;
    /** The default load factor. */
    public static final float DEFAULT_LOAD_FACTOR = 0.80f;
    /** The default max key length. */
    public static final short DEFAULT_MAX_KEY_LENGTH = 256;

    private ByteBufferMapEntry<E>[] data;
    private int lengthMinusOne;
    private int length;
    private int initialCapacity;
    private int count;
    private int threshold;
    private float loadFactor;
    private ByteBuffer currentIteratorKey;
    private boolean isPowerOfTwo;
    private int maxKeyLength;
    // Keep the builder before the pool for reverse-order constructor rollback.
    private final ObjectBuilder<ByteBufferMapEntry<E>> entryBuilder;
    private final ArrayObjectPool<ByteBufferMapEntry<E>> entryPool;
    private ByteBufferMapIterator<E> reusableIterator;
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap() {

        this(DEFAULT_INITIAL_CAPACITY, DEFAULT_MAX_KEY_LENGTH, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap(int initialCapacity) {

        this(initialCapacity, DEFAULT_MAX_KEY_LENGTH, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap(int initialCapacity, short maxKeyLength) {

        this(initialCapacity, maxKeyLength, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap(int initialCapacity, float loadFactor) {

        this(initialCapacity, DEFAULT_MAX_KEY_LENGTH, loadFactor);
    }
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap(short maxKeyLength) {

        this(DEFAULT_INITIAL_CAPACITY, maxKeyLength, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap(short maxKeyLength, float loadFactor) {

        this(DEFAULT_INITIAL_CAPACITY, maxKeyLength, loadFactor);
    }
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap(float loadFactor) {

        this(DEFAULT_INITIAL_CAPACITY, DEFAULT_MAX_KEY_LENGTH, loadFactor);
    }
    /** Creates a new ByteBufferMap. */

    public ByteBufferMap(int initialCapacity, short maxKeyLength, float loadFactor) {

        if (initialCapacity <= 0) throw new IllegalArgumentException("initialCapacity must be greater than zero");
        if (maxKeyLength < 0) throw new IllegalArgumentException("maxKeyLength cannot be negative");
        if (!Float.isFinite(loadFactor) || loadFactor <= 0.0f) throw new IllegalArgumentException("loadFactor must be finite and greater than zero");
        this.initialCapacity = initialCapacity;
        this.isPowerOfTwo = MathUtils.isPowerOfTwo(initialCapacity);
        this.data = new ByteBufferMapEntry<E>[initialCapacity];
        this.lengthMinusOne = initialCapacity - 1;
        this.length = initialCapacity;
        this.loadFactor = loadFactor;
        this.threshold = Math.max(1, Math.round(initialCapacity * loadFactor));
        this.maxKeyLength = maxKeyLength;
        this.count = 0;
        this.currentIteratorKey = null;
        this.entryBuilder = new ByteBufferMapEntryBuilder<E>(maxKeyLength);
        this.entryPool = new ArrayObjectPool<ByteBufferMapEntry<E>>(this.threshold, this.entryBuilder, 2.0f);
        this.reusableIterator = new ByteBufferMapIterator<E>(this);
    }
    /** Returns the initial capacity. */

    public int getInitialCapacity() {

        return initialCapacity;
    }
    /** Returns the max key length. */

    public short getMaxKeyLength() {

        return (short) this.maxKeyLength;
    }
    /** Returns the load factor. */

    public float getLoadFactor() {

        return loadFactor;
    }

    private static int keyHashCode(byte[] source) {

        return keyHashCode(source, 0, source.length);
    }

    private static int keyHashCode(byte[] source, int start, int keyLength) {

        int hash = 0;
        int index = 0;
        while (index < keyLength) {
            hash = 31 * hash + source[start + index];
            index++;
        }
        return hash & 0x7FFFFFFF;
    }

    private static int keyHashCode(ByteBuffer source) {

        int sourcePosition = source.position();
        int keyLength = source.remaining();
        int hash = 0;
        int index = 0;
        while (index < keyLength) {
            hash = 31 * hash + source.get(sourcePosition + index);
            index++;
        }
        return hash & 0x7FFFFFFF;
    }

    private static boolean keyEquals(ByteBuffer internalKey, int internalKeyLength,
                                     byte[] externalKey, int externalKeyStart,
                                     int externalKeyLength) {

        if (internalKeyLength != externalKeyLength) return false;
        internalKey.limit(internalKeyLength).position(0);
        int index = 0;
        while (index < internalKeyLength) {
            if (internalKey.get(index) != externalKey[externalKeyStart + index]) return false;
            index++;
        }
        return true;
    }

    private static boolean keyEquals(ByteBuffer internalKey, int internalKeyLength,
                                     ByteBuffer externalKey) {

        if (internalKeyLength != externalKey.remaining()) return false;
        internalKey.limit(internalKeyLength).position(0);
        int externalPosition = externalKey.position();
        int index = 0;
        while (index < internalKeyLength) {
            if (internalKey.get(index) != externalKey.get(externalPosition + index)) return false;
            index++;
        }
        return true;
    }

    private static void appendKey(StringBuilder builder, ByteBuffer key) {

        builder.append('[');
        int keyPosition = key.position();
        int index = keyPosition;
        while (index < key.limit()) {
            if (index > keyPosition) builder.append(", ");
            builder.append(key.get(index));
            index++;
        }
        builder.append(']');
    }

    private static void ensureKeyNotNull(Object key) {

        if (key == null) throw new NullPointerException("key cannot be null");
    }

    private static void ensureValidRange(byte[] key, int start, int keyLength) {

        ensureKeyNotNull(key);
        if (start < 0 || keyLength < 0 || start > key.length - keyLength) throw new IndexOutOfBoundsException();
    }

    private void ensureNotNull(E value) {

        if (value == null) throw new IllegalArgumentException("value cannot be null");
    }

    private void ensureMaxKeyLength(int keyLength) {

        if (keyLength > this.maxKeyLength) throw new IllegalArgumentException("key is longer than maxKeyLength");
    }

    private int toArrayIndex(int hash) {

        if (this.isPowerOfTwo) return (hash & 0x7FFFFFFF) & this.lengthMinusOne;
        return (hash & 0x7FFFFFFF) % this.length;
    }

    private void releaseEntryBackToPool(ByteBufferMapEntry<E> entry) {

        // Reuse overwrites value and next before the entry is published again.
        this.entryPool.release(entry);
    }

    private void rehash() {

        int oldCapacity = this.data.length;
        ByteBufferMapEntry<E>[] oldData = this.data;
        int newCapacity = oldCapacity * 2;
        this.data = new ByteBufferMapEntry<E>[newCapacity];
        this.lengthMinusOne = newCapacity - 1;
        this.length = newCapacity;
        this.threshold = Math.max(1, Math.round(newCapacity * this.loadFactor));

        int oldIndex = oldCapacity - 1;
        while (oldIndex >= 0) {
            ByteBufferMapEntry<E> oldEntry = oldData[oldIndex];
            while (oldEntry != null) {
                ByteBufferMapEntry<E> entry = oldEntry;
                oldEntry = oldEntry.next;
                int newIndex = toArrayIndex(entry.hash);
                entry.next = this.data[newIndex];
                this.data[newIndex] = entry;
            }
            oldIndex--;
        }
        free oldData;
    }

    private ByteBufferMapEntry<E> findEntry(byte[] key, int start, int keyLength) {

        int hash = keyHashCode(key, start, keyLength);
        int index = toArrayIndex(hash);
        ByteBufferMapEntry<E> entry = this.data[index];
        while (entry != null) {
            if (entry.hash == hash
                    && keyEquals(entry.key(), entry.keyLength, key, start, keyLength)) {

                return entry;
            }
            entry = entry.next;
        }
        return null;
    }

    private ByteBufferMapEntry<E> findEntry(ByteBuffer key) {

        int hash = keyHashCode(key);
        int index = toArrayIndex(hash);
        ByteBufferMapEntry<E> entry = this.data[index];
        while (entry != null) {
            if (entry.hash == hash && keyEquals(entry.key(), entry.keyLength, key)) return entry;
            entry = entry.next;
        }
        return null;
    }
    /** Returns the number of stored values. */

    public int size() {

        return count;
    }
    /** Returns the curr iterator key. */

    public ByteBuffer getCurrIteratorKey() {

        return currentIteratorKey;
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return count == 0;
    }
    /** Returns whether a value is associated with the supplied key. */

    public boolean containsKey(byte[] key) {

        return get(key) != null;
    }
    /** Returns whether a value is associated with the supplied key. */

    public boolean containsKey(ByteBuffer key) {

        return get(key) != null;
    }
    /** Returns whether a value is associated with the supplied key. */

    public boolean containsKey(byte[] key, int start, int keyLength) {

        return get(key, start, keyLength) != null;
    }
    /** Returns whether the supplied value is present. */

    public boolean containsValue(E value) {

        if (value == null) return false;
        int index = 0;
        while (index < this.data.length) {
            ByteBufferMapEntry<E> entry = this.data[index];
            while (entry != null) {
                if (value.equals(entry.value)) return true;
                entry = entry.next;
            }
            index++;
        }
        return false;
    }
    /** Returns the requested value. */

    public E get(byte[] key) {

        ensureKeyNotNull(key);
        if (key.length > this.maxKeyLength) return null;
        ByteBufferMapEntry<E> entry = findEntry(key, 0, key.length);
        return entry == null ? null : entry.value;
    }
    /** Returns the requested value. */

    public E get(ByteBuffer key) {

        ensureKeyNotNull(key);
        if (key.remaining() > this.maxKeyLength) return null;
        ByteBufferMapEntry<E> entry = findEntry(key);
        return entry == null ? null : entry.value;
    }
    /** Returns the requested value. */

    public E get(byte[] key, int start, int keyLength) {

        ensureValidRange(key, start, keyLength);
        if (keyLength > this.maxKeyLength) return null;
        ByteBufferMapEntry<E> entry = findEntry(key, start, keyLength);
        return entry == null ? null : entry.value;
    }
    /** Associates the supplied key with the supplied value. */

    public E put(byte[] key, E value) {

        ensureKeyNotNull(key);
        return put(key, 0, key.length, value);
    }
    /** Associates the supplied key with the supplied value. */

    public E put(ByteBuffer key, E value) {

        ensureKeyNotNull(key);
        int keyLength = key.remaining();
        ensureMaxKeyLength(keyLength);
        ensureNotNull(value);
        int hash = keyHashCode(key);
        int dataIndex = toArrayIndex(hash);
        ByteBufferMapEntry<E> entry = this.data[dataIndex];
        while (entry != null) {
            if (entry.hash == hash && keyEquals(entry.key(), entry.keyLength, key)) {
                E oldValue = entry.value;
                entry.value = value;
                return oldValue;
            }
            entry = entry.next;
        }

        if (this.count >= this.threshold) {
            rehash();
            dataIndex = toArrayIndex(hash);
        }
        ByteBufferMapEntry<E> newEntry = this.entryPool.get();
        newEntry.keyLength = keyLength;
        newEntry.key().clear();
        int sourcePosition = key.position();
        int index = 0;
        while (index < keyLength) {
            newEntry.key().put(key.get(sourcePosition + index));
            index++;
        }
        newEntry.key().flip();
        newEntry.hash = hash;
        newEntry.value = value;
        newEntry.next = this.data[dataIndex];
        this.data[dataIndex] = newEntry;
        this.count++;
        return null;
    }
    /** Associates the supplied key with the supplied value. */

    public E put(byte[] key, int start, int keyLength, E value) {

        ensureValidRange(key, start, keyLength);
        ensureMaxKeyLength(keyLength);
        ensureNotNull(value);
        int hash = keyHashCode(key, start, keyLength);
        int dataIndex = toArrayIndex(hash);
        ByteBufferMapEntry<E> entry = this.data[dataIndex];
        while (entry != null) {
            if (entry.hash == hash
                    && keyEquals(entry.key(), entry.keyLength, key, start, keyLength)) {

                E oldValue = entry.value;
                entry.value = value;
                return oldValue;
            }
            entry = entry.next;
        }

        if (this.count >= this.threshold) {
            rehash();
            dataIndex = toArrayIndex(hash);
        }
        ByteBufferMapEntry<E> newEntry = this.entryPool.get();
        newEntry.keyLength = keyLength;
        newEntry.key().clear();
        newEntry.key().put(key, start, keyLength);
        newEntry.key().flip();
        newEntry.hash = hash;
        newEntry.value = value;
        newEntry.next = this.data[dataIndex];
        this.data[dataIndex] = newEntry;
        this.count++;
        return null;
    }
    /** Removes the requested value or entry. */

    public E remove(byte[] key) {

        ensureKeyNotNull(key);
        if (key.length > this.maxKeyLength) return null;
        return removeArrayKey(key, 0, key.length);
    }
    /** Removes the requested value or entry. */

    public E remove(ByteBuffer key) {

        ensureKeyNotNull(key);
        if (key.remaining() > this.maxKeyLength) return null;
        int hash = keyHashCode(key);
        int dataIndex = toArrayIndex(hash);
        ByteBufferMapEntry<E> entry = this.data[dataIndex];
        ByteBufferMapEntry<E> previous = null;
        while (entry != null) {
            if (entry.hash == hash && keyEquals(entry.key(), entry.keyLength, key)) {
                if (previous == null) {
                    this.data[dataIndex] = entry.next;
                } else {
                    previous.next = entry.next;
                }
                E oldValue = entry.value;
                releaseEntryBackToPool(entry);
                this.count--;
                return oldValue;
            }
            previous = entry;
            entry = entry.next;
        }
        return null;
    }
    /** Removes the requested value or entry. */

    public E remove(byte[] key, int start, int keyLength) {

        ensureValidRange(key, start, keyLength);
        if (keyLength > this.maxKeyLength) return null;
        return removeArrayKey(key, start, keyLength);
    }

    private E removeArrayKey(byte[] key, int start, int keyLength) {

        int hash = keyHashCode(key, start, keyLength);
        int dataIndex = toArrayIndex(hash);
        ByteBufferMapEntry<E> entry = this.data[dataIndex];
        ByteBufferMapEntry<E> previous = null;
        while (entry != null) {
            if (entry.hash == hash
                    && keyEquals(entry.key(), entry.keyLength, key, start, keyLength)) {

                if (previous == null) {
                    this.data[dataIndex] = entry.next;
                } else {
                    previous.next = entry.next;
                }
                E oldValue = entry.value;
                releaseEntryBackToPool(entry);
                this.count--;
                return oldValue;
            }
            previous = entry;
            entry = entry.next;
        }
        return null;
    }
    /** Removes all stored values. */

    public void clear() {

        int dataIndex = this.data.length - 1;
        while (dataIndex >= 0) {
            while (this.data[dataIndex] != null) {
                ByteBufferMapEntry<E> nextEntry = this.data[dataIndex].next;
                releaseEntryBackToPool(this.data[dataIndex]);
                this.data[dataIndex] = nextEntry;
            }
            dataIndex--;
        }
        this.count = 0;
        this.currentIteratorKey = null;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof ByteBufferMap<?>)) return false;
        ByteBufferMap<?> other = (ByteBufferMap<?>) otherObject;
        if (this.count != other.count) return false;
        Iterator<E> iterator = iterator();
        while (iterator.hasNext()) {
            E value = iterator.next();
            Object otherValue = other.get(this.currentIteratorKey);
            if (otherValue == null || !value.equals(otherValue)) return false;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 0;
        Iterator<E> iterator = iterator();
        while (iterator.hasNext()) {
            E value = iterator.next();
            hash += keyHashCode(this.currentIteratorKey) ^ value.hashCode();
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        try {
            builder.append('{');
            Iterator<E> iterator = iterator();
            boolean first = true;
            while (iterator.hasNext()) {
                Object value = iterator.next();
                if (!first) builder.append(", ");
                first = false;
                appendKey(builder, this.currentIteratorKey);
                builder.append('=');
                if (value == this) {
                    builder.append("(this ByteBufferMap)");
                } else {
                    builder.append(value);
                }
            }
            builder.append('}');
            return builder.toString();
        } finally {
            free builder;
        }
    }

    int iteratorSize() {

        return count;
    }

    ByteBufferMapEntry<E> iteratorBucket(int dataIndex) {

        return this.data[dataIndex];
    }

    void iteratorReset() {

        this.currentIteratorKey = null;
    }

    void iteratorVisited(ByteBufferMapEntry<E> entry) {

        this.currentIteratorKey = entry.key();
    }

    void removeIteratorEntry(int dataIndex, ByteBufferMapEntry<E> previous,
                             ByteBufferMapEntry<E> entry,
                             ByteBufferMapEntry<E> nextEntry) {

        if (previous == null) {
            this.data[dataIndex] = nextEntry;
        } else {
            previous.next = nextEntry;
        }
        this.currentIteratorKey = null;
        releaseEntryBackToPool(entry);
        this.count--;
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
        free this.data;
        free this.entryPool;
        free this.entryBuilder;
    }
}
