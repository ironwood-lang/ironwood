package ironwood.ds;

/** Utility methods for Ironwood data structures. */
public final class Collections {

    private Collections() {

    }
    /** Performs the unmodifiable list operation. */

    public static <E extends Object> UnmodifiableList<E> unmodifiableList(ArrayList<E> list) {

        return new UnmodifiableList<E>(list);
    }
}
