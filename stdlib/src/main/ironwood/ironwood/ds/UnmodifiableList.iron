package ironwood.ds;

import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;

/**
 * A read-only view of an {@link ArrayList}. Changes made through the backing
 * list remain visible through this view.
 */
public final class UnmodifiableList<E extends Object> implements Iterable<E> {

    private ArrayList<E> list;
    private ReadOnlyIterator<E> reusableIterator;

    UnmodifiableList(ArrayList<E> list) {

        if (list == null) throw new NullPointerException();
        this.list = list;
        this.reusableIterator = new ReadOnlyIterator<E>(this);
    }
    /** Returns the number of stored values. */

    public int size() {

        return this.list.size();
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return this.list.isEmpty();
    }
    /** Returns whether the supplied value is present. */

    public boolean contains(E element) {

        return this.list.contains(element);
    }
    /** Returns the requested value. */

    public E get(int index) {

        return this.list.get(index);
    }
    /** Returns the first index of the supplied value. */

    public int indexOf(E element) {

        return this.list.indexOf(element);
    }
    /** Returns the last index of the supplied value. */

    public int lastIndexOf(E element) {

        return this.list.lastIndexOf(element);
    }
    /** Sets the supplied value. */

    public E set(int index, E element) {

        throw new UnsupportedOperationException();
    }
    /** Adds the supplied value. */

    public void add(E element) {

        throw new UnsupportedOperationException();
    }
    /** Removes all stored values. */

    public void clear() {

        throw new UnsupportedOperationException();
    }
    /** Removes the requested value or entry. */

    public E remove(int index) {

        throw new UnsupportedOperationException();
    }
    /** Removes the requested value or entry. */

    public boolean remove(E element) {

        throw new UnsupportedOperationException();
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
    }

    private static class ReadOnlyIterator<T extends Object> implements Iterator<T> {

        private UnmodifiableList<T> owner;
        private int index;

        ReadOnlyIterator(UnmodifiableList<T> owner) {

            this.owner = owner;
            this.index = 0;
        }

        void reset() {

            this.index = 0;
        }

        @Override
        public boolean hasNext() {

            return this.index < this.owner.size();
        }

        @Override
        public T next() {

            if (!hasNext()) throw new NoSuchElementException();
            T value = this.owner.get(this.index);
            this.index++;
            return value;
        }

        @Override
        public void remove() {

            throw new UnsupportedOperationException();
        }
    }
}
