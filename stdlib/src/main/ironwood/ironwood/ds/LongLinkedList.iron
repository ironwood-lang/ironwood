package ironwood.ds;

import ironwood.pool.ObjectBuilder;
import ironwood.pool.MultiArrayObjectPool;
import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;
/** Provides a linked list of long values. */

public class LongLinkedList implements Iterable<LongHolder> {

    // Keep the builder before the pool for reverse-order constructor rollback.
    private final ObjectBuilder<LongLinkedListEntry> entryBuilder;
    private final MultiArrayObjectPool<LongLinkedListEntry> entryPool;
    private int initialCapacity;
    private LongLinkedListEntry head;
    private LongLinkedListEntry tail;
    private int size;
    private LongLinkedListIterator reusableIterator;
    /** Creates a new LongLinkedList. */

    public LongLinkedList(int initialCapacity) {

        this.initialCapacity = initialCapacity;
        this.entryBuilder = new LongLinkedListEntryBuilder();
        this.entryPool = new MultiArrayObjectPool<LongLinkedListEntry>(initialCapacity, this.entryBuilder);
        this.head = null;
        this.tail = null;
        this.size = 0;
        this.reusableIterator = new LongLinkedListIterator(this);
    }
    /** Returns the initial capacity. */

    public int getInitialCapacity() {

        return initialCapacity;
    }

    private LongLinkedListEntry getEntryFromPool() {

        return this.entryPool.get();
    }

    private void releaseEntryBackToPool(LongLinkedListEntry entry) {

        entry.previous = null;
        entry.next = null;
        this.entryPool.release(entry);
    }
    /** Removes all stored values. */

    public void clear() {

        while (this.head != null) {
            LongLinkedListEntry saveNext = this.head.next;
            releaseEntryBackToPool(this.head);
            this.head = saveNext;
        }
        this.tail = null;
        this.size = 0;
    }
    /** Adds the supplied first. */

    public void addFirst(long value) {

        LongLinkedListEntry entry = getEntryFromPool();
        entry.value = value;
        if (this.head == null) {
            this.head = entry;
            this.tail = entry;
        } else {
            entry.next = this.head;
            this.head.previous = entry;
            this.head = entry;
        }
        this.size++;
    }
    /** Adds the supplied value. */

    public void add(long value) {

        addLast(value);
    }
    /** Adds the supplied last. */

    public void addLast(long value) {

        LongLinkedListEntry entry = getEntryFromPool();
        entry.value = value;
        if (this.tail == null) {
            this.tail = entry;
            this.head = entry;
        } else {
            entry.previous = this.tail;
            this.tail.next = entry;
            this.tail = entry;
        }
        this.size++;
    }
    /** Performs the first operation. */

    public long first() {

        if (this.head == null) throw new NoSuchElementException();
        return this.head.value;
    }
    /** Performs the remove first operation. */

    public long removeFirst() {

        if (this.head == null) throw new NoSuchElementException();
        LongLinkedListEntry entry = this.head;
        this.head = this.head.next;
        if (this.head != null) this.head.previous = null;
        long value = entry.value;
        releaseEntryBackToPool(entry);
        this.size--;
        if (this.size == 0) this.tail = null;
        return value;
    }
    /** Performs the last operation. */

    public long last() {

        if (this.tail == null) throw new NoSuchElementException();
        return this.tail.value;
    }
    /** Performs the remove last operation. */

    public long removeLast() {

        if (this.tail == null) throw new NoSuchElementException();
        LongLinkedListEntry entry = this.tail;
        this.tail = this.tail.previous;
        if (this.tail != null) this.tail.next = null;
        long value = entry.value;
        releaseEntryBackToPool(entry);
        this.size--;
        if (this.size == 0) this.head = null;
        return value;
    }
    /** Returns whether the supplied value is present. */

    public boolean contains(long value) {

        LongLinkedListEntry entry = this.head;
        while (entry != null) {
            if (entry.value == value) return true;
            entry = entry.next;
        }
        return false;
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return size == 0;
    }
    /** Returns the number of stored values. */

    public int size() {

        return size;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof LongLinkedList)) return false;
        LongLinkedList other = (LongLinkedList) otherObject;
        if (this.size != other.size) return false;
        LongLinkedListEntry entry = this.head;
        LongLinkedListEntry otherEntry = other.head;
        while (entry != null) {
            if (entry.value != otherEntry.value) return false;
            entry = entry.next;
            otherEntry = otherEntry.next;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 1;
        LongLinkedListEntry entry = this.head;
        while (entry != null) {
            hash = 31 * hash + Long.hashCode(entry.value);
            entry = entry.next;
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        try {
            builder.append('[');
            LongLinkedListEntry entry = this.head;
            while (entry != null) {
                if (entry != this.head) builder.append(", ");
                builder.append(entry.value);
                entry = entry.next;
            }
            builder.append(']');
            return builder.toString();
        } finally {
            free builder;
        }
    }

    LongLinkedListEntry iteratorHead() {

        return head;
    }

    void removeIteratorEntry(LongLinkedListEntry entry) {

        if (entry == this.tail) {
            removeLast();
        } else if (entry == this.head) {

            removeFirst();
        } else {
            entry.previous.next = entry.next;
            entry.next.previous = entry.previous;
            releaseEntryBackToPool(entry);
            this.size--;
        }
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<LongHolder> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
        free this.entryPool;
        free this.entryBuilder;
    }
}
