package ironwood.ds;

import ironwood.util.Iterator;

class IntSetIterator implements Iterator<IntHolder> {

    private IntSet owner;
    private Iterator<Object> iterator;
    private IntSetHolder holder;

    IntSetIterator(IntSet owner) {

        this.owner = owner;
        this.holder = new IntSetHolder();
        reset();
    }

    void reset() {

        this.iterator = this.owner.backingIterator();
    }

    @Override
    public boolean hasNext() {

        return this.iterator.hasNext();
    }

    @Override
    public IntHolder next() {

        this.iterator.next();
        return this.holder.set(this.owner.currentIteratorValue());
    }

    @Override
    public void remove() {

        this.iterator.remove();
    }

    destructor {

        free this.holder;
    }
}
