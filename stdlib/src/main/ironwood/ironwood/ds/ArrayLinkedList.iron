package ironwood.ds;

import ironwood.util.Iterator;
/** Provides an array-backed linked list. */

public class ArrayLinkedList<E extends Object> implements Iterable<E> {

    private E[] array;
    private LinkedList<E> linkedList;
    private int count;
    private ArrayLinkedListIterator<E> reusableIterator;
    /** Creates a new ArrayLinkedList. */

    public ArrayLinkedList(int arraySize) {

        this.array = new E[arraySize];
        this.linkedList = new LinkedList<E>(arraySize);
        this.count = 0;
        this.reusableIterator = new ArrayLinkedListIterator<E>(this);
    }
    /** Returns the array size. */

    public int getArraySize() {

        return this.array.length;
    }
    /** Adds the supplied last. */

    public void addLast(E entry) {

        if (entry == null) throw new IllegalArgumentException("entry cannot be null");
        if (this.count >= this.array.length) {
            this.linkedList.addLast(entry);
        } else {
            this.array[this.count] = entry;
        }
        this.count = this.count + 1;
    }
    /** Performs the remove last operation. */

    public E removeLast() {

        if (this.count == 0) return null;
        E result = null;
        if (this.count > this.array.length) {
            result = this.linkedList.removeLast();
        } else {
            int index = this.count - 1;
            result = this.array[index];
            this.array[index] = null;
        }
        this.count = this.count - 1;
        return result;
    }
    /** Returns the number of stored values. */

    public int size() {

        return count;
    }
    /** Returns whether the supplied value is present. */

    public boolean contains(E value) {

        if (value == null) return false;
        int arrayCount = Math.min(this.count, this.array.length);
        int index = 0;
        while (index < arrayCount) {
            if (value.equals(this.array[index])) return true;
            index++;
        }
        return this.linkedList.contains(value);
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof ArrayLinkedList<?>)) return false;
        ArrayLinkedList<?> other = (ArrayLinkedList<?>) otherObject;
        if (this.count != other.size()) return false;
        Iterator<E> iterator = iterator();
        Iterator<?> otherIterator = other.iterator();
        while (iterator.hasNext()) {
            if (!iterator.next().equals(otherIterator.next())) return false;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 1;
        Iterator<E> iterator = iterator();
        while (iterator.hasNext()) {
            hash = 31 * hash + iterator.next().hashCode();
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        builder.append('[');
        Iterator<E> overflowIterator = this.linkedList.iterator();
        int index = 0;
        boolean firstElement = true;
        while (index < this.count) {
            Object element = null;
            if (index < this.array.length) {
                element = this.array[index];
            } else {
                element = overflowIterator.next();
            }
            if (!firstElement) builder.append(", ");
            firstElement = false;
            if (element == this) {
                builder.append("(this ArrayLinkedList)");
            } else {
                builder.append(element);
            }
            index++;
        }
        builder.append(']');
        return builder.toString();
    }

    /** Removes membership and clears every obsolete physical reference. */
    public void clear() {

        this.linkedList.clear();
        this.count = 0;
        clearUnusedReferences();
    }

    /** Retains fixed-array references for deliberate reuse; overflow entries are recycled. */
    public void resetForReuse() {

        this.linkedList.clear();
        this.count = 0;
    }

    /** Clears inactive fixed capacity without changing active values. */
    public void clearUnusedReferences() {

        for (int index = Math.min(this.count, this.array.length); index < this.array.length; index++) {
            this.array[index] = null;
        }
    }

    /** Compatibility spelling: false explicitly retains fixed-array references. */
    public void clear(boolean nullifyLiveArrayPrefix) {

        if (nullifyLiveArrayPrefix) clear();
        else resetForReuse();
    }

    E arrayElement(int index) {

        return this.array[index];
    }

    Iterator<E> overflowIterator() {

        return this.linkedList.iterator();
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }


}
