package ironwood.ds;

class LongLinkedListEntry {

    long value;
    LongLinkedListEntry next;
    LongLinkedListEntry previous;

    LongLinkedListEntry() {

        this.value = 0L;
        this.next = null;
        this.previous = null;
    }
}
