package ironwood.ds;

class HashMapEntry<K extends Object, E extends Object> {

    K key;
    int hash;
    E value;
    HashMapEntry<K, E> next;

    HashMapEntry() {

        this.key = null;
        this.hash = 0;
        this.value = null;
        this.next = null;
    }
}
