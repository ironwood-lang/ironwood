package ironwood.ds;

import ironwood.util.Iterator;

class HashSetIterator<E extends Object> implements Iterator<E> {

    private HashSet<E> owner;
    private Iterator<Object> mapIterator;

    HashSetIterator(HashSet<E> owner) {

        this.owner = owner;
        reset();
    }

    void reset() {

        this.mapIterator = this.owner.setValueIterator();
    }

    @Override
    public boolean hasNext() {

        return this.mapIterator.hasNext();
    }

    @Override
    public E next() {

        this.mapIterator.next();
        return this.owner.setCurrentIteratorElement();
    }

    @Override
    public void remove() {

        this.mapIterator.remove();
    }
}
