package ironwood.ds;
/** Provides mathematical helper operations. */

public class MathUtils {

    private MathUtils() {

    }
    /** Returns whether this value is power of two. */

    public static boolean isPowerOfTwo(long value) {

        return value > 0L && (value & (value - 1L)) == 0L;
    }
    /** Performs the ensure power of two operation. */

    public static void ensurePowerOfTwo(long value) {

        if (!isPowerOfTwo(value)) throw new IllegalArgumentException("Not a power of two");
    }
}
