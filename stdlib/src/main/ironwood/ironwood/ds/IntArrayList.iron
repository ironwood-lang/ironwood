 * Modified for Ironwood: neutral package, reusable helpers, and deterministic
 * reclamation of superseded backing arrays.
 */
package ironwood.ds;

import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;
/** Provides an array-backed list of integer values. */

public class IntArrayList implements Iterable<IntHolder> {
    /** The default initial capacity. */

    public static final int DEFAULT_INITIAL_CAPACITY = 64;
    /** The default growth factor. */
    public static final float DEFAULT_GROWTH_FACTOR = 1.75f;

    private int[] array;
    private int size;
    private int initialCapacity;
    private float growthFactor;
    private IntArrayListIterator reusableIterator;
    /** Creates a new IntArrayList. */

    public IntArrayList() {

        this(DEFAULT_INITIAL_CAPACITY, DEFAULT_GROWTH_FACTOR);
    }
    /** Creates a new IntArrayList. */

    public IntArrayList(int initialCapacity) {

        this(initialCapacity, DEFAULT_GROWTH_FACTOR);
    }
    /** Creates a new IntArrayList. */

    public IntArrayList(float growthFactor) {

        this(DEFAULT_INITIAL_CAPACITY, growthFactor);
    }
    /** Creates a new IntArrayList. */

    public IntArrayList(int initialCapacity, float growthFactor) {

        if (initialCapacity <= 0) throw new IllegalArgumentException("Initial capacity must be positive");
        if (!Float.isFinite(growthFactor) || growthFactor <= 1.0f) throw new IllegalArgumentException("Growth factor must be finite and greater than one");
        this.array = new int[initialCapacity];
        this.size = 0;
        this.initialCapacity = initialCapacity;
        this.growthFactor = growthFactor;
        this.reusableIterator = new IntArrayListIterator(this);
    }
    /** Returns the initial capacity. */

    public int getInitialCapacity() {

        return initialCapacity;
    }
    /** Returns the growth factor. */

    public float getGrowthFactor() {

        return growthFactor;
    }

    private void checkBounds(int index) {

        if (index < 0 || index >= this.size) throw new IndexOutOfBoundsException();
    }

    private void grow() {

        int oldCapacity = this.array.length;
        int newCapacity = Math.round(oldCapacity * this.growthFactor);
        if (newCapacity == oldCapacity) newCapacity++;
        int[] oldArray = this.array;
        this.array = new int[newCapacity];
        System.arraycopy(oldArray, 0, this.array, 0, this.size);
        free oldArray;
    }
    /** Removes all stored values. */

    public void clear() {

        this.size = 0;
    }
    /** Adds the supplied value. */

    public void add(int element) {

        if (this.size == this.array.length) grow();
        this.array[this.size] = element;
        this.size++;
    }
    /** Adds the supplied last. */

    public void addLast(int element) {

        add(element);
    }
    /** Adds the supplied first. */

    public void addFirst(int element) {

        insert(0, element);
    }
    /** Performs the remove first operation. */

    public int removeFirst() {

        if (this.size == 0) throw new NoSuchElementException();
        return remove(0);
    }
    /** Performs the remove last operation. */

    public int removeLast() {

        if (this.size == 0) throw new NoSuchElementException();
        this.size--;
        return this.array[this.size];
    }
    /** Inserts the supplied value. */

    public void insert(int index, int element) {

        if (index == this.size) {
            addLast(element);
            return;
        }
        checkBounds(index);
        if (this.size == this.array.length) grow();
        System.arraycopy(this.array, index, this.array, index + 1, this.size - index);
        this.array[index] = element;
        this.size++;
    }
    /** Returns the requested value. */

    public int get(int index) {

        checkBounds(index);
        return this.array[index];
    }
    /** Sets the supplied value. */

    public int set(int index, int element) {

        checkBounds(index);
        int previous = this.array[index];
        this.array[index] = element;
        return previous;
    }
    /** Removes the requested value or entry. */

    public int remove(int index) {

        checkBounds(index);
        int oldValue = this.array[index];
        int toShiftLeft = this.size - index - 1;
        if (toShiftLeft > 0) System.arraycopy(this.array, index + 1, this.array, index, toShiftLeft);
        this.size--;
        return oldValue;
    }
    /** Returns whether the supplied value is present. */

    public boolean contains(int element) {

        return indexOf(element) >= 0;
    }
    /** Returns the first index of the supplied value. */

    public int indexOf(int element) {

        int index = 0;
        while (index < this.size) {
            if (this.array[index] == element) return index;
            index++;
        }
        return -1;
    }
    /** Returns the last index of the supplied value. */

    public int lastIndexOf(int element) {

        int index = this.size - 1;
        while (index >= 0) {
            if (this.array[index] == element) return index;
            index--;
        }
        return -1;
    }
    /** Returns the number of stored values. */

    public int size() {

        return size;
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return size == 0;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof IntArrayList)) return false;
        IntArrayList other = (IntArrayList) otherObject;
        if (this.size != other.size) return false;
        int index = 0;
        while (index < this.size) {
            if (this.array[index] != other.array[index]) return false;
            index++;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 1;
        int index = 0;
        while (index < this.size) {
            hash = 31 * hash + Integer.hashCode(this.array[index]);
            index++;
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        try {
            builder.append('[');
            int index = 0;
            while (index < this.size) {
                if (index > 0) builder.append(", ");
                builder.append(this.array[index]);
                index++;
            }
            builder.append(']');
            return builder.toString();
        } finally {
            free builder;
        }
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<IntHolder> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
        free this.array;
    }
}
