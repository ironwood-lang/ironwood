 * Modified for Ironwood: neutral package, pooled helpers, generic native
 * arrays, and deterministic reclamation of superseded bucket arrays.
 */
package ironwood.ds;

import ironwood.pool.ArrayObjectPool;
import ironwood.pool.ObjectBuilder;
import ironwood.util.Iterator;
/** Maps long keys to values. */

public class LongMap<E extends Object> implements Iterable<E> {
    /** The default initial capacity. */

    public static final int DEFAULT_INITIAL_CAPACITY = 128;
    /** The default load factor. */
    public static final float DEFAULT_LOAD_FACTOR = 0.80f;

    private LongMapEntry<E>[] data;
    private int lengthMinusOne;
    private int length;
    private int initialCapacity;
    private boolean powerOfTwo;
    private int count;
    private int threshold;
    private float loadFactor;
    // Keep the builder before the pool for reverse-order constructor rollback.
    private final ObjectBuilder<LongMapEntry<E>> entryBuilder;
    private final ArrayObjectPool<LongMapEntry<E>> entryPool;
    private LongMapIterator<E> reusableIterator;
    private long currentIteratorKey;
    /** Creates a new LongMap. */

    public LongMap() {

        this(DEFAULT_INITIAL_CAPACITY, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new LongMap. */

    public LongMap(int initialCapacity) {

        this(initialCapacity, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new LongMap. */

    public LongMap(int initialCapacity, float loadFactor) {

        if (initialCapacity <= 0) throw new IllegalArgumentException("initialCapacity must be greater than zero");
        if (!Float.isFinite(loadFactor) || loadFactor <= 0.0f) throw new IllegalArgumentException("loadFactor must be finite and greater than zero");
        this.initialCapacity = initialCapacity;
        this.powerOfTwo = MathUtils.isPowerOfTwo(initialCapacity);
        this.data = new LongMapEntry<E>[initialCapacity];
        this.lengthMinusOne = initialCapacity - 1;
        this.length = initialCapacity;
        this.loadFactor = loadFactor;
        this.threshold = Math.max(1, Math.round(initialCapacity * loadFactor));
        this.count = 0;
        this.currentIteratorKey = 0L;
        this.entryBuilder = new LongMapEntryBuilder<E>();
        this.entryPool = new ArrayObjectPool<LongMapEntry<E>>(this.threshold, this.entryBuilder, 2.0f);
        this.reusableIterator = new LongMapIterator<E>(this);
    }
    /** Returns the initial capacity. */

    public int getInitialCapacity() {

        return initialCapacity;
    }
    /** Returns the load factor. */

    public float getLoadFactor() {

        return loadFactor;
    }

    int getCurrentArrayLength() {

        return this.data.length;
    }

    private LongMapEntry<E> getEntryFromPool(long key, E value, LongMapEntry<E> next) {

        LongMapEntry<E> entry = this.entryPool.get();
        entry.key = key;
        entry.value = value;
        entry.next = next;
        return entry;
    }

    private void releaseEntryBackToPool(LongMapEntry<E> entry) {

        // getEntryFromPool overwrites every field before it can be observed.
        this.entryPool.release(entry);
    }

    private void ensureNotNull(E value) {

        if (value == null) throw new IllegalArgumentException("value cannot be null");
    }
    /** Returns the curr iterator key. */

    public long getCurrIteratorKey() {

        return currentIteratorKey;
    }
    /** Returns the number of stored values. */

    public int size() {

        return count;
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return count == 0;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof LongMap<?>)) return false;
        LongMap<?> other = (LongMap<?>) otherObject;
        if (this.count != other.size()) return false;
        Iterator<E> iterator = iterator();
        while (iterator.hasNext()) {
            E value = iterator.next();
            Object otherValue = other.get(this.currentIteratorKey);
            if (otherValue == null || !value.equals(otherValue)) return false;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 0;
        Iterator<E> iterator = iterator();
        while (iterator.hasNext()) {
            E value = iterator.next();
            hash = hash + (Long.hashCode(this.currentIteratorKey) ^ value.hashCode());
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        try {
            builder.append('{');
            Iterator<E> iterator = iterator();
            boolean first = true;
            while (iterator.hasNext()) {
                Object value = iterator.next();
                if (!first) builder.append(", ");
                first = false;
                builder.append(this.currentIteratorKey).append('=');
                if (value == this) {
                    builder.append("(this LongMap)");
                } else {
                    builder.append(value);
                }
            }
            builder.append('}');
            return builder.toString();
        } finally {
            free builder;
        }
    }

    private int toArrayIndex(long key) {

        int hash = (int) (key ^ (key >>> 32));
        if (this.powerOfTwo) return (hash & 0x7FFFFFFF) & this.lengthMinusOne;
        return (hash & 0x7FFFFFFF) % this.length;
    }
    /** Returns whether a value is associated with the supplied key. */

    public boolean containsKey(long key) {

        int index = toArrayIndex(key);
        LongMapEntry<E> entry = this.data[index];
        while (entry != null) {
            if (entry.key == key) return true;
            entry = entry.next;
        }
        return false;
    }
    /** Returns whether the supplied value is present. */

    public boolean containsValue(E value) {

        if (value == null) return false;
        int index = 0;
        while (index < this.data.length) {
            LongMapEntry<E> entry = this.data[index];
            while (entry != null) {
                if (value.equals(entry.value)) return true;
                entry = entry.next;
            }
            index++;
        }
        return false;
    }
    /** Returns the requested value. */

    public E get(long key) {

        int index = toArrayIndex(key);
        LongMapEntry<E> entry = this.data[index];
        while (entry != null) {
            if (entry.key == key) return entry.value;
            entry = entry.next;
        }
        return null;
    }

    private void rehash() {

        int oldCapacity = this.data.length;
        LongMapEntry<E>[] oldData = this.data;
        int newCapacity = oldCapacity * 2;
        this.data = new LongMapEntry<E>[newCapacity];
        this.lengthMinusOne = newCapacity - 1;
        this.length = newCapacity;
        this.threshold = Math.max(1, Math.round(newCapacity * this.loadFactor));

        int index = oldCapacity - 1;
        while (index >= 0) {
            LongMapEntry<E> old = oldData[index];
            while (old != null) {
                LongMapEntry<E> entry = old;
                old = old.next;
                int newIndex = toArrayIndex(entry.key);
                entry.next = this.data[newIndex];
                this.data[newIndex] = entry;
            }
            index = index - 1;
        }
        free oldData;
    }
    /** Associates the supplied key with the supplied value. */

    public E put(long key, E value) {

        ensureNotNull(value);
        int index = toArrayIndex(key);
        LongMapEntry<E> entry = this.data[index];
        while (entry != null) {
            if (entry.key == key) {
                E oldValue = entry.value;
                entry.value = value;
                return oldValue;
            }
            entry = entry.next;
        }
        if (this.count >= this.threshold) {
            rehash();
            index = toArrayIndex(key);
        }
        LongMapEntry<E> inserted = getEntryFromPool(key, value, this.data[index]);
        this.data[index] = inserted;
        this.count = this.count + 1;
        return null;
    }
    /** Removes the requested value or entry. */

    public E remove(long key) {

        int index = toArrayIndex(key);
        LongMapEntry<E> entry = this.data[index];
        LongMapEntry<E> previous = null;
        while (entry != null) {
            if (entry.key == key) {
                if (previous != null) {
                    previous.next = entry.next;
                } else {
                    this.data[index] = entry.next;
                }
                E oldValue = entry.value;
                releaseEntryBackToPool(entry);
                this.count = this.count - 1;
                return oldValue;
            }
            previous = entry;
            entry = entry.next;
        }
        return null;
    }
    /** Removes all stored values. */

    public void clear() {

        int index = this.data.length - 1;
        while (index >= 0) {
            while (this.data[index] != null) {
                LongMapEntry<E> next = this.data[index].next;
                releaseEntryBackToPool(this.data[index]);
                this.data[index] = next;
            }
            index = index - 1;
        }
        this.count = 0;
    }

    int iteratorSize() {

        return count;
    }

    LongMapEntry<E> iteratorBucket(int index) {

        return this.data[index];
    }

    void iteratorVisited(long key) {

        this.currentIteratorKey = key;
    }

    void iteratorRemove(int dataIndex, LongMapEntry<E> previous,
                        LongMapEntry<E> next, LongMapEntry<E> entry) {

        if (previous == null) {
            this.data[dataIndex] = next;
        } else {
            previous.next = next;
        }
        releaseEntryBackToPool(entry);
        this.count = this.count - 1;
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
        free this.data;
        free this.entryPool;
        free this.entryBuilder;
    }
}
