package ironwood.ds;

import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;

class ByteMapIterator<E extends Object> implements Iterator<E> {

    private ByteMap<E> owner;
    private int index;
    private int position;
    private int size;

    ByteMapIterator(ByteMap<E> owner) {

        this.owner = owner;
        reset();
    }

    void reset() {

        this.index = 0;
        this.position = 0;
        this.size = this.owner.iteratorSize();
    }

    @Override
    public boolean hasNext() {

        return this.position < this.size;
    }

    @Override
    public E next() {

        if (this.position >= this.size) throw new NoSuchElementException();
        E value = null;
        while (value == null) {
            value = this.owner.iteratorElement(this.index);
            this.index++;
        }
        this.owner.iteratorVisited(this.index - 1);
        this.position++;
        return value;
    }

    @Override
    public void remove() {

        if (this.index == 0 || this.owner.iteratorElement(this.index - 1) == null) throw new NoSuchElementException();
        this.owner.iteratorRemove(this.index - 1);
    }
}
