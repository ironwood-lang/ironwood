 * Modified for Ironwood: neutral package, reusable helpers, explicit builder,
 * and deterministic reclamation of superseded bucket arrays.
 */
package ironwood.ds;

import ironwood.pool.ArrayObjectPool;
import ironwood.pool.ObjectBuilder;
import ironwood.util.Iterator;
/** Maps keys to values while preserving insertion order. */

public class LinkedHashMap<K extends Object, E extends Object> implements Iterable<E> {
    /** The default initial capacity. */

    public static final int DEFAULT_INITIAL_CAPACITY = 128;
    /** The default load factor. */
    public static final float DEFAULT_LOAD_FACTOR = 0.80f;

    private LinkedHashMapEntry<K, E>[] data;
    private int lengthMinusOne;
    private int length;
    private int initialCapacity;
    private boolean isPowerOfTwo;
    private int count;
    private int threshold;
    private float loadFactor;
    // Keep the builder before the pool for reverse-order constructor rollback.
    private final ObjectBuilder<LinkedHashMapEntry<K, E>> entryBuilder;
    private final ArrayObjectPool<LinkedHashMapEntry<K, E>> entryPool;
    private LinkedHashMapEntry<K, E> head;
    private LinkedHashMapEntry<K, E> tail;
    private LinkedHashMapIterator<K, E> reusableIterator;
    private K currentIteratorKey;
    /** Creates a new LinkedHashMap. */

    public LinkedHashMap() {

        this(DEFAULT_INITIAL_CAPACITY, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new LinkedHashMap. */

    public LinkedHashMap(int initialCapacity) {

        this(initialCapacity, DEFAULT_LOAD_FACTOR);
    }
    /** Creates a new LinkedHashMap. */

    public LinkedHashMap(int initialCapacity, float loadFactor) {

        if (initialCapacity <= 0) throw new IllegalArgumentException("initialCapacity must be greater than zero");
        if (!Float.isFinite(loadFactor) || loadFactor <= 0.0f) throw new IllegalArgumentException("loadFactor must be finite and greater than zero");
        this.initialCapacity = initialCapacity;
        this.isPowerOfTwo = MathUtils.isPowerOfTwo(initialCapacity);
        this.data = new LinkedHashMapEntry<K, E>[initialCapacity];
        this.lengthMinusOne = initialCapacity - 1;
        this.length = initialCapacity;
        this.loadFactor = loadFactor;
        this.threshold = Math.max(1, Math.round(initialCapacity * loadFactor));
        this.entryBuilder = new LinkedHashMapEntryBuilder<K, E>();
        this.entryPool = new ArrayObjectPool<LinkedHashMapEntry<K, E>>(this.threshold, this.entryBuilder, 2.0f);
        this.head = null;
        this.tail = null;
        this.count = 0;
        this.currentIteratorKey = null;
        this.reusableIterator = new LinkedHashMapIterator<K, E>(this);
    }
    /** Returns the initial capacity. */

    public int getInitialCapacity() {

        return initialCapacity;
    }
    /** Returns the load factor. */

    public float getLoadFactor() {

        return loadFactor;
    }

    int getCurrentArrayLength() {

        return this.data.length;
    }

    private int toArrayIndex(int hash) {

        if (this.isPowerOfTwo) return (hash & 0x7FFFFFFF) & this.lengthMinusOne;
        return (hash & 0x7FFFFFFF) % this.length;
    }

    private void ensureNotNull(Object value) {

        if (value == null) throw new IllegalArgumentException("key and value cannot be null");
    }

    private LinkedHashMapEntry<K, E> findEntry(Object key) {

        ensureNotNull(key);
        int hash = key.hashCode();
        int index = toArrayIndex(hash);
        LinkedHashMapEntry<K, E> entry = this.data[index];
        while (entry != null) {
            if (entry.hash == hash && entry.key.equals(key)) return entry;
            entry = entry.next;
        }
        return null;
    }

    Object getObjectKey(Object key) {

        LinkedHashMapEntry<K, E> entry = findEntry(key);
        if (entry == null) return null;
        return entry.value;
    }

    private LinkedHashMapEntry<K, E> getEntryFromPool(K key, int hash, E value,
                                                   LinkedHashMapEntry<K, E> next) {

        LinkedHashMapEntry<K, E> entry = this.entryPool.get();
        entry.key = key;
        entry.hash = hash;
        entry.value = value;
        entry.next = next;
        return entry;
    }

    private void releaseEntryBackToPool(LinkedHashMapEntry<K, E> entry) {

        // User fields are overwritten before reuse; ordering links are not.
        entry.before = null;
        entry.after = null;
        this.entryPool.release(entry);
    }

    private void addToInsertionOrder(LinkedHashMapEntry<K, E> entry) {

        if (this.tail == null) {
            this.head = entry;
            this.tail = entry;
        } else {
            entry.before = this.tail;
            this.tail.after = entry;
            this.tail = entry;
        }
    }

    private void removeFromInsertionOrder(LinkedHashMapEntry<K, E> entry) {

        if (entry.before == null) {
            this.head = entry.after;
        } else {
            entry.before.after = entry.after;
        }
        if (entry.after == null) {
            this.tail = entry.before;
        } else {
            entry.after.before = entry.before;
        }
    }

    private void rehash() {

        int oldCapacity = this.data.length;
        LinkedHashMapEntry<K, E>[] oldData = this.data;
        int newCapacity = oldCapacity * 2;
        this.data = new LinkedHashMapEntry<K, E>[newCapacity];
        this.lengthMinusOne = newCapacity - 1;
        this.length = newCapacity;
        this.threshold = Math.max(1, Math.round(newCapacity * this.loadFactor));

        int oldIndex = oldCapacity - 1;
        while (oldIndex >= 0) {
            LinkedHashMapEntry<K, E> oldEntry = oldData[oldIndex];
            while (oldEntry != null) {
                LinkedHashMapEntry<K, E> entry = oldEntry;
                oldEntry = oldEntry.next;
                int newIndex = toArrayIndex(entry.hash);
                entry.next = this.data[newIndex];
                this.data[newIndex] = entry;
            }
            oldIndex--;
        }
        free oldData;
    }
    /** Returns the curr iterator key. */

    public K getCurrIteratorKey() {

        return currentIteratorKey;
    }
    /** Returns the number of stored values. */

    public int size() {

        return count;
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return count == 0;
    }
    /** Returns whether a value is associated with the supplied key. */

    public boolean containsKey(K key) {

        return findEntry(key) != null;
    }
    /** Returns whether the supplied value is present. */

    public boolean containsValue(E value) {

        if (value == null) return false;
        LinkedHashMapEntry<K, E> entry = this.head;
        while (entry != null) {
            if (value.equals(entry.value)) return true;
            entry = entry.after;
        }
        return false;
    }
    /** Returns the requested value. */

    public E get(K key) {

        LinkedHashMapEntry<K, E> entry = findEntry(key);
        if (entry == null) return null;
        return entry.value;
    }
    /** Associates the supplied key with the supplied value. */

    public E put(K key, E value) {

        ensureNotNull(key);
        ensureNotNull(value);
        int hash = key.hashCode();
        int dataIndex = toArrayIndex(hash);
        LinkedHashMapEntry<K, E> entry = this.data[dataIndex];
        while (entry != null) {
            if (entry.hash == hash && entry.key.equals(key)) {
                E oldValue = entry.value;
                entry.value = value;
                return oldValue;
            }
            entry = entry.next;
        }

        if (this.count >= this.threshold) {
            rehash();
            dataIndex = toArrayIndex(hash);
        }
        LinkedHashMapEntry<K, E> newEntry = getEntryFromPool(key, hash, value, this.data[dataIndex]);
        this.data[dataIndex] = newEntry;
        addToInsertionOrder(newEntry);
        this.count++;
        return null;
    }
    /** Removes the requested value or entry. */

    public E remove(K key) {

        ensureNotNull(key);
        int hash = key.hashCode();
        int dataIndex = toArrayIndex(hash);
        LinkedHashMapEntry<K, E> entry = this.data[dataIndex];
        LinkedHashMapEntry<K, E> previous = null;
        while (entry != null) {
            if (entry.hash == hash && entry.key.equals(key)) {
                if (previous == null) {
                    this.data[dataIndex] = entry.next;
                } else {
                    previous.next = entry.next;
                }
                removeFromInsertionOrder(entry);
                E oldValue = entry.value;
                if (this.currentIteratorKey == entry.key) this.currentIteratorKey = null;
                releaseEntryBackToPool(entry);
                this.count--;
                return oldValue;
            }
            previous = entry;
            entry = entry.next;
        }
        return null;
    }
    /** Removes all stored values. */

    public void clear() {

        int dataIndex = this.data.length - 1;
        while (dataIndex >= 0) {
            while (this.data[dataIndex] != null) {
                LinkedHashMapEntry<K, E> nextEntry = this.data[dataIndex].next;
                releaseEntryBackToPool(this.data[dataIndex]);
                this.data[dataIndex] = nextEntry;
            }
            dataIndex--;
        }
        this.head = null;
        this.tail = null;
        this.count = 0;
        this.currentIteratorKey = null;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof LinkedHashMap<?, ?>)) return false;
        LinkedHashMap<?, ?> other = (LinkedHashMap<?, ?>) otherObject;
        if (this.count != other.count) return false;
        LinkedHashMapEntry<K, E> entry = this.head;
        while (entry != null) {
            Object otherValue = other.getObjectKey(entry.key);
            if (otherValue == null || !entry.value.equals(otherValue)) return false;
            entry = entry.after;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 0;
        LinkedHashMapEntry<K, E> entry = this.head;
        while (entry != null) {
            hash += entry.key.hashCode() ^ entry.value.hashCode();
            entry = entry.after;
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        try {
            builder.append('{');
            LinkedHashMapEntry<K, E> entry = this.head;
            while (entry != null) {
                if (entry != this.head) builder.append(", ");
                Object key = entry.key;
                Object value = entry.value;
                if (key == this) {
                    builder.append("(this LinkedHashMap)");
                } else {
                    builder.append(key);
                }
                builder.append('=');
                if (value == this) {
                    builder.append("(this LinkedHashMap)");
                } else {
                    builder.append(value);
                }
                entry = entry.after;
            }
            builder.append('}');
            return builder.toString();
        } finally {
            free builder;
        }
    }

    int iteratorSize() {

        return count;
    }

    LinkedHashMapEntry<K, E> iteratorHead() {

        return head;
    }

    void iteratorReset() {

        this.currentIteratorKey = null;
    }

    void iteratorVisited(K key) {

        this.currentIteratorKey = key;
    }

    void removeIteratorEntry(LinkedHashMapEntry<K, E> entry) {

        int dataIndex = toArrayIndex(entry.hash);
        LinkedHashMapEntry<K, E> current = this.data[dataIndex];
        LinkedHashMapEntry<K, E> previous = null;
        while (current != entry) {
            previous = current;
            current = current.next;
        }
        if (previous == null) {
            this.data[dataIndex] = entry.next;
        } else {
            previous.next = entry.next;
        }
        removeFromInsertionOrder(entry);
        this.currentIteratorKey = null;
        releaseEntryBackToPool(entry);
        this.count--;
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
        free this.data;
        free this.entryPool;
        free this.entryBuilder;
    }
}
