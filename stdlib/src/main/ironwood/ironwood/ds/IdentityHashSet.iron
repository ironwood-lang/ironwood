 *
 * Modified for Ironwood: neutral package, flattened reusable iterator, and
 * Object-based wildcard membership used by identity equality.
 */
package ironwood.ds;

import ironwood.util.Iterator;
/** Stores unique values by reference identity. */

public class IdentityHashSet<E extends Object> implements Iterable<E> {

    private IdentityHashMap<E, E> map;
    private IdentityHashSetIterator<E> reusableIterator;
    /** Creates a new IdentityHashSet. */

    public IdentityHashSet(int initialCapacity, float loadFactor) {

        this.map = new IdentityHashMap<E, E>(initialCapacity, loadFactor);
        this.reusableIterator = new IdentityHashSetIterator<E>(this);
    }
    /** Creates a new IdentityHashSet. */

    public IdentityHashSet(int initialCapacity) {

        this.map = new IdentityHashMap<E, E>(initialCapacity);
        this.reusableIterator = new IdentityHashSetIterator<E>(this);
    }
    /** Creates a new IdentityHashSet. */

    public IdentityHashSet() {

        this.map = new IdentityHashMap<E, E>();
        this.reusableIterator = new IdentityHashSetIterator<E>(this);
    }
    /** Returns the initial capacity. */

    public int getInitialCapacity() {

        return this.map.getInitialCapacity();
    }
    /** Returns the load factor. */

    public float getLoadFactor() {

        return this.map.getLoadFactor();
    }
    /** Returns the number of stored values. */

    public int size() {

        return this.map.size();
    }
    /** Returns whether this value is empty. */

    public boolean isEmpty() {

        return this.map.isEmpty();
    }
    /** Returns whether the supplied value is present. */

    public boolean contains(E value) {

        return this.map.containsKey(value);
    }

    boolean containsObject(Object value) {

        return this.map.getObjectKey(value) != null;
    }
    /** Adds the supplied value. */

    public boolean add(E value) {

        return this.map.put(value, value) == null;
    }
    /** Removes the requested value or entry. */

    public boolean remove(E value) {

        return this.map.remove(value) != null;
    }
    /** Removes all stored values. */

    public void clear() {

        this.map.clear();
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object otherObject) {

        if (otherObject == this) return true;
        if (!(otherObject instanceof IdentityHashSet<?>)) return false;
        IdentityHashSet<?> other = (IdentityHashSet<?>) otherObject;
        if (size() != other.size()) return false;
        Iterator<E> iterator = iterator();
        while (iterator.hasNext()) {
            if (!other.containsObject(iterator.next())) return false;
        }
        return true;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        int hash = 0;
        Iterator<E> iterator = iterator();
        while (iterator.hasNext()) {
            hash = hash + System.identityHashCode(iterator.next());
        }
        return hash;
    }
    /** Returns a textual representation of this value. */

    @Override
    public String toString() {

        StringBuilder builder = new StringBuilder();
        try {
            builder.append('[');
            Iterator<E> iterator = this.map.iterator();
            boolean first = true;
            while (iterator.hasNext()) {
                Object element = iterator.next();
                if (!first) builder.append(", ");
                first = false;
                if (element == this) {
                    builder.append("(this IdentityHashSet)");
                } else {
                    builder.append(element);
                }
            }
            builder.append(']');
            return builder.toString();
        } finally {
            free builder;
        }
    }

    Iterator<E> identitySetValueIterator() {

        return this.map.iterator();
    }
    /** Returns an iterator over this value's elements. */

    @Override
    public Iterator<E> iterator() {

        reusableIterator.reset();
        return reusableIterator;
    }

    destructor {

        free this.reusableIterator;
        free this.map;
    }
}
