package ironwood.ds;

import ironwood.nio.ByteBuffer;

class ByteBufferMapEntry<E extends Object> {

    private final ByteBuffer keyBuffer;
    int keyLength;
    int hash;
    E value;
    ByteBufferMapEntry<E> next;

    ByteBufferMapEntry(int maxKeyLength) {

        this.keyBuffer = ByteBuffer.allocate(maxKeyLength);
        this.keyLength = 0;
        this.hash = 0;
        this.value = null;
        this.next = null;
    }

    final ByteBuffer key() {

        // The entry owns this reusable key; callers receive a dependent borrow.
        return keyBuffer;
    }

    destructor {

        free this.keyBuffer;
    }
}
