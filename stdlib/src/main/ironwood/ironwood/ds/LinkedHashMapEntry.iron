package ironwood.ds;

class LinkedHashMapEntry<K extends Object, E extends Object> {

    K key;
    int hash;
    E value;
    LinkedHashMapEntry<K, E> next;
    LinkedHashMapEntry<K, E> before;
    LinkedHashMapEntry<K, E> after;

    LinkedHashMapEntry() {

        this.key = null;
        this.hash = 0;
        this.value = null;
        this.next = null;
        this.before = null;
        this.after = null;
    }
}
