package ironwood.ds;

class LinkedListEntry<E extends Object> {

    E value;
    LinkedListEntry<E> next;
    LinkedListEntry<E> previous;

    LinkedListEntry() {

        this.value = null;
        this.next = null;
        this.previous = null;
    }
}
