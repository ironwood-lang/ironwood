package ironwood.ds;

import ironwood.pool.ObjectBuilder;

class IdentityHashMapEntryBuilder<K extends Object, E extends Object> implements ObjectBuilder<IdentityHashMapEntry<K, E>> {

    IdentityHashMapEntryBuilder() {

    }

    @Override
    public IdentityHashMapEntry<K, E> newInstance() {

        return new IdentityHashMapEntry<K, E>();
    }
}
