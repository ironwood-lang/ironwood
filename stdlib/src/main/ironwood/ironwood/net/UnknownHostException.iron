package ironwood.net;

import ironwood.io.IOException;

/**
 * Reports an invalid numeric address or a host that cannot be resolved. Message text is copied;
 * it is independent of later caller input changes.
 */
public class UnknownHostException extends IOException {

    private String detail;

    /**
     * Creates an exception without a detail message.
     */
    public UnknownHostException() {

        super();
    }

    /**
     * Creates an exception with a copy of the supplied detail message.
     *
     * @param message the managed message to copy, or null
     */
    public UnknownHostException(String message) {

        super();
        if (message != null) this.detail = new String(message);
    }

    /**
     * Returns this exception's managed detail text.
     *
     * @return borrowed message text, or null when no message was supplied
     */
    @Override
    public String getMessage() {

        return this.detail;
    }


}
