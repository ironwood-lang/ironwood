package ironwood.net;

/**
 * Immutable IP endpoint with a port and either a copied address or an unresolved host label.
 * Constructors copy retained inputs. Address and name getters return borrowed values; toString
 * returns fresh text. Resolution is synchronous when requested at construction; unresolved values
 * do not resolve themselves later.
 */
public final class InetSocketAddress extends SocketAddress {

    private final InetAddress address;
    private final String unresolvedName;
    private final int port;
    private int unresolvedHash;
    private boolean hashComputed;

    /**
     * Creates a wildcard endpoint in the preferred address family.
     *
     * @param port 0 through 65535; zero requests an ephemeral port when binding
     * @throws IllegalArgumentException if port is outside 0 through 65535
     */
    public InetSocketAddress(int port) {

        this((InetAddress) null, port);
    }

    /**
     * Creates an endpoint with an independent copy of the address, without DNS.
     *
     * @param address the address to copy, or null for a wildcard
     * @param port 0 through 65535
     * @throws IllegalArgumentException if port is outside 0 through 65535
     */
    public InetSocketAddress(InetAddress address, int port) {

        if (port < 0 || port > 65535) throw new IllegalArgumentException("Invalid port");
        this.port = port;
        this.unresolvedName = null;
        if (address == null) {
            this.address = InetAddress.wildcard();
        } else {
            this.address = address.copy();
        }
    }

    /**
     * Attempts synchronous resolution and retains an unresolved copy of the hostname if resolution
     * fails. An empty hostname selects loopback.
     *
     * @param host a non-null hostname or numeric address to resolve and copy
     * @param port 0 through 65535
     * @throws IllegalArgumentException if host is null or port is outside 0 through 65535
     */
    public InetSocketAddress(String host, int port) {

        this(host, port, true);
    }

    private InetSocketAddress(String host, int port, boolean resolve) {

        if (port < 0 || port > 65535) throw new IllegalArgumentException("Invalid port");
        if (host == null) throw new IllegalArgumentException("Missing hostname");
        this.port = port;
        if (resolve) {
            this.address = resolve(host);
        } else {
            this.address = null;
        }
        if (this.address == null) {
            this.unresolvedName = new String(host);
        } else {
            this.unresolvedName = null;
        }
    }

    private static InetAddress resolve(String host) {

        try {
            return InetAddress.getByName(host);
        } catch (UnknownHostException failure) {
            return null;
        }
    }

    /**
     * Creates an unresolved endpoint by copying the hostname without DNS, including when the text
     * is numeric.
     *
     * @param host the non-null host label to copy
     * @param port 0 through 65535
     * @return a fresh endpoint owned by the caller
     * @throws IllegalArgumentException if host is null or port is outside 0 through 65535
     */
    public static InetSocketAddress createUnresolved(String host, int port) {

        return new InetSocketAddress(host, port, false);
    }

    /**
     * Returns the unresolved label or the resolved address's host name. The latter may trigger a
     * synchronous reverse lookup. Do not free the returned text separately.
     *
     * @return host text borrowed from this endpoint
     */
    public String getHostName() {

        if (this.address == null) return this.unresolvedName;
        return this.address.getHostName();
    }

    /**
     * Returns a host label or numeric text without triggering reverse DNS. Do not free the
     * returned text separately.
     *
     * @return host text borrowed from this endpoint
     */
    public String getHostString() {

        if (this.address == null) return this.unresolvedName;
        return this.address.hostString();
    }

    /**
     * Returns this endpoint's copied immutable address. Its lifetime is bounded by this endpoint;
     * do not free it separately.
     *
     * @return a borrowed address, or null when unresolved
     */
    public InetAddress getAddress() {

        return this.address;
    }

    /**
     * Returns the endpoint port.
     *
     * @return the port in the range 0 through 65535
     */
    public int getPort() {

        return this.port;
    }

    /**
     * Tests whether this endpoint contains a hostname without resolved address bits.
     *
     * @return true if getAddress() is null
     */
    public boolean isUnresolved() {

        return this.address == null;
    }

    /**
     * Compares ports and resolved address bits, or ports and case-insensitive unresolved host
     * labels. A resolved value never equals an unresolved value.
     *
     * @param other the value to compare, or null
     * @return true if the values are equal
     */
    @Override
    public boolean equals(Object other) {

        if (!(other instanceof InetSocketAddress)) return false;
        InetSocketAddress endpoint = (InetSocketAddress) other;
        if (this.port != endpoint.port) return false;
        if (this.address != null) return this.address.equals(endpoint.address);
        return endpoint.address == null && this.unresolvedName.equalsIgnoreCase(endpoint.unresolvedName);
    }

    /**
     * Hashes the port and address or case-insensitive unresolved hostname.
     *
     * @return the hash code consistent with equality
     */
    @Override
    public int hashCode() {

        if (this.address != null) return this.address.hashCode() + this.port;
        if (this.hashComputed) return this.unresolvedHash;
        String lower = this.unresolvedName.toLowerCase();
        defer free lower;
        this.unresolvedHash = lower.hashCode() + this.port;
        this.hashComputed = true;
        return this.unresolvedHash;
    }

    /**
     * Formats the host and port without DNS. Unresolved values include an unresolved marker;
     * resolved IPv6 addresses use brackets.
     *
     * @return a fresh string owned by the caller
     */
    @Override
    public String toString() {

        if (this.address == null) return this.unresolvedName + "/<unresolved>:" + this.port;
        String host = this.address.getHostAddress();
        defer free host;
        String label = this.address.label();
        if (this.address.family() == 6) {
            return label == null ? "/[" + host + "]:" + this.port : label + "/[" + host + "]:" + this.port;
        }
        return label == null ? "/" + host + ":" + this.port : label + "/" + host + ":" + this.port;
    }

    destructor {

        free this.address;
        free this.unresolvedName;
    }
}
