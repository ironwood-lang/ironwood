package ironwood.net;

import ironwood.io.IOException;

/**
 * Reports a socket state or native networking failure. Message text is copied; it remains valid
 * after the input string is freed.
 */
public class SocketException extends IOException {

    private String detail;

    /**
     * Creates an exception without a detail message.
     */
    public SocketException() {

        super();
    }

    /**
     * Creates an exception with a copy of the supplied detail message.
     *
     * @param message the caller-owned message to copy, or null
     */
    public SocketException(String message) {

        super();
        if (message != null) this.detail = new String(message);
    }

    /**
     * Returns the detail text owned by this exception. Do not free the result separately.
     *
     * @return borrowed message text, or null when no message was supplied
     */
    @Override
    public String getMessage() {

        return this.detail;
    }

    destructor {

        free this.detail;
    }
}
