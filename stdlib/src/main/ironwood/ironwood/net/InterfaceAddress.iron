package ironwood.net;

/**
 * Immutable address, broadcast and prefix metadata borrowed from an interface snapshot. Do not
 * free an entry or its address values separately; they remain valid only while the query owner
 * lives. Address.copy() creates an independent value when needed.
 */
public class InterfaceAddress {

    private final InterfaceSnapshot snapshot;
    private final int record;
    private final InetAddress address;
    private final InetAddress broadcast;
    private final short prefix;

    InterfaceAddress(InterfaceQuery query, InterfaceSnapshot snapshot, int record, String name, int index) {

        this.snapshot = snapshot;
        this.record = record;
        if (query.family() == 4) {
            this.address = new Inet4Address(query.wordAt(3));
        } else {
            this.address = new Inet6Address(query.wordAt(0), query.wordAt(1), query.wordAt(2),
                query.wordAt(3), query.scope() == 0 ? index : query.scope(), this, name);
        }
        if (query.hasBroadcast()) {
            this.broadcast = new Inet4Address(query.broadcast());
        } else {
            this.broadcast = null;
        }
        this.prefix = (short) query.prefix();
    }

    InterfaceAddress(InterfaceAddress source, InterfaceSnapshot snapshot, int record, String name, int index) {

        this.snapshot = snapshot;
        this.record = record;
        InetAddress address = source.getAddress();
        if (address.family() == 4) {
            this.address = new Inet4Address(address.wordAt(3));
        } else {
            this.address = new Inet6Address(address.wordAt(0), address.wordAt(1), address.wordAt(2),
                address.wordAt(3), address.scopeId() == 0 ? index : address.scopeId(), this, name);
        }
        if (source.broadcast == null) {
            this.broadcast = null;
        } else {
            this.broadcast = source.broadcast.copy();
        }
        this.prefix = source.prefix;
    }

    NetworkInterface scopeInterface() {

        return this.snapshot.at(this.record);
    }

    /**
     * Returns the address held by this entry without DNS or a live interface query.
     *
     * @return an address borrowed from the snapshot owner
     */
    public InetAddress getAddress() {

        return this.address;
    }

    /**
     * Returns the captured IPv4 broadcast address when available. IPv6 entries have no broadcast
     * address.
     *
     * @return a borrowed broadcast address, or null
     */
    public InetAddress getBroadcast() {

        return this.broadcast;
    }

    /**
     * Returns the captured network-prefix length.
     *
     * @return the prefix length in bits, up to 32 for IPv4 or 128 for IPv6
     */
    public short getNetworkPrefixLength() {

        return this.prefix;
    }

    /**
     * Compares address bits, broadcast address and prefix length.
     *
     * @param other the value to compare, or null
     * @return true if the values are equal
     */
    @Override
    public boolean equals(Object other) {

        if (!(other instanceof InterfaceAddress)) return false;
        InterfaceAddress value = (InterfaceAddress) other;
        return this.address.equals(value.address) && this.prefix == value.prefix
            && (this.broadcast == null ? value.broadcast == null : this.broadcast.equals(value.broadcast));
    }

    /**
     * Hashes address, broadcast and prefix metadata.
     *
     * @return the hash code consistent with equality
     */
    @Override
    public int hashCode() {

        return this.address.hashCode() + (this.broadcast == null ? 0 : this.broadcast.hashCode()) + this.prefix;
    }

    /**
     * Formats the address, prefix and broadcast metadata without DNS.
     *
     * @return a fresh string owned by the caller
     */
    @Override
    public String toString() {

        String address = this.address.toString();
        try {
            if (this.broadcast == null) return address + "/" + this.prefix + " [null]";
            String broadcast = this.broadcast.toString();
            try {
                return address + "/" + this.prefix + " [" + broadcast + "]";
            } finally {
                free broadcast;
            }
        } finally {
            free address;
        }
    }

    destructor {

        free this.broadcast;
        free this.address;
    }
}
