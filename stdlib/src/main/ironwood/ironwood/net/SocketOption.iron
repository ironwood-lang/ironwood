package ironwood.net;

/**
 * Identifies a socket option with a statically checked value type. Primitive specializations such
 * as {@code SocketOption<int>} require no boxing. Native options are recognized by token identity;
 * matching a name does not create an equivalent token.
 *
 * @param <T> the option value type, including primitive types
 */
public interface SocketOption<T> extends SocketOptionDescriptor {

}
