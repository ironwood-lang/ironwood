package ironwood.net;

/**
 * Describes an option independently of its specialized value type. Metadata and tokens in a socket
 * inventory may be shared managed values retained by the inventory.
 */
public interface SocketOptionDescriptor {

    /**
     * Returns the descriptive option name. Built-in names are process-lifetime strings; custom
     * tokens may return shared managed text.
     *
     * @return the option name, borrowed for built-in tokens
     */
    String name();

    /**
     * Describes the option value shape without runtime class objects. Built-in tokens use {@code
     * boolean} or {@code int}; custom tokens define their own description and text lifetime.
     *
     * @return the value-kind description, borrowed for built-in tokens
     */
    String valueKind();
}
