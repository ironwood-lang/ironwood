package ironwood.net;

import ironwood.ds.ArrayList;
import ironwood.util.Arrays;
import ironwood.util.Enumeration;

/**
 * Captured interface structure with live status queries. Individual lookup results own their
 * snapshot; enumeration elements borrow the enumeration's snapshot. Names, addresses, parents and
 * subinterfaces remain tied to that owner. Free caller-owned cursors and lists before the snapshot
 * owner, and never free borrowed entries separately. Status, MTU and hardware queries consult the
 * current host by the captured interface name and can fail if it disappears.
 */
public final class NetworkInterface {

    private final InterfaceSnapshot owned;
    private final InterfaceSnapshot borrowed;
    private final String name;
    private final byte[] encodedName;
    private final InterfaceAddress[] addresses;
    private final int record;
    private final int index;
    private final int parent;

    private NetworkInterface(String name, int index, InetAddress address, int mode) throws SocketException {

        this.owned = InterfaceSnapshot.capture();
        this.borrowed = null;
        this.record = this.owned.find(name, index, address, mode);
        if (this.record < 0) {
            this.name = null;
            this.encodedName = null;
            this.index = -1;
            this.parent = -1;
            this.addresses = new InterfaceAddress[0];
        } else {
            NetworkInterface value = this.owned.at(this.record);
            this.name = new String(value.getName());
            this.encodedName = this.name.getBytes();
            this.index = value.index;
            this.parent = value.parent;
            this.addresses = new InterfaceAddress[0];
        }
    }

    NetworkInterface(InterfaceSnapshot snapshot, int record, InterfaceQuery query) throws SocketException {

        this.owned = null;
        this.borrowed = snapshot;
        this.record = record;
        this.index = query.interfaceIndex();
        this.parent = query.parent();
        this.name = query.name();
        this.encodedName = this.name.getBytes();
        this.addresses = new InterfaceAddress[query.addressCount()];
        for (int position = 0; position < this.addresses.length; position++) {
            query.readAddress();
            this.addresses[position] = new InterfaceAddress(query, this.borrowed, record, this.getName(), this.index);
        }
    }

    NetworkInterface(InterfaceSnapshot snapshot, int record, NetworkInterface source) {

        this.owned = null;
        this.borrowed = snapshot;
        this.record = record;
        this.index = source.index;
        this.parent = source.parent;
        this.name = new String(source.getName());
        this.encodedName = this.name.getBytes();
        this.addresses = new InterfaceAddress[source.addressCount()];
        for (int position = 0; position < this.addresses.length; position++) {
            this.addresses[position] = new InterfaceAddress(source.addressAt(position), this.borrowed,
                record, this.getName(), this.index);
        }
    }

    NetworkInterface(NetworkInterface source) {

        this.owned = new InterfaceSnapshot(source);
        this.borrowed = null;
        this.record = source.record;
        this.index = source.index;
        this.parent = source.parent;
        this.name = new String(source.getName());
        this.encodedName = this.name.getBytes();
        this.addresses = new InterfaceAddress[0];
    }

    private static NetworkInterface lookup(String name, int index, InetAddress address, int mode) throws SocketException {

        NetworkInterface result = new NetworkInterface(name, index, address, mode);
        if (result.record >= 0) return result;
        free result;
        return null;
    }

    /**
     * Captures the host interfaces and selects a matching name. A successful result owns its
     * snapshot independently of the input.
     *
     * @param name the interface name, borrowed only for this call
     * @return a fresh caller-owned interface query, or null when no interface matches
     * @throws NullPointerException if name is null
     * @throws SocketException if capturing the host interface snapshot fails
     */
    public static NetworkInterface getByName(String name) throws SocketException {

        if (name == null) throw new NullPointerException();
        return lookup(name, 0, null, 0);
    }

    /**
     * Captures the host interfaces and selects a matching index. A successful result owns its
     * snapshot independently of the input.
     *
     * @param index a nonnegative interface index; zero never matches
     * @return a fresh caller-owned interface query, or null when no interface matches
     * @throws IllegalArgumentException if index is negative
     * @throws SocketException if capturing the host interface snapshot fails
     */
    public static NetworkInterface getByIndex(int index) throws SocketException {

        if (index < 0) throw new IllegalArgumentException("Negative interface index");
        if (index == 0) return null;
        return lookup(null, index, null, 1);
    }

    /**
     * Captures the host interfaces and selects a matching address. A successful result owns its
     * snapshot independently of the input.
     *
     * @param address an address to match, borrowed only for this call
     * @return a fresh caller-owned interface query, or null when no interface matches
     * @throws NullPointerException if address is null
     * @throws SocketException if capturing the host interface snapshot fails
     */
    public static NetworkInterface getByInetAddress(InetAddress address) throws SocketException {

        if (address == null) throw new NullPointerException();
        return lookup(null, 0, address, 2);
    }

    /**
     * Captures the current interfaces in a fresh owning enumeration. Returned interfaces and their
     * metadata borrow this snapshot. Exhausting the cursor does not reclaim it; free it only after
     * all borrowed values and subordinate cursors are no longer needed.
     *
     * @return a fresh caller-owned enumeration, possibly empty
     * @throws SocketException if capturing the host interface snapshot fails
     */
    public static Enumeration<NetworkInterface> getNetworkInterfaces() throws SocketException {

        return new InterfaceEnumeration();
    }

    /**
     * Returns the captured interface name, without a live host query.
     *
     * @return name text borrowed from the snapshot owner
     */
    public String getName() {

        return this.name;
    }

    /**
     * Returns the captured interface name as its display name on the supported native platforms.
     *
     * @return display text borrowed from the snapshot owner
     */
    public String getDisplayName() {

        return this.name;
    }

    /**
     * Returns the interface index captured with the snapshot.
     *
     * @return the captured interface index
     */
    public int getIndex() {

        return this.index;
    }

    /**
     * Tests whether the captured name identifies a colon-named subinterface. This does not
     * classify all host virtual network devices.
     *
     * @return true for a colon-named subinterface
     */
    public boolean isVirtual() {

        return this.name.indexOf(':') >= 0;
    }

    /**
     * Returns the parent from the same captured snapshot. Do not free the result separately.
     *
     * @return a borrowed parent interface, or null if there is none
     */
    public NetworkInterface getParent() {

        if (this.parent < 0) return null;
        return this.snapshotAt(this.parent);
    }

    /**
     * Creates a cursor over captured address values. The cursor and its elements borrow this
     * interface's snapshot; free the cursor before the owner, and do not free the addresses
     * separately.
     *
     * @return a fresh enumeration owned by the caller
     */
    public Enumeration<InetAddress> getInetAddresses() {

        return new InterfaceAddressEnumeration(this);
    }

    /**
     * Creates a cursor over captured child interfaces. The cursor and its elements borrow this
     * interface's snapshot; free the cursor before the owner, and do not free the child interfaces
     * separately.
     *
     * @return a fresh enumeration owned by the caller
     */
    public Enumeration<NetworkInterface> getSubInterfaces() {

        return new SubInterfaceEnumeration(this);
    }

    /**
     * Creates a mutable list containing borrowed address/prefix entries. Mutating the list does
     * not alter the snapshot. Free the list before the snapshot owner; do not free its borrowed
     * entries separately.
     *
     * @return a fresh list owned by the caller
     */
    public ArrayList<InterfaceAddress> getInterfaceAddresses() {

        ArrayList<InterfaceAddress> result = new ArrayList<InterfaceAddress>(this.addressCapacity());
        try {
            for (int position = 0; position < this.addressCount(); position++) {
                result.add(this.addressAt(position));
            }
            return result;
        } catch (RuntimeException | Error failure) {
            free result;
            throw failure;
        }
    }

    private int addressCapacity() {

        int count = this.addressCount();
        return count == 0 ? 1 : count;
    }

    int snapshotSize() {

        if (this.owned != null) return this.owned.size();
        return this.borrowed.size();
    }

    NetworkInterface snapshotAt(int position) {

        if (this.owned != null) return this.owned.at(position);
        return this.borrowed.at(position);
    }

    int parentRecord() {

        return this.parent;
    }

    int record() {

        return this.record;
    }

    int addressCount() {

        if (this.owned != null) return this.owned.at(this.record).addressCount();
        return this.addresses.length;
    }

    private InterfaceAddress capturedAddressAt(int position) {

        return this.addresses[position];
    }

    InterfaceAddress addressAt(int position) {

        if (this.owned != null) return this.owned.at(this.record).capturedAddressAt(position);
        return this.capturedAddressAt(position);
    }

    boolean hasAddress(InetAddress address) {

        for (int position = 0; position < this.addressCount(); position++) {
            if (this.addressAt(position).getAddress().equals(address)) return true;
        }
        return false;
    }

    private int flags() throws SocketException {

        return InterfaceQuery.checked(TcpNative.interfaceFlags(this.encodedName));
    }

    InetAddress reachabilitySource(InetAddress destination) {

        for (int position = 0; position < this.addressCount(); position++) {
            InetAddress candidate = this.addressAt(position).getAddress();
            if (candidate.family() != destination.family()) continue;
            if (destination.isLinkLocalAddress() && !candidate.isLinkLocalAddress()) continue;
            return candidate;
        }
        return null;
    }

    int scopeFor(int first) throws UnknownHostException {

        int kind = first >>> 22;
        for (int position = 0; position < this.addressCount(); position++) {
            InetAddress candidate = this.addressAt(position).getAddress();
            if (candidate.family() != 6) continue;
            if (kind == 1018 && !candidate.isLinkLocalAddress()) continue;
            if (kind == 1019 && !candidate.isSiteLocalAddress()) continue;
            return candidate.scopeId() == 0 ? this.index : candidate.scopeId();
        }
        throw new UnknownHostException("Interface has no matching IPv6 scope");
    }

    /**
     * Queries whether the interface is currently enabled using the captured interface name.
     *
     * @return true if the current host flags report this property
     * @throws SocketException if the live host query fails
     */
    public boolean isUp() throws SocketException {

        return (this.flags() & 1) != 0;
    }

    /**
     * Queries whether the interface is a loopback device using the captured interface name.
     *
     * @return true if the current host flags report this property
     * @throws SocketException if the live host query fails
     */
    public boolean isLoopback() throws SocketException {

        return (this.flags() & 2) != 0;
    }

    /**
     * Queries whether the interface is point-to-point using the captured interface name.
     *
     * @return true if the current host flags report this property
     * @throws SocketException if the live host query fails
     */
    public boolean isPointToPoint() throws SocketException {

        return (this.flags() & 4) != 0;
    }

    /**
     * Queries whether the interface supports multicast using the captured interface name.
     *
     * @return true if the current host flags report this property
     * @throws SocketException if the live host query fails
     */
    public boolean supportsMulticast() throws SocketException {

        return (this.flags() & 8) != 0;
    }

    /**
     * Queries the current maximum transmission unit using the captured interface name.
     *
     * @return the MTU in bytes
     * @throws SocketException if the live host query fails
     */
    public int getMTU() throws SocketException {

        return InterfaceQuery.checked(TcpNative.interfaceMtu(this.encodedName));
    }

    /**
     * Queries the current hardware address and copies it independently of the snapshot.
     *
     * @return fresh caller-owned hardware bytes, or null when no address is reported
     * @throws SocketException if the live host query fails
     */
    public byte[] getHardwareAddress() throws SocketException {

        byte[] buffer = new byte[256];
        try {
            int count = InterfaceQuery.checked(TcpNative.interfaceHardware(this.encodedName, buffer));
            if (count == 0) return null;
            return Arrays.copyOf(buffer, count);
        } finally {
            free buffer;
        }
    }

    /**
     * Compares captured interface names and address membership. Live status flags and MTU do not
     * participate.
     *
     * @param other the value to compare, or null
     * @return true if the values are equal
     */
    @Override
    public boolean equals(Object other) {

        if (!(other instanceof NetworkInterface)) return false;
        NetworkInterface value = (NetworkInterface) other;
        if (!this.name.equals(value.name) || this.addressCount() != value.addressCount()) return false;
        for (int position = 0; position < this.addressCount(); position++) {
            if (!value.hasAddress(this.addressAt(position).getAddress())) return false;
        }
        return true;
    }

    /**
     * Hashes the captured interface name.
     *
     * @return the hash code consistent with equality
     */
    @Override
    public int hashCode() {

        return this.name.hashCode();
    }

    /**
     * Formats the captured interface name and display name without a live query.
     *
     * @return a fresh string owned by the caller
     */
    @Override
    public String toString() {

        return "name:" + this.name + " (" + this.name + ")";
    }

    destructor {

        for (int position = 0; position < this.addresses.length; position++) {
            free this.addresses[position];
        }
        free this.addresses;
        free this.encodedName;
        free this.name;
        free this.owned;
    }
}
