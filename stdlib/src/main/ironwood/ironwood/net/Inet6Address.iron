package ironwood.net;

/**
 * Immutable 128-bit IPv6 value with an optional numeric or interface scope. Its factories always
 * produce Inet6Address, including for IPv4-mapped bits. Equality inherited from InetAddress
 * ignores the scope. A retained interface snapshot is owned by this value and reclaimed with it.
 */
public final class Inet6Address extends InetAddress {

    private final NetworkInterface scopedInterface;
    private final InterfaceAddress binding;

    Inet6Address(int first, int second, int third, int fourth) {

        this(first, second, third, fourth, null, -1, null);
    }

    Inet6Address(int first, int second, int third, int fourth, String host, int scope, String scopeName) {

        super(6, first, second, third, fourth, host, scope, scopeName);
        this.scopedInterface = null;
        this.binding = null;
    }

    Inet6Address(int first, int second, int third, int fourth, String host, int scope,
            String scopeName, NetworkInterface netif) {

        super(6, first, second, third, fourth, host, scope, scopeName);
        this.binding = null;
        if (netif == null) {
            this.scopedInterface = null;
        } else {
            this.scopedInterface = new NetworkInterface(netif);
        }
    }

    // Address entries lend interface views within the same flat snapshot. The
    // hidden storage owner is never returned and there is no ownership cycle.
    Inet6Address(int first, int second, int third, int fourth, int scope,
            InterfaceAddress binding, String name) {

        super(6, first, second, third, fourth, null, scope, name);
        this.scopedInterface = null;
        this.binding = binding;
    }

    /**
     * Creates an IPv6 value from copied bytes and an optional interface-derived scope. A supplied
     * interface must contain a compatible IPv6 source; its snapshot is copied so the input owner
     * may be freed afterward.
     *
     * @param host an optional host label to copy without DNS
     * @param address exactly 16 network-order bytes to copy
     * @param netif an interface to copy and derive scope from, or null for no scope
     * @return a fresh IPv6 value owned by the caller
     * @throws UnknownHostException if the byte array is null, its length is not 16, or no
     *     compatible interface scope exists
     */
    public static Inet6Address getByAddress(String host, byte[] address, NetworkInterface netif) throws UnknownHostException {

        if (address == null || address.length != 16) throw new UnknownHostException("IPv6 requires 16 bytes");
        if (netif == null) return getByAddress(host, address, -1);
        int first = word(address, 0);
        return new Inet6Address(first, word(address, 4), word(address, 8), word(address, 12),
            host, netif.scopeFor(first), netif.getName(), netif);
    }

    /**
     * Returns the associated interface from this value's retained snapshot or its enclosing
     * interface query. Do not free the result separately or use it after the address owner is
     * freed.
     *
     * @return a borrowed interface, or null for numeric or unspecified scope
     */
    public NetworkInterface getScopedInterface() {

        if (this.scopedInterface != null) return this.scopedInterface;
        if (this.binding != null) return this.binding.scopeInterface();
        return null;
    }

    /**
     * Creates an IPv6 value from copied bytes and a numeric scope, without DNS or interface
     * lookup.
     *
     * @param host an optional host label to copy
     * @param address exactly 16 network-order bytes to copy
     * @param scope the numeric scope; negative values mean unspecified
     * @return a fresh IPv6 value owned by the caller
     * @throws UnknownHostException if the byte array is null or its length is not 16
     */
    public static Inet6Address getByAddress(String host, byte[] address, int scope) throws UnknownHostException {

        if (address == null || address.length != 16) throw new UnknownHostException("IPv6 requires 16 bytes");
        return new Inet6Address(word(address, 0), word(address, 4), word(address, 8), word(address, 12),
            host, scope < 0 ? -1 : scope, null);
    }

    /**
     * Returns the stored numeric scope identifier without querying the host.
     *
     * @return the scope ID, or zero when unspecified
     */
    public int getScopeId() {

        return this.scopeId();
    }

    /**
     * Tests whether the first 96 address bits are zero. This includes :: and ::1 but excludes
     * IPv4-mapped addresses.
     *
     * @return true for an IPv4-compatible bit pattern
     */
    public boolean isIPv4CompatibleAddress() {

        return this.wordAt(0) == 0 && this.wordAt(1) == 0 && this.wordAt(2) == 0;
    }

    destructor {

        free this.scopedInterface;
    }
}
