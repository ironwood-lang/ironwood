package ironwood.net;

/**
 * Immutable explicit proxy configuration with copied endpoint and credential inputs. Sockets and
 * TLS clients copy the configuration again, so an ordinary proxy may be freed after client
 * construction. The shared {@code NO_PROXY} value must not be freed. No environment variables,
 * system proxy discovery, automatic authentication, or protocol fallback are used. Equality
 * compares route type and endpoint, ignoring credentials and SOCKS version.
 */
public class Proxy {

    /**
     * Selects direct TCP, an HTTP CONNECT tunnel, or a SOCKS tunnel.
     */
    public enum Type {

        /**
         * Connects directly without a proxy. Use {@code Proxy.NO_PROXY}.
         */
        DIRECT,
        /**
         * Opens a TCP tunnel with HTTP CONNECT.
         */
        HTTP,
        /**
         * Opens a TCP tunnel using the explicitly selected SOCKS version.
         */
        SOCKS
    }

    /**
     * Ironwood extension selecting a SOCKS wire protocol per proxy. There is no automatic
     * downgrade or fallback.
     */
    public enum SocksVersion {

        /**
         * Selects SOCKS4 with a resolved IPv4 destination. SOCKS4a hostname forwarding is
         * unsupported.
         */
        V4,
        /**
         * Selects SOCKS5 with IPv4, IPv6, or unresolved destination names.
         */
        V5
    }

    /**
     * Shared direct-route sentinel with process lifetime. It has no endpoint or credentials and
     * must not be freed.
     */
    public static final Proxy NO_PROXY = new Proxy();

    private final Type routeType;
    private final InetSocketAddress endpoint;
    private final SocksVersion version;
    private final byte[] username;
    private final byte[] password;

    private Proxy() {

        this.routeType = Type.DIRECT;
        this.endpoint = null;
        this.version = SocksVersion.V5;
        this.username = null;
        this.password = null;
    }

    /**
     * Creates credential-free HTTP CONNECT or SOCKS5 configuration by copying the proxy endpoint.
     * Use {@code NO_PROXY} for a direct connection. For compatibility, a null type is retained,
     * but sockets reject that unusable route.
     *
     * @param type HTTP or SOCKS for a usable proxy route; null is retained as supplied
     * @param address the InetSocketAddress of the proxy, resolved or unresolved
     * @throws IllegalArgumentException if the type is DIRECT or the address is not an
     *     InetSocketAddress
     */
    public Proxy(Type type, SocketAddress address) {

        this(type, address, SocksVersion.V5, null, null);
    }

    private Proxy(Type type, SocketAddress address, SocksVersion version, byte[] username, byte[] password) {

        if (type == Type.DIRECT || !(address instanceof InetSocketAddress)) throw new IllegalArgumentException("Invalid proxy route");
        this.routeType = type;
        this.version = version;
        this.endpoint = copyEndpoint((InetSocketAddress) address);
        this.username = copyBytes(username);
        this.password = copyBytes(password);
    }

    /**
     * Creates credential-free SOCKS configuration with an explicit version. SOCKS4 sends an empty
     * user ID. The proxy endpoint is copied.
     *
     * @param address the proxy endpoint
     * @param version the selected wire protocol
     * @return a fresh proxy owned by the caller
     * @throws NullPointerException if either argument is null
     */
    public static Proxy socks(InetSocketAddress address, SocksVersion version) {

        if (address == null || version == null) throw new NullPointerException();
        return new Proxy(Type.SOCKS, address, version, null, null);
    }

    /**
     * Creates SOCKS4 configuration with copied user-ID octets. The wire encoder adds the
     * terminating NUL; an empty ID is allowed. Destinations must be resolved IPv4 addresses.
     *
     * @param address the proxy endpoint to copy
     * @param userId the encoded user ID to copy
     * @return a fresh proxy owned by the caller
     * @throws NullPointerException if either argument is null
     * @throws IllegalArgumentException if the ID contains a NUL byte
     */
    public static Proxy socks4(InetSocketAddress address, byte[] userId) {

        if (address == null || userId == null) throw new NullPointerException();
        for (int index = 0; index < userId.length; index++) {
            if (userId[index] == 0) throw new IllegalArgumentException("Invalid SOCKS4 user ID");
        }
        return new Proxy(Type.SOCKS, address, SocksVersion.V4, userId, null);
    }

    /**
     * Creates SOCKS5 configuration requiring username/password authentication. Credentials are
     * already encoded octets and are copied. Authentication refusal fails the connection without
     * an unauthenticated retry.
     *
     * @param address the proxy endpoint to copy
     * @param username 1 through 255 username octets
     * @param password 1 through 255 password octets
     * @return a fresh proxy owned by the caller
     * @throws NullPointerException if any argument is null
     * @throws IllegalArgumentException if either credential length is outside the permitted range
     */
    public static Proxy socks5(InetSocketAddress address, byte[] username, byte[] password) {

        if (address == null || username == null || password == null) throw new NullPointerException();
        if (username.length == 0 || username.length > 255 || password.length == 0 || password.length > 255) throw new IllegalArgumentException("Invalid SOCKS5 credential length");
        return new Proxy(Type.SOCKS, address, SocksVersion.V5, username, password);
    }

    /**
     * Creates HTTP CONNECT configuration with copied Basic credentials. They are sent to this
     * proxy only, without a 407 retry. Basic encoding does not encrypt credentials on the TCP
     * connection to the proxy.
     *
     * @param address the proxy endpoint to copy
     * @param username encoded username octets, with no colon or control bytes; may be empty
     * @param password encoded password octets, with no control bytes; may be empty
     * @return a fresh proxy owned by the caller
     * @throws NullPointerException if any argument is null
     * @throws IllegalArgumentException if credentials contain prohibited bytes
     */
    public static Proxy httpConnectBasic(InetSocketAddress address, byte[] username, byte[] password) {

        if (address == null || username == null || password == null) throw new NullPointerException();
        checkBasic(username, true);
        checkBasic(password, false);
        return new Proxy(Type.HTTP, address, SocksVersion.V5, username, password);
    }

    private static void checkBasic(byte[] value, boolean username) {

        for (int index = 0; index < value.length; index++) {
            int octet = value[index] & 255;
            if (octet < 32 || octet == 127 || (username && octet == 58)) throw new IllegalArgumentException("Invalid HTTP proxy credentials");
        }
    }

    /**
     * Returns the configured route type.
     *
     * @return the type supplied at construction, including null, or DIRECT for NO_PROXY
     */
    public Type type() {

        return this.routeType;
    }

    /**
     * Returns the immutable endpoint owned by this proxy. Do not free it or retain it beyond the
     * proxy's lifetime.
     *
     * @return a borrowed proxy endpoint, or null for NO_PROXY
     */
    public SocketAddress address() {

        return this.endpoint;
    }

    static InetSocketAddress copyEndpoint(InetSocketAddress endpoint) {

        if (endpoint.isUnresolved()) return InetSocketAddress.createUnresolved(endpoint.getHostString(), endpoint.getPort());
        return new InetSocketAddress(endpoint.getAddress(), endpoint.getPort());
    }

    private static byte[] copyBytes(byte[] bytes) {

        if (bytes == null) return null;
        byte[] result = new byte[bytes.length];
        System.arraycopy(bytes, 0, result, 0, bytes.length);
        return result;
    }

    Proxy copy() {

        return new Proxy(this.type(), this.address(), this.version, this.username, this.password);
    }

    void negotiate(ProxyExchange exchange, InetSocketAddress target) throws ironwood.io.IOException {

        if (this.routeType == Type.HTTP) {
            HttpConnectProtocol.connect(exchange, target, this.username, this.password);
        } else {
            SocksProtocol.connect(exchange, target, this.version == SocksVersion.V4, this.username, this.password);
        }
    }

    boolean usesSocks4() {

        return this.routeType == Type.SOCKS && this.version == SocksVersion.V4;
    }

    /**
     * Compares route type and endpoint, ignoring credentials and SOCKS version. This is route
     * equality, not authentication-configuration equality.
     *
     * @param other the value to compare, or null
     * @return true if the values are equal
     */
    @Override
    public final boolean equals(Object other) {

        if (!(other instanceof Proxy)) return false;
        Proxy proxy = (Proxy) other;
        if (this.type() != proxy.type()) return false;
        SocketAddress address = this.address();
        if (address == null) return proxy.address() == null;
        return address.equals(proxy.address());
    }

    /**
     * Hashes the route type and endpoint, ignoring credentials and SOCKS version.
     *
     * @return the hash code consistent with equality
     * @throws NullPointerException if this proxy was constructed with a null route type
     */
    @Override
    public final int hashCode() {

        SocketAddress address = this.address();
        return this.type().hashCode() + (address == null ? 0 : address.hashCode());
    }

    /**
     * Formats the route and endpoint without exposing credentials or resolving DNS.
     *
     * @return a fresh string owned by the caller
     * @throws NullPointerException if this proxy was constructed with a null route type
     */
    @Override
    public String toString() {

        Type type = this.type();
        if (type == null) throw new NullPointerException();
        if (type == Type.DIRECT) return new String("DIRECT");
        String address = this.address().toString();
        defer free address;
        return (type == Type.HTTP ? "HTTP @ " : "SOCKS @ ") + address;
    }

    destructor {

        free this.password;
        free this.username;
        free this.endpoint;
    }
}
