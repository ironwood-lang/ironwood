package ironwood.net;

/**
 * An immutable IPv4 value obtained from {@link InetAddress} factories and queries. Address classification
 * uses the stored bits without DNS. Factories return fresh managed values; socket and interface
 * getters may return shared cached values with ordinary managed lifetimes.
 */
public final class Inet4Address extends InetAddress {

    Inet4Address(int address) {

        this(address, null);
    }

    Inet4Address(int address, String host) {

        super(4, 0, 0, 0, address, host, -1, null);
    }
}
