package ironwood.lang;
/** Base class for serious errors. */

public class Error extends Throwable {
    /** Creates a new Error. */

    public Error() {

        super();
    }
    /** Creates a new Error. */

    public Error(String message) {

        super(message);
    }
    /** Creates a new Error. */

    public Error(Throwable cause) {

        super(cause);
    }
    /** Creates a new Error. */

    public Error(String message, Throwable cause) {

        super(message, cause);
    }
}
