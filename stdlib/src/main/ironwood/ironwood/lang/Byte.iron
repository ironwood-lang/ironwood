package ironwood.lang;
/** Provides 8-bit integer operations. */

public class Byte {
    /** The minimum supported value. */

    public static final byte MIN_VALUE = (byte) -128;
    /** The maximum supported value. */
    public static final byte MAX_VALUE = (byte) 127;

    private Byte() {

    }
    /** Returns this value's hash code. */

    public static int hashCode(byte value) {

        return value;
    }
    /** Compares the supplied values. */

    public static int compare(byte first, byte second) {

        return first - second;
    }
    /** Parses the supplied byte. */

    public static byte parseByte(String text) {

        return parseByte(text, 10);
    }
    /** Parses the supplied byte. */

    public static byte parseByte(String text, int radix) {

        int value = Integer.parseInt(text, radix);
        if (value < -128 || value > 127) throw new NumberFormatException();
        return (byte) value;
    }
    /** Returns a textual representation of this value. */

    public static String toString(byte value) {

        return Integer.toString(value);
    }
}
