package ironwood.util;

/** Deterministic 48-bit linear-congruential pseudorandom generator. */
public class Random {

    private static final long MULTIPLIER = 25214903917L;
    private static final long ADDEND = 11L;
    private static final long MASK = 281474976710655L;
    private long seed;
    /** Creates a new Random. */

    public Random() {

        this(System.nanoTime());
    }
    /** Creates a new Random. */

    public Random(long seed) {

        setSeed(seed);
    }
    /** Sets the seed. */

    public void setSeed(long seed) {

        this.seed = (seed ^ MULTIPLIER) & MASK;
    }
    /** Returns the next value. */

    protected int next(int bits) {

        this.seed = (this.seed * MULTIPLIER + ADDEND) & MASK;
        return (int) (this.seed >>> (48 - bits));
    }
    /** Returns the next bytes. */

    public void nextBytes(byte[] bytes) {

        int index = 0;
        while (index < bytes.length) {
            int random = nextInt();
            int remaining = bytes.length - index;
            int count = remaining < 4 ? remaining : 4;
            while (count > 0) {
                bytes[index] = (byte) random;
                random = random >> 8;
                index++;
                count--;
            }
        }
    }
    /** Returns the next int. */

    public int nextInt() {

        return next(32);
    }
    /** Returns the next int. */

    public int nextInt(int bound) {

        if (bound <= 0) throw new IllegalArgumentException("bound must be positive");
        int mask = bound - 1;
        if ((bound & mask) == 0) return (int) ((bound * (long) next(31)) >> 31);
        int bits = 0;
        int value = 0;
        do {
            bits = next(31);
            value = bits % bound;
        } while (bits - value + mask < 0);
        return value;
    }
    /** Returns the next long. */

    public long nextLong() {

        return ((long) next(32) << 32) + (long) next(32);
    }
    /** Returns the next boolean. */

    public boolean nextBoolean() {

        return next(1) != 0;
    }
    /** Returns the next float. */

    public float nextFloat() {

        return next(24) / 16777216.0f;
    }
    /** Returns the next double. */

    public double nextDouble() {

        return (((long) next(26) << 27) + next(27)) / 9007199254740992.0;
    }

}
