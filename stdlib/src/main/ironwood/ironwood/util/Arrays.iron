package ironwood.util;

/** Allocation-conscious operations on Ironwood arrays. */
public final class Arrays {

    private Arrays() {

    }

    private static void checkRange(int length, int fromIndex, int toIndex) {

        if (fromIndex > toIndex) throw new IllegalArgumentException("fromIndex is greater than toIndex");
        if (fromIndex < 0 || toIndex > length) throw new ArrayIndexOutOfBoundsException();
    }
    /** Fills the supplied range. */

    public static void fill(boolean[] array, boolean value) {

        fill(array, 0, array.length, value);
    }
    /** Fills the supplied range. */

    public static void fill(boolean[] array, int fromIndex, int toIndex, boolean value) {

        checkRange(array.length, fromIndex, toIndex);
        for (int index = fromIndex; index < toIndex; index++) array[index] = value;
    }
