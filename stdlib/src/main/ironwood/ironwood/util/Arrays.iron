    /** Copies the supplied value or range. */

    public static <T extends Object> T[] copyOf(T[] original, int newLength) {

        if (original == null) throw new NullPointerException();
        int originalLength = original.length;
        T[] copy = new T[newLength];
        int length = Math.min(originalLength, newLength);
        for (int index = 0; index < length; index++) copy[index] = original[index];
        return copy;
    }
    /** Sorts the supplied values. */

    public static void sort(byte[] array) {

        sort(array, 0, array.length);
    }
    /** Sorts the supplied values. */

    public static void sort(byte[] array, int fromIndex, int toIndex) {

        checkRange(array.length, fromIndex, toIndex);
        if (fromIndex == toIndex) return;
        for (int index = fromIndex + 1; index < toIndex; index++) {
            byte value = array[index];
            int position = index;
            while (position > fromIndex && array[position - 1] > value) {
                array[position] = array[position - 1];
                position--;
            }
            array[position] = value;
        }
    }
