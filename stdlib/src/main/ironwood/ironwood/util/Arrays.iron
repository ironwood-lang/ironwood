    /** Sorts the supplied values. */

    public static <T extends Comparable<T>> void sort(T[] array) {

        sort(array, 0, array.length);
    }
    /** Sorts the supplied values. */

    public static <T extends Comparable<T>> void sort(T[] array, int fromIndex, int toIndex) {

        checkRange(array.length, fromIndex, toIndex);
        if (fromIndex == toIndex) return;
        for (int index = fromIndex + 1; index < toIndex; index++) {
            T value = array[index];
            int position = index;
            while (position > fromIndex && array[position - 1].compareTo(value) > 0) {
                array[position] = array[position - 1];
                position--;
            }
            array[position] = value;
        }
    }
    /** Sorts the supplied values. */

    public static <T extends Comparable<T>> void sort(T[] array, Comparator<? super T> comparator) {

        for (int index = 1; index < array.length; index++) {
            T value = array[index];
            int position = index;
            int comparison = position == 0 ? 0 : comparator == null
                    ? array[position - 1].compareTo(value)
                    : comparator.compare(array[position - 1], value);
            while (position > 0 && comparison > 0) {
                array[position] = array[position - 1];
                position--;
                comparison = position == 0 ? 0 : comparator == null
                        ? array[position - 1].compareTo(value)
                        : comparator.compare(array[position - 1], value);
            }
            array[position] = value;
        }
    }
    /** Sorts the supplied values. */

    public static <T extends Comparable<T>> void sort(T[] array, int fromIndex, int toIndex,
                                                       Comparator<? super T> comparator) {

        checkRange(array.length, fromIndex, toIndex);
        if (fromIndex == toIndex) return;
        for (int index = fromIndex + 1; index < toIndex; index++) {
            T value = array[index];
            int position = index;
            int comparison = position == fromIndex ? 0 : comparator == null
                    ? array[position - 1].compareTo(value)
                    : comparator.compare(array[position - 1], value);
            while (position > fromIndex && comparison > 0) {
                array[position] = array[position - 1];
                position--;
                comparison = position == fromIndex ? 0 : comparator == null
                        ? array[position - 1].compareTo(value)
                        : comparator.compare(array[position - 1], value);
            }
            array[position] = value;
        }
    }
    /** Returns this value's hash code. */

    public static int hashCode(boolean[] array) {

        if (array == null) return 0;
        int result = 1;
        for (int index = 0; index < array.length; index++) {
            result = 31 * result + (array[index] ? 1231 : 1237);
        }
        return result;
    }
    /** Returns this value's hash code. */

    public static int hashCode(byte[] array) {

        if (array == null) return 0;
        int result = 1;
        for (int index = 0; index < array.length; index++) result = 31 * result + array[index];
        return result;
    }
