package ironwood.time.format;

import ironwood.time.DateTimeException;
/** Signals text that cannot be parsed as a date or time. */

public class DateTimeParseException extends DateTimeException {

    private char[] parsed;
    private final int errorIndex;
    /** Creates a new DateTimeParseException. */

    public DateTimeParseException(String message, CharSequence parsedData, int errorIndex) {

        this(message, parsedData, errorIndex, null);
    }
    /** Creates a new DateTimeParseException. */

    public DateTimeParseException(String message, CharSequence parsedData, int errorIndex, Throwable cause) {

        super(message, cause);
        this.errorIndex = errorIndex;
        String rendered = parsedData.toString();
        try {
            if (rendered != null) {
                this.parsed = new char[rendered.length()];
                for (int index = 0; index < this.parsed.length; index++) {
                    char character = rendered.charAt(index);
                    this.parsed[index] = character;
                }
            }
        } finally {
            releaseRenderedString(parsedData, rendered);
        }
    }
    /** Returns the error index. */

    public int getErrorIndex() {

        return this.errorIndex;
    }

    // A fresh snapshot lets the caller keep diagnostic text after freeing this exception.
    /** Returns the parsed string. */
    public String getParsedString() {

        return this.parsed == null ? null : new String(this.parsed, 0, this.parsed.length);
    }

    private static void releaseRenderedString(Object object, String rendered) {

    }

    destructor {

        free this.parsed;
    }
}
