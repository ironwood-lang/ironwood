package ironwood.nio.file;

import ironwood.io.IOException;
import ironwood.nio.file.attribute.BasicFileAttributes;
/** Defines callbacks for visiting file values. */

public interface FileVisitor<T extends Object> {
    /** Performs the pre visit directory operation. */

    FileVisitResult preVisitDirectory(T directory, BasicFileAttributes attributes) throws IOException;
    /** Performs the visit file operation. */

    FileVisitResult visitFile(T file, BasicFileAttributes attributes) throws IOException;
    /** Performs the visit file failed operation. */

    FileVisitResult visitFileFailed(T file, IOException failure) throws IOException;
    /** Performs the post visit directory operation. */

    FileVisitResult postVisitDirectory(T directory, IOException failure) throws IOException;
}
