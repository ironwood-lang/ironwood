package ironwood.nio.file.attribute;
/** Represents a file timestamp. */

public final class FileTime implements Comparable<FileTime> {

    private long millis;

    private FileTime(long millis) {

        this.millis = millis;
    }
    /** Performs the from millis operation. */

    public static FileTime fromMillis(long value) {

        return new FileTime(value);
    }
    /** Performs the to millis operation. */

    public long toMillis() {

        return this.millis;
    }
    /** Compares this value with another value. */

    @Override
    public int compareTo(FileTime other) {

        if (this.millis < other.millis) return -1;
        return this.millis == other.millis ? 0 : 1;
    }
    /** Tests this value for equality with another object. */

    @Override
    public boolean equals(Object other) {

        return other instanceof FileTime && this.millis == ((FileTime) other).millis;
    }
    /** Returns this value's hash code. */

    @Override
    public int hashCode() {

        return (int) (this.millis ^ (this.millis >>> 32));
    }
}
