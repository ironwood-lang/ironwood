package ironwood.nio.file.attribute;
/** Defines basic file metadata. */

public interface BasicFileAttributes {
    /** Performs the last modified time operation. */

    FileTime lastModifiedTime();
    /** Performs the last access time operation. */

    FileTime lastAccessTime();
    /** Performs the creation time operation. */

    FileTime creationTime();
    /** Returns whether this value is regular file. */

    boolean isRegularFile();
    /** Returns whether this value is directory. */

    boolean isDirectory();
    /** Returns whether this value is symbolic link. */

    boolean isSymbolicLink();
    /** Returns whether this value is other. */

    boolean isOther();
    /** Returns the number of stored values. */

    long size();
    /** Performs the file key operation. */

    Object fileKey();
}
