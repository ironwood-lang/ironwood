package ironwood.nio.file;

import ironwood.io.IOException;
/** Defines operations on file-system paths. */

public interface Path extends Comparable<Path> {
    /** Performs the of operation. */

    static Path of(String first) {

        return Paths.get(first);
    }
    /** Performs the of operation. */

    static Path of(String first, String more) {

        return new UnixPath(first, more);
    }
    /** Returns whether this value is absolute. */

    boolean isAbsolute();
    /** Returns the file name. */

    Path getFileName();
    /** Returns the parent. */

    Path getParent();
    /** Returns the root. */

    Path getRoot();
    /** Returns the name count. */

    int getNameCount();
    /** Returns the name. */

    Path getName(int index);
    /** Performs the starts with operation. */

    boolean startsWith(Path other);
    /** Performs the starts with operation. */

    boolean startsWith(String other);
    /** Performs the relativize operation. */

    Path relativize(Path other);
    /** Performs the resolve operation. */

    Path resolve(Path other);
    /** Performs the resolve operation. */

    Path resolve(String other);
    /** Performs the resolve sibling operation. */

    Path resolveSibling(Path other);
    /** Performs the resolve sibling operation. */

    Path resolveSibling(String other);
    /** Performs the normalize operation. */

    Path normalize();
    /** Performs the to absolute path operation. */

    Path toAbsolutePath();

    /**
     * Returns the real path of an existing entry: absolute, with every
     * symbolic link resolved through the host filesystem and no redundant
     * name elements. The path's own spelling is resolved, so {@code ..} after
     * a link follows the link rather than being removed lexically; the empty
     * path resolves the current directory. This fixed overload always follows
     * links, as Java's call without options does.
     *
     * @return a fresh caller-owned path
     * @throws NoSuchFileException if the entry or a component does not exist
     * @throws IOException if the path cannot be resolved
     */
    Path toRealPath() throws IOException;
    /** Returns a textual representation of this value. */

    @Override
    String toString();
}
