package ironwood.io;

// Compiler-created singleton implementation; applications obtain it via System.in.
/** Reads bytes from an input source. */
public final class StandardInputStream extends InputStream {

    private StandardInputStream() {

    }
    /** Reads data from this input. */
    @Override
    public int read() throws IOException {

        int result = StreamSupport.readByte(0);
        if (result < -1) throw StreamSupport.failure();
        return result;
    }
    /** Reads data from this input. */
    @Override
    public int read(byte[] buffer, int offset, int length) throws IOException {

        StreamSupport.range(buffer.length, offset, length);
        int result = StreamSupport.readBytes(0, buffer, offset, length);
        if (result < -1) throw StreamSupport.failure();
        return result;
    }
    /** Returns the input available without blocking. */
    @Override
    public int available() throws IOException {

        int result = StreamSupport.available(0);
        if (result < 0) throw StreamSupport.failure();
        return result;
    }
    /** Closes this resource. */
    @Override
    public void close() {

    }
}
