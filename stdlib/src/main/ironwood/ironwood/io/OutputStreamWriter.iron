package ironwood.io;

import ironwood.nio.file.Path;
/** Writes characters to a destination. */

public class OutputStreamWriter extends Writer {

    private OutputStream output;
    private FileOutputStream ownedOutput;
    private byte[] buffer;
    private int count;
    private int high;
    private boolean closed;
    private boolean strict;
    /** Creates a new OutputStreamWriter. */
    public OutputStreamWriter(OutputStream output) {

        if (output == null) throw new NullPointerException();
        this.buffer = new byte[8192];
        this.output = output;
    }
    /** Creates a new OutputStreamWriter. */

    protected OutputStreamWriter(String name, boolean append) throws IOException {

        this.buffer = new byte[8192];
        this.ownedOutput = new FileOutputStream(name, append);
    }
    /** Creates a new OutputStreamWriter. */
    public OutputStreamWriter(Path path) throws IOException {

        this.buffer = new byte[8192];
        this.strict = true;
        this.ownedOutput = new FileOutputStream(path);
    }
    /** Creates a new OutputStreamWriter. */

    protected OutputStreamWriter(Path path, boolean append) throws IOException {

        this.buffer = new byte[8192];
        this.ownedOutput = new FileOutputStream(path, append);
    }
    /** Returns the encoding. */
    public String getEncoding() {

        if (this.closed) return null;
        return "UTF8";
    }
    private void drain() throws IOException {

        int pending = this.count;
        this.count = 0;
        if (pending > 0) {
            if (this.ownedOutput != null) {
                this.ownedOutput.write(this.buffer, 0, pending);
            } else {
                this.output.write(this.buffer, 0, pending);
            }
        }
    }
    private void encode(int point) throws IOException {

        if (this.buffer.length - this.count < 4) drain();
        if (point < 128) this.buffer[this.count++] = (byte) point;
        else if (point < 2048) {
            this.buffer[this.count++] = (byte) (192 | (point >> 6));
            this.buffer[this.count++] = (byte) (128 | (point & 63));
        } else if (point < 65536) {

            this.buffer[this.count++] = (byte) (224 | (point >> 12));
            this.buffer[this.count++] = (byte) (128 | ((point >> 6) & 63));
            this.buffer[this.count++] = (byte) (128 | (point & 63));
        } else {
            this.buffer[this.count++] = (byte) (240 | (point >> 18));
            this.buffer[this.count++] = (byte) (128 | ((point >> 12) & 63));
            this.buffer[this.count++] = (byte) (128 | ((point >> 6) & 63));
            this.buffer[this.count++] = (byte) (128 | (point & 63));
        }
    }
    private void malformed() throws IOException {

        if (this.strict) throw new IOException("Unpaired UTF-16 surrogate");
        encode(63);
    }
    /** Writes the supplied data. */
    @Override
    public void write(int value) throws IOException {

        StreamSupport.open(this.closed);
        int unit = value & 65535;
        if (this.high != 0) {
            int previous = this.high;
            this.high = 0;
            if (unit >= 56320 && unit <= 57343) {
                encode(65536 + ((previous - 55296) << 10) + unit - 56320);
                return;
            }
            malformed();
        }
        if (unit >= 55296 && unit <= 56319) this.high = unit;
        else if (unit >= 56320 && unit <= 57343) malformed();
        else {
            encode(unit);
        }
    }
    /** Writes the supplied data. */
    @Override
    public void write(char[] chars, int offset, int length) throws IOException {

        StreamSupport.range(chars.length, offset, length);
        StreamSupport.open(this.closed);
        int i = 0;
        while (i < length) { write((int) chars[offset + i]); i++; }
    }
    /** Writes the supplied data. */
    @Override
    public void write(String text, int offset, int length) throws IOException {

        StreamSupport.range(text.length(), offset, length);
        StreamSupport.open(this.closed);
        int i = 0;
        while (i < length) { write((int) text.charAt(offset + i)); i++; }
    }
    /** Flushes this output. */
    @Override
    public void flush() throws IOException {

        StreamSupport.open(this.closed);
        drain();
        if (this.ownedOutput != null) {
            this.ownedOutput.flush();
        } else {
            this.output.flush();
        }
    }
    /** Closes this resource. */
    @Override
    public void close() throws IOException {

        if (!this.closed) {
            this.closed = true;
            try {
                if (this.high != 0) { this.high = 0; malformed(); }
                drain();
                if (this.ownedOutput != null) {
                    this.ownedOutput.flush();
                } else {
                    this.output.flush();
                }
            } finally {
                if (this.ownedOutput != null) {
                    this.ownedOutput.close();
                } else {
                    this.output.close();
                }
            }
        }
    }
    destructor {

        free this.buffer; free this.ownedOutput;
    }
}
