package ironwood.net;

import ironwood.ds.ArrayList;
import ironwood.testing.TestSuite;
import ironwood.util.Enumeration;
import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;
import static ironwood.testing.Assertions.*;

final class TwoNames implements Enumeration<String> {

    private int position;

    @Override
    public boolean hasMoreElements() {

        return this.position < 2;
    }

    @Override
    public String nextElement() {

        if (!this.hasMoreElements()) throw new NoSuchElementException();
        return this.position++ == 0 ? "first" : "second";
    }
}

/** M3 public ownership contracts. Native queries are read-only; no live probes. */
public final class HostNetworkingTests extends TestSuite {

    @Test
    private void lookupArgumentContracts() throws Exception {

        boolean caught = false;
        try {
            NetworkInterface value = NetworkInterface.getByName(null);
            free value;
        } catch (NullPointerException expected) { caught = true; }
        assertTrue(caught);
        caught = false;
        try {
            NetworkInterface value = NetworkInterface.getByInetAddress(null);
            free value;
        } catch (NullPointerException expected) { caught = true; }
        assertTrue(caught);
        caught = false;
        try {
            NetworkInterface value = NetworkInterface.getByIndex(-1);
            free value;
        } catch (IllegalArgumentException expected) { caught = true; }
        assertTrue(caught);
        NetworkInterface absent = NetworkInterface.getByIndex(0);
        defer free absent;
        assertNull(absent);
    }

    @Test
    private void interfaceQueriesAndLiveMetadata() throws Exception {

        Enumeration<NetworkInterface> interfaces = NetworkInterface.getNetworkInterfaces();
        defer free interfaces;
        while (interfaces.hasMoreElements()) {
            NetworkInterface netif = interfaces.nextElement();
            assertNotNull(netif.getName());
            assertNotNull(netif.getDisplayName());
            NetworkInterface lookup = NetworkInterface.getByName(netif.getName());
            defer free lookup;
            assertNotNull(lookup);
            assertEquals(netif.getName(), lookup.getName());
            assertEquals(netif.hashCode(), lookup.hashCode());
            if (netif.getIndex() > 0) {
                NetworkInterface indexed = NetworkInterface.getByIndex(netif.getIndex());
                defer free indexed;
                assertNotNull(indexed);
                assertEquals(netif.getIndex(), indexed.getIndex());
            }
            assertTrue(netif.getMTU() >= 0);
            netif.isUp();
            netif.isLoopback();
            netif.isPointToPoint();
            netif.supportsMulticast();
            byte[] hardware = netif.getHardwareAddress();
            defer free hardware;
            if (hardware != null) assertTrue(hardware.length > 0);
            String text = netif.toString();
            defer free text;
            assertTrue(text.contains(netif.getName()));
        }
    }

    @Test
    private void addressAndChildCursorsAreIndependent() throws Exception {

        Enumeration<NetworkInterface> interfaces = NetworkInterface.getNetworkInterfaces();
        defer free interfaces;
        while (interfaces.hasMoreElements()) {
            NetworkInterface netif = interfaces.nextElement();
            Enumeration<InetAddress> first = netif.getInetAddresses();
            defer free first;
            Enumeration<InetAddress> second = netif.getInetAddresses();
            defer free second;
            while (first.hasMoreElements()) {
                assertTrue(second.hasMoreElements());
                InetAddress address = first.nextElement();
                assertTrue(address.equals(second.nextElement()));
                NetworkInterface lookup = NetworkInterface.getByInetAddress(address);
                defer free lookup;
                assertNotNull(lookup);
            }
            assertFalse(second.hasMoreElements());
            Enumeration<NetworkInterface> children = netif.getSubInterfaces();
            defer free children;
            while (children.hasMoreElements()) {
                NetworkInterface child = children.nextElement();
                assertTrue(child.isVirtual());
                assertTrue(child.getParent().equals(netif));
            }
        }
    }

    private static void checkBindings(String name) throws Exception {

        NetworkInterface netif = NetworkInterface.getByName(name);
        defer free netif;
        InterfaceAddress retained = null;
        ArrayList<InterfaceAddress> bindings = netif.getInterfaceAddresses();
        {
            defer free bindings;
            if (bindings.isEmpty()) return;
            retained = bindings.get(0);
            for (int index = 0; index < bindings.size(); index++) {
                InterfaceAddress binding = bindings.get(index);
                int width = binding.getAddress() instanceof Inet6Address ? 128 : 32;
                assertTrue(binding.getNetworkPrefixLength() >= 0);
                assertTrue(binding.getNetworkPrefixLength() <= width);
                if (binding.getBroadcast() != null) assertTrue(binding.getBroadcast() instanceof Inet4Address);
                String text = binding.toString();
                defer free text;
                assertTrue(text.length() > 0);
            }
            bindings.clear();
            assertTrue(bindings.isEmpty());
            bindings.add(retained);
            assertEquals(1, bindings.size());
            assertSame(retained, bindings.get(0));
        }
        assertNotNull(retained.getAddress());
    }

    @Test
    private void bindingEntriesOutliveTheirMutableList() throws Exception {

        Enumeration<NetworkInterface> interfaces = NetworkInterface.getNetworkInterfaces();
        defer free interfaces;
        while (interfaces.hasMoreElements()) checkBindings(interfaces.nextElement().getName());
    }

    private static Inet6Address scopedCopy(NetworkInterface netif, InetAddress source) throws Exception {

        byte[] bytes = source.getAddress();
        defer free bytes;
        Inet6Address scoped = Inet6Address.getByAddress("scoped-test", bytes, netif);
        defer free scoped;
        return (Inet6Address) scoped.copy();
    }

    @Test
    private void scopedIpv6CopiesRetainIndependentGraphs() throws Exception {

        // Hosts may disable IPv6. Test every IPv6 record that the OS provides;
        // controlled no-address and synthetic IPv6 cases live in the M3 driver.
        Enumeration<NetworkInterface> interfaces = NetworkInterface.getNetworkInterfaces();
        defer free interfaces;
        while (interfaces.hasMoreElements()) {
            NetworkInterface netif = interfaces.nextElement();
            Enumeration<InetAddress> addresses = netif.getInetAddresses();
            defer free addresses;
            while (addresses.hasMoreElements()) {
                InetAddress address = addresses.nextElement();
                if (address instanceof Inet6Address) {
                    Inet6Address copy = scopedCopy(netif, address);
                    defer free copy;
                    assertTrue(copy.equals(address));
                    assertEquals("scoped-test", copy.getHostName());
                    assertNotNull(copy.getScopedInterface());
                    assertNotSame(netif, copy.getScopedInterface());
                    assertEquals(netif.getName(), copy.getScopedInterface().getName());
                    assertTrue(copy.getScopeId() > 0);
                }
            }
        }
    }

    private static Inet6Address unscopedLoopback() throws Exception {

        byte[] bytes = new byte[16];
        defer free bytes;
        bytes[15] = 1;
        return Inet6Address.getByAddress(null, bytes, (NetworkInterface) null);
    }

    @Test
    private void nullInterfaceScopeCopiesItsAddressBytes() throws Exception {

        Inet6Address address = unscopedLoopback();
        defer free address;
        assertTrue(address.isLoopbackAddress());
        assertEquals(0, address.getScopeId());
        assertNull(address.getScopedInterface());
    }

    @Test
    private void iteratorAdapterAdvancesItsEnumeration() {

        TwoNames values = new TwoNames();
        defer free values;
        Iterator<String> iterator = values.asIterator();
        defer free iterator;
        assertTrue(iterator.hasNext());
        assertEquals("first", iterator.next());
        assertEquals("second", values.nextElement());
        assertFalse(iterator.hasNext());
        boolean caught = false;
        try { iterator.next(); } catch (NoSuchElementException expected) { caught = true; }
        assertTrue(caught);
        caught = false;
        try { iterator.remove(); } catch (UnsupportedOperationException expected) { caught = true; }
        assertTrue(caught);
    }

    @Test
    private void invalidReachabilityArgumentsNeverProbe() throws Exception {

        InetAddress address = NetworkingSupport.loopback();
        defer free address;
        boolean caught = false;
        try { address.isReachable(-1); } catch (IllegalArgumentException expected) { caught = true; }
        assertTrue(caught);
        caught = false;
        try { address.isReachable(null, -1, 0); } catch (IllegalArgumentException expected) { caught = true; }
        assertTrue(caught);
        caught = false;
        try { address.isReachable(null, 0, -1); } catch (IllegalArgumentException expected) { caught = true; }
        assertTrue(caught);
    }
}
