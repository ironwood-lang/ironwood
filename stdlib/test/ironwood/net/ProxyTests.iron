package ironwood.net;

import ironwood.testing.TestSuite;
import static ironwood.testing.Assertions.*;

/** M4 values, validation, copied ownership, direct routing and local deadlines. */
public final class ProxyTests extends TestSuite {

    private static Proxy route() {

        InetSocketAddress endpoint = InetSocketAddress.createUnresolved("proxy.invalid", 1080);
        defer free endpoint;
        return new Proxy(Proxy.Type.SOCKS, endpoint);
    }

    @Test
    private void routeOwnsItsEndpointAndRendersWithoutCredentials() {

        Proxy proxy = route();
        {
            defer free proxy;
            assertEquals(Proxy.Type.SOCKS, proxy.type());
            assertEquals("proxy.invalid", ((InetSocketAddress) proxy.address()).getHostString());
            String text = proxy.toString();
            {
                defer free text;
                assertEquals("SOCKS @ proxy.invalid/<unresolved>:1080", text);
            }
            assertSame(proxy.address(), proxy.address());
        }
        assertEquals(Proxy.Type.DIRECT, Proxy.NO_PROXY.type());
        assertNull(Proxy.NO_PROXY.address());
    }

    @Test
    private void equalityDescribesRouteRatherThanCredentialsOrVersion() {

        InetSocketAddress endpoint = InetSocketAddress.createUnresolved("proxy.invalid", 1080);
        defer free endpoint;
        byte[] secret = {85, 115, 101, 114};
        defer free secret;
        Proxy plain = new Proxy(Proxy.Type.SOCKS, endpoint);
        defer free plain;
        Proxy authenticated = Proxy.socks5(endpoint, secret, secret);
        defer free authenticated;
        Proxy v4 = Proxy.socks(endpoint, Proxy.SocksVersion.V4);
        defer free v4;
        assertTrue(plain.equals(authenticated));
        assertTrue(authenticated.equals(v4));
        assertEquals(plain.hashCode(), v4.hashCode());
        String text = authenticated.toString();
        defer free text;
        assertFalse(text.contains("User"));
    }

    private static Socket copiedSocket() {

        Proxy proxy = route();
        defer free proxy;
        return new Socket(proxy);
    }

    @Test
    private void socketsOwnIndependentCopiesOfProxyConfiguration() throws Exception {

        Socket warm = copiedSocket();
        {
            defer free warm;
            defer warm.close();
            warm.supportedOptions();
        }
        long baseline = System.liveAllocationCount();
        for (int index = 0; index < 20; index++) {
            Socket socket = copiedSocket();
            defer free socket;
            defer socket.close();
            assertFalse(socket.isConnected());
            assertNull(socket.getRemoteSocketAddress());
        }
        assertEquals(baseline, System.liveAllocationCount());
    }

    private static void socksLength(InetSocketAddress endpoint, int length, boolean accepted) {

        byte[] bytes = new byte[length];
        defer free bytes;
        boolean caught = false;
        try {
            Proxy proxy = Proxy.socks5(endpoint, bytes, bytes);
            free proxy;
        } catch (IllegalArgumentException expected) { caught = true; }
        assertEquals(!accepted, caught);
    }

    @Test
    private void socks5ValidatesEncodedOctetLengths() {

        InetSocketAddress endpoint = InetSocketAddress.createUnresolved("proxy.invalid", 1080);
        defer free endpoint;
        socksLength(endpoint, 0, false);
        socksLength(endpoint, 1, true);
        socksLength(endpoint, 255, true);
        socksLength(endpoint, 256, false);
    }

    private static void basicOctet(InetSocketAddress endpoint, int octet, boolean username, boolean accepted) {

        byte[] value = {(byte) octet};
        defer free value;
        byte[] empty = new byte[0];
        defer free empty;
        boolean caught = false;
        try {
            Proxy proxy = basicValue(endpoint, value, empty, username);
            free proxy;
        } catch (IllegalArgumentException expected) { caught = true; }
        assertEquals(!accepted, caught);
    }

    private static Proxy basicValue(InetSocketAddress endpoint, byte[] value, byte[] empty, boolean username) {

        if (username) return Proxy.httpConnectBasic(endpoint, value, empty);
        return Proxy.httpConnectBasic(endpoint, empty, value);
    }

    @Test
    private void basicRejectsControlsAndUsernameColonButKeepsEncodedBytes() {

        InetSocketAddress endpoint = InetSocketAddress.createUnresolved("proxy.invalid", 8080);
        defer free endpoint;
        for (int octet = 0; octet < 32; octet++) {
            basicOctet(endpoint, octet, true, false);
            basicOctet(endpoint, octet, false, false);
        }
        basicOctet(endpoint, 127, true, false);
        basicOctet(endpoint, 127, false, false);
        basicOctet(endpoint, 58, true, false);
        basicOctet(endpoint, 58, false, true);
        basicOctet(endpoint, 128, true, true);
        basicOctet(endpoint, 255, false, true);
        byte[] empty = new byte[0];
        defer free empty;
        Proxy proxy = Proxy.httpConnectBasic(endpoint, empty, empty);
        free proxy;
    }

    @Test
    private void socks4UserIdHasItsOwnNulTerminatedContract() {

        InetSocketAddress endpoint = InetSocketAddress.createUnresolved("proxy.invalid", 1080);
        defer free endpoint;
        byte[] bytes = new byte[0];
        {
            defer free bytes;
            Proxy proxy = Proxy.socks4(endpoint, bytes);
            free proxy;
        }
        byte[] nul = {0};
        defer free nul;
        boolean caught = false;
        try { Proxy invalid = Proxy.socks4(endpoint, nul); free invalid; }
        catch (IllegalArgumentException expected) { caught = true; }
        assertTrue(caught);
    }

    @Test
    private void factoriesRejectNullAndInvalidRoutesBeforeNetworking() {

        InetSocketAddress endpoint = InetSocketAddress.createUnresolved("proxy.invalid", 1080);
        {
            defer free endpoint;
            byte[] bytes = {1};
            {
                defer free bytes;
                for (int choice = 0; choice < 7; choice++) {
                    boolean caught = false;
                    try {
                        Proxy invalid = nullFactory(endpoint, bytes, choice);
                        free invalid;
                    } catch (NullPointerException expected) { caught = true; }
                    assertTrue(caught);
                }
            }
            boolean caught = false;
            try { Proxy invalid = new Proxy(Proxy.Type.DIRECT, endpoint); free invalid; }
            catch (IllegalArgumentException expected) { caught = true; }
            assertTrue(caught);
        }
        boolean caught = false;
        try { Socket invalid = new Socket((Proxy) null); free invalid; }
        catch (IllegalArgumentException expected) { caught = true; }
        assertTrue(caught);
    }

    private static Proxy nullFactory(InetSocketAddress endpoint, byte[] bytes, int choice) {

        if (choice == 0) return Proxy.socks5(null, bytes, bytes);
        if (choice == 1) return Proxy.socks5(endpoint, null, bytes);
        if (choice == 2) return Proxy.socks5(endpoint, bytes, null);
        if (choice == 3) return Proxy.httpConnectBasic(null, bytes, bytes);
        if (choice == 4) return Proxy.httpConnectBasic(endpoint, null, bytes);
        if (choice == 5) return Proxy.httpConnectBasic(endpoint, bytes, null);
        return Proxy.socks(endpoint, null);
    }

    @Test
    private void explicitDirectSocketKeepsNormalStreamAndOptionContracts() throws Exception {

        Socket socket = new Socket(Proxy.NO_PROXY);
        defer free socket;
        defer socket.close();
        Socket peer = NetworkingSupport.connectPair(socket);
        defer free peer;
        defer peer.close();
        socket.setOption(StandardSocketOptions.TCP_NODELAY, true);
        assertTrue(socket.getOption(StandardSocketOptions.TCP_NODELAY));
        socket.getOutputStream().write(42);
        assertEquals(42, peer.getInputStream().read());
        socket.getOutputStream().close();
        assertTrue(socket.isClosed());
    }

    @Test
    private void socks4RejectsUnresolvedAndIpv6Targets() throws Exception {

        InetSocketAddress endpoint = new InetSocketAddress("127.0.0.1", 1);
        defer free endpoint;
        Proxy proxy = Proxy.socks(endpoint, Proxy.SocksVersion.V4);
        defer free proxy;
        Socket socket = new Socket(proxy);
        {
            defer free socket;
            defer socket.close();
            InetSocketAddress target = InetSocketAddress.createUnresolved("target.invalid", 80);
            defer free target;
            boolean caught = false;
            try { socket.connect(target); } catch (UnknownHostException expected) { caught = true; }
            assertTrue(caught);
            assertTrue(socket.isClosed());
        }
        Socket ipv6 = new Socket(proxy);
        defer free ipv6;
        defer ipv6.close();
        InetSocketAddress target = new InetSocketAddress("::1", 80);
        defer free target;
        boolean caught = false;
        try { ipv6.connect(target); } catch (SocketException expected) { caught = true; }
        assertTrue(caught);
        assertTrue(ipv6.isClosed());
    }

    @Test
    private void proxyNegotiationUsesTheConnectTimeoutAndClosesOnFailure() throws Exception {

        InetAddress address = NetworkingSupport.loopback();
        defer free address;
        ServerSocket listener = new ServerSocket(0, 8, address);
        defer free listener;
        defer listener.close();
        InetSocketAddress endpoint = new InetSocketAddress(address, listener.getLocalPort());
        defer free endpoint;
        Proxy proxy = new Proxy(Proxy.Type.SOCKS, endpoint);
        defer free proxy;
        Socket socket = new Socket(proxy);
        defer free socket;
        defer socket.close();
        boolean caught = false;
        // The OS accepts the TCP connection into the backlog,
        // but no proxy reply arrives. SO_TIMEOUT is unrelated.
        socket.setSoTimeout(5000);
        try { socket.connect(endpoint, 50); } catch (SocketTimeoutException expected) { caught = true; }
        assertTrue(caught);
        assertTrue(socket.isClosed());
    }
}
