package ironwood.net;

import ironwood.io.IOException;
import ironwood.io.InputStream;
import static ironwood.testing.Assertions.*;

final class NetworkingSupport {

    static InetAddress loopback() throws UnknownHostException {

        byte[] bytes = {127, 0, 0, 1};
        defer free bytes;
        return InetAddress.getByAddress(bytes);
    }

    // Connect into the backlog before accept. The returned socket must remain
    // usable after the listener and its copied endpoint inputs are reclaimed.
    static Socket connectPair(Socket client) throws IOException {

        InetAddress address = loopback();
        defer free address;
        ServerSocket listener = new ServerSocket(0, 8, address);
        defer free listener;
        defer listener.close();
        listener.setSoTimeout(2000);
        SocketAddress endpoint = listener.getLocalSocketAddress();
        {
            defer free endpoint;
            client.connect(endpoint, 2000);
        }
        Socket accepted = listener.accept();
        return accepted;
    }

    static void readFully(InputStream input, byte[] bytes) throws IOException {

        int used = 0;
        while (used < bytes.length) {
            int count = input.read(bytes, used, bytes.length - used);
            assertTrue(count > 0, "unexpected EOF in loopback payload");
            used += count;
        }
    }
}
