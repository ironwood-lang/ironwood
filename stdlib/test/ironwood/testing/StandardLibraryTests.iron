package ironwood.testing;

import ironwood.ds.DataStructureTests;
import ironwood.ds.CollectionRetentionTests;
import ironwood.pool.PoolTests;
import ironwood.pool.PoolRetentionTests;
import ironwood.bench.BenchTests;
import ironwood.bench.NanoBenchTests;
import ironwood.net.TcpFoundationTests;
import ironwood.net.AddressSocketTests;
import ironwood.net.HostNetworkingTests;
import ironwood.net.ProxyTests;
import ironwood.net.TlsClientTests;

// Compile the repository suites together, then select one generated suite main
// per fresh process. Successful suites return 0; framework-failure must return 1.
// Missing or unknown selectors return 2. The script verifies each suite's output.
public final class StandardLibraryTests {

    public static int main(String[] args) {

        if (args.length != 1) return 2;
        String suite = args[0];
        if (suite.equals("framework-pass")) return FrameworkPassingTests.main(args);
        if (suite.equals("framework-failure")) return FrameworkFailureTests.main(args);
        if (suite.equals("pool")) return PoolTests.main(args);
        if (suite.equals("pool-retention")) return PoolRetentionTests.main(args);
        if (suite.equals("data-structures")) return DataStructureTests.main(args);
        if (suite.equals("collection-retention")) return CollectionRetentionTests.main(args);
        if (suite.equals("bench")) return BenchTests.main(args);
        if (suite.equals("nano-bench")) return NanoBenchTests.main(args);
        if (suite.equals("networking-m1")) return TcpFoundationTests.main(args);
        if (suite.equals("networking-m2")) return AddressSocketTests.main(args);
        if (suite.equals("networking-m3")) return HostNetworkingTests.main(args);
        if (suite.equals("networking-m4")) return ProxyTests.main(args);
        if (suite.equals("networking-m5")) return TlsClientTests.main(args);
        return 2;
    }
}
