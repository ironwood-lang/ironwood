    @Test
    private void byteMapPutsAndGets() {

        ByteMap<String> map = new ByteMap<String>();
        Assertions.assertNull(map.put((byte) 1, "value1"));
        Assertions.assertEquals("value1", map.get((byte) 1));
        Assertions.assertEquals(1, map.size());
        Assertions.assertFalse(map.isEmpty());
        free map;
    }

    @Test
    private void byteMapReplaces() {

        ByteMap<String> map = new ByteMap<String>();
        map.put((byte) 1, "value1");
        Assertions.assertEquals("value1", map.put((byte) 1, "value2"));
        Assertions.assertEquals("value2", map.get((byte) 1));
        Assertions.assertEquals(1, map.size());
        free map;
    }

    @Test
    private void byteMapRemoves() {

        ByteMap<String> map = new ByteMap<String>();
        map.put((byte) 1, "value1");
        Assertions.assertEquals("value1", map.remove((byte) 1));
        Assertions.assertNull(map.get((byte) 1));
        Assertions.assertEquals(0, map.size());
        Assertions.assertTrue(map.isEmpty());
        free map;
    }

    @Test
    private void byteMapChecksKeys() {

        ByteMap<String> map = new ByteMap<String>();
        Assertions.assertFalse(map.containsKey((byte) 1));
        map.put((byte) 1, "value1");
        Assertions.assertTrue(map.containsKey((byte) 1));
        free map;
    }

