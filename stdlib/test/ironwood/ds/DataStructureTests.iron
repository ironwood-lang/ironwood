        Assertions.assertTrue(map.isEmpty());
        Assertions.assertEquals(0, map.size());
        Assertions.assertNull(map.get((byte) 1));
        Assertions.assertNull(map.get((byte) 2));
        free map;
    }

    @Test
    private void byteMapIteratorTraverses() {

        ByteMap<String> map = new ByteMap<String>();
        map.put((byte) 1, "value1");
        map.put((byte) 2, "value2");
        Iterator<String> iterator = map.iterator();
        Assertions.assertEquals("value1", iterator.next());
        Assertions.assertEquals(1, map.getCurrIteratorKey());
        Assertions.assertEquals("value2", iterator.next());
        Assertions.assertEquals(2, map.getCurrIteratorKey());
        Assertions.assertFalse(iterator.hasNext());
        free map;
    }

