package ironwood.ds;

import ironwood.testing.Assertions;
import ironwood.testing.TestSuite;
import ironwood.util.Iterator;
import ironwood.util.NoSuchElementException;

class AsymmetricContainmentValue {

    int value;
    boolean matches;

    AsymmetricContainmentValue(int value, boolean matches) {

        this.value = value;
        this.matches = matches;
    }

    @Override
    public boolean equals(Object otherObject) {

        if (!(otherObject instanceof AsymmetricContainmentValue)) return false;
        AsymmetricContainmentValue other = (AsymmetricContainmentValue) otherObject;
        return this.matches && this.value == other.value;
    }

    @Override
    public int hashCode() {

        return this.value;
    }
}

public final class DataStructureTests extends TestSuite {

    @Test
    private void intListDefaultConstructor() {

        IntArrayList list = new IntArrayList();
        Assertions.assertTrue(list.isEmpty(), "new list is empty");
        Assertions.assertEquals(0, list.size(), "new list size");
        free list;
    }

    @Test
    private void intListInitialCapacityConstructor() {

        IntArrayList list = new IntArrayList(10);
        Assertions.assertTrue(list.isEmpty(), "new list is empty");
        Assertions.assertEquals(10, list.getInitialCapacity());
        free list;
    }

    @Test
    private void intListGrowthFactorConstructor() {

        IntArrayList list = new IntArrayList(2.0f);
        Assertions.assertTrue(list.isEmpty());
        Assertions.assertEquals(2.0f, list.getGrowthFactor(), 0.0f);
        free list;
    }

    @Test
    private void intListFullConstructor() {

        IntArrayList list = new IntArrayList(10, 2.0f);
        Assertions.assertTrue(list.isEmpty());
        Assertions.assertEquals(10, list.getInitialCapacity());
        Assertions.assertEquals(2.0f, list.getGrowthFactor(), 0.0f);
        free list;
    }

