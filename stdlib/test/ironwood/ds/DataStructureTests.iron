    @Test
    private void byteMapIteratorHandlesUnsignedDomainEnds() {

        ByteMap<String> map = new ByteMap<String>();
        map.put((byte) 0, "Zero");
        map.put((byte) 255, "Max");
        Iterator<String> iterator = map.iterator();
        Assertions.assertEquals("Zero", iterator.next());
