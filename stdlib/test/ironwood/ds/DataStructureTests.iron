    @Test
    private void byteMapIteratorRejectsRemoveBeforeNext() {

        ByteMap<String> map = new ByteMap<String>();
        map.put((byte) 1, "One");
        Iterator<String> iterator = map.iterator();
        boolean caught = false;
        try {
            iterator.remove();
