package ironwood.ds;

import ironwood.testing.Assertions;
import ironwood.testing.TestSuite;

class DestructionDataItem {

    static int destroyed;
    int value;

    DestructionDataItem(int value) {

        this.value = value;
    }

    @Override
    public int hashCode() {

        return this.value;
    }

    destructor {

        destroyed++;
    }
}

/** Ironwood-native coverage for container storage and borrowed-item destruction. */
public final class DataStructureDestructionTests extends TestSuite {

    @Test
    private void arrayListReclaimsStorageAndBorrowsItems() {

        long baseline = System.liveAllocationCount();
        int destroyed = DestructionDataItem.destroyed;
        DestructionDataItem item = new DestructionDataItem(42);
        long itemBaseline = System.liveAllocationCount();
        ArrayList<DestructionDataItem> list = new ArrayList<DestructionDataItem>(1);
        list.add(item);
        list.add(item);
        list.clear();
        list.add(item);
        Assertions.assertEquals(1, list.size());
        free list;
        Assertions.assertEquals(itemBaseline, System.liveAllocationCount());
        Assertions.assertEquals(destroyed, DestructionDataItem.destroyed);
        Assertions.assertEquals(42, item.value);
        free item;
        Assertions.assertEquals(destroyed + 1, DestructionDataItem.destroyed);
        Assertions.assertEquals(baseline, System.liveAllocationCount());
    }

    @Test
    private void arrayListRemoveFirstPreservesReclamation() {

        long baseline = System.liveAllocationCount();
        ArrayList<String> list = new ArrayList<String>(2);
        list.add("a");
        String removed = list.removeFirst();
        Assertions.assertEquals("a", removed);
        Assertions.assertEquals(0, list.size());
        free list;
        Assertions.assertEquals(baseline, System.liveAllocationCount());
    }

    @Test
    private void intArrayListReclaimsStorage() {

        long baseline = System.liveAllocationCount();
        IntArrayList list = new IntArrayList(1);
        for (int index = 0; index < 32; index++) list.add(index);
        list.clear();
        list.add(42);
        Assertions.assertEquals(42, list.iterator().next().get());
        free list;
        Assertions.assertEquals(baseline, System.liveAllocationCount());
    }

    @Test
    private void longArrayListReclaimsStorage() {

        long baseline = System.liveAllocationCount();
        LongArrayList list = new LongArrayList(1);
        for (int index = 0; index < 32; index++) list.add((long) index);
        list.clear();
        list.add(42L);
        Assertions.assertEquals(42L, list.iterator().next().get());
        free list;
        Assertions.assertEquals(baseline, System.liveAllocationCount());
    }

    @Test
    private void linkedListReclaimsEntriesAndBorrowsItems() {

        long baseline = System.liveAllocationCount();
        int destroyed = DestructionDataItem.destroyed;
        DestructionDataItem item = new DestructionDataItem(42);
        long itemBaseline = System.liveAllocationCount();
        LinkedList<DestructionDataItem> list = new LinkedList<DestructionDataItem>(1);
        list.add(item);
        list.addFirst(item);
        list.addLast(item);
        list.clear();
        list.add(item);
        Assertions.assertEquals(1, list.size());
        free list;
        Assertions.assertEquals(itemBaseline, System.liveAllocationCount());
        Assertions.assertEquals(destroyed, DestructionDataItem.destroyed);
        Assertions.assertEquals(42, item.value);
        free item;
        Assertions.assertEquals(destroyed + 1, DestructionDataItem.destroyed);
        Assertions.assertEquals(baseline, System.liveAllocationCount());
    }

