    @Test
    private void charSequenceMapReclaimsCopiedKeys() {

        long baseline = System.liveAllocationCount();
        int destroyed = DestructionDataItem.destroyed;
        DestructionDataItem item = new DestructionDataItem(42);
        StringBuilder key = new StringBuilder(4);
        key.append("key");
        long inputsBaseline = System.liveAllocationCount();
        CharSequenceMap<DestructionDataItem> map =
                new CharSequenceMap<DestructionDataItem>(1, (short) 4);
        map.put(key, item);
        map.clear();
        map.put(key, item);
        Assertions.assertEquals(1, map.size());
        free map;
        Assertions.assertEquals(inputsBaseline, System.liveAllocationCount());
        Assertions.assertEquals(destroyed, DestructionDataItem.destroyed);
        Assertions.assertEquals(3, key.length());
        Assertions.assertEquals(42, item.value);
        free key;
        free item;
        Assertions.assertEquals(destroyed + 1, DestructionDataItem.destroyed);
        Assertions.assertEquals(baseline, System.liveAllocationCount());
    }

