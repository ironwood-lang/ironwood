    @Test
    private void setAndHybridListToStringPreservesReclamation() {

        HashSet<String> setWarmup = new HashSet<String>(1);
        LinkedHashSet<String> linkedSetWarmup = new LinkedHashSet<String>(1);
        IntSet intSetWarmup = new IntSet(1);
        LongSet longSetWarmup = new LongSet(1);
        free setWarmup;
        free linkedSetWarmup;
        free intSetWarmup;
        free longSetWarmup;
        long baseline = System.liveAllocationCount();

        HashSet<String> set = new HashSet<String>(2);
        set.add("a");
        String setText = set.toString();
        Assertions.assertTrue(setText.equals("[a]"));
        free setText;
        free set;
        Assertions.assertEquals(baseline, System.liveAllocationCount(),
                "set rendering leaked");

        IdentityHashSet<String> identitySet = new IdentityHashSet<String>(2);
        identitySet.add("a");
        String identitySetText = identitySet.toString();
        Assertions.assertTrue(identitySetText.equals("[a]"));
        free identitySetText;
        free identitySet;
        Assertions.assertEquals(baseline, System.liveAllocationCount(),
                "identity set rendering leaked");

        LinkedHashSet<String> linkedSet = new LinkedHashSet<String>(2);
        linkedSet.add("a");
        String linkedSetText = linkedSet.toString();
        Assertions.assertTrue(linkedSetText.equals("[a]"));
        free linkedSetText;
        free linkedSet;
        Assertions.assertEquals(baseline, System.liveAllocationCount(),
                "linked set rendering leaked");

        IntSet intSet = new IntSet(2);
        intSet.add(1);
        String intSetText = intSet.toString();
        Assertions.assertTrue(intSetText.equals("[1]"));
        free intSetText;
        free intSet;
        Assertions.assertEquals(baseline, System.liveAllocationCount(),
                "int set rendering leaked");

        LongSet longSet = new LongSet(2);
        longSet.add(1L);
        String longSetText = longSet.toString();
        Assertions.assertTrue(longSetText.equals("[1]"));
        free longSetText;
        free longSet;
        Assertions.assertEquals(baseline, System.liveAllocationCount(),
                "long set rendering leaked");

        ArrayLinkedList<String> list = new ArrayLinkedList<String>(1);
        list.addLast("a");
        list.addLast("b");
        String listText = list.toString();
        Assertions.assertTrue(listText.equals("[a, b]"));
        free listText;
        free list;
        Assertions.assertEquals(baseline, System.liveAllocationCount(),
                "hybrid list rendering leaked");
    }

    /* Compiling this helper proves implicit toString conversion does not publish the set. */
    private void setConcatenationAllowsReclamation() {

        HashSet<String> set = new HashSet<String>(2);
        set.add("a");
        String text = "set=" + set;
        free text;
        free set;
    }

    @Test
    private void unmodifiableViewsReclaimOnlyTheirIterators() {

        long baseline = System.liveAllocationCount();
        int destroyed = DestructionDataItem.destroyed;
        DestructionDataItem item = new DestructionDataItem(42);
        ArrayList<DestructionDataItem> list = new ArrayList<DestructionDataItem>(1);
        list.add(item);
        UnmodifiableList<DestructionDataItem> first = Collections.unmodifiableList(list);
        UnmodifiableList<DestructionDataItem> second = Collections.unmodifiableList(list);
        Assertions.assertEquals(1, first.size());
        Assertions.assertFalse(second.isEmpty());
        free first;
        free second;
        Assertions.assertEquals(destroyed, DestructionDataItem.destroyed);
        Assertions.assertEquals(1, list.size());
        free list;
        Assertions.assertEquals(destroyed, DestructionDataItem.destroyed);
        Assertions.assertEquals(42, item.value);
        free item;
        Assertions.assertEquals(destroyed + 1, DestructionDataItem.destroyed);
        Assertions.assertEquals(baseline, System.liveAllocationCount());
    }
}
