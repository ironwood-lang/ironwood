    private boolean writeExpression(Expression value) {

        if (value == null) return this.writeNull();
        return switch (value.expressionVariant()) {
            case ARRAY_ACCESS_EXPRESSION -> this.writeArrayAccessExpression((ArrayAccessExpression) value);
            case ARRAY_CREATION_EXPRESSION -> this.writeArrayCreationExpression((ArrayCreationExpression) value);
            case ARRAY_INITIALIZER_EXPRESSION -> this.writeArrayInitializerExpression((ArrayInitializerExpression) value);
            case ASSIGNMENT_EXPRESSION -> this.writeAssignmentExpression((AssignmentExpression) value);
            case BINARY_EXPRESSION -> this.writeBinaryExpression((BinaryExpression) value);
            case BOOLEAN_LITERAL_EXPRESSION -> this.writeBooleanLiteralExpression((BooleanLiteralExpression) value);
            case CALL_EXPRESSION -> this.writeCallExpression((CallExpression) value);
            case CAST_EXPRESSION -> this.writeCastExpression((CastExpression) value);
            case CHARACTER_LITERAL_EXPRESSION -> this.writeCharacterLiteralExpression((CharacterLiteralExpression) value);
            case CONDITIONAL_EXPRESSION -> this.writeConditionalExpression((ConditionalExpression) value);
            case FIELD_ACCESS_EXPRESSION -> this.writeFieldAccessExpression((FieldAccessExpression) value);
            case FLOATING_LITERAL_EXPRESSION -> this.writeFloatingLiteralExpression((FloatingLiteralExpression) value);
            case INSTANCE_OF_EXPRESSION -> this.writeInstanceOfExpression((InstanceOfExpression) value);
            case INTEGER_LITERAL_EXPRESSION -> this.writeIntegerLiteralExpression((IntegerLiteralExpression) value);
            case INTERFACE_SUPER_EXPRESSION -> this.writeInterfaceSuperExpression((InterfaceSuperExpression) value);
            case NAME_EXPRESSION -> this.writeNameExpression((NameExpression) value);
            case NEW_EXPRESSION -> this.writeNewExpression((NewExpression) value);
            case NULL_LITERAL_EXPRESSION -> this.writeNullLiteralExpression((NullLiteralExpression) value);
            case QUALIFIED_SUPER_CONSTRUCTOR_EXPRESSION -> this.writeQualifiedSuperConstructorExpression((QualifiedSuperConstructorExpression) value);
            case QUALIFIED_THIS_EXPRESSION -> this.writeQualifiedThisExpression((QualifiedThisExpression) value);
            case STRING_LITERAL_EXPRESSION -> this.writeStringLiteralExpression((StringLiteralExpression) value);
            case SUPER_EXPRESSION -> this.writeSuperExpression((SuperExpression) value);
            case SWITCH_EXPRESSION -> this.writeSwitchExpression((SwitchExpression) value);
            case THIS_EXPRESSION -> this.writeThisExpression((ThisExpression) value);
            case UNARY_EXPRESSION -> this.writeUnaryExpression((UnaryExpression) value);
            case UPDATE_EXPRESSION -> this.writeUpdateExpression((UpdateExpression) value);
        };
    }

    private boolean writeInstanceInitialization(InstanceInitialization value) {

        if (value == null) return this.writeNull();
        return switch (value.initializationVariant()) {
            case BLOCK -> this.writeBlock((Block) value);
            case FIELD_DECLARATION -> this.writeFieldDeclaration((FieldDeclaration) value);
        };
    }

    private boolean writeStatement(Statement value) {

        if (value == null) return this.writeNull();
        return switch (value.statementVariant()) {
            case ASSIGNMENT_STATEMENT -> this.writeAssignmentStatement((AssignmentStatement) value);
            case BLOCK -> this.writeBlock((Block) value);
            case BREAK_STATEMENT -> this.writeBreakStatement((BreakStatement) value);
            case CONTINUE_STATEMENT -> this.writeContinueStatement((ContinueStatement) value);
            case DEFER_STATEMENT -> this.writeDeferStatement((DeferStatement) value);
            case DEFERRED_FREE_STATEMENT -> this.writeDeferredFreeStatement((DeferredFreeStatement) value);
            case DO_WHILE_STATEMENT -> this.writeDoWhileStatement((DoWhileStatement) value);
            case EMPTY_STATEMENT -> this.writeEmptyStatement((EmptyStatement) value);
            case ENHANCED_FOR_STATEMENT -> this.writeEnhancedForStatement((EnhancedForStatement) value);
            case ENUM_CONSTANT_INITIALIZATION -> this.writeEnumConstantInitialization((EnumConstantInitialization) value);
            case EXPRESSION_STATEMENT -> this.writeExpressionStatement((ExpressionStatement) value);
            case FOR_STATEMENT -> this.writeForStatement((ForStatement) value);
            case FREE_STATEMENT -> this.writeFreeStatement((FreeStatement) value);
            case IF_STATEMENT -> this.writeIfStatement((IfStatement) value);
            case LABELED_STATEMENT -> this.writeLabeledStatement((LabeledStatement) value);
            case LOCAL_CLASS_DECLARATION -> this.writeLocalClassDeclaration((LocalClassDeclaration) value);
            case LOCAL_VARIABLE_DECLARATION -> this.writeLocalVariableDeclaration((LocalVariableDeclaration) value);
            case MODERN_SWITCH_STATEMENT -> this.writeModernSwitchStatement((ModernSwitchStatement) value);
            case RETURN_STATEMENT -> this.writeReturnStatement((ReturnStatement) value);
            case SUPER_CONSTRUCTOR_INVOCATION -> this.writeSuperConstructorInvocation((SuperConstructorInvocation) value);
            case SWITCH_STATEMENT -> this.writeSwitchStatement((SwitchStatement) value);
            case THIS_CONSTRUCTOR_INVOCATION -> this.writeThisConstructorInvocation((ThisConstructorInvocation) value);
            case THROW_STATEMENT -> this.writeThrowStatement((ThrowStatement) value);
            case TRY_STATEMENT -> this.writeTryStatement((TryStatement) value);
            case WHILE_STATEMENT -> this.writeWhileStatement((WhileStatement) value);
            case YIELD_STATEMENT -> this.writeYieldStatement((YieldStatement) value);
        };
    }

    private boolean writeStaticInitialization(StaticInitialization value) {

        if (value == null) return this.writeNull();
        return switch (value.initializationVariant()) {
            case BLOCK -> this.writeBlock((Block) value);
            case FIELD_DECLARATION -> this.writeFieldDeclaration((FieldDeclaration) value);
        };
    }

    private boolean writeSwitchRuleBody(SwitchRuleBody value) {

        if (value == null) return this.writeNull();
        return switch (value.switchRuleBodyVariant()) {
            case SWITCH_RULE_BLOCK -> this.writeSwitchRuleBlock((SwitchRuleBlock) value);
            case SWITCH_RULE_EXPRESSION -> this.writeSwitchRuleExpression((SwitchRuleExpression) value);
            case SWITCH_RULE_THROW -> this.writeSwitchRuleThrow((SwitchRuleThrow) value);
        };
    }

    private boolean writeTypeDeclaration(TypeDeclaration value) {

        if (value == null) return this.writeNull();
        return switch (value.typeDeclarationVariant()) {
            case CLASS_DECLARATION -> this.writeClassDeclaration((ClassDeclaration) value);
            case INTERFACE_DECLARATION -> this.writeInterfaceDeclaration((InterfaceDeclaration) value);
        };
    }

    destructor {

        free this.out;
    }
}
