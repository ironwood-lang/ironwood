    private boolean writeClassDeclaration(ClassDeclaration value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("ClassDeclaration");
        this.field("accessModifier");
        this.writeEnum("AccessModifier", value.accessModifier() == null ? null : value.accessModifier().name());
        this.field("isStatic");
        this.writeBoolean(value.isStatic());
        this.field("isAbstract");
        this.writeBoolean(value.isAbstract());
        this.field("isFinal");
        this.writeBoolean(value.isFinal());
        this.field("name");
        this.writeString(value.name());
        this.field("nameSpan");
        this.writeSpan(value.nameSpan());
        this.field("typeParameters");
        this.writeTypeParameterList(value.typeParameters());
        this.field("superclass");
        this.writeOptionalTypeReference(value.superclass());
        this.field("implementedInterfaces");
        this.writeTypeReferenceList(value.implementedInterfaces());
        this.field("fields");
        this.writeFieldDeclarationList(value.fields());
        this.field("instanceInitializations");
        this.writeInstanceInitializationList(value.instanceInitializations());
        this.field("staticInitializations");
        this.writeStaticInitializationList(value.staticInitializations());
        this.field("constructors");
        this.writeConstructorDeclarationList(value.constructors());
        this.field("destructor");
        this.writeOptionalDestructorDeclaration(value.destructorDeclaration());
        this.field("methods");
        this.writeMethodDeclarationList(value.methods());
        this.field("memberTypes");
        this.writeTypeDeclarationList(value.memberTypes());
        this.field("enumType");
        this.writeBoolean(value.enumType());
        this.field("enumConstants");
        this.writeEnumConstantList(value.enumConstants());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeCompilationUnit(CompilationUnit value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("CompilationUnit");
        this.field("source");
        this.writeSource(value.source());
        this.field("packageDeclaration");
        this.writeOptionalPackageDeclaration(value.packageDeclaration());
        this.field("imports");
        this.writeImportDeclarationList(value.imports());
        this.field("declarations");
        this.writeTypeDeclarationList(value.declarations());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeConditionalExpression(ConditionalExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("ConditionalExpression");
        this.field("condition");
        this.writeExpression(value.condition());
        this.field("whenTrue");
        this.writeExpression(value.whenTrue());
        this.field("whenFalse");
        this.writeExpression(value.whenFalse());
        this.field("questionSpan");
        this.writeSpan(value.questionSpan());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeConstructorDeclaration(ConstructorDeclaration value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("ConstructorDeclaration");
        this.field("accessModifier");
        this.writeEnum("AccessModifier", value.accessModifier() == null ? null : value.accessModifier().name());
        this.field("typeParameters");
        this.writeTypeParameterList(value.typeParameters());
        this.field("name");
        this.writeString(value.name());
        this.field("nameSpan");
        this.writeSpan(value.nameSpan());
        this.field("parameters");
        this.writeParameterList(value.parameters());
        this.field("thrownTypes");
        this.writeTypeNameList(value.thrownTypes());
        this.field("superInvocation");
        this.writeOptionalSuperConstructorInvocation(value.superInvocation());
        this.field("thisInvocation");
        this.writeOptionalThisConstructorInvocation(value.thisInvocation());
        this.field("body");
        this.writeBlock(value.body());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

