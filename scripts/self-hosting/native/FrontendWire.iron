    private boolean writeForStatement(ForStatement value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("ForStatement");
        this.field("initializer");
        this.writeOptionalStatement(value.initializer());
        this.field("condition");
        this.writeOptionalExpression(value.condition());
        this.field("updates");
        this.writeExpressionList(value.updates());
