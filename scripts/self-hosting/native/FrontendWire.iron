import ironwood.compiler.ast.*;
import ironwood.compiler.diagnostic.Diagnostic;
import ironwood.compiler.diagnostic.DiagnosticNote;
import ironwood.compiler.lexer.Token;
import ironwood.compiler.port.SnapshotInts;
import ironwood.compiler.port.SnapshotList;
import ironwood.compiler.source.SourceFile;
import ironwood.compiler.source.SourcePosition;
import ironwood.compiler.source.SourceSpan;

/**
 * Test-only structural wire writer for the native frontend pilot. It emits the
 * same bytes as ReferenceCapture's reflective writer for tokens, diagnostics
 * and the AST: records as objects with a "node" name and components in record
 * order, Optional components as {"optional":...}, lists as arrays, int as
 * Integer payloads, enums with their declaring type, and source files as the
 * file name plus the UTF-8 SHA-256 of the input. Native code computes no
 * digest: the harness supplies the input's hash and this writer prints it.
 * While writing, the writer reports every object it reaches to the census,
 * which counts each distinct allocation once.
 * Every AST variant is dispatched by an exhaustive switch over its variant
 * enum, so an untreated variant fails compilation (D260).
 */
final class FrontendWire {

    private final StringBuilder out = new StringBuilder(65536);
    private final SourceFile source;
    private final String sourceHash;
    private final FrontendCensus census;

    FrontendWire(SourceFile source, String sourceHash, FrontendCensus census) {

        this.source = source;
        this.sourceHash = sourceHash;
        this.census = census;
    }

    /** @return the accumulated text, borrowed until the next reset */
    StringBuilder text() {

        return this.out;
    }

    void reset() {

        this.out.setLength(0);
    }

    void writeTokens(SnapshotList<Token> tokens) {

        this.census.count(tokens, this.census.listCost());
        this.openList();
        for (int index = 0; index < tokens.size(); index++) {
            this.element(index);
            this.writeToken(tokens.get(index));
        }
        this.closeList();
        this.out.append('\n');
    }

    void writeDiagnostics(SnapshotList<Diagnostic> diagnostics) {

        this.census.count(diagnostics, this.census.listCost());
        this.openList();
        for (int index = 0; index < diagnostics.size(); index++) {
            this.element(index);
            this.writeDiagnostic(diagnostics.get(index));
        }
        this.closeList();
        this.out.append('\n');
    }

    void writeUnit(CompilationUnit unit) {

        this.openOptional();
        this.writeCompilationUnit(unit);
        this.closeOptional();
        this.out.append('\n');
    }

    private boolean writeToken(Token value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("Token");
        this.field("kind");
        this.writeEnum("TokenKind", value.kind().name());
        this.field("lexeme");
        this.writeString(value.lexeme());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeDiagnostic(Diagnostic value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("Diagnostic");
        this.field("message");
        this.writeString(value.message());
        this.field("source");
        this.writeSource(value.source());
        this.field("span");
        this.writeSpan(value.span());
        this.field("severity");
        this.writeEnum("Severity", value.severity().name());
        this.field("notes");
        SnapshotList<DiagnosticNote> notes = value.notes();
        this.census.count(notes, this.census.listCost());
        this.openList();
        for (int index = 0; index < notes.size(); index++) {
            this.element(index);
            this.writeNote(notes.get(index));
        }
        this.closeList();
        return this.close();
    }

    private boolean writeNote(DiagnosticNote value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("DiagnosticNote");
        this.field("message");
        this.writeString(value.message());
        this.field("source");
        this.writeSource(value.source());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeSpan(SourceSpan value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("SourceSpan");
        this.field("start");
        this.writePosition(value.start());
        this.field("end");
        this.writePosition(value.end());
        return this.close();
    }

    private boolean writePosition(SourcePosition value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("SourcePosition");
        this.field("offset");
        this.writeInteger(value.offset());
        this.field("line");
        this.writeInteger(value.line());
        this.field("column");
        this.writeInteger(value.column());
        return this.close();
    }

    private boolean writeSource(SourceFile value) {

        if (value == null) return this.writeNull();
        if (value != this.source) throw new IllegalStateException("output refers to a different source file");
        // Source files and their names exist before the measured phase.
        this.out.append("{\"source\":");
        this.writeText(value.fileName());
        this.out.append(",\"sha256_utf8\":\"");
        this.out.append(this.sourceHash);
        this.out.append("\"}");
        return true;
    }

    private boolean writeCounts(SnapshotInts values) {

        if (values == null) return this.writeNull();
        this.census.count(values, this.census.intsCost());
        this.openList();
        for (int index = 0; index < values.size(); index++) {
            this.element(index);
            this.writeInteger(values.get(index));
        }
        return this.closeList();
    }

    private boolean writeNull() {

        this.out.append("null");
        return true;
    }

    private boolean writeBoolean(boolean value) {

        this.out.append(value ? "true" : "false");
        return true;
    }

    private boolean writeInteger(int value) {

        this.out.append("{\"number_kind\":\"Integer\",\"payload\":\"");
        this.out.append(value);
        this.out.append("\"}");
        return true;
    }

    private boolean writeEnum(String declaringType, String name) {

        if (name == null) return this.writeNull();
        this.out.append("{\"enum\":\"");
        this.out.append(declaringType);
        this.out.append("\",\"name\":\"");
        this.out.append(name);
        this.out.append("\"}");
        return true;
    }

    private boolean writeString(String value) {

        if (value == null) return this.writeNull();
        this.census.count(value, this.census.stringCost());
        return this.writeText(value);
    }

    // Java's quote: escape quote and backslash, keep printable ASCII, and
    // write every other UTF-16 unit as a lowercase four-digit \\u escape.
    private boolean writeText(String value) {

        if (value == null) return this.writeNull();
        this.out.append('"');
        for (int index = 0; index < value.length(); index++) {
            char current = value.charAt(index);
            if (current == '"' || current == '\\') {
                this.out.append('\\');
                this.out.append(current);
            } else if (current >= 32 && current <= 126) {
                this.out.append(current);
            } else {
                this.out.append("\\u");
                for (int shift = 12; shift >= 0; shift -= 4) {
                    this.out.append(Character.forDigit((current >> shift) & 15, 16));
                }
            }
        }
        this.out.append('"');
        return true;
    }

    private void open(String node) {

        this.out.append("{\"node\":\"");
        this.out.append(node);
        this.out.append('"');
    }

    private void field(String name) {

        this.out.append(",\"");
        this.out.append(name);
        this.out.append("\":");
    }

    private boolean close() {

        this.out.append('}');
        return true;
    }

    private void openList() {

        this.out.append('[');
    }

    private void element(int index) {

        if (index > 0) this.out.append(',');
    }

    private boolean closeList() {

        this.out.append(']');
        return true;
    }

    private void openOptional() {

        this.out.append("{\"optional\":");
    }

    private boolean closeOptional() {

        this.out.append('}');
        return true;
    }

    private boolean writeAnonymousClassBody(AnonymousClassBody value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("AnonymousClassBody");
        this.field("fields");
        this.writeFieldDeclarationList(value.fields());
        this.field("instanceInitializations");
        this.writeInstanceInitializationList(value.instanceInitializations());
        this.field("staticInitializations");
        this.writeStaticInitializationList(value.staticInitializations());
        this.field("destructor");
        this.writeOptionalDestructorDeclaration(value.destructorDeclaration());
        this.field("methods");
        this.writeMethodDeclarationList(value.methods());
        this.field("memberTypes");
        this.writeTypeDeclarationList(value.memberTypes());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeArrayAccessExpression(ArrayAccessExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("ArrayAccessExpression");
        this.field("array");
        this.writeExpression(value.array());
        this.field("index");
        this.writeExpression(value.index());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeArrayCreationExpression(ArrayCreationExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("ArrayCreationExpression");
        this.field("elementType");
        this.writeTypeName(value.elementType());
        this.field("length");
        this.writeOptionalExpression(value.length());
        this.field("initializer");
        this.writeOptionalArrayInitializerExpression(value.initializer());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeArrayInitializerExpression(ArrayInitializerExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("ArrayInitializerExpression");
        this.field("elements");
        this.writeExpressionList(value.elements());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeAssignmentExpression(AssignmentExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("AssignmentExpression");
        this.field("target");
        this.writeExpression(value.target());
        this.field("operator");
        this.writeEnum("AssignmentOperator", value.operator() == null ? null : value.operator().name());
        this.field("operatorSpan");
        this.writeSpan(value.operatorSpan());
        this.field("value");
        this.writeExpression(value.value());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeAssignmentStatement(AssignmentStatement value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("AssignmentStatement");
        this.field("target");
        this.writeExpression(value.target());
        this.field("equalsSpan");
        this.writeSpan(value.equalsSpan());
        this.field("value");
        this.writeExpression(value.value());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeBinaryExpression(BinaryExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("BinaryExpression");
        this.field("left");
        this.writeExpression(value.left());
        this.field("operator");
        this.writeEnum("BinaryOperator", value.operator() == null ? null : value.operator().name());
        this.field("right");
        this.writeExpression(value.right());
        this.field("operatorSpan");
        this.writeSpan(value.operatorSpan());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeBlock(Block value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("Block");
        this.field("statements");
        this.writeStatementList(value.statements());
        this.field("span");
