        this.openOptional();
        this.writeArrayInitializerExpression(value);
        return this.closeOptional();
    }

    private boolean writeOptionalBlock(Block value) {

        this.openOptional();
        this.writeBlock(value);
        return this.closeOptional();
    }

    private boolean writeOptionalDestructorDeclaration(DestructorDeclaration value) {

        this.openOptional();
        this.writeDestructorDeclaration(value);
