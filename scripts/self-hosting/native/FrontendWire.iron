        return this.close();
    }

    private boolean writeBooleanLiteralExpression(BooleanLiteralExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("BooleanLiteralExpression");
        this.field("value");
        this.writeBoolean(value.value());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeBreakStatement(BreakStatement value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("BreakStatement");
        this.field("label");
        this.writeOptionalString(value.label());
        this.field("labelSpan");
        this.writeOptionalSourceSpan(value.labelSpan());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeCallExpression(CallExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("CallExpression");
        this.field("receiver");
        this.writeOptionalExpression(value.receiver());
        this.field("typeArguments");
        this.writeTypeNameList(value.typeArguments());
        this.field("methodName");
        this.writeString(value.methodName());
        this.field("methodNameSpan");
        this.writeSpan(value.methodNameSpan());
        this.field("arguments");
        this.writeExpressionList(value.arguments());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeCastExpression(CastExpression value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("CastExpression");
        this.field("targetType");
        this.writeTypeName(value.targetType());
        this.field("operand");
        this.writeExpression(value.operand());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeCatchClause(CatchClause value) {

        if (value == null) return this.writeNull();
        this.census.count(value, 1);
        this.open("CatchClause");
        this.field("types");
        this.writeTypeNameList(value.types());
        this.field("isFinal");
        this.writeBoolean(value.isFinal());
        this.field("variableName");
        this.writeString(value.variableName());
        this.field("variableNameSpan");
        this.writeSpan(value.variableNameSpan());
        this.field("body");
        this.writeBlock(value.body());
        this.field("span");
        this.writeSpan(value.span());
        return this.close();
    }

    private boolean writeCharacterLiteralExpression(CharacterLiteralExpression value) {

        if (value == null) return this.writeNull();
