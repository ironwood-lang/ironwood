package org.ironwood.anonymousclasses;

class AnonymousBox {

    int value;

    AnonymousBox(int value) {

        this.value = value;
    }
}

class AnonymousBase {

    int value;

    AnonymousBase(int value) {

        this.value = value;
    }

    int result() {

        return value;
    }
}

interface AnonymousValue {

    int result();

    default int plus(int amount) {

        return result() + amount;
    }
}

// Demonstrates anonymous subclasses and captures; no output, exit status 42.
public class AnonymousClasses {

    private int outer;

    AnonymousClasses(int outer) {

        this.outer = outer;
    }

    int run(int seed) {

        AnonymousBox captured = new AnonymousBox(7);
        AnonymousBase base = new AnonymousBase(seed) {

            @Override
            int result() {

                return super.result() + captured.value + AnonymousClasses.this.outer;
            }
        };
        AnonymousValue value = new AnonymousValue() {

            @Override
            public int result() {

                return seed + AnonymousClasses.this.outer;
            }
        };
        int result = base.result() + value.plus(5);
        free value;
        free base;
        // The captured box remains allocated under conservative capture analysis.
        return result;
    }

    public static int main(String[] args) {

        AnonymousClasses owner = new AnonymousClasses(5);
        try {
            return owner.run(10);
        } finally {
            // run() does not publish its enclosing instance.
            free owner;
        }
    }
}
