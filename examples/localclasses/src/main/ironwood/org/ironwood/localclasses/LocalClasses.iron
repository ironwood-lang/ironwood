package org.ironwood.localclasses;

class LocalBase {

    private int value;

    LocalBase(int value) {

        this.value = value;
    }

    int value() {

        return value;
    }
}

public class LocalClasses {

    static int calculate() {

        class Local extends LocalBase {

            Local(int value) {

                super(value);
            }

            int answer() {

                return value() + 2;
            }
        }

        // The Local instance is an unnamed temporary, reclaimed after answer returns.
        return new Local(40).answer();
    }

    public static int main(String[] args) {

        return calculate();
    }
}
