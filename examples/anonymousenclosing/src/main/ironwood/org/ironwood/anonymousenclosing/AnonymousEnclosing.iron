package org.ironwood.anonymousenclosing;

class EnclosingOuter {

    private int amount;
    private int order;

    EnclosingOuter(int amount) {

        this.amount = amount;
    }

    EnclosingOuter choose(EnclosingOuter other) {

        if (this.order != 0) this.amount = 100;
        this.order = 1;
        return other;
    }

    int nextBase() {

        if (this.order != 1) this.amount = 100;
        this.order = 2;
        return 5;
    }

    class Inner {

        int value;

        <T> Inner(T ignored, int base, int first, int second) {

            this.value = base + first + second + amount;
        }

        int result() {

            return value;
        }
    }

    int run(EnclosingOuter other) {

        int captured = 2;
        Inner value =
                choose(other).new <String> Inner("ignored", nextBase(), 10, 10) {

            @Override
            int result() {

                return super.result() + captured + EnclosingOuter.this.amount;
            }
        };

        // The superclass Inner retains other, while this anonymous body retains
        // the lexical EnclosingOuter on which run was invoked.
        int result = this.order != 2 ? 100 : value.result();
        free value;
        return result;
    }
}

public class AnonymousEnclosing {

    public static int main(String[] args) {

        EnclosingOuter lexical = new EnclosingOuter(5);
        EnclosingOuter other = new EnclosingOuter(10);
        int result = lexical.run(other);
        // other escapes through run and cannot be proven safe to reclaim here.
        free lexical;
        return result;
    }
}
