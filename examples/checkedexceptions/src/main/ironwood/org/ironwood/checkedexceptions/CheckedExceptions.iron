package org.ironwood.checkedexceptions;

class ReadFailure extends Exception {

}

interface Reader {

    int read() throws ReadFailure;
}

class FailingReader implements Reader {

    FailingReader(boolean ready) throws ReadFailure {

        if (!ready) throw new ReadFailure();
    }

    @Override
    public int read() throws ReadFailure {

        throw new ReadFailure();
    }
}

public class CheckedExceptions {

    static int load(Reader reader) throws ReadFailure {

        return reader.read();
    }

    public static int main(String[] args) {

        try {
            Reader reader = new FailingReader(true);
            try {
                return load(reader);
            } finally {
                free reader;
            }
        } catch (ReadFailure failure) {

            return 42;
        }
    }
}
