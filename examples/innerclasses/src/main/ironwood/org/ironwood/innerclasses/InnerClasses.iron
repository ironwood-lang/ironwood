package org.ironwood.innerclasses;

class InnerOuter {

    private int base;

    InnerOuter(int base) {

        this.base = base;
    }

    class Inner {

        private int addition;

        Inner(int addition) {

            this.addition = addition;
        }

        int answer() {

            return InnerOuter.this.base + this.addition;
        }
    }

    Inner make(int addition) {

        return new Inner(addition);
    }
}

public class InnerClasses {

    public static int main(String[] args) {

        InnerOuter outer = new InnerOuter(40);
        InnerOuter.Inner explicit = outer.new Inner(2);
        InnerOuter.Inner implicit = outer.make(2);

        // Invalid while either inner object remains live:
        // free outer;

        int result = explicit.answer() != 42 || implicit.answer() != 42 ? 1 : 42;
        free implicit;
        free explicit;
        // outer escapes through make; its reclamation is not proven here.
        return result;
    }
}
