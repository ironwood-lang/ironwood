package org.ironwood.inheritance;

public class Plus extends Base implements Value, Tagged {

    private int delta;

    public Plus(int seed, int delta) {

        super(seed);
        this.delta = delta;
    }

    @Override
    public int value() {

        return seed + this.delta;
    }

    @Override
    public int tag() {

        return 5;
    }
}
