package org.ironwood.nestaccess;

abstract class NestReader {

    abstract int read();
}

public class NestAccess {

    private int secret;

    NestAccess(int secret) {

        this.secret = secret;
    }

    private class MemberReader extends NestReader {

        private int memberSecret() {

            return secret;
        }

        @Override
        int read() {

            return memberSecret();
        }
    }

    int fromMember() {

        MemberReader reader = new MemberReader();
        int result = reader.memberSecret();
        free reader;
        return result;
    }

    int fromLocal() {

        class LocalReader extends NestReader {

            @Override
            int read() {

                return secret;
            }
        }
        LocalReader reader = new LocalReader();
        int result = reader.read();
        free reader;
        return result;
    }

    int fromAnonymous() {

        NestReader reader = new NestReader() {

            @Override
            int read() {

                return secret;
            }
        };
        int result = reader.read();
        free reader;
        return result;
    }

    public static int main(String[] args) {

        NestAccess value = new NestAccess(42);
        // Reader creation captures value, so its own reclamation is not proven here.
        if (value.fromMember() != 42 || value.fromLocal() != 42) return 1;
        return value.fromAnonymous();
    }
}
