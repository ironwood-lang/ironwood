package org.ironwood.memorymanagement;
// Prints a container through its dynamic toString result: Storing1: Hey.
// Managed storage follows reachability; printing performs no collection. Exit zero.
public class TestMemoryManagement1 {

    private static class Container {

        private String storeMe;

        @Override
        public String toString() {
            return "Storing1: " + storeMe;
        }

        public void set(String value) {
            this.storeMe = value;
        }
    }

    public static void main(String[] args) {

        Container c = new Container();
        c.set("Hey");
        System.out.println(c);
    }
}
