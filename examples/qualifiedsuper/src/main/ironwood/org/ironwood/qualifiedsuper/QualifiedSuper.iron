// Selects an inner superclass's enclosing instance with outer.super(...).
// Produces no console output and exits with status 42.
package org.ironwood.qualifiedsuper;

class SuperOuter {

    class Inner {

        int value;

        Inner(int value) {

            this.value = value;
        }

        int inherited() {

            return this.value;
        }
    }
}

class QualifiedDerived extends SuperOuter.Inner {

    QualifiedDerived(SuperOuter outer, int value) {

        outer.super(value);
    }

    int answer() {

        return super.inherited();
    }
}

public class QualifiedSuper {

    public static int main(String[] args) {

        SuperOuter outer = new SuperOuter();
        QualifiedDerived value = new QualifiedDerived(outer, 42);
        int result = value.answer();
        free value;
        // The hidden superclass enclosing field makes outer escape. Its
        // reclamation is not proven, so outer remains live until process exit.
        return result;
    }
}
