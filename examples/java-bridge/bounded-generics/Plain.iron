package boundedbench;

// Equivalent nongeneric retention path for the performance control.
public final class Plain {

    private Value value;

    public Plain(Value value) {

        this.value = value;
    }

    public void set(Value value) {

        this.value = value;
    }

    public int read() {

        return this.value == null ? 0 : this.value.number();
    }
}
