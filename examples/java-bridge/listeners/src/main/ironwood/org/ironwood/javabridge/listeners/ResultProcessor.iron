package org.ironwood.javabridge.listeners;

// A retained Java listener receives one result per iteration. The bridge owns
// its registration until replacement, clearing or explicit processor free.
public final class ResultProcessor {

    private ResultListener listener;

    public ResultProcessor() {

    }

    public void setListener(ResultListener listener) {

        this.listener = listener;
    }

    public long process(int count, long seed) {

        if (count < 0) throw new IllegalArgumentException("negative count");
        // Snapshot the registration. Reentrant replacement takes effect on the
        // next process invocation, while this listener remains alive until exit.
        ResultListener current = this.listener;
        long value = seed;
        for (int sequence = 0; sequence < count; sequence++) {
            value = (value ^ (value >>> 13)) * 2862933555777941757L + 3037000493L;
            current.onResult((long)sequence, value);
        }
        return value;
    }
}
