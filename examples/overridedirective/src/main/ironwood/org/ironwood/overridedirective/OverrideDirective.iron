package org.ironwood.overridedirective;

interface Calculation {

    int value();
}

interface RefinedCalculation extends Calculation {

    @Override
    int value();
}

abstract class BaseCalculation implements RefinedCalculation {

    @Override public abstract int value();
}

class InitialCalculation extends BaseCalculation {

    @Override
    public int value() {

        return 41;
    }
}

class FinalCalculation extends InitialCalculation {

    public @Override int value() {

        return super.value() + 1;
    }
}

public class OverrideDirective {

    public static int main(String[] args) {

        Calculation calculation = new FinalCalculation();
        int answer = calculation.value();
        free calculation;
        String message = "mandatory override answer=" + answer;
        System.out.println(message);
        free message;
        return answer;
    }
}
