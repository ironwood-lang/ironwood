package org.ironwood.staticnested;

class StaticContainer {

    private static int base = 40;

    static class Nested {

        int answer() {

            return base + 2;
        }
    }
}

public class StaticNestedTypes {

    public static int main(String[] args) {

        StaticContainer.Nested nested = new StaticContainer.Nested();
        return nested.answer();
    }
}
