package org.ironwood.staticnested;

class StaticContainer {

    private static int base = 40;

    static class Nested {

        int answer() {

            return base + 2;
        }
    }
}

public class StaticNestedTypes {

    public static int main(String[] args) {

        // The nested instance is an unnamed temporary, reclaimed after answer returns.
        return new StaticContainer.Nested().answer();
    }
}
