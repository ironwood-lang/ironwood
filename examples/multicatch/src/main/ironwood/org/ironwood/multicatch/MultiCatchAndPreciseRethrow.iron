package org.ironwood.multicatch;

class ReadFailure extends Exception {

    int code() {

        return 20;
    }
}

class FormatFailure extends ReadFailure {

}

class TransportFailure extends ReadFailure {

}

class CleanupFailure extends Exception {

}

public class MultiCatchAndPreciseRethrow {

    static void source(boolean format) throws FormatFailure, TransportFailure {

        if (format) throw new FormatFailure();
        throw new TransportFailure();
    }

    static void relay(boolean format) throws FormatFailure, TransportFailure {

        try {
            source(format);
        } catch (Exception failure) {

            // The effectively-final binding keeps the exact caught alternatives.
            throw failure;
        }
    }

    static void relayWithCleanup(boolean format)
            throws FormatFailure, TransportFailure, CleanupFailure {

        try {
            relay(format);
        } finally {
            throw new CleanupFailure();
        }
    }

    static int handle(boolean format) {

        try {
            relayWithCleanup(format);
        } catch (FormatFailure | TransportFailure failure) {

            class CapturedFailure {

                int code() {

                    return failure.code();
                }
            }
            if (failure.getSecondaryExceptionCount() != 1) return 0;
            if (!(failure.getSecondaryException(0) instanceof CleanupFailure)) return 0;
            return new CapturedFailure().code();
        } catch (CleanupFailure failure) {

            return 0;
        }
        return 0;
    }

    public static int main(String[] args) {

        return handle(true) + handle(false) + 2;
    }
}
