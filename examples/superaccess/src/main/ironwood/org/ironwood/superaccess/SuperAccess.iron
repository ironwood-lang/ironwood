package org.ironwood.superaccess;

class SuperBase {

    int value;

    SuperBase(int value) {

        this.value = value;
    }

    int adjustment() {

        return 2;
    }
}

class SuperChild extends SuperBase {

    int value = 100;

    SuperChild() {

        super(40);
    }

    int answer() {

        return super.value + super.adjustment();
    }
}

public class SuperAccess {

    public static int main(String[] args) {

        SuperChild child = new SuperChild();
        if (child.value != 100) return 1;
        return child.answer();
    }
}
