package org.ironwood.ownedhelperborrows;

class RollbackFailure extends Error {

}

class RollbackHelper {

    int value = 42;



}

class FailingOwner {

    static RollbackHelper published;
    private RollbackHelper helper;

    FailingOwner() {

        this.helper = new RollbackHelper();
        published = this.helper;
        throw new RollbackFailure();
    }

}

// Exit 42 verifies that a published child survives failed managed construction.
public class ConstructorRollback {

    public static int main(String[] args) {

        try {
            FailingOwner unexpected = new FailingOwner();
            return 1;
        } catch (RollbackFailure expected) {

            ironwood.lang.Memory.collect();
            return FailingOwner.published.value == 42 ? 42 : 2;
        }
    }
}
