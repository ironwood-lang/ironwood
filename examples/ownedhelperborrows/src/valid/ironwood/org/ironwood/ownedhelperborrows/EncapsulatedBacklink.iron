package org.ironwood.ownedhelperborrows;

// The helper keeps a private backlink but never publishes it.
class EncapsulatedBacklinkHelper {

    private EncapsulatedBacklinkOwner owner;

    EncapsulatedBacklinkHelper(EncapsulatedBacklinkOwner owner) {

        this.owner = owner; // Contained backlink, not an external escape.
    }

    int read() {

        return this.owner.readDirectly();
    }
}

class EncapsulatedBacklinkOwner {

    private int value;
    private EncapsulatedBacklinkHelper helper;

    EncapsulatedBacklinkOwner(int value) {

        this.value = value;
        this.helper = new EncapsulatedBacklinkHelper(this);
    }

    int readDirectly() {

        return value;
    }

    int readThroughHelper() {

        return this.helper.read();
    }

}

// Expected: compile, link, and exit 42. Shared helper links remain valid through collection.
public class EncapsulatedBacklink {

    public static int main(String[] args) {

        EncapsulatedBacklinkOwner owner = new EncapsulatedBacklinkOwner(42);
        int result = owner.readThroughHelper();
        return result;
    }
}
