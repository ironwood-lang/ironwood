package org.ironwood.ownedhelperborrows;

import ironwood.ds.ArrayList;

class RetainedElement {

    int value = 42;

}

// Exit 42 verifies a shared item remains usable after its list is cleared.
public class FreeInsertedElement {

    public static int main(String[] args) {

        RetainedElement element = new RetainedElement();
        ArrayList<RetainedElement> list = new ArrayList<RetainedElement>();
        list.add(element);

        list.clear();
        ironwood.lang.Memory.collect();
        return element.value == 42 ? 42 : 2;
    }
}
