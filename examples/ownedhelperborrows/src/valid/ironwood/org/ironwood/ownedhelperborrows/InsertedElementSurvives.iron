package org.ironwood.ownedhelperborrows;

import ironwood.ds.ArrayList;

class SurvivingElement {

    int value;

    SurvivingElement(int value) {

        this.value = value;
    }
}

public class InsertedElementSurvives {

    public static int main(String[] args) {

        SurvivingElement element = new SurvivingElement(42);
        ArrayList<SurvivingElement> list = new ArrayList<SurvivingElement>();
        list.add(element); // The list retains a non-owning alias.
        int result = element.value; // Valid: element was not owned by the list.
        return result;
    }
}
