package org.ironwood.multidimensionalarrays;

public class MultidimensionalArrays {

    private static int checkArrayType(int[][] probe) {

        // Keep the widened and cast views within this call, before the caller frees probe.
        Object widened = probe;
        if (!(widened instanceof int[][]) || widened instanceof long[][]) return 1;
        int[][] exact = (int[][]) widened;
        return exact.length != 0 ? 2 : 0;
    }

    public static int main(String[] args) {

        int[][] probe = new int[0][];
        int probeResult = checkArrayType(probe);
        free probe;
        if (probeResult != 0) return probeResult;

        int[][] grid = new int[2][];
        int[] first = new int[2];
        int[] second = new int[1];
        first[0] = 20;
        first[1] = 10;
        second[0] = 12;
        grid[0] = first;
        grid[1] = second;

        int result = grid[0][0] + grid[0][1] + grid[1][0];

        grid[0] = null;
        grid[1] = null;
        free first;
        free second;
        free grid;

        System.out.println("multidimensional array result: 42");
        return result;
    }
}
