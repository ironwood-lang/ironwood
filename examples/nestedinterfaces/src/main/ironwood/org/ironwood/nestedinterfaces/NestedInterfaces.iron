package org.ironwood.nestedinterfaces;

class InterfaceContainer {

    interface Answer {

        int value();
    }

    static class Constant implements Answer {

        @Override
        public int value() {

            return 42;
        }
    }
}

interface InterfaceNamespace {

    interface Marker {

        int marked();
    }
}

class MarkedValue implements InterfaceNamespace.Marker {

    @Override
    public int marked() {

        return 42;
    }
}

public class NestedInterfaces {

    public static int main(String[] args) {

        InterfaceContainer.Answer answer = new InterfaceContainer.Constant();
        InterfaceNamespace.Marker marker = new MarkedValue();
        int result = marker.marked() != 42 ? 1 : answer.value();
        free marker;
        free answer;
        return result;
    }
}
