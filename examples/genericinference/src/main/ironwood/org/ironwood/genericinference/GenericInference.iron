package org.ironwood.genericinference;

class InferenceBox<T> {

}

class InferenceUtility {

    static <T> T create() {

        return null;
    }

    static <T> InferenceBox<T> createBox() {

        return new InferenceBox<>();
    }

    static <T> T identity(T value) {

        return value;
    }

    static <T, U> T first(T value, U ignored) {

        return value;
    }

    static <T> T common(T first, T second) {

        return first;
    }

    static <T> int select(T first, T second) {

        return 1;
    }

    static int select(String first, Object second) {

        return 42;
    }
}

public class GenericInference {

    public static int main(String[] args) {

        String expected = InferenceUtility.identity(InferenceUtility.create());
        InferenceBox<String> stringBox = InferenceUtility.createBox();
        InferenceBox<Object> objectBox = InferenceUtility.createBox();
        // Named arguments retain their original inference types and permit explicit cleanup.
        Object ignored = new Object();
        String inferred = InferenceUtility.first("inferred", ignored);
        free ignored;
        InferenceBox<String> first = new InferenceBox<String>();
        InferenceBox<Object> second = new InferenceBox<Object>();
        InferenceBox<?> common = InferenceUtility.common(first, second);

        try {
            if (expected != null || stringBox == null || objectBox == null
                    || inferred.length() != 8 || common == null) {

                return 2;
            }
            return InferenceUtility.select("first", "second");
        } finally {
            // common aliases first; drop that view before reclaiming its allocation.
            common = null;
            free second;
            free first;
            free objectBox;
            free stringBox;
        }
    }
}
