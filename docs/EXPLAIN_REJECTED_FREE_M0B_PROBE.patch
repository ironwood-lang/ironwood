+// SPDX-License-Identifier: MIT OR Apache-2.0
+package ironwood.compiler.semantic;
+
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+final class Probe {
+    private static final boolean ENABLED = System.getenv("IW_M0_PROBE") != null;
+    private static final int SAMPLE_EVERY = Integer.parseInt(
+            System.getenv().getOrDefault("IW_M0_SAMPLE_EVERY", "100"));
+    private static final Map<String, Method> METHODS = new HashMap<>();
+    private static final List<WeakReference<Object>> SNAPSHOTS = new ArrayList<>();
+    private static final List<Integer> SNAPSHOT_ENTRIES = new ArrayList<>();
+    private static long analyzers, snapshots, snapshotEntries, joins, valueJoins;
+    private static long exceptionalJoins, cleanupCopies, summaryBuilds;
+    private static long summaryRounds, symbolicRounds, outerPasses;
+    private static int maxPresent, maxAllocs, maxSnapshotEntries, maxPredecessors;
+    private static int maxLiveSnapshots, maxLiveEntries, maxSummaryFacts;
+
+    static {
+        if (ENABLED) Runtime.getRuntime().addShutdownHook(new Thread(Probe::report));
+    }
+
+    private Probe() {}
+
+    private static Method method(String name) {
+        return METHODS.computeIfAbsent(name, ignored -> new Method());
+    }
+
+    static void functionEnd(String name, int allocations, int present) {
+        if (!ENABLED) return;
+        analyzers++;
+        Method method = method(name);
+        method.allocMax = Math.max(method.allocMax, allocations);
+        method.presentMax = Math.max(method.presentMax, present);
+        maxAllocs = Math.max(maxAllocs, allocations);
+        maxPresent = Math.max(maxPresent, present);
+    }
+
+    static void present(String name, int count) {
+        if (!ENABLED) return;
+        method(name).presentMax = Math.max(method(name).presentMax, count);
+        maxPresent = Math.max(maxPresent, count);
+    }
+
+    static void snapshot(String name, Object snapshot, int entries) {
+        if (!ENABLED) return;
+        snapshots++;
+        snapshotEntries += entries;
+        maxSnapshotEntries = Math.max(maxSnapshotEntries, entries);
+        Method method = method(name);
+        method.snapshots++;
+        method.snapshotMaxEntries = Math.max(method.snapshotMaxEntries, entries);
+        SNAPSHOTS.add(new WeakReference<>(snapshot));
+        SNAPSHOT_ENTRIES.add(entries);
+        if (snapshots % SAMPLE_EVERY == 0) sample();
+    }
+
+    private static void sample() {
+        System.gc();
+        int count = 0, entries = 0;
+        for (int i = SNAPSHOTS.size() - 1; i >= 0; i--) {
+            if (SNAPSHOTS.get(i).get() == null) {
+                SNAPSHOTS.remove(i);
+                SNAPSHOT_ENTRIES.remove(i);
+            } else {
+                count++;
+                entries += SNAPSHOT_ENTRIES.get(i);
+            }
+        }
+        maxLiveSnapshots = Math.max(maxLiveSnapshots, count);
+        maxLiveEntries = Math.max(maxLiveEntries, entries);
+    }
+
+    static void join(String name, int predecessors) {
+        if (!ENABLED) return;
+        joins++;
+        maxPredecessors = Math.max(maxPredecessors, predecessors);
+        method(name).joins++;
+    }
+
+    static void valueJoin(String name, int predecessors) {
+        if (!ENABLED) return;
+        valueJoins++;
+        maxPredecessors = Math.max(maxPredecessors, predecessors);
+        method(name).valueJoins++;
+    }
+
+    static void exceptionalJoin(String name, int predecessors) {
+        if (!ENABLED) return;
+        exceptionalJoins++;
+        maxPredecessors = Math.max(maxPredecessors, predecessors);
+    }
+
+    static void cleanup(String name) {
+        if (!ENABLED) return;
+        cleanupCopies++;
+        method(name).cleanups++;
+    }
+
+    static void summaryBuild(int facts) {
+        if (!ENABLED) return;
+        summaryBuilds++;
+        maxSummaryFacts = Math.max(maxSummaryFacts, facts);
+    }
+
+    static void summaryRound() { if (ENABLED) summaryRounds++; }
+    static void symbolicRound() { if (ENABLED) symbolicRounds++; }
+    static void outerPass() { if (ENABLED) outerPasses++; }
+
+    private static void report() {
+        sample();
+        System.err.println("MEASURE total analyzers=" + analyzers + " methods=" + METHODS.size()
+                + " maxPresent=" + maxPresent + " maxAllocations=" + maxAllocs
+                + " snapshots=" + snapshots + " snapshotEntries=" + snapshotEntries
+                + " maxSnapshotEntries=" + maxSnapshotEntries
+                + " sampledLiveSnapshots=" + maxLiveSnapshots
+                + " sampledLiveEntries=" + maxLiveEntries
+                + " joins=" + joins + " valueJoins=" + valueJoins
+                + " exceptionalJoins=" + exceptionalJoins + " maxPredecessors=" + maxPredecessors
+                + " cleanupCopies=" + cleanupCopies + " summaryBuilds=" + summaryBuilds
+                + " summaryRounds=" + summaryRounds + " symbolicRounds=" + symbolicRounds
+                + " outerPasses=" + outerPasses + " maxSummaryFacts=" + maxSummaryFacts);
+        METHODS.entrySet().stream().sorted(Comparator.comparing(Map.Entry::getKey))
+                .forEach(entry -> System.err.println("MEASURE method " + entry.getKey()
+                        + " allocations=" + entry.getValue().allocMax
+                        + " present=" + entry.getValue().presentMax
+                        + " snapshots=" + entry.getValue().snapshots
+                        + " snapshotMaxEntries=" + entry.getValue().snapshotMaxEntries
+                        + " joins=" + entry.getValue().joins
+                        + " valueJoins=" + entry.getValue().valueJoins
+                        + " cleanups=" + entry.getValue().cleanups));
+    }
+
+    private static final class Method {
+        int allocMax, presentMax, snapshotMaxEntries;
+        long snapshots, joins, valueJoins, cleanups;
+    }
+}
