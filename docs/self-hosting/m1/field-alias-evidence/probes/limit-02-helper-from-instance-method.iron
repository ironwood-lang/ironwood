class Helper {
    private Parent owner;
    Helper(Parent owner) { this.owner = owner; }
    int peek() { return this.owner.value(); }
}
class Parent {
    private Helper helper;
    private int marker = 7;
    Parent(boolean fail) { this.helper = make(); if (this.helper.peek() == 7 && fail) throw Main.failure; }
    private Helper make() { return new Helper(this); }
    int value() { return this.marker; }
    destructor { free this.helper; }
}
class Main {
    static RuntimeException failure = new RuntimeException();
    public static int main(String[] args) {
        Parent parent = new Parent(false);
        int observed = parent.value();
        free parent;
        try { new Parent(true); } catch (RuntimeException expected) { return observed + 35; }
        return 0;
    }
}
