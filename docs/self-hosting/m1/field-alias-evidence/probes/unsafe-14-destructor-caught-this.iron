class Parent extends Error {
    static Throwable saved;
    private Parent self;
    Parent() { this.self = this; }
    destructor { try { throw this; } catch (Throwable caught) { saved = caught; } }
}
class Main { public static int main(String[] args) { Parent value = new Parent(); free value; return 0; } }
