class Holder {
    private Parent owner;
    Holder(Parent owner) { this.owner = owner; }
    Parent owner() { return this.owner; }
}
class Helper {
    static Parent saved;
    private Parent owner;
    Helper(Parent owner) { this.owner = owner; reset(); }
    private void reset() { saved = this.owner; throw Main.failure; }
}
class Parent {
    private Holder holder;
    private Helper helper;
    private int marker = 7;
    Parent() { this.holder = new Holder(this); this.helper = new Helper(this.holder.owner()); }
    int value() { return this.marker; }
    destructor { free this.holder; free this.helper; }
}
class Main {
    static RuntimeException failure = new RuntimeException();
    public static int main(String[] args) {
        try { new Parent(); }
        catch (RuntimeException expected) { return Helper.saved.value(); }
        return 0;
    }
}
