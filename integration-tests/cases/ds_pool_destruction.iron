    static int checkIntSet(Item[] items, int state) {

        long baseline = System.liveAllocationCount();
        IntSet container = new IntSet(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.add(i); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.add(i); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        free container;
