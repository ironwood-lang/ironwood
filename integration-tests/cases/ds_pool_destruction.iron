import ironwood.ds.*;
import ironwood.lang.Memory;

// Exit 42 checks allocation-free pool reuse and live containers across collection.
// After each helper returns, collection reclaims its graph without touching items.

class Item {
    int id;
    Item(int id) {

        this.id = id;
    }
    @Override public int hashCode() {

        return id;
    }

}
class Main {

    static int checkMap(Item[] items, int state) {

        HashMap<Item, Item> container = new HashMap<Item, Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkIdentityMap(Item[] items, int state) {

        IdentityHashMap<Item, Item> container = new IdentityHashMap<Item, Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkLinkedMap(Item[] items, int state) {

        LinkedHashMap<Item, Item> container = new LinkedHashMap<Item, Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkIntMap(Item[] items, int state) {

        IntMap<Item> container = new IntMap<Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.put(i, items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.put(i, items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkLongMap(Item[] items, int state) {

        LongMap<Item> container = new LongMap<Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.put(i, items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.put(i, items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkLinkedList(Item[] items, int state) {

        LinkedList<Item> container = new LinkedList<Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.add(items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.add(items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkIntLinkedList(Item[] items, int state) {

        IntLinkedList container = new IntLinkedList(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.add(i); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.add(i); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkLongLinkedList(Item[] items, int state) {

        LongLinkedList container = new LongLinkedList(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.add(i); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.add(i); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkArrayLinkedList(Item[] items, int state) {

        ArrayLinkedList<Item> container = new ArrayLinkedList<Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.addLast(items[i]); }
        }
        if (state > 1) {
            container.clear(true);
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.addLast(items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear(true);
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkSet(Item[] items, int state) {

        HashSet<Item> container = new HashSet<Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.add(items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.add(items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
        if (container.size() != (state == 1 || state == 2 ? items.length : 0)) return 2;
        return 0;
    }
    static int checkIdentitySet(Item[] items, int state) {

        IdentityHashSet<Item> container = new IdentityHashSet<Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.add(items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.add(items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        Memory.collect();
