// Containers own their private storage and entry pools, but borrow every
// caller-supplied item. Exercise empty, populated, reused and cleared storage.
// Exit 42 with no output. Caller-owned items deliberately live to process end.
import ironwood.ds.*;

class Item {

    static int destroyed;
    int id;
    Item(int id) {

        this.id = id;
    }
    @Override public int hashCode() {

        return id;
    }
    destructor {

        destroyed++;
    }
}
class Main {

    static int checkMap(Item[] items, int state) {

        long baseline = System.liveAllocationCount();
        HashMap<Item, Item> container = new HashMap<Item, Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        free container;
        if (state >= 0 && System.liveAllocationCount() != baseline) return 2;
        return 0;
    }
    static int checkIdentityMap(Item[] items, int state) {

        long baseline = System.liveAllocationCount();
        IdentityHashMap<Item, Item> container = new IdentityHashMap<Item, Item>(2);
        if (state > 0) {
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
        }
        if (state > 1) {
            container.clear();
            long allocations = System.allocationCount();
            for (int i = 0; i < items.length; i++) { container.put(items[i], items[i]); }
            if (System.allocationCount() != allocations) return 1;
        }
        if (state > 2) container.clear();
        free container;
        if (state >= 0 && System.liveAllocationCount() != baseline) return 2;
        return 0;
    }
