        }
        if (state > 2) container.clear();
        free container;
        if (state >= 0 && System.liveAllocationCount() != baseline) return 2;
        return 0;
    }
    static int checkCopiedKeys(Item item) {

        // Entries own their copied keys and backing arrays. Both active and
        // returned entries must be fully reclaimed without touching input keys.
        long baseline = System.liveAllocationCount();
        CharSequenceMap<Item> text = new CharSequenceMap<Item>(2, (short) 8);
        text.put("key", item);
        text.clear();
        text.put("key", item);
        free text;
        if (System.liveAllocationCount() != baseline) return 1;
        byte[] key = new byte[] {1};
        baseline = System.liveAllocationCount();
        ByteBufferMap<Item> bytes = new ByteBufferMap<Item>(2, (short) 8);
        bytes.put(key, item);
        bytes.clear();
        bytes.put(key, item);
        free bytes;
        if (System.liveAllocationCount() != baseline || key[0] != 1) return 2;
        return 0;
    }
    public static int main(String[] args) {

        Item[] items = new Item[16];
        for (int i = 0; i < items.length; i++) { items[i] = new Item(i); }
        // Warm static set sentinels before checking per-container balance.
        for (int state = -1; state < 4; state++) {
            if (checkMap(items, state) != 0) return 1;
            if (checkIdentityMap(items, state) != 0) return 2;
            if (checkLinkedMap(items, state) != 0) return 3;
            if (checkIntMap(items, state) != 0) return 4;
            if (checkLongMap(items, state) != 0) return 5;
            if (checkLinkedList(items, state) != 0) return 6;
            if (checkIntLinkedList(items, state) != 0) return 7;
            if (checkLongLinkedList(items, state) != 0) return 8;
            if (checkArrayLinkedList(items, state) != 0) return 9;
            if (checkSet(items, state) != 0) return 10;
            if (checkIdentitySet(items, state) != 0) return 11;
            if (checkLinkedSet(items, state) != 0) return 12;
            if (checkIntSet(items, state) != 0) return 13;
            if (checkLongSet(items, state) != 0) return 14;
        }
        if (checkCopiedKeys(items[0]) != 0) return 15;
        if (Item.destroyed != 0) return 16;
        for (int i = 0; i < items.length; i++) {
            if (items[i].id != i) return 17;
        }
        return 42;
    }
}
