// Map copies own separate entries and pools, borrow keys and values, and leave
// source cursors untouched. Exit 42 after checking independent mutations and
// entry allocation scaling. Keys outlive every map; all storage is reclaimed.
import ironwood.ds.*;

final class Item {

    private int id;
    Item(int id) {

        this.id = id;
    }
    @Override public int hashCode() {

        return this.id % 2;
    }
    @Override public boolean equals(Object value) {

        if (!(value instanceof Item)) return false;
        return this.id == ((Item) value).id;
    }
}

class Items {

    private Item[] data;
    Items(int count) {

        this.data = new Item[count];
        for (int i = 0; i < this.data.length; i++) {
            Item item = new Item(i);
            this.data[i] = item;
        }
    }
    Item get(int index) {

        return this.data[index];
    }
    destructor {
        for (int i = 0; i < this.data.length; i++) {

           free this.data[i];
       }
        free this.data;
    }
}

class Main {

    static void checkHashMap(int count) {

        long baseline = System.liveAllocationCount();
        Items items = new Items(count);
        HashMap<Item, Item> source = new HashMap<Item, Item>(1);
        for (int i = 0; i < count; i++) {

           source.put(items.get(i), items.get(i));
       }
        long before = System.allocationCount();
        HashMap<Item, Item> copied = source.copy();
        long allocations = System.allocationCount() - before;
        if (copied.size() != count) throw new IllegalStateException();
        if (count > 0) {
            copied.remove(items.get(0));
            if (source.size() != count || copied.size() != count - 1) throw new IllegalStateException();
            copied.put(items.get(0), items.get(0));
        }
        source.clear();
        if (copied.size() != count) throw new IllegalStateException();
        free copied;
        free source;
        free items;
        if (System.liveAllocationCount() != baseline) throw new IllegalStateException();
        System.out.print("value:");
        System.out.print(count);
        System.out.print(":");
        System.out.println(allocations);
    }

    static void checkIdentityHashMap(int count) {

        long baseline = System.liveAllocationCount();
        Items items = new Items(count);
        IdentityHashMap<Item, Item> source = new IdentityHashMap<Item, Item>(1);
        for (int i = 0; i < count; i++) {

           source.put(items.get(i), items.get(i));
       }
        long before = System.allocationCount();
        IdentityHashMap<Item, Item> copied = source.copy();
        long allocations = System.allocationCount() - before;
        if (copied.size() != count) throw new IllegalStateException();
        if (count > 0) {
            copied.remove(items.get(0));
            if (source.size() != count || copied.size() != count - 1) throw new IllegalStateException();
            copied.put(items.get(0), items.get(0));
        }
        source.clear();
        if (copied.size() != count) throw new IllegalStateException();
        free copied;
        free source;
        free items;
        if (System.liveAllocationCount() != baseline) throw new IllegalStateException();
        System.out.print("identity:");
        System.out.print(count);
        System.out.print(":");
        System.out.println(allocations);
    }

    static void checkLinkedHashMap(int count) {

        long baseline = System.liveAllocationCount();
        Items items = new Items(count);
        LinkedHashMap<Item, Item> source = new LinkedHashMap<Item, Item>(1);
        for (int i = 0; i < count; i++) {

           source.put(items.get(i), items.get(i));
       }
        long before = System.allocationCount();
        LinkedHashMap<Item, Item> copied = source.copy();
        long allocations = System.allocationCount() - before;
        if (copied.size() != count) throw new IllegalStateException();
        if (count > 0) {
            copied.remove(items.get(0));
            if (source.size() != count || copied.size() != count - 1) throw new IllegalStateException();
            copied.put(items.get(0), items.get(0));
        }
        source.clear();
        if (copied.size() != count) throw new IllegalStateException();
        free copied;
        free source;
        free items;
        if (System.liveAllocationCount() != baseline) throw new IllegalStateException();
        System.out.print("linked:");
        System.out.print(count);
        System.out.print(":");
        System.out.println(allocations);
    }

    static void checkScale(int count) {

        checkHashMap(count);
        checkIdentityHashMap(count);
        checkLinkedHashMap(count);
    }

    public static int main(String[] args) {

        long baseline = System.liveAllocationCount();
        checkScale(0);
        checkScale(8);
        checkScale(32);
        checkScale(128);
        checkScale(512);
        if (System.liveAllocationCount() != baseline) return 1;
        return 42;
    }
}
