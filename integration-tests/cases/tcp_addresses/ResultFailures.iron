import ironwood.net.*;

// Sweep the managed allocation limit across lazy names and copied value graphs.
// The diagnostic resolver supplies a confirmed reverse name without external DNS.
class AddressResultFailures {

    public static int main(String[] args) throws UnknownHostException {
        try {
            if (args[0].equals("reverse")) {
                InetAddress address = InetAddress.getByName("127.0.0.42");
                try {
                    address.getHostName();
                    address.getCanonicalHostName();
                } finally { ; }
            } else if (args[0].equals("scope")) {
                InetAddress address = InetAddress.getByName("fe80::1%42");
                try {
                    InetAddress copy = address.copy();
                    try {
                        String text = copy.getHostAddress();
                    } finally { ; }
                } finally { ; }
            } else if (args[0].equals("unresolved")) {
                InetSocketAddress endpoint = InetSocketAddress.createUnresolved("name.invalid", 7);
                try {
                    endpoint.hashCode();
                    endpoint.hashCode();
                } finally { ; }
            } else {
                byte[] bytes = {127, 0, 0, 42};
                try {
                    InetAddress address = InetAddress.getByAddress("copied-name", bytes);
                    try {
                        InetSocketAddress endpoint = new InetSocketAddress(address, 7);
                        try {
                            String text = endpoint.toString();
                        } finally { ; }
                    } finally { ; }
                } finally { ; }
            }
        } catch (OutOfMemoryError expected) {
        }
        return 0;
    }
}
