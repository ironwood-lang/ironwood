class ScopedValue {

}

class FailureSource {

    private static Error failure = new Error();

    static void prepare() {

    }

    static void fail() {

        throw failure;
    }
}

class ClosingResource {

    private static Error failure = new Error();

    static void prepare() {

    }

    void use() {

    }

    void close() {

        throw failure;
    }
}

class Scope {

    static int returnThroughFinally() {

        ScopedValue value = new ScopedValue();
        try {
            value.hashCode();
            return 7;
        } finally {
        }
    }

    static void throwThroughFinally() {

        ScopedValue value = new ScopedValue();
        try {
            FailureSource.fail();
        } finally {
        }
    }

    static int catchThenReturnThroughFinally() {

        ScopedValue value = new ScopedValue();
        try {
            FailureSource.fail();
            return 0;
        } catch (Error expected) {

            return 9;
        } finally {
        }
    }

    static void closeThenFree() {

        ClosingResource resource = new ClosingResource();
        try {
            resource.use();
        } finally {
            try {
                resource.close();
            } finally {
            }
        }
    }
}

class Main {

    public static int main(String[] args) {

        FailureSource.prepare();
        ClosingResource.prepare();

        if (Scope.returnThroughFinally() != 7) {

            return 1;
        }

        boolean throwFailed = false;
        try {
            Scope.throwThroughFinally();
        } catch (Error expected) {

            throwFailed = true;
        }
        if (!throwFailed) return 2;

        if (Scope.catchThenReturnThroughFinally() != 9) {

            return 3;
        }

        boolean closeFailed = false;
        try {
            Scope.closeThenFree();
        } catch (Error expected) {

            closeFailed = true;
        }
        if (!closeFailed) return 4;
        return 42;
    }
}
