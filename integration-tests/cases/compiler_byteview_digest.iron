// ByteView declaration authority with the native SHA-256. Each argument is a
// file holding a ByteView declaration's source content as J0 reconstructs it
// (from source, a .ironclass or the library archive) or a changed copy. For
// each one this prints the lowercase digest of the content's UTF-8 bytes, as
// ByteViewIntrinsic.trusted computes it, and whether it equals the trusted
// SOURCE_SHA256. The digest object is reused; each text and digest is freed.
// Exit 42 after reading every argument.
import ironwood.compiler.port.Sha256;
import ironwood.nio.file.Files;
import ironwood.nio.file.Path;
import ironwood.nio.file.Paths;

class Main {

    static final String SOURCE_SHA256 = "e88c4dbc78e057285069a9fd4b256ac79f62590de9ad3ef0453329ed43e3a850";

    public static int main(String[] args) {

        Sha256 digest = new Sha256();
        defer free digest;
        for (int index = 0; index < args.length; index++) {
            Path path = Paths.get(args[index]);
            defer free path;
            try {
                String content = Files.readString(path);
                defer free content;
                digest.updateUtf8(content);
                String hex = digest.hexDigest();
                defer free hex;
                System.out.println(index + " " + hex + " " + hex.equals(SOURCE_SHA256));
            } catch (ironwood.io.IOException failure) {
                System.out.println(index + " unreadable");
                return 1;
            }
        }
        return 42;
    }
}
