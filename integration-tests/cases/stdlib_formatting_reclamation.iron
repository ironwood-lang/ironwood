class Main {

    static boolean checkSlices(StringBuilder builder, String text) {

        long baseline = System.liveAllocationCount();
        // Include empty ranges, the complete range, and split surrogate pairs.
        for (int start = 0; start <= text.length(); start++) {
            for (int end = start; end <= text.length(); end++) {
                long before = System.allocationCount();
                String slice = (String) builder.subSequence(start, end);
                if (slice.length() != end - start
                        || System.allocationCount() != before + 1
                        || System.liveAllocationCount() != baseline + 1) {

                            return false;
                        }
                for (int index = 0; index < slice.length(); index++) {
                    if (slice.charAt(index) != text.charAt(start + index)) return false;
                }
                free slice;
            }
        }
        return System.liveAllocationCount() == baseline;
    }

    public static int main(String[] args) {

        long baseline = System.liveAllocationCount();
        // Each public conversion must allocate only its returned String.
        for (int code = 0; code <= 65535; code++) {
            long before = System.allocationCount();
            String value = String.valueOf((char) code);
            String character = Character.toString((char) code);
            int bytes = code < 128 ? 1 : code < 2048 ? 2 : 3;
            if (value.length() != 1 || value.charAt(0) != (char) code
                    || value.byteLength() != bytes || !character.equals(value)
                    || System.allocationCount() != before + 2
                    || System.liveAllocationCount() != baseline + 2) {

                        return 1;
                    }
            free character;
            free value;
        }
        for (int value = -32768; value <= 32767; value++) {
            long before = System.allocationCount();
            String small = Byte.toString((byte) value);
            String medium = Short.toString((short) value);
            String integer = String.valueOf(value);
            String wide = String.valueOf((long) value);
            if (Byte.parseByte(small) != (byte) value
                    || Short.parseShort(medium) != value
                    || !integer.equals(medium) || !wide.equals(medium)
                    || System.allocationCount() != before + 4
                    || System.liveAllocationCount() != baseline + 4) {

                        return 2;
                    }
            free wide;
            free integer;
            free medium;
            free small;
        }

        String text = "A😀éZ";
        StringBuilder builder = new StringBuilder(64);
        builder.append(text);
        if (!checkSlices(builder, text)) return 3;
        String detached = (String) builder.subSequence(1, 4);
        builder.setLength(0);
        long appendBaseline = System.allocationCount();
        builder.append(Integer.MIN_VALUE).append(':').append(Long.MIN_VALUE).append(true);
        if (System.allocationCount() != appendBaseline) return 5;
        free builder;
        // A slice owns its text independently of later mutation and builder lifetime.
        if (detached.length() != 3 || detached.charAt(0) != (char) 55357
                || detached.charAt(1) != (char) 56832 || detached.charAt(2) != 'é') {

                    return 6;
                }
        free detached;
        return System.liveAllocationCount() == baseline ? 42 : 7;
    }
}
