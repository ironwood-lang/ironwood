class Helper {

    private Parent owner;
    private int[] scratch = new int[2];

    Helper(Parent owner) {

        this.owner = owner;
    }

    void check(boolean fail) {

        if (fail && this.owner.marker() == 7) throw Main.failure;
    }

}

class Parent {

    private Parent self;
    private Helper helper;
    private int marker = 7;
    private int seen;

    Parent(boolean fail) {

        this.self = this;
        this.helper = new Helper(this.self);
        this.seen = this.self.marker;
        // Every field is complete, so rollback destroys the owned helper.
        this.helper.check(fail);
    }

    int marker() {

        return this.self.marker;
    }

    int seen() {

        return this.seen;
    }

}

class Main {

    static RuntimeException failure = new RuntimeException();

    public static int main(String[] args) {

        RuntimeException original = failure;
        for (int attempt = 0; attempt < 20; attempt++) {
            long before = System.allocationCount();
            Parent value = new Parent(false);
            int observed = value.seen();
            if (observed != 7) return 1;
            if (System.allocationCount() - before != 3) return 2;


            before = System.allocationCount();
            boolean caught = false;
            try {
                new Parent(true);
            }

            catch (RuntimeException expected) {
                if (expected != original) return 4;
                caught = true;
            }

            if (!caught || System.allocationCount() - before != 3) return 5;

        }

        return 42;
    }
}
