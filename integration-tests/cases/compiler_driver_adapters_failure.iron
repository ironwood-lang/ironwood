// SPDX-License-Identifier: MIT OR Apache-2.0

// Inject allocation failure into the native driver's adapters: a Command,
// two probes of the M4.3 helper (argument 0) through Probes, one repeated,
// and the port's ExecutableSearch. The harness points TMPDIR at an empty
// directory and checks that every run leaves it empty: each log is deleted
// and the scratch directory closed on every exit. Exit 42 on allocation
// failure with the live-allocation baseline restored, 43 on success.
import ironwood.compiler.port.Command;
import ironwood.compiler.port.ExecutableSearch;
import ironwood.compiler.port.Probes;
import ironwood.nio.file.Path;

class Main {

    static void exercise(String helper) {

        Probes probes = new Probes(null);
        defer free probes;
        try {
            StringBuilder failure = new StringBuilder();
            defer free failure;
            Command command = new Command(3);
            defer free command;
            command.add(helper).add("argv").add("value");
            String first = probes.output(command, failure);
            String second = probes.output(command, failure);
            if (first == null || second != first || !first.equals("[value]") || probes.launches() != 1) {
                throw new IllegalStateException();
            }
            Path working = Path.of("/");
            defer free working;
            Path shell = ExecutableSearch.find("sh", "/usr/bin:/bin", working);
            if (shell == null) throw new IllegalStateException();
            free shell;
        } finally {
            probes.close();
        }
    }

    public static int main(String[] args) {

        long baseline = System.liveAllocationCount();
        boolean failed = false;
        try {
            exercise(args[0]);
        } catch (OutOfMemoryError failure) {
            failed = true;
        }
        if (System.liveAllocationCount() != baseline) return 1;
        return failed ? 42 : 43;
    }
}
