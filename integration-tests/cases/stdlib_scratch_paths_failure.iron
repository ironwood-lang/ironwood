// SPDX-License-Identifier: MIT OR Apache-2.0

// Inject allocation failure into the M4.1 filesystem services: temporary
// files and directories in an explicit and the default directory (the
// harness points TMPDIR at the scratch directory in argument 0), real paths,
// no-follow attributes, deletion and access checks. A failure after native
// creation must remove the new entry, so the harness also checks that the
// scratch directory is empty after every run. Exit 42 on allocation failure
// with the live-allocation baseline restored, 43 on success.
import ironwood.io.IOException;
import ironwood.nio.file.Files;
import ironwood.nio.file.Path;
import ironwood.nio.file.attribute.BasicFileAttributes;

class Main {

    static void temporaries(Path scratch) throws IOException {

        Path file = Files.createTempFile(scratch, "file-", ".tmp");
        defer free file;
        try {
            Path real = file.toRealPath();
            defer free real;
            BasicFileAttributes attributes = Files.readAttributesNoFollow(real);
            defer free attributes;
            if (!attributes.isRegularFile() || !Files.isReadable(file) || Files.isExecutable(file)) {
                throw new IllegalStateException();
            }
        } finally {
            // A returned entry is the caller's to delete, also after a failure.
            Files.deleteIfExists(file);
        }
        if (Files.deleteIfExists(file)) throw new IllegalStateException();
        Path directory = Files.createTempDirectory(scratch, "directory-");
        defer free directory;
        if (!Files.isExecutable(directory) || !Files.deleteIfExists(directory)) throw new IllegalStateException();
    }

    static void defaults() throws IOException {

        Path file = Files.createTempFile(null, null);
        defer free file;
        Files.delete(file);
        Path directory = Files.createTempDirectory("default-");
        defer free directory;
        Files.delete(directory);
    }

    static void exercise(String scratchText) throws IOException {

        Path scratch = Path.of(scratchText);
        defer free scratch;
        temporaries(scratch);
        defaults();
    }

    public static int main(String[] args) {

        long baseline = System.liveAllocationCount();
        boolean failed = false;
        try {
            exercise(args[0]);
        } catch (OutOfMemoryError failure) {
            failed = true;
        } catch (IOException unexpected) {
            return 2;
        }
        if (System.liveAllocationCount() != baseline) return 1;
        return failed ? 42 : 43;
    }
}
