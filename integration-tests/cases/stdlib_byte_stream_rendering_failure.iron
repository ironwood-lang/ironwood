import ironwood.io.ByteArrayOutputStream;

// An allocation limit of two allows the stream and buffer but no snapshot.
// Failed decoding must leave the stream intact and reclaimable. Success is 42.
class Main {

    public static int main(String[] args) {
        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
        bytes.write(72);
        bytes.write(105);
        try {
            String unexpected = bytes.toString();
            return 1;
        } catch (OutOfMemoryError expected) {
            if (bytes.size() != 2) return 2;
        }
        bytes.write(33);
        if (bytes.size() != 3) return 3;
        return 42;
    }
}
