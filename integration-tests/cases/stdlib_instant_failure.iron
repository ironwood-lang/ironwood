import ironwood.time.Instant;
import ironwood.time.format.DateTimeParseException;

// The runner fails each allocation in one selected operation. Successful
class Main {

    public static int main(String[] args) {

        int mode = Integer.parseInt(args[0]);
        long epoch = Instant.EPOCH.getEpochSecond();
        StringBuilder source = new StringBuilder("bad input");
        DateTimeParseException existing = new DateTimeParseException("bad", "input", 0);
        System.out.print("");
        long count = System.allocationCount();
        System.out.println(count);
        try {
            if (mode == 0) {
                Instant value = Instant.ofEpochSecond(epoch);
            } else if (mode == 1) {
                String text = Instant.MAX.toString();
            } else if (mode == 2) {
                Instant value = Instant.parse("2000-01-01T00:00:00Z");
            } else if (mode == 3) {
                DateTimeParseException error = new DateTimeParseException("bad", source, 0);
            } else {
                String text = existing.getParsedString();
            }
            System.out.println(System.allocationCount() - count);
        } catch (OutOfMemoryError expected) {
            return 43;
        }
        return 42;
    }
}
