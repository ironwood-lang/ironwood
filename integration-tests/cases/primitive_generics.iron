class Cell<T> {

    private T value;

    Cell(T value) {

        this.value = value;
    }

    T get() {

        return value;
    }

    T replace(T next) {

        T previous = this.value;
        this.value = next;
        return previous;
    }

    T[] pair(T other) {

        T[] values = new T[2];
        values[0] = this.value;
        values[1] = other;
        return values;
    }
}

interface IntCellMarker {

}

class IntCell extends Cell<int> implements IntCellMarker {

    IntCell(int value) {

        super(value);
    }
}

class PrimitiveGenericOps {

    static <T> T identity(T value) {

        return value;
    }

    static <T> boolean same(T left, T right) {

        return left == right;
    }

    static int exact(int value) {

        return 1;
    }

    static <T> int exact(T value) {

        return 2;
    }

    static int widened(long value) {

        return 1;
    }

    static <T> int widened(T value) {

        return 2;
    }
}

class Pair<A, B> {

    private A first;
    private B second;

    Pair(A first, B second) {

        this.first = first;
        this.second = second;
    }

    A first() {

        return first;
    }

    B second() {

        return second;
    }
}

class Constructed<T> {

    private T value;

    <U> Constructed(U ignored, T value) {

        this.value = value;
    }

    T value() {

        return value;
    }
}

interface PrimitiveTransformer<T> {

    T transform(T value);
}

class AddOne implements PrimitiveTransformer<int> {

    @Override
    public int transform(int value) {

        return value + 1;
    }
}

class AddTwo implements PrimitiveTransformer<int> {

    @Override
    public int transform(int value) {

        return value + 2;
    }
}

class PrimitiveBase<T> {

    T transform(T value) {

        return value;
    }
}

class AddThree extends PrimitiveBase<int> {

    @Override
    int transform(int value) {

        return value + 3;
    }
}

class AddFour extends PrimitiveBase<int> {

    @Override
    int transform(int value) {

        return value + 4;
    }
}

interface GenericEcho {

    <T> T echo(T value);
}

class FirstEcho implements GenericEcho {

    @Override
    public <T> T echo(T value) {

        return value;
    }
}

class SecondEcho implements GenericEcho {

    @Override
    public <T> T echo(T value) {

        return value;
    }
}

class Main {

    private static int reclaimSpecializedCell() {

        Cell<int> disposable = new Cell<int>(42);
        int value = disposable.get();
        free disposable;
        return value;
    }

    public static int main(String[] args) {

        Cell<int> cell = new Cell<int>(40);
        if (cell.get() != 40 || cell.replace(42) != 40 || cell.get() != 42) return 1;
        Object erasedCell = cell;
        if (erasedCell instanceof Cell<?>) return 7;
        IntCellMarker markedCell = new IntCell(42);
        Cell<int> recoveredCell = (Cell<int>) markedCell;
        if (recoveredCell.get() != 42) return 8;
        Cell<boolean> booleans = new Cell<boolean>(true);
        Cell<byte> bytes = new Cell<byte>((byte) 1);
        Cell<short> shorts = new Cell<short>((short) 2);
        Cell<char> characters = new Cell<char>('A');
        Cell<long> longs = new Cell<long>(4L);
        Cell<float> floats = new Cell<float>(5.0f);
        Cell<double> doubles = new Cell<double>(6.0);
        if (!booleans.get() || bytes.get() != (byte) 1 || shorts.get() != (short) 2
                || characters.get() != 'A' || longs.get() != 4L
                || floats.get() != 5.0f || doubles.get() != 6.0) {

            return 6;
        }
        int[] values = cell.pair(7);
        if (values[0] != 42 || values[1] != 7) return 2;

        long before = System.allocationCount();
        boolean booleanValue = PrimitiveGenericOps.identity(true);
        byte byteValue = PrimitiveGenericOps.<byte>identity((byte) 1);
        short shortValue = PrimitiveGenericOps.identity((short) 2);
        char charValue = PrimitiveGenericOps.identity('A');
        int intValue = PrimitiveGenericOps.identity(3);
        long longValue = PrimitiveGenericOps.identity(4L);
        float floatValue = PrimitiveGenericOps.identity(5.0f);
        double doubleValue = PrimitiveGenericOps.identity(6.0);
        long after = System.allocationCount();
        if (!booleanValue || byteValue != (byte) 1 || shortValue != (short) 2
                || charValue != 'A' || intValue != 3 || longValue != 4L
                || floatValue != 5.0f || doubleValue != 6.0 || before != after
                || !PrimitiveGenericOps.same(42, 42)
                || PrimitiveGenericOps.same(42, 41)
                || PrimitiveGenericOps.exact(42) != 1
                || PrimitiveGenericOps.widened(42) != 2) {

            return 3;
        }

        PrimitiveTransformer<int> transformer = new AddOne();
        PrimitiveBase<int> base = new AddThree();
        GenericEcho echo = new FirstEcho();
        if (args.length != 0) {
            transformer = new AddTwo();
            base = new AddFour();
            echo = new SecondEcho();
        }
        if (transformer.transform(40) != 41 || base.transform(39) != 42
                || echo.echo(42) != 42) {

            return 4;
        }

        Cell<int> inferred = new Cell<>(41);
        Cell<int>[] specializedReferences = new Cell<int>[1];
        specializedReferences[0] = inferred;
        Pair<int, String> pair = new Pair<int, String>(42, "shape");
        Pair<int, Object> sameShape = new Pair<int, Object>(42, args);
        Constructed<int> constructed = new <long> Constructed<>(9L, 42);
        if (specializedReferences[0].get() != 41
                || pair.first() != 42 || pair.second() != "shape"
                || sameShape.first() != 42 || sameShape.second() != args
                || constructed.value() != 42 || reclaimSpecializedCell() != 42) {

            return 5;
        }

        return 42;
    }
}
