    }

    static int container8(boolean clear) {

        int before = Item.destroyed;
        ByteMap<Item> values = new ByteMap<Item>();
        Item item = new Item();
        values.put((byte) 1, item); values.put((byte) 2, item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put((byte) 1, next); values.put((byte) 2, next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

    static int container9(boolean clear) {

        int before = Item.destroyed;
        CharMap<Item> values = new CharMap<Item>();
        Item item = new Item();
        values.put('a', item); values.put('b', item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put('a', next); values.put('b', next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
