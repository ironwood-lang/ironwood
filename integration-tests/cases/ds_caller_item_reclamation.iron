    }

    static int container13(boolean clear) {

        int before = Item.destroyed;
        IdentityHashSet<Item> values = new IdentityHashSet<Item>(1);
        Item item = new Item();
        values.add(item); values.add(item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
