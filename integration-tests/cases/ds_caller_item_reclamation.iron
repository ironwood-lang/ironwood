        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

    static int container14(boolean clear) {

        int before = Item.destroyed;
        LinkedHashSet<Item> values = new LinkedHashSet<Item>(1);
        Item item = new Item();
        values.add(item); values.add(item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.add(next); values.add(next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

    static int views() {

        ArrayList<Item> values = new ArrayList<Item>();
        Item item = new Item();
        values.add(item);
        UnmodifiableList<Item> first = Collections.unmodifiableList(values);
        UnmodifiableList<Item> second = Collections.unmodifiableList(values);
        if (first.size() != 1 || second.isEmpty()) return 1;
        free first;
        free second;
        free values;
        free item;
        return 0;
    }

    static int shared() {

        ArrayList<Item> first = new ArrayList<Item>();
        LinkedList<Item> second = new LinkedList<Item>(1);
        Item item = new Item();
        first.add(item);
        second.add(item);
        first.clear();
        free second;
        free item;
        free first;
        return 0;
    }

    static int copiedInputs() {

        CharSequenceMap<String> text = new CharSequenceMap<String>();
        StringBuilder key = new StringBuilder();
        key.append("key");
        text.put(key, "value");
        free key;
        if (text.get("key") != "value") return 1;
        free text;

        ByteBufferMap<String> bytes = new ByteBufferMap<String>();
        byte[] array = new byte[1];
        array[0] = 7;
        bytes.put(array, "array");
        free array;
        ByteBuffer buffer = ByteBuffer.allocate(1);
        buffer.put((byte) 8).flip();
        bytes.put(buffer, "buffer");
        free buffer;
        if (bytes.size() != 2) return 2;
        free bytes;
        return 0;
    }

    static int removed() {

        ArrayList<Item> values = new ArrayList<Item>();
        Item item = new Item();
        values.add(item);
        values.add(item);
        values.remove(0);
        values.clear();
        free item;
        free values;
        return 0;
    }

    static int run(boolean clear) {

        if (container0(clear) != 0) return 1;
        if (container1(clear) != 0) return 2;
        if (container2(clear) != 0) return 3;
        if (container3(clear) != 0) return 4;
        if (container4(clear) != 0) return 5;
        if (container5(clear) != 0) return 6;
        if (container6(clear) != 0) return 7;
        if (container7(clear) != 0) return 8;
        if (container8(clear) != 0) return 9;
        if (container9(clear) != 0) return 10;
        if (container10(clear) != 0) return 11;
        if (container11(clear) != 0) return 12;
        if (container12(clear) != 0) return 13;
        if (container13(clear) != 0) return 14;
        if (container14(clear) != 0) return 15;
        if (views() != 0 || shared() != 0 || copiedInputs() != 0 || removed() != 0) return 30;
        return 0;
    }

    public static int main(String[] args) {

        // Warm static state before checking the second run's live allocations.
        if (run(true) != 0) return 1;
        long baseline = System.liveAllocationCount();
        if (run(false) != 0) return 2;
        if (System.liveAllocationCount() != baseline) return 3;
        return 42;
    }
}
