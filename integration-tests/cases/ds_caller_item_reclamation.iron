    }

    static int container11(boolean clear) {

        int before = Item.destroyed;
        byte[] bytes = new byte[1];
        ByteBufferMap<Item> values = new ByteBufferMap<Item>(1);
        Item item = new Item();
        values.put(bytes, item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put(bytes, next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
        free bytes;
        return 0;
    }

    static int container12(boolean clear) {

        int before = Item.destroyed;
        HashSet<Item> values = new HashSet<Item>(1);
        Item item = new Item();
        values.add(item); values.add(item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.add(next); values.add(next);
        free values;
