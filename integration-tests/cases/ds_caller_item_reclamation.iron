// Containers borrow caller items. Releasing a whole container or clearing all
// observable entries permits explicit caller reclamation without destroying items
// implicitly. Exercise growth, duplicate references, reuse, branch joins, and
// multiple live list views. Expected exit: 42, no output or live-allocation growth.
import ironwood.ds.*;
import ironwood.nio.ByteBuffer;

class Item {

    static int destroyed;
    int value = 42;
    @Override public int hashCode() {

        return value;
    }
    destructor {

        destroyed++;
    }
}

class Main {

    static int container0(boolean clear) {

        int before = Item.destroyed;
        ArrayList<Item> values = new ArrayList<Item>(1);
        Item item = new Item();
        values.add(item); values.addFirst(item); values.insert(1, item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.add(next); values.addFirst(next); values.insert(1, next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

    static int container1(boolean clear) {

        int before = Item.destroyed;
        LinkedList<Item> values = new LinkedList<Item>(1);
        Item item = new Item();
        values.add(item); values.addFirst(item); values.addLast(item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.add(next); values.addFirst(next); values.addLast(next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

    static int container2(boolean clear) {

        int before = Item.destroyed;
        ArrayLinkedList<Item> values = new ArrayLinkedList<Item>(1);
        Item item = new Item();
        values.addLast(item); values.addLast(item);
        values.clear(false);
        free values;
        if (item.value != 42 || Item.destroyed != before) return 1;
        free item;
        if (Item.destroyed != before + 1) return 2;
        return 0;
    }

    static int container3(boolean clear) {

        int before = Item.destroyed;
        HashMap<Item, Item> values = new HashMap<Item, Item>(1);
        Item item = new Item();
        values.put(item, item); values.put(item, item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put(next, next); values.put(next, next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

