    }

    static int container10(boolean clear) {

        int before = Item.destroyed;
        CharSequenceMap<Item> values = new CharSequenceMap<Item>(1);
        Item item = new Item();
        values.put("a", item); values.put("b", item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
