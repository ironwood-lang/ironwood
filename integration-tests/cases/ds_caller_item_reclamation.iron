        int before = Item.destroyed;
        IdentityHashMap<Item, Item> values = new IdentityHashMap<Item, Item>(1);
        Item item = new Item();
        values.put(item, item); values.put(item, item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put(next, next); values.put(next, next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
