        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put(next, next); values.put(next, next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
        free next;
        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

    static int container6(boolean clear) {

        int before = Item.destroyed;
        IntMap<Item> values = new IntMap<Item>(1);
        Item item = new Item();
        values.put(1, item); values.put(2, item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put(1, next); values.put(2, next);
        free values;
        if (next.value != 42 || Item.destroyed != before + 1) return 2;
