        if (Item.destroyed != before + 2) return 3;
        return 0;
    }

    static int container7(boolean clear) {

        int before = Item.destroyed;
        LongMap<Item> values = new LongMap<Item>(1);
        Item item = new Item();
        values.put(1L, item); values.put(2L, item);
        if (clear) {
            values.clear();
        } else {
            values.clear();
        }
        if (!values.isEmpty() || item.value != 42 || Item.destroyed != before) return 1;
        free item;
        Item next = new Item();
        values.put(1L, next); values.put(2L, next);
        free values;
