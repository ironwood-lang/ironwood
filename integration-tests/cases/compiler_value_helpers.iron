// M1.3 value helpers against their Java 21 counterparts. Prints, in order:
// every simple escape decoded in character and string context plus a hash over
// all 131,072 inputs; int sequences generated by a shared LCG with their size,
// wrapping sum, negative flag, List<Integer> hash and copy equality; singleton
// list behavior; and record value semantics for source positions and spans,
// evidence sites, retentions and effect summaries with logical BitSet
// equality. The transcript must equal ValueHelpersReference. Exit 42.
import ironwood.ds.*;
import ironwood.util.BitSet;
import ironwood.compiler.port.*;

final class Position {

    private final int offset;
    private final int line;
    private final int column;

    Position(int offset, int line, int column) {

        if (offset < 0 || line < 1 || column < 1) throw new IllegalArgumentException("invalid source position");
        this.offset = offset;
        this.line = line;
        this.column = column;
    }

    int offset() {

        return this.offset;
    }

    @Override public boolean equals(Object value) {

        if (!(value instanceof Position)) return false;
        Position other = (Position) value;
        return this.offset == other.offset && this.line == other.line && this.column == other.column;
    }

    @Override public int hashCode() {

        return (this.offset * 31 + this.line) * 31 + this.column;
    }
}

final class Span {

    private final Position start;
    private final Position end;

    Span(Position start, Position end) {

        if (start == null || end == null || end.offset() < start.offset()) {
            throw new IllegalArgumentException("invalid source span");
        }
        this.start = start;
        this.end = end;
    }

    @Override public boolean equals(Object value) {

        if (!(value instanceof Span)) return false;
        Span other = (Span) value;
        return this.start.equals(other.start) && this.end.equals(other.end);
    }

    @Override public int hashCode() {

        return this.start.hashCode() * 31 + this.end.hashCode();
    }
}

// SourceFile compares by identity.
final class Source {
}

final class Site {

    private final Source source;
    private final Span span;

    Site(Source source, Span span) {

        this.source = source;
        this.span = span;
    }

    @Override public boolean equals(Object value) {

        if (!(value instanceof Site)) return false;
        Site other = (Site) value;
        return this.source == other.source && this.span.equals(other.span);
    }

    @Override public int hashCode() {

        return System.identityHashCode(this.source) * 31 + this.span.hashCode();
    }
}

final class Retention {

    private final Object owner;
    private final Object child;

    Retention(Object owner, Object child) {

        this.owner = owner;
        this.child = child;
    }

    @Override public boolean equals(Object value) {

        if (!(value instanceof Retention)) return false;
        Retention other = (Retention) value;
        return this.owner == other.owner && this.child == other.child;
    }

    @Override public int hashCode() {

        return System.identityHashCode(this.owner) * 31 + System.identityHashCode(this.child);
    }
}

// ClosedWorldEffectAnalyzer.Summary: flags plus independent logical bit vectors.
final class Summary {

    private final boolean allocates;
    private final boolean throwsOutward;
    private final BitSet published;
    private final BitSet returned;
    private final BitSet reclaimed;

    Summary(boolean allocates, boolean throwsOutward, BitSet published, BitSet returned, BitSet reclaimed) {

        this.allocates = allocates;
        this.throwsOutward = throwsOutward;
        this.published = SnapshotBits.copy(published);
        this.returned = SnapshotBits.copy(returned);
        this.reclaimed = SnapshotBits.copy(reclaimed);
    }

    boolean same(Summary other) {

        return other != null && this.allocates == other.allocates && this.throwsOutward == other.throwsOutward
                && this.published.equals(other.published) && this.returned.equals(other.returned)
                && this.reclaimed.equals(other.reclaimed);
    }

    destructor {

        free this.reclaimed;
        free this.returned;
        free this.published;
    }
}

class Main {

    static int state = 20261005;

    static int next(int bound) {

        state = state * 1103515245 + 12345;
        return ((state >>> 16) & 32767) % bound;
    }

    static void escapes() {

        int hash = -2128831035;
        int present = 0;
        for (int code = 0; code < 65536; code++) {
            for (int context = 0; context < 2; context++) {
                int decoded = CharEscapes.decodeSimple((char) code, context == 1);
                hash = (hash ^ decoded) * 16777619;
                if (decoded != CharEscapes.ABSENT) {
                    present++;
                    System.out.println("escape " + code + ":" + context + ":" + decoded);
                }
            }
        }
        System.out.println("escapes present:" + present + " hash:" + hash);
    }

    static void ints() {

        int[] pool = {0, 1, 2, -1, 7, 2147483647, -2147483648, 1000000000};
        for (int round = 0; round < 64; round++) {
            int length = next(7);
            IntArrayList builder = new IntArrayList(8);
            for (int index = 0; index < length; index++) builder.add(pool[next(pool.length)]);
            SnapshotInts first = new SnapshotInts(builder);
            SnapshotInts second = new SnapshotInts(builder);
            builder.add(5);
            boolean independent = first.size() == length;
            System.out.println("ints " + round + ":" + first.size() + ":" + first.sum() + ":" + first.anyNegative()
                    + ":" + first.hashCode() + ":" + first.equals(second) + ":" + independent);
            free second; free first; free builder;
        }
        SnapshotInts empty = new SnapshotInts(null);
        System.out.println("ints empty:" + empty.size() + ":" + empty.sum() + ":" + empty.hashCode());
        boolean bounded = false;
        try { empty.get(0); }
        catch (IndexOutOfBoundsException expected) { bounded = true; }
        System.out.println("ints bounds:" + bounded);
        free empty;
        free pool;
    }

    static void singles() {

        Source item = new Source();
        SnapshotList<Source> one = Lists.single(item);
        System.out.println("single:" + one.size() + ":" + (one.get(0) == item));
        free one;
        boolean rejected = false;
        try {
            SnapshotList<Source> none = Lists.single(null);
            free none;
        }

        catch (NullPointerException expected) {
            rejected = true;
        }

        System.out.println("single null:" + rejected);
        // The generic factory conservatively exposes its item, which stays live.
    }

    static boolean rejectsPosition(int offset, int line, int column) {

        try {
            Position unexpected = new Position(offset, line, column);
            free unexpected;
        }

        catch (IllegalArgumentException expected) {
            return true;
        }

        return false;
    }

    static boolean rejectsSpan(Position start, Position end) {

        try {
            Span unexpected = new Span(start, end);
            free unexpected;
        }

        catch (IllegalArgumentException expected) {
            return true;
        }

        return false;
    }

    static void records() {

        Position a = new Position(4, 1, 5);
        Position equalA = new Position(4, 1, 5);
        Position b = new Position(9, 2, 1);
        System.out.println("position:" + a.equals(equalA) + ":" + (a.hashCode() == equalA.hashCode()) + ":"
                + a.equals(b) + ":" + a.equals(null));
        System.out.println("position invalid:" + rejectsPosition(-1, 1, 1) + ":" + rejectsPosition(0, 0, 1) + ":"
                + rejectsPosition(0, 1, 0) + ":" + rejectsPosition(0, 1, 1));
        Span span = new Span(a, b);
        Span equalSpan = new Span(equalA, b);
        Span point = new Span(a, a);
        System.out.println("span:" + span.equals(equalSpan) + ":" + (span.hashCode() == equalSpan.hashCode()) + ":"
                + span.equals(point));
        System.out.println("span invalid:" + rejectsSpan(null, a) + ":" + rejectsSpan(a, null) + ":"
                + rejectsSpan(b, a) + ":" + rejectsSpan(a, a));
        Source file = new Source();
        Source otherFile = new Source();
        Site site = new Site(file, span);
        Site equalSite = new Site(file, equalSpan);
        Site otherSite = new Site(otherFile, span);
        System.out.println("site:" + site.equals(equalSite) + ":" + (site.hashCode() == equalSite.hashCode()) + ":"
                + site.equals(otherSite));
        Retention retention = new Retention(file, otherFile);
        Retention equalRetention = new Retention(file, otherFile);
        Retention swapped = new Retention(otherFile, file);
        System.out.println("retention:" + retention.equals(equalRetention) + ":"
                + (retention.hashCode() == equalRetention.hashCode()) + ":" + retention.equals(swapped));
        BitSet bits = new BitSet();
        bits.set(1);
        bits.set(200);
        BitSet trimmed = new BitSet();
        trimmed.set(1);
        BitSet none = new BitSet();
        Summary first = new Summary(true, false, bits, none, none);
        bits.clear(200);
        Summary second = new Summary(true, false, bits, none, none);
        Summary third = new Summary(true, false, trimmed, none, none);
        Summary fourth = new Summary(false, false, trimmed, none, none);
        System.out.println("summary:" + first.same(second) + ":" + second.same(third) + ":" + third.same(fourth)
                + ":" + third.same(null));
        free fourth; free third; free second; free first;
        free none; free trimmed; free bits;
        free swapped; free equalRetention; free retention;
        free otherSite; free equalSite; free site;
        free otherFile; free file;
        free point; free equalSpan; free span;
        free b; free equalA; free a;
    }

    public static int main(String[] args) {

        escapes();
        ints();
        singles();
        records();
        return 42;
    }
}
