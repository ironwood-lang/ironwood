import ironwood.ds.ArrayList;
import ironwood.ds.ByteMap;
import ironwood.ds.IntArrayList;
import ironwood.ds.IntHolder;
import ironwood.ds.LinkedList;
import ironwood.ds.HashMap;
import ironwood.ds.HashSet;
import ironwood.util.Iterator;

class Item {

    int value;

    Item(int value) {

        this.value = value;
    }
}

class Main {

    public static int main(String[] args) {
        ArrayList<String> list = new ArrayList<String>();
        list.add("value");
        Iterator<String> iterator = list.iterator();
        while (iterator.hasNext()) {
            if (iterator.next() != "value") return 1;
        }


        IntArrayList numbers = new IntArrayList(2);
        numbers.add(42);
        Iterator<IntHolder> numberIterator = numbers.iterator();
        IntHolder number = numberIterator.next();
        if (number.get() != 42) return 3;


        Item item = new Item(42);
        ArrayList<Item> borrowedElements = new ArrayList<Item>();
        borrowedElements.add(item);
        if (item.value != 42) return 5;

        ByteMap<String> byteMap = new ByteMap<String>();
        byteMap.put((byte) 7, "byte");

        HashMap<String, String> map = new HashMap<String, String>();
        map.put("key", "value");

        LinkedList<String> linked = new LinkedList<String>(4);
        linked.add("value");

        HashSet<String> set = new HashSet<String>();
        set.add("value");
        return 42;
    }
}
