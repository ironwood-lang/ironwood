// Run with different IRONWOOD_ALLOCATION_LIMIT values to fail construction,
// creation-array growth and availability-storage growth. Cleanup must restore
// the initial live allocation count on every failure and success path.
// Expected exit: 42, no output.
import ironwood.pool.*;

class Value { private int[] storage = new int[2]; destructor { free this.storage; } }
class Factory implements ObjectBuilder<Value> {

    @Override public Value newInstance() {

        return new Value();
    }
}
class Main {

    static int attempts;
    static void checkArrayObjectPool() {

        attempts++;
        Factory factory = new Factory();
        try {
            ArrayObjectPool<Value> pool = new ArrayObjectPool<Value>(1, factory);
            try {
                // Keep values checked out to exercise creation-array and pool growth.
                for (int i = 0; i < 12; i++) { pool.get(); }
                // Repeated returns exercise left growth without tracking writes.
                // Although misuse, they must not cause duplicate destruction.
                Value returned = pool.get();
                for (int i = 0; i < 30; i++) { pool.release(returned); }
            } finally { free pool; }
        } finally { free factory; }
    }
    static void checkMultiArrayObjectPool() {

        attempts++;
        Factory factory = new Factory();
        try {
            MultiArrayObjectPool<Value> pool = new MultiArrayObjectPool<Value>(1, factory);
            try {
                // Keep values checked out to exercise creation-array and pool growth.
                for (int i = 0; i < 12; i++) { pool.get(); }
                // Repeated returns exercise left growth without tracking writes.
                // Although misuse, they must not cause duplicate destruction.
                Value returned = pool.get();
                for (int i = 0; i < 30; i++) { pool.release(returned); }
            } finally { free pool; }
        } finally { free factory; }
    }
    public static int main(String[] args) {

        long baseline = System.liveAllocationCount();
        try {
            if (args[0].equals("0")) checkArrayObjectPool();
            if (args[0].equals("1")) checkMultiArrayObjectPool();
        } catch (OutOfMemoryError failure) {}
        if (attempts != 1) return 2;
        if (System.liveAllocationCount() != baseline) return 1;
        return 42;
    }
}
