interface Reader {

    int read(int value);
    int read(boolean value);
}

class BaseReader implements Reader {

    @Override
    public int read(int value) {

        return value;
    }

    @Override
    public int read(boolean value) {

        if (value) return 7;
        return 0;
    }
}

class ChildReader extends BaseReader {

    @Override
    public int read(int value) {

        return value + 10;
    }
}

class Box {

    int value;

    Box() {

        this(10);
    }

    Box(int value) {

        this.value = value;
    }
}

class AccessBase {

    public int choose(Object value) {

        return 1;
    }
}

class AccessChild extends AccessBase {

    private int choose(String value) {

        return 2;
    }
}

class ConstructorChoice {

    int selected;

    public ConstructorChoice(Object value) {

        this.selected = 1;
    }

    private ConstructorChoice(String value) {

        this.selected = 2;
    }
}

class InvocationChoice {

    static int form(String value) {

        return 3;
    }

    int form(Object value) {

        return 4;
    }
}

class Main {

    static int choose(int value) {

        return value;
    }

    static int choose(boolean value) {

        if (value) return 1;
        return 0;
    }

    public static int main(String[] args) {

        Box box = new Box();
        Reader reader = new ChildReader();
        AccessChild access = new AccessChild();
        ConstructorChoice constructor = new ConstructorChoice("value");
        InvocationChoice invocation = new InvocationChoice();
        if (access.choose("value") != 1) return 1;
        if (constructor.selected != 1) return 2;
        if (invocation.form("value") != 3) return 3;
        if (InvocationChoice.form("value") != 3) return 4;
        return box.value + reader.read(3) + reader.read(true) + choose(12);
    }
}
