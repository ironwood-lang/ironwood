import ironwood.ds.*;
import ironwood.util.Iterator;
class Main {

    static String key;
    static String other;
    static void cursorHashMap() {

        HashMap<String, String> source = new HashMap<String, String>(4);
        source.put("Aa", "first"); source.put("BB", "second");
        Iterator<String> iterator = source.iterator();
        String first = iterator.next();
        HashMap<String, String> copied = source.copy();
        if (source.getCurrIteratorKey() == null) throw new IllegalStateException();
        String second = iterator.next();
        if (first == second || copied.size() != 2) throw new IllegalStateException();
        ; ;
    }
    static void membershipHashMap() {

        HashMap<String, String> source = new HashMap<String, String>(4);
        source.put("Aa", "first"); source.put("BB", "second");
        HashMap<String, String> copied = source.copy();
        if (copied.get("Aa") != "first" || copied.get("BB") != "second") throw new IllegalStateException();
        source.clear();
        if (copied.get("Aa") != "first") throw new IllegalStateException();
        ; ;
    }
    static void cursorIdentityHashMap() {

        IdentityHashMap<String, String> source = new IdentityHashMap<String, String>(4);
        source.put("Aa", "first"); source.put("BB", "second");
        Iterator<String> iterator = source.iterator();
        String first = iterator.next();
        IdentityHashMap<String, String> copied = source.copy();
        if (source.getCurrIteratorKey() == null) throw new IllegalStateException();
        String second = iterator.next();
        if (first == second || copied.size() != 2) throw new IllegalStateException();
        ; ;
    }
    static void membershipIdentityHashMap() {

        IdentityHashMap<String, String> source = new IdentityHashMap<String, String>(4);
        source.put("Aa", "first"); source.put("BB", "second");
        IdentityHashMap<String, String> copied = source.copy();
        if (copied.get("Aa") != "first" || copied.get("BB") != "second") throw new IllegalStateException();
        source.clear();
        if (copied.get("Aa") != "first") throw new IllegalStateException();
        ; ;
    }
    static void cursorLinkedHashMap() {

        LinkedHashMap<String, String> source = new LinkedHashMap<String, String>(4);
        source.put("Aa", "first"); source.put("BB", "second");
        Iterator<String> iterator = source.iterator();
        String first = iterator.next();
        LinkedHashMap<String, String> copied = source.copy();
        if (source.getCurrIteratorKey() == null) throw new IllegalStateException();
        String second = iterator.next();
        if (first == second || copied.size() != 2) throw new IllegalStateException();
        ; ;
    }
    static void membershipLinkedHashMap() {

        LinkedHashMap<String, String> source = new LinkedHashMap<String, String>(4);
        source.put("Aa", "first"); source.put("BB", "second");
        LinkedHashMap<String, String> copied = source.copy();
        if (copied.get("Aa") != "first" || copied.get("BB") != "second") throw new IllegalStateException();
        Iterator<String> iterator = copied.iterator();
        if (iterator.next() != "first" || iterator.next() != "second") throw new IllegalStateException();
        source.clear();
        if (copied.get("Aa") != "first") throw new IllegalStateException();
        ; ;
    }
    static void identityKeys() {

        IdentityHashMap<String, String> source = new IdentityHashMap<String, String>(1);
        source.put(key, "value");
        IdentityHashMap<String, String> copied = source.copy();
        if (copied.containsKey(other) || !copied.containsKey(key)) throw new IllegalStateException();
        ; ;
    }
    public static int main(String[] args) {

        key = new String("equal");
        other = new String("equal");
        if (key == other || !key.equals(other)) return 2;
        cursorHashMap(); cursorIdentityHashMap(); cursorLinkedHashMap();
        membershipHashMap(); membershipIdentityHashMap(); membershipLinkedHashMap();
        identityKeys();

        return 42;
    }
}
