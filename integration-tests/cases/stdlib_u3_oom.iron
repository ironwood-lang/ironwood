import ironwood.io.*;
import ironwood.nio.file.*;

// Run under allocation limits at each owned-graph construction boundary.
// Native open is last: failed construction must leave no new destination file.
class Main {

    public static int main(String[] args) throws IOException {

        Path path = Path.of(args[1]);
        boolean failed = false;
        try {
            try {
                if (args[0].equals("reader")) {
                    BufferedReader reader = Files.newBufferedReader(path);
                    try {
                        try {
                            String line = reader.readLine();
                        } finally { reader.close(); }
                    } finally { ; }
                } else if (args[0].equals("bytes")) {

                    ByteArrayOutputStream output = new ByteArrayOutputStream(1);
                    try {
                        output.write(1);
                        output.write(2);
                        byte[] snapshot = output.toByteArray();
                    } finally { ; }
                } else if (args[0].equals("text")) {

                    StringWriter output = new StringWriter(1);
                    try {
                        output.write("four");
                        String snapshot = output.toString();
                    } finally { ; }
                } else {
                    BufferedWriter writer = Files.newBufferedWriter(path);
                    try { writer.close(); } finally { ; }
                }
            } catch (OutOfMemoryError expected) {

                failed = true;
            }

        } finally { ; }
        if (failed) return 42;
        return 0;
    }
}
