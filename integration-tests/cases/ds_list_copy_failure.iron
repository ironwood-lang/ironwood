// Inject OOM into source and result construction/growth. Both lists own their
// storage; neither frees borrowed literals. Exit 42 on OOM, 43 on success.
import ironwood.ds.ArrayList;

class Main {

    static void copyLists() {

        ArrayList<String> source = new ArrayList<String>(1);
        for (int index = 0; index < 256; index++) {
            source.add("item");
        }
        ArrayList<String> copied = source.copy();
        if (copied.size() != 256 || source.size() != 256) throw new IllegalStateException();
    }

    public static int main(String[] args) {
        boolean failed = false;
        try {
            copyLists();
        } catch (OutOfMemoryError failure) {
            failed = true;
        }

        return failed ? 42 : 43;
    }
}
