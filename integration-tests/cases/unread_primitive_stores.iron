class StoreBase {

    int live;
    int dead;
    Object reference;

    StoreBase() {

        this.live = 10;
        this.dead = 11;
        this.reference = "retained reference store";
    }

    int read() {

        return this.live;
    }

    int unusedGetter() {

        return this.dead;
    }
}

class StoreChild extends StoreBase {

    long live;
    int dead;

    StoreChild() {

        this.live = 20L;
        this.dead = 22;
    }

    @Override int read() {

        return super.read() + (int) this.live;
    }
}

class StoreCell<T> {

    T item;

    StoreCell(T item) {

        this.item = item;
    }
}

class StoreObserved {
    int observed;

    StoreObserved(int value) {

        this.observed = value;
    }

}

class Main {

    static int effects;
    static int cleaned;

    static int next() {

        effects++;
        return effects;
    }

    static int fail() {

        effects++;
        throw new IllegalStateException("preserved RHS");
    }

    static void store(StoreBase value) {

        int captured = next();
        value.dead = captured;
    }

    static int run() {

        StoreChild child = new StoreChild();
        StoreCell<int> number = new StoreCell<int>(9);
        StoreCell<String> text = new StoreCell<String>("reference");
        StoreObserved watch = new StoreObserved(7);
        store(child);
        try {
            store(null);
            return 1;
        } catch (NullPointerException expected) {
            if (effects != 2) return 2;
        } finally {
            cleaned++;
        }
        try {
            child.dead = fail();
            return 3;
        } catch (IllegalStateException expected) {
            if (effects != 3) return 4;
        } finally {
            cleaned++;
        }
        StoreBase base = child;
        if (base.read() != 30 || watch.observed != 7 || effects != 3 || cleaned != 2) return 5;
        return 42;
    }

    public static int main(String[] args) {

        int result = run();
        return result == 42 ? 42 : 6;
    }
}
