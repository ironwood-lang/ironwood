class Cell {

    private int value;

    Cell(int value) {

        this.value = value;
    }

    int read() {

        return value;
    }
}

class Main {

    static int read(int[] values, int index) {

        return values[index];
    }

    public static int main(String[] args) {

        int[] values = new int[3];
        boolean[] flags = new boolean[2];
        Cell[] cells = new Cell[2];
        Cell cell = new Cell(35);
        values[1] = 6;
        flags[0] = true;
        cells[0] = cell;
        int result = values.length + read(values, 1) + cells[0].read();
        boolean enabled = flags[0];
        boolean zeroInt = values[0] == 0;
        boolean zeroBoolean = flags[1] == false;
        boolean zeroReference = cells[1] == null;
        free cells;
        free flags;
        free values;
        if (!zeroInt) return 1;
        if (!zeroBoolean) return 2;
        if (!zeroReference) return 3;
        if (enabled) result = result - 2;
        return result;
    }
}
