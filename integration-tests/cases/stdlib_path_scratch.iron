import ironwood.nio.file.Path;
import ironwood.nio.file.Paths;

class Main {

    // Each non-null path result owns exactly its wrapper and one String.
    static boolean normalize(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.normalize();
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean name(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.getFileName();
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean parent(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.getParent();
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean root(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.getRoot();
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean absolute(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.toAbsolutePath();
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean resolveText(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.resolve("../z//🌲/");
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean resolvePath(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        Path other = Path.of("../z//🌲/");
        long before = System.allocationCount();
        Path result = base.resolve(other);
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean siblingText(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.resolveSibling("../z//🌲/");
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean siblingPath(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        Path other = Path.of("../z//🌲/");
        long before = System.allocationCount();
        Path result = base.resolveSibling(other);
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean resolveEmpty(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.resolve("");
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean resolveRooted(String input) {

        long baseline = System.liveAllocationCount();
        Path base = Paths.get(input);
        long before = System.allocationCount();
        Path result = base.resolve("///fixed//leaf/");
        if (result == null) {
            boolean correct = System.allocationCount() == before;
            System.out.println("<null>");
            return correct;
        }
        boolean correct = System.allocationCount() == before + 2;
        // The transformed result must remain valid after both borrowed inputs die.
        System.out.println(result.toString());
        return correct;
    }

    static boolean check(String input) {

        long baseline = System.liveAllocationCount();
        long before = System.allocationCount();
        Path base = Paths.get(input);
        boolean correct = System.allocationCount() == before + 2;
        System.out.println(base.toString());
        if (!normalize(input)) correct = false;
        if (!name(input)) correct = false;
        if (!parent(input)) correct = false;
        if (!root(input)) correct = false;
        if (!absolute(input)) correct = false;
        if (!resolveText(input)) correct = false;
        if (!resolvePath(input)) correct = false;
        if (!siblingText(input)) correct = false;
        if (!siblingPath(input)) correct = false;
        if (!resolveEmpty(input)) correct = false;
        if (!resolveRooted(input)) correct = false;
        return correct;
    }

    public static int main(String[] args) {

        for (int index = 0; index < args.length; index++) {
            if (!check(args[index])) return 1;
        }
        return 42;
    }
}
