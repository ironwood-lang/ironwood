import ironwood.io.BufferedOutputStream;
import ironwood.io.IOException;
import ironwood.io.InputStream;
import ironwood.net.InetAddress;
import ironwood.net.InetSocketAddress;
import ironwood.net.ServerSocket;
import ironwood.net.Socket;

// Exit 42 proves exact loopback output, close-before-free, and no per-cycle retention.
// Every acquired owner is explicitly scheduled; borrowed streams are never freed.
class Main {

    static int cycle() throws IOException {

        byte[] bytes = {127, 0, 0, 1};
        defer free bytes;
        InetAddress address = InetAddress.getByAddress(bytes);
        defer free address;
        ServerSocket listener = new ServerSocket();
        defer free listener;
        defer listener.close();
        listener.bind(null);
        InetSocketAddress endpoint = new InetSocketAddress(address, listener.getLocalPort());
        defer free endpoint;
        Socket client = new Socket();
        defer free client;
        defer client.close();
        client.connect(endpoint, 1000);
        Socket peer = listener.accept();
        defer free peer;
        defer peer.close();
        peer.setSoTimeout(1000);
        InputStream input = peer.getInputStream();
        {
            BufferedOutputStream output = new BufferedOutputStream(client.getOutputStream(), 16);
            defer free output;
            defer output.close();
            defer output.write(44);
            output.write(42);
            output.write(43);
        }
        if (!client.isClosed() || input.read() != 42 || input.read() != 43
                || input.read() != 44 || input.read() != -1) return 1;
        return 42;
    }

    public static int main(String[] args) throws IOException {

        // The first cycle initializes process-owned socket factories and option
        // inventories. Repeated cycles must retain none of their resource graphs.
        if (cycle() != 42) return 1;
        long live = System.liveAllocationCount();
        if (cycle() != 42) return 2;
        return System.liveAllocationCount() == live ? 42 : 3;
    }
}
