// Exit 42 verifies zero-iteration and mutable-array behavior. Argument "fail"
// throws through an inlined loop and wrapper while finally reclaims the array.
class Main {

    private static int work(int[] values, int count, boolean fail) {

        int sum = 0;
        for (int i = 0; i < count; i++) {
            sum += values[0];
            sum += values[0];
            sum += values[0];
            sum += values[0];
            sum += values[0];
            sum += values[0];
        }
        if (fail) throw new IllegalArgumentException("selective inline trace");
        return sum;
    }

    private static int wrapper(int[] values, int count, boolean fail) {

        return work(values, count, fail);
    }

    public static int main(String[] args) {

        int[] values = new int[1];
        try {
            values[0] = 3;
            if (wrapper(values, 0, false) != 0 || wrapper(values, 2, false) != 36) return 1;
            values[0] = 5;
            if (wrapper(values, 2, false) != 60) return 2;
            if (args.length > 0) return wrapper(values, 1, true);
            return 42;
        } finally {
            free values;
        }
    }
}
