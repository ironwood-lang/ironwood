// Constructor and target inference specialize inherited signatures before body checks.
// String overrides, including super calls, dispatch natively; success exits 42.
// Polymorphic reference-returning calls retain these instances for the process.
class Box<T> {

    T value;

    Box(T value) {

        this.value = value;
    }

    T value() {

        return this.value;
    }

    T echo(T input) {

        return input;
    }

    int code() {

        return 0;
    }
}

class Main {

    public static int main(String[] args) {

        Box<String> fromConstructor = new Box<>("hello") {

            @Override
            String value() {

                return super.value();
            }

            @Override
            String echo(String input) {

                return super.echo(input);
            }
        };
        Box<String> fromExpectedType = new Box<>(null) {

            @Override
            String value() {

                return super.value();
            }

            @Override
            int code() {

                return 37;
            }
        };
        int result = fromExpectedType.value() == null
                && fromConstructor.echo("echo").equals("echo")
                ? fromConstructor.value().length() + fromExpectedType.code() : 1;
        return result;
    }
}
