// SPDX-License-Identifier: MIT OR Apache-2.0

// The Bridge's JDK tool path on the compiler port: JdkSelection (D295) picks
// the JDK from the inherited JAVA_HOME, installation and PATH, applies
// BridgeBuildTools' gate, and runs javac or javadoc by absolute path through
// ProcessRunner.runToFile with BridgeBuildTools' flags, against the
// baseline's in-process tools.
// `program javac <scratch> <work> <classes> <source>...` and
// `program javadoc <scratch> <work> <classes> <output> <source>...` print
// the tool's exit value and merged diagnostics as UTF-16 hex. Every result is
// selected or the tool cannot start.
import ironwood.compiler.port.JdkSelection;
import ironwood.compiler.port.TextList;
import ironwood.io.IOException;
import ironwood.nio.file.Path;

class Main {

    static String hex(String text) {

        if (text.isEmpty()) return new String("-");
        StringBuilder out = new StringBuilder();
        for (int index = 0; index < text.length(); index++) {
            int unit = text.charAt(index);
            for (int shift = 12; shift >= 0; shift = shift - 4) out.append("0123456789abcdef".charAt((unit >>> shift) & 15));
        }
        return out.toString();
    }

    static void run(String[] args) throws IOException {

        boolean javadoc = args[0].equals("javadoc");
        Path scratch = Path.of(args[1]);
        Path work = Path.of(args[2]);
        Path classes = Path.of(args[3]);
        JdkSelection jdk = new JdkSelection(null, scratch, work);
        TextList sources = new TextList();
        for (int index = javadoc ? 5 : 4; index < args.length; index++) sources.add(args[index]);
        StringBuilder diagnostics = new StringBuilder();
        int exit = 0;
        if (javadoc) {
            jdk.requireJavadoc();
            Path output = Path.of(args[4]);
            exit = jdk.javadoc(sources, classes, output, work, diagnostics);
        } else {
            jdk.requireJdk("Java compilation");
            exit = jdk.javac(sources, "", classes, work, diagnostics);
        }
        String text = diagnostics.toString();
        String encoded = hex(text);
        System.out.println("exit " + exit + " " + encoded);
    }

    public static int main(String[] args) {
        try {
            run(args);
        } catch (IOException failure) {
            return 1;
        }
        return 43;
    }
}
