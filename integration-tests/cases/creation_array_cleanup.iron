import ironwood.lang.Memory;

// Shared array elements survive collection, including during failed construction.
// Only the completed phase becomes reclaimable. Expected exit: 42.
class Element {

    int[] storage = {42, 7};
}

class Owner {

    static Owner published;
    Element[] elements;

    Owner(Element item, boolean fail) {

        published = this;
        Memory.collect(); // The published, zero-initialized partial object is rooted.
        elements = new Element[] {item, item};
        Memory.collect();
        if (fail) throw new IllegalStateException();
    }
}

class Main {

    private static int phase() {

        Element item = new Element();
        Owner owner = new Owner(item, false);
        Element[] alias = owner.elements;
        Owner.published = null;
        Memory.collect();
        if (alias[0] != item || alias[1] != item || alias[0].storage[0] != 42) return 1;
        try {
            new Owner(item, true);
            return 2;
        } catch (IllegalStateException expected) {
            Memory.collect();
            if (Owner.published.elements[1] != item) return 3;
            Owner.published = null;
        }
        Memory.collect();
        return alias[1].storage[0];
    }

    public static int main(String[] args) {

        if (phase() != 42) return 4;
        Memory.collect();
        long baseline = System.liveAllocationCount();
        if (phase() != 42) return 5;
        Memory.collect();
        return System.liveAllocationCount() == baseline ? 42 : 6;
    }
}
