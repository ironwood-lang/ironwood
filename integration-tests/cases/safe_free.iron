class Cell {

    int value;

    Cell(int value) {

        this.value = value;
    }
}

class Main {

    static int observe(Cell cell) {

        return cell.value;
    }

    public static int main(String[] args) {

        int next = 0;
        int observed = 0;
        while (next < 10000) {
            Cell cell = new Cell(next);
            observed = observe(cell);
            free cell;
            next = next + 1;
        }
        if (observed == 9999) return 42;
        return 1;
    }
}
