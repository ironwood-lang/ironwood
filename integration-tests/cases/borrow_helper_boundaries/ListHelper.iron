// Safe program currently rejected at free owner across the helper boundary.
// Compile separately; this is an investigation fixture, not a registered test.
import ironwood.ds.ArrayList;

class Item {

    int value;
}

class Owner {

    private final Item item = new Item();

    Item item() {

        return this.item;
    }

    destructor {

        free this.item;
    }
}

class Main {

    static Item use(Owner owner) {

        ArrayList<Item> list = new ArrayList<Item>(1);
        list.add(owner.item());
        Item retained = list.get(0);
        free list;
        return retained;
    }

    public static int main(String[] args) {

        Owner owner = new Owner();
        Item retained = use(owner);
        int result = retained.value;
        free owner;
        return result;
    }
}
