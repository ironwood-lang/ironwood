// Compile separately; this is an investigation fixture, not a registered test.
class Item {

    int value;
}

class Wrapper {

    private final Item item;

    Wrapper(Item item) {

        this.item = item;
    }

    void touch() {

        this.item.value++;
    }
}

class Main {

    public static int main(String[] args) {

        Item item = new Item();
        Wrapper wrapper = new Wrapper(item);
        wrapper.touch();
        int result = item.value;
        return result;
    }
}
