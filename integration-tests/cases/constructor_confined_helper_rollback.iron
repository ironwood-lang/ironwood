// A helper borrows its constructing parent without publishing it. Normal
// destruction and throwing-helper rollback reclaim both objects and private
// arrays. The preallocated process-lived exception is outside each baseline.
// Exit 42 after checking four allocations per attempt and no retained storage.
class Helper {

    private Object owner;
    private int[] scratch = new int[4];

    Helper(Object owner, boolean fail) {

        this.owner = owner;
        reset(fail);
    }

    private void reset(boolean fail) {

        if (fail) throw Main.failure;
    }

    destructor {

        free this.scratch;
    }
}

class Parent {

    private Helper helper;
    private int[] scratch = new int[8];

    Parent(boolean fail) {

        this.helper = new Helper(this, fail);
    }

    destructor {

        free this.helper;
        free this.scratch;
    }
}

class Main {

    static RuntimeException failure = new RuntimeException();

    public static int main(String[] args) {

        RuntimeException original = failure;
        long baseline = System.liveAllocationCount();
        for (int attempt = 0; attempt < 20; attempt++) {
            long before = System.allocationCount();
            Parent value = new Parent(false);
            free value;
            if (System.allocationCount() - before != 4) return 1;
            if (System.liveAllocationCount() != baseline) return 2;

            before = System.allocationCount();
            boolean caught = false;
            try {
                new Parent(true);
            }

            catch (RuntimeException expected) {
                if (expected != original) return 3;
                caught = true;
            }

            if (!caught || System.allocationCount() - before != 4) return 4;
            if (System.liveAllocationCount() != baseline) return 5;
        }

        return 42;
    }
}
