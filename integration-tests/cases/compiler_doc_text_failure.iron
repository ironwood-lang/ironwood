// Inject allocation failure into the M5.4 documentation helpers: every fresh
// result of DocText (splits, head and tail, prefixes, entities, removals,
// collapses, stripLeading, anchors) and a link callback's fresh Markdown.
// Every failure unwinds to the live-allocation baseline. Exit 42 on
// allocation failure with every check intact, 43 on success.
import ironwood.compiler.port.DocText;
import ironwood.compiler.port.JavaIdentifiers;
import ironwood.compiler.port.LinkRenderer;

final class Brackets implements LinkRenderer {

    @Override
    public String link(String reference, boolean code) {

        return (code ? "[`" : "[") + reference + (code ? "`]" : "]");
    }
}

class Main {

    // Calls the callback through the interface, as DocComment.render does.
    static String render(LinkRenderer links, String reference) {

        return links.link(reference, true);
    }

    static void exercise() {

        // Ironwood string literals have no \u escapes; NEL and LS come from char
        // literals. The constant concatenation is an immortal literal.
        String text = " * &lt;code&gt;x&#x1F600;</code>" + '\u0085' + " a \r\n b" + '\u2028' + "c `` d.e#f(g)";
        int[] fields = DocText.lineFields(text);
        String head = DocText.head(text);
        String tail = DocText.tail(text);
        String star = DocText.stripCommentStar(text);
        String code = DocText.stripCodeTags(star);
        String entities = DocText.entities(text);
        String nospace = DocText.removeSpace(text);
        String collapse = DocText.collapseLineBreaks(text);
        String stripped = DocText.stripLeading(text);
        String anchor = DocText.anchor(text);
        Brackets renderer = new Brackets();
        String link = render(renderer, "d.e#f");
        if (fields.length != 8 || !link.equals("[`d.e#f`]") || DocText.tagEnd("@param x") != 6) {
            throw new IllegalStateException();
        }
    }

    public static int main(String[] args) {

        // The identifier table is process-lived after its first use.
        try {
            JavaIdentifiers.isJavaIdentifierPart(0x4e2d);
        } catch (OutOfMemoryError failure) {
            return 42;
        }
        boolean failed = false;
        try {
            exercise();
        } catch (OutOfMemoryError failure) {
            failed = true;
        }

        return failed ? 42 : 43;
    }
}
