class TransferValue { int number = 42; }

class Transfers {

    static Error failure = new Error();
    static int order;

    static void prepare() {

    }

    static void loops() {

        // An already-dead local is harmless when later iterations never read it.
        TransferValue retired = new TransferValue();
        int i = 0;
        while (i < 3) {
            TransferValue value = new TransferValue();
            try { i++; continue; } finally { ; }
        }
        do {
            TransferValue value = new TransferValue();
            try { i--; continue; } finally { ; }
        } while (i > 0);
        for (int j = 0; j < 3; j++) {
            TransferValue value = new TransferValue();
            try { continue; } finally { ; }
        }
        int[] values = new int[3];
        for (int ignored : values) {
            TransferValue value = new TransferValue();
            try { continue; } finally { ; }
        }
        TransferValue once = new TransferValue();
        do { try { continue; } finally { ; } } while (false);
    }

    static void breaks(int selector) {

        TransferValue value = new TransferValue();
        while (true) { try { break; } finally { ; } }
        TransferValue labeled = new TransferValue();
        done: { try { break done; } finally { ; } }
        TransferValue classic = new TransferValue();
        switch (selector) {
            case 0: try { break; } finally { ; }
            default: try { break; } finally { ; }
        }
        TransferValue modern = new TransferValue();
        switch (selector) {
            case 0 -> { try { break; } finally { ; } }
            default -> { try { break; } finally { ; } }
        }
    }

    static void nestedLabels() {

        // Every outer iteration creates two objects; inner cleanup runs first.
        order = 0;
        outer: for (int i = 0; i < 2; i++) {

            TransferValue outerValue = new TransferValue();
            try {
                while (true) {
                    TransferValue innerValue = new TransferValue();
                    try { continue outer; }
                    finally { ; order = order * 10 + 1; }
                }
            } finally { ; order = order * 10 + 2; }
        }
    }

    static int yields(int selector) {

        TransferValue shared = new TransferValue();
        int result = switch (selector) {

            case 0 -> { try { yield 20; } finally { ; } }
            default -> { try { yield 22; } finally { ; } }
        };
        result += switch (selector) {

            case 0:
                TransferValue first = new TransferValue();
                try { yield 22; } finally { ; }
            default:
                TransferValue second = new TransferValue();
                try { yield 20; } finally { ; }
        };
        return result;
    }

    static int referenceYield() {

        TransferValue result = switch (0) {

            default -> {
                TransferValue returned = new TransferValue();
                TransferValue helper = new TransferValue();
                try { yield returned; } finally { ; }
            }
        };
        int number = result.number;
        return number;
    }

    static void replacedBreak() {

        int i = 0;
        while (i < 3) {
            TransferValue value = new TransferValue();
            try { break; }
            finally { ; i++; continue; }
        }
        order = i;
    }

    static int replacedYield() {

        return switch (0) {

            default -> {
                TransferValue value = new TransferValue();
                try { yield 1; }
                finally { ; yield 42; }
            }
        };
    }

    static void throwingCleanup() {

        TransferValue value = new TransferValue();
        while (true) {
            try { break; }
            finally {
                try { throw failure; }
                finally { ; }
            }
        }
    }
}

class Main {

    public static int main(String[] args) {

        // Warm the retained failure before checking transient allocation balance.
        Transfers.prepare();
        Transfers.loops();

        Transfers.breaks(0);
        Transfers.breaks(1);

        Transfers.nestedLabels();
        if (Transfers.order != 1212) return 3;

        if (Transfers.yields(0) != 42) return 5;
        if (Transfers.yields(1) != 42) return 6;
        if (Transfers.referenceYield() != 42) return 7;

        Transfers.replacedBreak();
        if (Transfers.order != 3) return 9;
        if (Transfers.replacedYield() != 42) return 10;
        boolean caught = false;
        try { Transfers.throwingCleanup(); }
        catch (Error expected) { caught = true; }
        if (!caught) return 11;

        // Exit 42 means cleanup order, jump replacement and reclamation all passed.
        return 42;
    }
}
