// Inject allocation failure during view construction and list growth. Shared
// caller items remain usable on failure. Expected exit: 42 with no output.
// Managed storage remains eligible for a later explicit collection.
import ironwood.ds.ArrayList;
import ironwood.ds.Collections;
import ironwood.ds.UnmodifiableList;

class Item {

}

class Main {

    static void view() {

        ArrayList<Item> values = new ArrayList<Item>();
        try {
            UnmodifiableList<Item> view = Collections.unmodifiableList(values);
        } finally {
        }
    }

    static void insertion() {

        Item item = new Item();
        try {
            ArrayList<Item> values = new ArrayList<Item>(1);
            try {
                values.add(item);
                values.add(item);
            } finally {
            }
        } finally {
        }
    }

    public static int main(String[] args) {
        try {
            if (args.length == 0) {
                view();
            } else {
                insertion();
            }
        } catch (OutOfMemoryError error) {

            // Failed construction rolls back owned helpers before this handler.
        }
        return 42;
    }
}
