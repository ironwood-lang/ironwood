import ironwood.nio.file.Path;

class Main {

    static boolean check(Path base, Path other, int operation, boolean failureExpected) {
        try {
            if (operation == 0) { Path result = base.normalize(); ; }
            else if (operation == 1) { Path result = base.getFileName(); ; }
            else if (operation == 2) { Path result = base.getParent(); ; }
            else if (operation == 3) { Path result = base.getRoot(); ; }
            else if (operation == 4) { Path result = base.toAbsolutePath(); ; }
            else if (operation == 5) { Path result = base.resolve("x//y/"); ; }
            else if (operation == 6) { Path result = base.resolve(other); ; }
            else if (operation == 7) { Path result = base.resolveSibling("x//y/"); ; }
            else {
                Path result = base.resolveSibling(other); ;
            }
        } catch (OutOfMemoryError expected) {

            return failureExpected;
        }
        return !failureExpected;
    }

    public static int main(String[] args) {

        int operation = Integer.parseInt(args[0]);
        boolean failureExpected = Boolean.parseBoolean(args[1]);
        // Four setup allocations; each transformation needs only two more.
        String input = operation == 4 ? "a/b/../c" : "/a/b/../c";
        Path base = Path.of(input);
        Path other = Path.of("d");
        boolean correct = check(base, other, operation, failureExpected);
        return correct ? 42 : 1;
    }
}
