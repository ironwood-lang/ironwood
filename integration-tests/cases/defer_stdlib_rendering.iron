    }

    private static boolean checkLinkedHashMap() {

        LinkedHashMap<String, String> value = new LinkedHashMap<String, String>(4);
        defer free value;
        value.put("key", "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{key=value}") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkByteMap() {

        ByteMap<String> value = new ByteMap<String>();
        defer free value;
        value.put((byte) 7, "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{7=value}") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkCharMap() {

        CharMap<String> value = new CharMap<String>();
        defer free value;
        value.put('k', "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{k=value}") || System.liveAllocationCount() != live + 1) return false;
