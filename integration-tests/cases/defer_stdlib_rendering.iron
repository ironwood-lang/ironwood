        return System.liveAllocationCount() == live;
    }

    private static boolean checkHashMap() {

        HashMap<String, String> value = new HashMap<String, String>(4);
        defer free value;
        value.put("key", "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{key=value}") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkIdentityHashMap() {

        IdentityHashMap<String, String> value = new IdentityHashMap<String, String>(4);
        defer free value;
        value.put("key", "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{key=value}") || System.liveAllocationCount() != live + 1) return false;
