import ironwood.ds.*;

// Every collection renderer owns its temporary builder and returns fresh text.
// Repeated rendering must leave only that result live. Iteration exit frees the
// result; method exit frees the container. Warm class-owned sentinels before
// measuring teardown; immortal entries avoid transferring ownership.
class Main {

    public static int main(String[] args) {

        int warmup = check(false);
        if (warmup != 42) return warmup;
        return check(true);
    }

    private static int check(boolean warmed) {

        long baseline = System.liveAllocationCount();
        if (!checkArrayLinkedList()) return 1;
        if (warmed && System.liveAllocationCount() != baseline) return 101;
        if (!checkArrayList()) return 2;
        if (warmed && System.liveAllocationCount() != baseline) return 102;
        if (!checkLinkedList()) return 3;
        if (warmed && System.liveAllocationCount() != baseline) return 103;
        if (!checkHashSet()) return 4;
        if (warmed && System.liveAllocationCount() != baseline) return 104;
        if (!checkIdentityHashSet()) return 5;
        if (warmed && System.liveAllocationCount() != baseline) return 105;
        if (!checkLinkedHashSet()) return 6;
        if (warmed && System.liveAllocationCount() != baseline) return 106;
        if (!checkIntArrayList()) return 7;
        if (warmed && System.liveAllocationCount() != baseline) return 107;
        if (!checkIntLinkedList()) return 8;
        if (warmed && System.liveAllocationCount() != baseline) return 108;
        if (!checkLongArrayList()) return 9;
        if (warmed && System.liveAllocationCount() != baseline) return 109;
        if (!checkLongLinkedList()) return 10;
        if (warmed && System.liveAllocationCount() != baseline) return 110;
        if (!checkIntSet()) return 11;
        if (warmed && System.liveAllocationCount() != baseline) return 111;
        if (!checkLongSet()) return 12;
        if (warmed && System.liveAllocationCount() != baseline) return 112;
        if (!checkHashMap()) return 13;
        if (warmed && System.liveAllocationCount() != baseline) return 113;
        if (!checkIdentityHashMap()) return 14;
        if (warmed && System.liveAllocationCount() != baseline) return 114;
        if (!checkLinkedHashMap()) return 15;
        if (warmed && System.liveAllocationCount() != baseline) return 115;
        if (!checkByteMap()) return 16;
        if (warmed && System.liveAllocationCount() != baseline) return 116;
        if (!checkCharMap()) return 17;
        if (warmed && System.liveAllocationCount() != baseline) return 117;
        if (!checkIntMap()) return 18;
        if (warmed && System.liveAllocationCount() != baseline) return 118;
        if (!checkLongMap()) return 19;
        if (warmed && System.liveAllocationCount() != baseline) return 119;
        if (!checkCharSequenceMap()) return 20;
        if (warmed && System.liveAllocationCount() != baseline) return 120;
        if (!checkByteBufferMap()) return 21;
        if (warmed && System.liveAllocationCount() != baseline) return 121;
        return 42;
    }

    private static boolean checkArrayLinkedList() {

        ArrayLinkedList<String> value = new ArrayLinkedList<String>(4);
        defer free value;
        value.addLast("value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[value]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkArrayList() {

        ArrayList<String> value = new ArrayList<String>(4);
        defer free value;
        value.add("value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[value]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkLinkedList() {

        LinkedList<String> value = new LinkedList<String>(4);
        defer free value;
        value.add("value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[value]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkHashSet() {

        HashSet<String> value = new HashSet<String>(4);
        defer free value;
        value.add("value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[value]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkIdentityHashSet() {

        IdentityHashSet<String> value = new IdentityHashSet<String>(4);
        defer free value;
        value.add("value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[value]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkLinkedHashSet() {

        LinkedHashSet<String> value = new LinkedHashSet<String>(4);
        defer free value;
        value.add("value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[value]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkIntArrayList() {

        IntArrayList value = new IntArrayList(4);
        defer free value;
        value.add(7);
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[7]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkIntLinkedList() {

        IntLinkedList value = new IntLinkedList(4);
        defer free value;
        value.add(7);
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[7]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkLongArrayList() {

        LongArrayList value = new LongArrayList(4);
        defer free value;
        value.add(7);
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[7]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkLongLinkedList() {

        LongLinkedList value = new LongLinkedList(4);
        defer free value;
        value.add(7);
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[7]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkIntSet() {

        IntSet value = new IntSet(4);
        defer free value;
        value.add(7);
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[7]") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkLongSet() {

        LongSet value = new LongSet(4);
        defer free value;
        value.add(7);
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("[7]") || System.liveAllocationCount() != live + 1) return false;
