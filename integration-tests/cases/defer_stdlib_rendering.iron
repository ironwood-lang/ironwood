        LongMap<String> value = new LongMap<String>(4);
        defer free value;
        value.put(7L, "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{7=value}") || System.liveAllocationCount() != live + 1) return false;
