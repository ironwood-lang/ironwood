    private static boolean checkCharSequenceMap() {

        CharSequenceMap<String> value = new CharSequenceMap<String>(4);
        defer free value;
        value.put("key", "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{key=value}") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }

    private static boolean checkByteBufferMap() {

        byte[] key = {(byte) 107};
        defer free key;
        ByteBufferMap<String> value = new ByteBufferMap<String>(4);
        defer free value;
        value.put(key, "value");
        long live = System.liveAllocationCount();
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            defer free text;
            if (!text.equals("{[107]=value}") || System.liveAllocationCount() != live + 1) return false;
        }
        return System.liveAllocationCount() == live;
    }
}
