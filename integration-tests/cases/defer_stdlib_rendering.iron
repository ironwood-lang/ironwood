import ironwood.ds.*;

// Collection renderers return managed text. Every family keeps exact text checks.
// Reclamation is observed once after a complete rendering phase, outside loops.
class Main {

    public static int main(String[] args) {

        int warmup = check();
        if (warmup != 42) return warmup;
        ironwood.lang.Memory.collect();
        long baseline = System.liveAllocationCount();
        int result = check();
        if (result != 42) return result;
        ironwood.lang.Memory.collect();
        return System.liveAllocationCount() == baseline ? 42 : 122;
    }

    private static int check() {
        if (!checkArrayLinkedList()) return 1;
        if (!checkArrayList()) return 2;
        if (!checkLinkedList()) return 3;
        if (!checkHashSet()) return 4;
        if (!checkIdentityHashSet()) return 5;
        if (!checkLinkedHashSet()) return 6;
        if (!checkIntArrayList()) return 7;
        if (!checkIntLinkedList()) return 8;
        if (!checkLongArrayList()) return 9;
        if (!checkLongLinkedList()) return 10;
        if (!checkIntSet()) return 11;
        if (!checkLongSet()) return 12;
        if (!checkHashMap()) return 13;
        if (!checkIdentityHashMap()) return 14;
        if (!checkLinkedHashMap()) return 15;
        if (!checkByteMap()) return 16;
        if (!checkCharMap()) return 17;
        if (!checkIntMap()) return 18;
        if (!checkLongMap()) return 19;
        if (!checkCharSequenceMap()) return 20;
        if (!checkByteBufferMap()) return 21;
        return 42;
    }

    private static boolean checkArrayLinkedList() {

        ArrayLinkedList<String> value = new ArrayLinkedList<String>(4);
        value.addLast("value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[value]")) return false;
        }
        return true;
    }

    private static boolean checkArrayList() {

        ArrayList<String> value = new ArrayList<String>(4);
        value.add("value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[value]")) return false;
        }
        return true;
    }

    private static boolean checkLinkedList() {

        LinkedList<String> value = new LinkedList<String>(4);
        value.add("value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[value]")) return false;
        }
        return true;
    }

    private static boolean checkHashSet() {

        HashSet<String> value = new HashSet<String>(4);
        value.add("value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[value]")) return false;
        }
        return true;
    }

    private static boolean checkIdentityHashSet() {

        IdentityHashSet<String> value = new IdentityHashSet<String>(4);
        value.add("value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[value]")) return false;
        }
        return true;
    }

    private static boolean checkLinkedHashSet() {

        LinkedHashSet<String> value = new LinkedHashSet<String>(4);
        value.add("value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[value]")) return false;
        }
        return true;
    }

    private static boolean checkIntArrayList() {

        IntArrayList value = new IntArrayList(4);
        value.add(7);
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[7]")) return false;
        }
        return true;
    }

    private static boolean checkIntLinkedList() {

        IntLinkedList value = new IntLinkedList(4);
        value.add(7);
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[7]")) return false;
        }
        return true;
    }

    private static boolean checkLongArrayList() {

        LongArrayList value = new LongArrayList(4);
        value.add(7);
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[7]")) return false;
        }
        return true;
    }

    private static boolean checkLongLinkedList() {

        LongLinkedList value = new LongLinkedList(4);
        value.add(7);
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[7]")) return false;
        }
        return true;
    }

    private static boolean checkIntSet() {

        IntSet value = new IntSet(4);
        value.add(7);
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[7]")) return false;
        }
        return true;
    }

    private static boolean checkLongSet() {

        LongSet value = new LongSet(4);
        value.add(7);
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("[7]")) return false;
        }
        return true;
    }

    private static boolean checkHashMap() {

        HashMap<String, String> value = new HashMap<String, String>(4);
        value.put("key", "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{key=value}")) return false;
        }
        return true;
    }

    private static boolean checkIdentityHashMap() {

        IdentityHashMap<String, String> value = new IdentityHashMap<String, String>(4);
        value.put("key", "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{key=value}")) return false;
        }
        return true;
    }

    private static boolean checkLinkedHashMap() {

        LinkedHashMap<String, String> value = new LinkedHashMap<String, String>(4);
        value.put("key", "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{key=value}")) return false;
        }
        return true;
    }

    private static boolean checkByteMap() {

        ByteMap<String> value = new ByteMap<String>();
        value.put((byte) 7, "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{7=value}")) return false;
        }
        return true;
    }

    private static boolean checkCharMap() {

        CharMap<String> value = new CharMap<String>();
        value.put('k', "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{k=value}")) return false;
        }
        return true;
    }

    private static boolean checkIntMap() {

        IntMap<String> value = new IntMap<String>(4);
        value.put(7, "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{7=value}")) return false;
        }
        return true;
    }

    private static boolean checkLongMap() {

        LongMap<String> value = new LongMap<String>(4);
        value.put(7L, "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{7=value}")) return false;
        }
        return true;
    }

    private static boolean checkCharSequenceMap() {

        CharSequenceMap<String> value = new CharSequenceMap<String>(4);
        value.put("key", "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{key=value}")) return false;
        }
        return true;
    }

    private static boolean checkByteBufferMap() {

        byte[] key = {(byte) 107};
        ByteBufferMap<String> value = new ByteBufferMap<String>(4);
        value.put(key, "value");
        for (int repeat = 0; repeat < 3; repeat++) {
            String text = value.toString();
            if (!text.equals("{[107]=value}")) return false;
        }
        return true;
    }
}
