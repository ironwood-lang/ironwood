// M4.3 process runner cases against integration-tests/runtime/process_helper.c.
// Arguments: the helper's absolute path, the scratch directory (also this
// program's working directory), its child directory, a missing tool, a
// non-executable file, a file of an unknown executable format, a shell
// script and a missing directory. Each case prints one line with the scratch
// path replaced by <s>; the test compares the lines. Paths come from the
// arguments, so no case frees a String it placed in a command; the two cases
// with fresh special Strings call the runner directly. Exit 42.
import ironwood.io.FileInputStream;
import ironwood.io.IOException;
import ironwood.nio.file.AccessDeniedException;
import ironwood.nio.file.DirectoryStream;
import ironwood.nio.file.FileSystemException;
import ironwood.nio.file.Files;
import ironwood.nio.file.NoSuchFileException;
import ironwood.nio.file.Path;
import ironwood.process.ProcessResult;
import ironwood.process.ProcessRunner;

class Main {

    static String helper;
    static String scratch;

    public static int main(String[] args) throws IOException {

        helper = args[0];
        scratch = args[1];
        String child = args[2];
        launch("exit 0", null, "out.log", helper, "exit", "0");
        launch("exit 3", null, "out.log", helper, "exit", "3");
        launch("child exit 127", null, "out.log", helper, "exit", "127");
        launch("signal 15", null, "out.log", helper, "signal", "15");
        launch("signal 9", null, "out.log", helper, "signal", "9");
        literals();
        launch("environment", null, "out.log", helper, "env", "M4_PROBE");
        launch("child directory", child, "out.log", helper, "cwd", null);
        launch("inherited directory", null, "out.log", helper, "cwd", null);
        launch("relative output", child, "relative.log", helper, "cwd", null);
        Path here = Path.of("relative.log");
        Path there = Path.of("child/relative.log");
        System.out.println(Files.exists(here) && !Files.exists(there)
                ? "relative output -> written in the parent's directory" : "relative output -> misplaced");
        launch("stdin", null, "out.log", helper, "stdin", null);
        launch("large output", null, "large.log", helper, "large", "1048576");
        descriptors();
        launch("missing executable", null, "out.log", args[3], null, null);
        launch("not executable", null, "out.log", args[4], null, null);
        launch("directory executable", null, "out.log", child, null, null);
        launch("unknown format", null, "out.log", args[5], null, null);
        launch("shell script", null, "out.log", args[6], "x y", null);
        launch("missing directory", args[7], "out.log", helper, "exit", "0");
        launch("file as directory", args[4], "out.log", helper, "exit", "0");
        launch("missing output parent", null, "missing-dir/out.log", helper, "exit", "0");
        launch("directory as output", null, "child", helper, "exit", "0");
        String[] empty = {};
        run("empty command", empty, null, "out.log");
        launch("relative executable", null, "out.log", "process_helper", "exit", "0");
        repeated();
        return 42;
    }

    // Spaces, quotes, shell metacharacters, an empty argument, Unicode and an
    // unpaired surrogate reach the program literally; NUL is rejected.
    static void literals() throws IOException {

        Path output = Path.of("out.log");
        String surrogate = text((char) 0xD800);
        String[] literal = {helper, "argv", "a b", "'q'", "\"d\"", "$HOME", "*", ";|&", "back\\slash", "", "🌲",
                surrogate};
        ProcessResult result = ProcessRunner.runToFile(literal, null, output);
        completed("literal argv", result, output);
        String nul = text((char) 0);
        String[] withNul = {helper, "argv", nul};
        try {
            ProcessResult rejected = ProcessRunner.runToFile(withNul, null, output);
            System.out.println("NUL argument -> launched");
        } catch (IllegalArgumentException expected) {
            System.out.println("NUL argument -> !IllegalArgumentException");
        }
    }

    // Up to two arguments; a null argument ends the list.
    static void launch(String name, String directory, String output, String executable, String first,
                       String second) {

        int length = first == null ? 1 : second == null ? 2 : 3;
        String[] command = new String[length];
        command[0] = executable;
        if (length > 1) command[1] = first;
        if (length > 2) command[2] = second;
        run(name, command, directory, output);
    }

    static void run(String name, String[] command, String directory, String output) {

        if (directory == null) {
            attempt(name, command, null, output);
            return;
        }
        Path directoryPath = Path.of(directory);
        attempt(name, command, directoryPath, output);
    }

    static void attempt(String name, String[] command, Path directoryPath, String output) {

        Path outputPath = Path.of(output);
        try {
            ProcessResult result = ProcessRunner.runToFile(command, directoryPath, outputPath);
            completed(name, result, outputPath);
        } catch (IOException failure) {
            failed(name, failure);
        } catch (IllegalArgumentException failure) {
            System.out.println(name + " -> !IllegalArgumentException");
        }
    }

    static void completed(String name, ProcessResult result, Path output) throws IOException {

        StringBuilder line = new StringBuilder();
        line.append(name).append(" -> ");
        if (result.signaled()) line.append("signal ").append(result.signal()).append(' ');
        line.append("exit ").append(result.exitValue());
        long size = Files.size(output);
        if (size > 4096L) {
            line.append(" size ").append(size);
        } else {
            String text = Files.readString(output);
            String flat = text.replace('\n', '|');
            line.append(" output ").append(flat);
        }
        emit(line);
    }

    static void failed(String name, IOException failure) {

        StringBuilder line = new StringBuilder();
        line.append(name).append(" -> !");
        if (failure instanceof NoSuchFileException) line.append("NoSuchFileException");
        else if (failure instanceof AccessDeniedException) line.append("AccessDeniedException");
        else if (failure instanceof FileSystemException) line.append("FileSystemException");
        else line.append("IOException");
        if (failure instanceof FileSystemException) {
            String file = ((FileSystemException) failure).getFile();
            String reason = ((FileSystemException) failure).getReason();
            line.append(' ').append(file == null ? "<null>" : file);
            if (reason != null) line.append(": ").append(reason);
        }
        emit(line);
    }

    // While this process holds a file stream and a directory stream open,
    // the program sees only its three standard descriptors.
    static void descriptors() throws IOException {

        Path plain = Path.of("plain.txt");
        FileInputStream input = new FileInputStream(plain);
        Path here = Path.of(".");
        DirectoryStream<Path> entries = Files.newDirectoryStream(here);
        launch("open descriptors", null, "out.log", helper, "fds", null);
        entries.close();
        input.close();
    }

    // Repeated launches leave this process's open descriptors unchanged.
    static void repeated() throws IOException {

        int before = openDescriptors();
        String[] command = {helper, "exit", "0"};
        Path output = Path.of("repeat.log");
        for (int round = 0; round < 300; round++) {
            ProcessResult result = ProcessRunner.runToFile(command, null, output);
            int value = result.exitValue();
            if (value != 0) throw new IllegalStateException();
        }
        int after = openDescriptors();
        System.out.println(before == after ? "repeated 300 launches -> descriptors stable"
                : "repeated 300 launches -> descriptors changed");
    }

    static int openDescriptors() throws IOException {

        String system = System.getProperty("os.name");
        Path directory = Path.of(system.startsWith("Mac") ? "/dev/fd" : "/proc/self/fd");
        DirectoryStream<Path> entries = Files.newDirectoryStream(directory);
        int count = 0;
        while (entries.hasNext()) {
            Path entry = entries.nextEntry();
            count++;
        }
        entries.close();
        return count;
    }

    // A fresh String holding "a", the unit and "b".
    static String text(char unit) {

        StringBuilder value = new StringBuilder();
        value.append('a').append(unit).append('b');
        return value.toString();
    }

    static void emit(StringBuilder line) {

        String text = line.toString();
        String shown = text.replace(scratch, "<s>");
        System.out.println(shown);
    }
}
