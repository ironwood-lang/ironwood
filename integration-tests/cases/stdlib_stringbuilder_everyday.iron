// Runs unchanged on Java after removing explicit free statements and adapting main.
// Polymorphic helper inputs live for the process; ownership is tested separately.
// Print UTF-16 units so lone surrogates cannot hide differences during UTF-8 output.
class Text implements CharSequence {

    @Override
    public int length() {

        return 3;
    }

    @Override
    public char charAt(int index) {

        return index == 2 ? (char) 0xd800 : "xy".charAt(index);
    }

    @Override
    public CharSequence subSequence(int start, int end) {

        return "xyz".substring(start, end);
    }

    @Override
    public String toString() {

        return "object";
    }
}

class NullText {

    @Override
    public String toString() {

        return null;
    }
}

class ThrowingText implements CharSequence {

    @Override
    public int length() {

        return 3;
    }

    @Override
    public char charAt(int index) {

        if (index == 1) throw new IllegalArgumentException();
        return 'Z';
    }

    @Override
    public CharSequence subSequence(int start, int end) {

        return "";
    }
}

class Main {

    static void show(CharSequence text) {

        System.out.print(text.length());
        System.out.print(':');
        for (int index = 0; index < text.length(); index++) {
            System.out.print((int) text.charAt(index));
            System.out.print(',');
        }
        System.out.println();
    }

    static void reset(StringBuilder builder) {

        builder.setLength(0);
        builder.append("ab🌲cd");
    }

    static void boundaries(StringBuilder builder, Text sequence) {

        int[] bounds = {Integer.MIN_VALUE, -1, 0, 2, 6, 7, Integer.MAX_VALUE};
        char[] characters = {'X', (char) 0xd800, 'Y'};
        for (int operation = 0; operation < 13; operation++) {
            for (int start : bounds) {
                for (int end : bounds) {
                    reset(builder);
                    try {
                        switch (operation) {
                            case 0: builder.delete(start, end); break;
                            case 1: builder.replace(start, end, "XY"); break;
                            case 2: builder.replace(start, end, null); break;
                            case 3: builder.append(characters, start, end); break;
                            case 4: builder.insert(2, characters, start, end); break;
                            case 5: builder.insert(2, sequence, start, end); break;
                            case 6: builder.insert(start, (char[]) null, end, 0); break;
                            case 7: builder.insert(start, (CharSequence) null, 0, end); break;
                            case 8: builder.insert(start, 'X'); break;
                            case 9: builder.deleteCharAt(start); break;
                            case 10: builder.setCharAt(start, (char) 0xd800); break;
                            case 11: {
                                String result = builder.substring(start, end);
                                show(result);
                                free result;
                                break;
                            }
                            case 12: {
                                String result = builder.substring(start);
                                show(result);
                                free result;
                                break;
                            }
                        }
                        System.out.print(0);
                    } catch (StringIndexOutOfBoundsException expected) {
                        System.out.print(1);
                    } catch (IndexOutOfBoundsException expected) {
                        System.out.print(2);
                    } catch (NullPointerException expected) {
                        System.out.print(3);
                    }
                    show(builder);
                }
            }
        }
        free bounds;
    }

    public static int main(String[] args) {

        StringBuilder builder = new StringBuilder(64);
        char[] characters = {'a', (char) 0xd83c, (char) 0xdf32, 'z'};
        Text text = new Text();
        NullText nullText = new NullText();
        ThrowingText throwing = new ThrowingText();
        System.out.println(builder.isEmpty());
        System.out.println(builder.append(characters) == builder);
        characters[0] = 'Q';
        builder.append(characters, 1, 2).append(0.1f);
        show(builder);
        builder.setLength(0);
        builder.append('|');
        builder.insert(0, 'A').insert(1, true).insert(2, (byte) -8).insert(3, (short) 12);
        builder.insert(4, 42).insert(5, Long.MIN_VALUE).insert(6, 0).insert(7, Long.MAX_VALUE);
        builder.insert(0, 0.1f).insert(0, 1.0f / 3.0f).insert(0, -0.0f).insert(0, 0.1);
        builder.insert(0, Float.NaN).insert(0, Float.POSITIVE_INFINITY).insert(0, Double.MIN_VALUE);
        builder.insert(builder.length(), characters).insert(0, characters, 1, 2);
        builder.insert(1, text).insert(2, text, 1, 3).insert(3, (Object) text);
        builder.insert(0, (Object) nullText).insert(0, (Object) null);
        builder.insert(0, (String) null).insert(0, (CharSequence) null);
        builder.insert(0, (CharSequence) null, 1, 3);
        show(builder);
        builder.setLength(0);
        builder.append("abcd");
        System.out.println(builder.insert(1, "X") == builder);
        System.out.println(builder.delete(1, 2) == builder);
        System.out.println(builder.replace(1, 3, "XY") == builder);
        System.out.println(builder.reverse() == builder);
        System.out.println(builder.deleteCharAt(0) == builder);
        show(builder);
        for (int position = 0; position <= 4; position++) {
            StringBuilder small = new StringBuilder(4);
            small.append("abcd");
            small.insert(position, small);
            show(small);
            free small;
            for (int start = 0; start <= 4; start++) {
                for (int end = start; end <= 4; end++) {
                    builder.setLength(0);
                    builder.append("abcd");
                    builder.insert(position, builder, start, end);
                    show(builder);
                }
            }
            builder.setLength(0);
            builder.append("abcd");
            builder.insert(position, builder);
            show(builder);
            builder.setLength(0);
            builder.append("abcd");
            builder.insert(position, (Object) builder);
            show(builder);
        }
        reset(builder);
        try {
            builder.insert(1, throwing);
        } catch (IllegalArgumentException expected) {
            show(builder);
        }
        reset(builder);
        String snapshot = builder.substring(1, 5);
        builder.setCharAt(2, 'Q');
        show(snapshot);
        show(builder);
        free snapshot;
        String high = String.valueOf((char) 0xd83c);
        String low = String.valueOf((char) 0xdf32);
        String[] needles = {"", "a", "cd", high, low, "🌲", "abcdabcd", "missing"};
        int[] offsets = {Integer.MIN_VALUE, -1, 0, 1, 2, 3, 6, 7, Integer.MAX_VALUE};
        reset(builder);
        for (String needle : needles) {
            System.out.println(builder.indexOf(needle));
            for (int offset : offsets) System.out.println(builder.indexOf(needle, offset));
        }
        try {
            builder.indexOf(null, Integer.MAX_VALUE);
        } catch (NullPointerException expected) {
            System.out.println("null needle");
        }
        boundaries(builder, text);
        // Exhaust small UTF-16 strings containing boundary surrogates and NUL.
        char[] alphabet = {'a', (char) 0, (char) 0xd800, (char) 0xdbff, (char) 0xdc00, (char) 0xdfff};
        long signature = 1;
        int combinations = 1;
        for (int length = 0; length <= 6; length++) {
            for (int sample = 0; sample < combinations; sample++) {
                builder.setLength(0);
                int remaining = sample;
                for (int index = 0; index < length; index++) {
                    builder.append(alphabet[remaining % alphabet.length]);
                    remaining /= alphabet.length;
                }
                builder.reverse();
                signature = signature * 31 + builder.length();
                for (int index = 0; index < length; index++) signature = signature * 31 + builder.charAt(index);
            }
            combinations *= alphabet.length;
        }
        System.out.println(signature);
        free alphabet;
        free offsets;
        free needles;
        free high;
        free low;
        return 42;
    }
}
