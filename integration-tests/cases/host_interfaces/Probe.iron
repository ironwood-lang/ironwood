import ironwood.net.InetAddress;
import ironwood.net.NetworkInterface;

// Run only under host_interpose: actual native calls receive controlled port-7
// refusal. No live reachability booleans are part of this deterministic gate.
class HostProbe {

    public static int main(String[] args) throws Exception {

        long baseline = System.liveAllocationCount();
        InetAddress ipv4 = InetAddress.getByName("192.0.2.1");
        try {
            InetAddress ipv6 = InetAddress.getByName("fe80::1%7");
            try {
                NetworkInterface alpha = NetworkInterface.getByName("alpha0");
                try {
                    NetworkInterface beta = NetworkInterface.getByName("beta0");
                    try {
                        long before = System.allocationCount();
                        if (!ipv4.isReachable(1000) || !ipv6.isReachable(null, (byte) 0, 1000)) return 1;
                        if (!ipv4.isReachable(alpha, (char) 3, 1000) || !ipv6.isReachable(alpha, 2, 1000)) return 2;
                        if (ipv6.isReachable(beta, 0, 1000)) return 3;
                        if (before != System.allocationCount()) return 4;
                        System.out.println("HOST_PROBE allocations=0 results=4 refused,1 family mismatch");
                    } finally {
                        free beta;
                    }
                } finally {
                    free alpha;
                }
            } finally {
                free ipv6;
            }
        } finally {
            free ipv4;
        }
        return System.liveAllocationCount() == baseline ? 0 : 5;
    }
}
