// Public CRC32 against Java 21 java.util.zip.CRC32
// (docs/self-hosting/m5/crc32-evidence/Crc32Reference.java): the check value,
// every length 0-300, every byte value, widened and negative integer
// arguments, offsets, two-piece splits, repeated reads, reset, 64 MiB streamed
// through one buffer, null and range failures with Java's exception types and
// range text, and subclass dispatch (a range override observes whole-array
// updates; a whole-array or byte override sees nothing else). Native-only
// checks then require updates, reads and resets to allocate nothing, the
// first use to allocate only the process-lived table, and the caught failures
// to be the only allocations left. Prints the shared transcript; exit 42.
import ironwood.util.zip.CRC32;

// Counts the range updates it receives, including whole-array delegation.
class CountingCrc extends CRC32 {

    int calls;
    int lastOffset;
    int lastLength;

    @Override
    public void update(byte[] b, int off, int len) {

        this.calls++;
        this.lastOffset = off;
        this.lastLength = len;
        super.update(b, off, len);
    }
}

// Replaces whole-array updates with one marker byte; ranges are unaffected.
class WholeMarkerCrc extends CRC32 {

    @Override
    public void update(byte[] b) {

        update(0x5A);
    }
}

// Counts single-byte updates; range updates never call update(int).
class ByteCountingCrc extends CRC32 {

    int calls;

    @Override
    public void update(int b) {

        this.calls++;
        super.update(b);
    }
}

class Main {

    static byte[] pattern(int length) {

        byte[] data = new byte[length];
        for (int index = 0; index < length; index++) data[index] = (byte) (index * 31 + 7);
        return data;
    }

    static void vectors(CRC32 crc) {

        System.out.println("empty " + crc.getValue());
        byte[] check = "123456789".getBytes();
        defer free check;
        crc.update(check);
        System.out.println("check " + crc.getValue());
        crc.reset();
        System.out.println("reset " + crc.getValue());
        byte[] data = pattern(300);
        defer free data;
        for (int length = 0; length <= 300; length++) {
            crc.reset();
            crc.update(data, 0, length);
            System.out.println("length " + length + " " + crc.getValue());
        }
        crc.reset();
        for (int value = 0; value < 256; value++) {
            crc.update(value);
            System.out.println("byte " + value + " " + crc.getValue());
        }
    }

    // Each argument is widened to int; only its low eight bits count.
    static void widened(CRC32 crc) {

        int[] values = {-1, -128, 127, 128, 255, 256, 511, 0x12345678, Integer.MIN_VALUE, Integer.MAX_VALUE};
        defer free values;
        for (int index = 0; index < values.length; index++) {
            crc.reset();
            crc.update(values[index]);
            System.out.println("int " + values[index] + " " + crc.getValue());
        }
        byte negative = (byte) -1;
        short shortValue = (short) -129;
        char unit = 'é';
        crc.reset();
        crc.update(negative);
        crc.update(shortValue);
        crc.update(unit);
        crc.update('z');
        System.out.println("widened " + crc.getValue());
    }

    static void ranges(CRC32 crc) {

        byte[] data = pattern(300);
        defer free data;
        int[] offsets = {0, 1, 7, 8, 9, 63, 64, 65, 199};
        defer free offsets;
        int[] lengths = {0, 1, 7, 8, 9, 15, 16, 17, 100};
        defer free lengths;
        for (int first = 0; first < offsets.length; first++) {
            for (int second = 0; second < lengths.length; second++) {
                crc.reset();
                crc.update(data, offsets[first], lengths[second]);
                System.out.println("range " + offsets[first] + " " + lengths[second] + " " + crc.getValue());
            }
        }
        crc.reset();
        crc.update(data, 0, 300);
        long whole = crc.getValue();
        boolean same = true;
        for (int split = 0; split <= 300; split++) {
            crc.reset();
            crc.update(data, 0, split);
            crc.update(data, split, 300 - split);
            if (crc.getValue() != whole) same = false;
        }
        System.out.println("splits " + whole + " " + same);
        crc.reset();
        crc.update(data);
        System.out.println("whole " + (crc.getValue() == whole));
    }

    static void reads(CRC32 crc) {

        crc.reset();
        byte[] abc = "abc".getBytes();
        defer free abc;
        crc.update(abc);
        long first = crc.getValue();
        long second = crc.getValue();
        crc.update(abc);
        System.out.println("repeat " + first + " " + second + " " + crc.getValue());
        crc.reset();
        crc.update(abc, 1, 2);
        System.out.println("tail " + crc.getValue());
    }

    static void streamed(CRC32 crc) {

        crc.reset();
        byte[] buffer = new byte[65536];
        defer free buffer;
        for (int chunk = 0; chunk < 1024; chunk++) {
            for (int index = 0; index < buffer.length; index++) buffer[index] = (byte) (chunk + index);
            crc.update(buffer, 0, buffer.length);
        }
        System.out.println("streamed " + crc.getValue());
    }

    static void range(CRC32 crc, byte[] data, int off, int len) {

        try {
            crc.update(data, off, len);
            System.out.println("accepted " + off + " " + len);
        } catch (ArrayIndexOutOfBoundsException failure) {
            System.out.println("rejected " + failure.getMessage());
        }
    }

    // Each caught failure stays allocated, as a caught exception cannot be freed.
    static void failures(CRC32 crc) {

        crc.reset();
        byte[] data = pattern(4);
        defer free data;
        crc.update(data, 0, 2);
        byte[] missing = null;
        try {
            crc.update(missing, 0, 0);
        } catch (NullPointerException failure) {
            System.out.println("null range NullPointerException");
        }
        try {
            crc.update(missing);
        } catch (NullPointerException failure) {
            System.out.println("null whole NullPointerException");
        }
        range(crc, data, -1, 1);
        range(crc, data, 0, -1);
        range(crc, data, 3, 2);
        range(crc, data, 1, Integer.MAX_VALUE);
        range(crc, data, Integer.MAX_VALUE, 1);
        range(crc, data, Integer.MIN_VALUE, 0);
        range(crc, data, 5, 0);
        range(crc, data, 4, 0);
        range(crc, data, 0, 4);
        System.out.println("after failures " + crc.getValue());
    }

    static void dispatch() {

        byte[] data = pattern(10);
        defer free data;
        CountingCrc counting = new CountingCrc();
        defer free counting;
        counting.update(data);
        System.out.println("counting " + counting.calls + " " + counting.lastOffset + " " + counting.lastLength
                + " " + counting.getValue());
        CRC32 general = counting;
        general.update(data);
        System.out.println("counting through CRC32 " + counting.calls + " " + counting.getValue());
        WholeMarkerCrc marker = new WholeMarkerCrc();
        defer free marker;
        marker.update(data);
        System.out.println("whole marker " + marker.getValue());
        marker.update(data, 0, 10);
        System.out.println("marker range " + marker.getValue());
        ByteCountingCrc bytes = new ByteCountingCrc();
        defer free bytes;
        bytes.update(data, 0, 10);
        bytes.update(data);
        System.out.println("byte calls after ranges " + bytes.calls);
        bytes.update(7);
        System.out.println("byte calls " + bytes.calls + " " + bytes.getValue());
    }

    // Native-only: updates, reads and resets allocate nothing.
    static boolean allocationFree(CRC32 crc) {

        byte[] data = pattern(4096);
        defer free data;
        long before = System.allocationCount();
        for (int round = 0; round < 64; round++) {
            crc.update(data, round, 4096 - round);
            crc.update(data);
            crc.update(round);
            if (crc.getValue() < 0) return false;
            crc.reset();
        }
        return System.allocationCount() == before;
    }

    public static int main(String[] args) {

        // The first CRC32 initializes the process-lived tables: one allocation
        // besides the object itself.
        long beforeFirst = System.allocationCount();
        CRC32 warm = new CRC32();
        long firstUse = System.allocationCount() - beforeFirst;
        free warm;
        long live = System.liveAllocationCount();
        CRC32 crc = new CRC32();
        vectors(crc);
        widened(crc);
        ranges(crc);
        reads(crc);
        streamed(crc);
        long beforeFailures = System.liveAllocationCount();
        failures(crc);
        long caught = System.liveAllocationCount() - beforeFailures;
        dispatch();
        boolean quiet = allocationFree(crc);
        free crc;
        // Two NullPointerExceptions, and seven range failures each with its message.
        if (firstUse != 2 || !quiet || caught != 16) return 1;
        if (System.liveAllocationCount() != live + caught) return 2;
        return 42;
    }
}
